;; `cconv--interactive-helper' is an OClosure type in GNU (defined in
;; oclosure.el); without the cl--class machinery we approximate it with a
;; plain closure that forwards calls, which preserves the observable
;; arity and call behavior.
(defun cconv--interactive-helper (fun if)
  "Add interactive \"form\" IF to FUN.
Returns a new command that otherwise behaves like FUN.
IF can be a Lisp form to be interpreted or a function of no arguments."
  (let ((helper-fun fun) (helper-if if))
    (lambda (&rest args)
      (apply (if (called-interactively-p 'any)
                 #'funcall-interactively #'funcall)
             helper-fun args))))

