;;; --- `cl-struct' pcase expander -----------------------------------
;;; GNU's cl-macs `cl-struct' pcase pattern consults the cl-structure
;;; class table.  Remacs does not implement that machinery, so the
;;; expander below uses a lightweight per-type registry installed via
;;; the `cl-struct--pcase-info' symbol property:
;;;   (PREDICATE SEQTYPE (SLOT . OFFSET)...)
;;; SEQTYPE is `list' (fields accessed with `nth') or anything else
;;; (fields accessed with `aref', tag at index 0 for record types).

(define-error 'cl-struct-unknown-slot "struct has no slot")

(defun cl-struct--pcase-macroexpander (type &rest fields)
  "Pcase patterns that match cl-struct EXPVAL of type TYPE.
Elements of FIELDS can be of the form (NAME PAT) in which case the
contents of field NAME is matched against PAT, or they can be of
the form NAME which is a shorthand for (NAME NAME)."
  (let ((info (get type 'cl-struct--pcase-info)))
    (unless info
      (error "%s is not a known cl-struct type" type))
    `(and (pred ,(car info))
          ,@(mapcar
             (lambda (field)
               (let* ((name (if (consp field) (car field) field))
                      (pat (if (consp field) (cadr field) field))
                      (off (cdr (assq name (cddr info)))))
                 (unless off
                   (signal 'cl-struct-unknown-slot (list type name)))
                 `(app ,(if (eq (cadr info) 'list)
                            `(nth ,off)
                          `(aref _ ,off))
                       ,pat)))
             fields))))

