(defun describe-key-briefly (&optional key-list insert buffer)
  "Print the name of the functions KEY-LIST invokes.\nKEY-LIST is a list of pairs (SEQ . RAW-SEQ) of key sequences, where\nRAW-SEQ is the untranslated form of the key sequence SEQ.\nIf INSERT (the prefix arg) is non-nil, insert the message in the buffer.\n\nWhile reading KEY-LIST interactively, this command temporarily enables\nmenu items or tool-bar buttons that are disabled to allow getting help\non them.\n\nBUFFER is the buffer in which to lookup those keys; it defaults to the\ncurrent buffer."
  (interactive
   (let ((key-list (help--read-key-sequence 'no-mouse-movement)))
     `(,key-list ,current-prefix-arg)))
  (when (arrayp key-list) (setq key-list (list (cons key-list nil))))
  (with-current-buffer
      (if (buffer-live-p buffer) buffer (current-buffer))
    (let*
	((info-list
	  (mapcar
	   (lambda (kr) (help--analyze-key (car kr) (cdr kr) buffer))
	   key-list))
	 (msg
	  (mapconcat #'car (help--filter-info-list info-list 1) "\n")))
      (if insert (insert msg) (message "%s" msg)))))

(defun help--read-key-sequence (&optional no-mouse-movement)
  "Read a key sequence from the user.\nUsually reads a single key sequence, except when that sequence might\nhide another one (e.g. a down event, where the user is interested\nin getting info about the up event, or a click event, where the user\nwants to get info about the double click).\nReturn a list of elements of the form (SEQ . RAW-SEQ), where SEQ is a key\nsequence, and RAW-SEQ is its untranslated form.\nIf NO-MOUSE-MOVEMENT is non-nil, ignore key sequences starting\nwith `mouse-movement' events."
  (let
      ((enable-disabled-menus-and-buttons t) (cursor-in-echo-area t)
       (side-event nil) (echo-keystrokes-help nil) saved-yank-menu)
    (unwind-protect
	(let (last-modifiers key-list)
	  (when (null (cdr yank-menu))
	    (setq saved-yank-menu (copy-sequence yank-menu))
	    (menu-bar-update-yank-menu "(any string)" nil))
	  (while
	      (or (null key-list) (memq 'down last-modifiers)
		  (and (memq 'click last-modifiers)
		       (not
			(sit-for (/ (mouse-double-click-time) 1000.0)
				 t))))
	    (let*
		((prompt
		  (propertize
		   "Describe the following key, mouse click, or menu item: "
		   'face 'minibuffer-prompt))
		 (seq
		  (read-key-sequence prompt nil nil
				     'can-return-switch-frame))
		 (raw-seq (this-single-command-raw-keys))
		 (keyn
		  (when (> (length seq) 0)
		    (aref seq (1- (length seq)))))
		 (base (event-basic-type keyn))
		 (modifiers (event-modifiers keyn)))
	      (cond ((zerop (length seq)))
		    ((and no-mouse-movement (eq base 'mouse-movement))
		     nil)
		    ((memq base
			   '(mouse-movement switch-frame select-window))
		     (setq side-event (cons seq raw-seq)))
		    ((eq base 'help-echo) nil)
		    (t (setq last-modifiers modifiers)
		       (push (cons seq raw-seq) key-list)))))
	  (if side-event (cons side-event (nreverse key-list))
	    (nreverse key-list)))
      (when saved-yank-menu
	(setq yank-menu (copy-sequence saved-yank-menu))
	(fset 'yank-menu (cons 'keymap yank-menu))))))

