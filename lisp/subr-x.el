(defvar auto-raise-mode-hook 'nil
  "Hook run after entering or leaving `auto-raise-mode'.
No problems result if this variable is not bound.
`add-hook' automatically binds it.  (This is true for all minor modes.)")

(defun auto-raise-mode (&optional arg)
  "Toggle whether or not selected frames should auto-raise."
  (interactive (list (or current-prefix-arg 'toggle)))
  (set-frame-parameter nil 'auto-raise
                       (cond ((eq arg 'toggle)
                              (not (frame-parameter nil 'auto-raise)))
                             ((null arg) t)
                             ((and (consp arg) (eq (car arg) 'toggle))
                              (not (frame-parameter nil 'auto-raise)))
                             (t (> (prefix-numeric-value arg) 0))))
  (if (frame-parameter nil 'auto-raise) (raise-frame))
  (run-hooks 'auto-raise-mode-hook)
  (frame-parameter nil 'auto-raise))

(defvar auto-lower-mode-hook 'nil
  "Hook run after entering or leaving `auto-lower-mode'.
No problems result if this variable is not bound.
`add-hook' automatically binds it.  (This is true for all minor modes.)")

(defun auto-lower-mode (&optional arg)
  "Toggle whether or not the selected frame should auto-lower."
  (interactive (list (or current-prefix-arg 'toggle)))
  (set-frame-parameter nil 'auto-lower
                       (cond ((eq arg 'toggle)
                              (not (frame-parameter nil 'auto-lower)))
                             ((null arg) t)
                             ((and (consp arg) (eq (car arg) 'toggle))
                              (not (frame-parameter nil 'auto-lower)))
                             (t (> (prefix-numeric-value arg) 0))))
  (run-hooks 'auto-lower-mode-hook)
  (frame-parameter nil 'auto-lower))

(defvar auto-save-mode-hook 'nil
  "Hook run after entering or leaving `auto-save-mode'.
No problems result if this variable is not bound.
`add-hook' automatically binds it.  (This is true for all minor modes.)")

(defun auto-save-mode (&optional arg)
  "Toggle auto-saving in the current buffer (Auto Save mode)."
  (interactive (list (or current-prefix-arg 'toggle)))
  (setq buffer-auto-save-file-name
        (let ((val (cond ((eq arg 'toggle)
                          (not (and buffer-auto-save-file-name
                                    (>= buffer-saved-size 0))))
                         ((null arg) t)
                         ((and (consp arg) (eq (car arg) 'toggle))
                          (not (and buffer-auto-save-file-name
                                    (>= buffer-saved-size 0))))
                         (t (> (prefix-numeric-value arg) 0)))))
          (cond ((null val) nil)
                ((and buffer-file-name
                      remote-file-name-inhibit-auto-save
                      (file-remote-p buffer-file-name))
                 nil)
                ((and buffer-file-name auto-save-visited-file-name
                      (not buffer-read-only))
                 buffer-file-name)
                (t (make-auto-save-file-name)))))
  (and (< buffer-saved-size 0) (setq buffer-saved-size 0))
  (run-hooks 'auto-save-mode-hook)
  (and buffer-auto-save-file-name (>= buffer-saved-size 0)))

(defvar normal-erase-is-backspace-mode-hook 'nil
  "Hook run after entering or leaving `normal-erase-is-backspace-mode'.
No problems result if this variable is not bound.
`add-hook' automatically binds it.  (This is true for all minor modes.)")

(defun normal-erase-is-backspace-mode (&optional arg)
  "Toggle the Erase and Delete mode of the Backspace and Delete keys."
  (interactive (list (or current-prefix-arg 'toggle)))
  (let ((v (cond ((eq arg 'toggle)
                  (not (eq (terminal-parameter nil 'normal-erase-is-backspace) 1)))
                 ((null arg) t)
                 ((and (consp arg) (eq (car arg) 'toggle))
                  (not (eq (terminal-parameter nil 'normal-erase-is-backspace) 1)))
                 (t (> (prefix-numeric-value arg) 0)))))
    (set-terminal-parameter nil 'normal-erase-is-backspace (if v 1 0)))
  (let ((enabled (eq 1 (terminal-parameter nil 'normal-erase-is-backspace))))
    (cond
     ((display-symbol-keys-p)
      (let ((bindings '(([M-delete] [M-backspace])
                        ([C-M-delete] [C-M-backspace])
                        ([27 C-delete] [27 C-backspace]))))
        (if enabled
            (progn
              (define-key local-function-key-map [delete] [deletechar])
              (define-key local-function-key-map [kp-delete] [deletechar])
              (define-key local-function-key-map [backspace] [127])
              (dolist (b bindings)
                (define-key global-map (nth 0 b) (nth 1 b))))
          (define-key local-function-key-map [delete] "\C-?")
          (define-key local-function-key-map [kp-delete] "\C-?")
          (define-key local-function-key-map [backspace] "\C-?")
          (dolist (b bindings)
            (define-key global-map (nth 0 b) (nth 1 b))
            (define-key global-map (nth 1 b) nil)))))
     ((and (not (window-system)) (eq enabled t))
      (keyboard-translate ?\C-h ?\C-?)
      (keyboard-translate ?\C-? ?\C-d))))
  (run-hooks 'normal-erase-is-backspace-mode-hook)
  (eq (terminal-parameter nil 'normal-erase-is-backspace) 1))

