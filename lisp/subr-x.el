;;; dnd.el remainder
(defcustom dnd-open-file-other-window nil
  "If non-nil, always use `find-file-other-window' to open dropped files."
  :version "22.1" :type 'boolean :group 'dnd)

(defun dnd-handle-movement (posn)
  "Handle mouse movement to POSN when receiving a drop from another program."
  (when (windowp (posn-window posn))
    (with-selected-window (posn-window posn)
      (when (and dnd-scroll-margin (not (posn-area posn)))
	(ignore-errors
	  (let*
	      ((row (cdr (posn-col-row posn)))
	       (window
		(when (windowp (posn-window posn)) (posn-window posn)))
	       (text-height (window-text-height window))
	       (margin (min (/ text-height 3) dnd-scroll-margin)))
	    (unless (<= text-height 2)
	      (cond
	       ((> row (- text-height margin))
		(with-selected-window window (scroll-up 1)))
	       ((< row margin)
		(with-selected-window window (scroll-down 1))))))))
      (when dnd-indicate-insertion-point
	(let ((pos (posn-point posn)))
	  (if (and pos (<= (point-min) pos (point-max)))
	      (goto-char pos)
	    pos))))))

(defvar dnd-unescape-file-uris 't
  "Whether to unescape file: URIs before they are opened.\nBind this to nil when providing `dnd-get-local-file-name' with a\nfile name that may incorporate URI escape sequences.")

(defvar dnd-last-dragged-remote-file 'nil
  "If non-nil, the name of a local copy of the last remote file that was dragged.\nThis may also be a list of files, if multiple files were dragged.\nIt can't be removed immediately after the drag-and-drop operation\ncompletes, since there is no way to determine when the drop\ntarget has finished opening it.  So instead, this file is removed\nwhen Emacs exits or the user drags another file.")

(defun dnd-begin-text-drag
    (text &optional frame action allow-same-frame)
  "Begin dragging TEXT from FRAME.\nInitiate a drag-and-drop operation allowing the user to drag text\nfrom Emacs to another program (the drop target), then block until\nthe drop is completed or is canceled.\n\nIf the drop completed, return the action that the drop target\nactually performed, which can be one of the following symbols:\n\n  - `copy', which means TEXT was inserted by the drop target.\n\n  - `move', which means TEXT was inserted, and the caller should\n    additionally delete TEXT from its source (such as the buffer\n    where it originated).\n\n  - `private', which means the drop target chose to perform an\n    unspecified action.\n\nReturn nil if the drop was canceled.\n\nTEXT is a string containing text that will be inserted by the\nprogram where the drop happened.  FRAME is the frame where the\nmouse is currently held down, or nil, which stands for the\ncurrent frame.  ACTION is one of the symbols `copy' or `move',\nwhere `copy' means that the text should be inserted by the drop\ntarget, and `move' means the same as `copy', but in addition\nthe caller might have to delete TEXT from its source after this\nfunction returns.  If ALLOW-SAME-FRAME is nil, ignore any drops\non FRAME itself.\n\nThis function might return immediately if no mouse buttons are\ncurrently being held down.  It should only be called upon a\n`down-mouse-1' (or similar) event.\n\nThis function is only supported on X Windows, macOS/GNUstep, and Haiku;\non all other platforms it will signal an error."
  (unless (fboundp 'x-begin-drag)
    (error
     "Dragging text from Emacs is not supported by this window system"))
  (gui-set-selection 'XdndSelection text)
  (unless action (setq action 'copy))
  (let
      ((return-value
	(x-begin-drag
	 '("STRING" "TEXT" "COMPOUND_TEXT" "UTF8_STRING" "text/plain"
	   "text/plain;charset=utf-8")
	 (cl-ecase action (copy 'XdndActionCopy)
		   (move 'XdndActionMove))
	 frame nil allow-same-frame)))
    (cond ((eq return-value 'XdndActionCopy) 'copy)
	  ((eq return-value 'XdndActionMove) 'move)
	  ((not return-value) nil) (t 'private))))

(defun dnd-begin-file-drag
    (file &optional frame action allow-same-frame)
  "Begin dragging FILE from FRAME.\nInitiate a drag-and-drop operation allowing the user to drag a file\nfrom Emacs to another program (the drop target), then block until\nthe drop happens or is canceled.\n\nReturn the action that the drop target actually performed, which\ncan be one of the following symbols:\n\n  - `copy', which means FILE was opened by the drop target.\n\n  - `move', which means FILE was moved to another location by the\n    drop target.\n\n  - `link', which means a symbolic link was created to FILE by\n    the drop target, usually a file manager.\n\n  - `private', which means the drop target chose to perform an\n    unspecified action.\n\nReturn nil if the drop was canceled.\n\nFILE is the file name that will be sent to the program where the\ndrop happened.  If it is a remote file, Emacs will make a\ntemporary copy and pass that.  FRAME is the frame where the mouse\nis currently held down, or nil (which means to use the current\nframe).  ACTION is one of the symbols `copy', `move' or `link',\nwhere `copy' means that the file should be opened or copied by\nthe drop target, `move' means the drop target should move the\nfile to another location, and `link' means the drop target should\ncreate a symbolic link to FILE.  It is an error to specify `link'\nas the action if FILE is a remote file.  If ALLOW-SAME-FRAME is\nnil, any drops on FRAME itself will be ignored.\n\nThis function might return immediately if no mouse buttons are\ncurrently being held down.  It should only be called upon a\n`down-mouse-1' (or similar) event.\n\nThis function is only supported on X Windows, macOS/GNUstep, and Haiku;\non all other platforms it will signal an error."
  (unless (fboundp 'x-begin-drag)
    (error
     "Dragging files from Emacs is not supported by this window system"))
  (dnd-remove-last-dragged-remote-file)
  (unless action (setq action 'copy))
  (if
      (and
       (or
	(and (eq dnd-direct-save-remote-files 'x)
	     (eq (framep (or frame (selected-frame))) 'x))
	(and dnd-direct-save-remote-files
	     (not (eq dnd-direct-save-remote-files 'x))))
       (eq action 'copy) (file-remote-p file))
      (dnd-direct-save file (file-name-nondirectory file) frame
		       allow-same-frame)
    (let ((original-file file))
      (when (file-remote-p file)
	(if (eq action 'link)
	    (error "Cannot create symbolic link to remote file")
	  (setq file (file-local-copy file))
	  (setq dnd-last-dragged-remote-file file)
	  (add-hook 'kill-emacs-hook
		    #'dnd-remove-last-dragged-remote-file)))
      (gui-set-selection 'XdndSelection
			 (propertize (expand-file-name file)
				     'text/uri-list
				     (concat "file://"
					     (expand-file-name file))))
      (let
	  ((return-value
	    (x-begin-drag
	     '("text/uri-list" "text/x-xdnd-username" "FILE_NAME"
	       "FILE" "HOST_NAME" "_DT_NETFILE")
	     (cl-ecase action
	       (copy 'XdndActionCopy) (move 'XdndActionMove)
	       (link 'XdndActionLink))
	     frame nil allow-same-frame)))
	(cond ((eq return-value 'XdndActionCopy) 'copy)
	      ((eq return-value 'XdndActionMove)
	       (prog1 'move
		 (when (file-remote-p original-file)
		   (ignore-errors (delete-file original-file)))))
	      ((eq return-value 'XdndActionLink) 'link)
	      ((not return-value) nil) (t 'private))))))

(defun dnd-begin-drag-files
    (files &optional frame action allow-same-frame)
  "Begin dragging FILES from FRAME.\nThis is like `dnd-begin-file-drag', except with multiple files.\nFRAME, ACTION and ALLOW-SAME-FRAME mean the same as in\n`dnd-begin-file-drag'.\n\nFILES is a list of files that will be dragged.  If the drop\ntarget doesn't support dropping multiple files, the first file in\nFILES will be dragged.\n\nThis function is only supported on X Windows, macOS/GNUstep, and Haiku;\non all other platforms it will signal an error."
  (unless (fboundp 'x-begin-drag)
    (error
     "Dragging files from Emacs is not supported by this window system"))
  (dnd-remove-last-dragged-remote-file)
  (let* ((new-files (copy-sequence files)) (tem new-files))
    (while tem
      (setcar tem (expand-file-name (car tem)))
      (when (file-remote-p (car tem))
	(when (eq action 'link)
	  (error "Cannot create symbolic link to remote file"))
	(condition-case error
	    (progn
	      (setcar tem (file-local-copy (car tem)))
	      (push (car tem) dnd-last-dragged-remote-file))
	  (error (message "Failed to download file: %s" error)
		 (setcar tem nil))))
      (setq tem (cdr tem)))
    (when dnd-last-dragged-remote-file
      (add-hook 'kill-emacs-hook #'dnd-remove-last-dragged-remote-file))
    (setq new-files (delq nil new-files))
    (unless new-files
      (error
       "No files were specified or no remote file could be downloaded"))
    (unless action (setq action 'copy))
    (gui-set-selection 'XdndSelection
		       (propertize (car new-files) 'text/uri-list
				   (cl-loop for file in new-files
					    collect
					    (concat "file://" file)
					    into targets finally
					    return
					    (apply #'vector targets))
				   'FILE_NAME
				   (apply #'vector new-files)))
    (let
	((return-value
	  (x-begin-drag
	   '("text/uri-list" "text/x-xdnd-username" "FILE_NAME"
	     "HOST_NAME")
	   (cl-ecase action
	     (copy 'XdndActionCopy) (move 'XdndActionMove)
	     (link 'XdndActionLink))
	   frame nil allow-same-frame)))
      (cond ((eq return-value 'XdndActionCopy) 'copy)
	    ((eq return-value 'XdndActionMove)
	     (prog1 'move
	       (dolist (original-file files)
		 (when (file-remote-p original-file)
		   (ignore-errors (delete-file original-file))))))
	    ((eq return-value 'XdndActionLink) 'link)
	    ((not return-value) nil) (t 'private)))))

(defun dnd-direct-save (file name &optional frame allow-same-frame)
  "Drag FILE from FRAME, but do not treat it as an actual file.\nInstead, ask the target window to insert the file with NAME.\nFile managers will create a file in the displayed directory with\nthe contents of FILE and the name NAME, while text editors will\ninsert the contents of FILE in a new document named\nNAME.\n\nALLOW-SAME-FRAME means the same as in `dnd-begin-file-drag'.\nReturn `copy' if the drop was successful, else nil."
  (setq file (expand-file-name file))
  (cond
   ((eq window-system 'x)
    (when (x-dnd-do-direct-save file name frame allow-same-frame)
      'copy))
   (t
    (let ((dnd-direct-save-remote-files nil))
      (dnd-begin-file-drag file frame nil allow-same-frame)))))

(defcustom dnd-indicate-insertion-point nil
  "Whether or not point should follow the position of the mouse.\nIf non-nil, the point of the window underneath the mouse will be\nadjusted to reflect where any text will be inserted upon drop\nwhen the mouse moves while receiving a drop from another\nprogram."
  :type 'boolean :version "29.1" :group 'dnd)

(defun dnd-remove-last-dragged-remote-file nil
  "Remove the local copy of the last remote file to be dragged.\nIf `dnd-last-dragged-remote-file' is a list, remove all the files\nin that list instead."
  (when dnd-last-dragged-remote-file
    (unwind-protect
	(if (consp dnd-last-dragged-remote-file)
	    (mapc #'delete-file dnd-last-dragged-remote-file)
	  (delete-file dnd-last-dragged-remote-file))
      (setq dnd-last-dragged-remote-file nil)))
  (remove-hook 'kill-emacs-hook #'dnd-remove-last-dragged-remote-file))



