;; seq.el: gv setter for `seq-elt'.  GNU defines this as two
;; cl-defmethods on the `(setf seq-elt)' generic (array/cons); remacs
;; lacks setf-head generics, so dispatch by sequence type directly.
(fset (intern "(setf seq-elt)")
