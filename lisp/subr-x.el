(defun kill-this-buffer nil
  "Kill the current buffer.\nWhen called in the minibuffer, get out of the minibuffer\nusing `abort-recursive-edit'.\n\nThis command can be invoked only from a menu or a tool bar.  If you want\nto invoke a similar command with `M-x', use `kill-current-buffer'."
  (interactive)
  (if
      (let ((lce last-command-event))
	(eq
	 (cond ((atom lce) lce)
	       ((mouse-event-p lce)
		(let*
		    ((posn (event-start lce)) (str (posn-string posn)))
		  (get-text-property (cdr str) 'tool-bar-key (car str))))
	       (t (car lce)))
	 'kill-buffer))
      (if
	  (let*
	      ((window
		(or (posn-window (event--posn-at-point))
		    last-event-frame (selected-frame)))
	       (frame
		(if (framep window) window (window-frame window))))
	    (not (window-minibuffer-p (frame-selected-window frame))))
	  (progn
	    (kill-buffer (current-buffer))
	    (when menu-bar-close-window
	      (ignore-errors (delete-window))))
	(abort-recursive-edit))
    (error "This command must be called from a menu or a tool bar")))

(defun kill-this-buffer-enabled-p nil
  "Return non-nil if the `kill-this-buffer' menu item should be enabled.\nIt should be enabled there is at least one non-hidden buffer, or if\n`menu-bar-close-window' is non-nil and there is more than one window on\nthis frame."
  (or (not (menu-bar-non-minibuffer-window-p))
      (let (found-1)
	(catch 'found-2
	  (dolist (buffer (buffer-list))
	    (unless (string-match-p "^ " (buffer-name buffer))
	      (if (not found-1) (setq found-1 t) (throw 'found-2 t))))))
      (and menu-bar-close-window (window-parent (selected-window)))))

(defun delete-frame-enabled-p nil
  "Return non-nil if `delete-frame' should be enabled in the menu bar."
  (let ((frames (frame-list)) (count 0))
    (while frames
      (if (frame-visible-p (car frames)) (setq count (1+ count)))
      (setq frames (cdr frames)))
    (> count 1)))

(defun menu-bar-update-yank-menu (string old)
  (let
      ((front (car (cdr yank-menu)))
       (menu-string
	(if (<= (length string) yank-menu-length) string
	  (concat (substring string 0 (/ yank-menu-length 2)) "..."
		  (substring string (- (/ yank-menu-length 2)))))))
    (if (string-match "\\`-+\\'" menu-string)
	(setq menu-string (concat menu-string " ")))
    (if (and old (or (eq old (car front)) (string= old (car front))))
	(progn (setcar front string) (setcar (cdr front) menu-string))
      (setcdr yank-menu
	      (cons
	       (cons string (cons menu-string 'menu-bar-select-yank))
	       (cdr yank-menu)))))
  (let ((max-items (min yank-menu-max-items kill-ring-max)))
    (if (> (length (cdr yank-menu)) max-items)
	(setcdr (nthcdr max-items yank-menu) nil))))

