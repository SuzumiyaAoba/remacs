;;; japan-util.el conversion functions (GNU japan-util.el)
(defun japanese-string-conversion (str func &rest args)
  (let ((buf (get-buffer-create " *Japanese work*")))
    (with-current-buffer buf
      (erase-buffer)
      (insert str)
      (apply func (point-min) (point) args)
      (buffer-string))))

(defun japanese-katakana (obj &optional hankaku)
  "Convert argument to Katakana and return that.
The argument may be a character or string.  The result has the same type.
The argument object is not altered--the value is a copy.
Optional argument HANKAKU t means to convert to `hankaku' Katakana
\(`japanese-jisx0201-kana'), in which case return value
may be a string even if OBJ is a character if two Katakanas are
necessary to represent OBJ."
  (if (stringp obj)
      (japanese-string-conversion obj 'japanese-katakana-region hankaku)
    (or (get-char-code-property obj (if hankaku 'jisx0201 'katakana))
	obj)))

(defun japanese-hiragana (obj)
  "Convert argument to Hiragana and return that.
The argument may be a character or string.  The result has the same type.
The argument object is not altered--the value is a copy."
  (if (stringp obj)
      (japanese-string-conversion obj 'japanese-hiragana-region)
    (or (get-char-code-property obj 'hiragana)
	obj)))

(defun japanese-hankaku (obj &optional ascii-only)
  "Convert argument to `hankaku' and return that.
The argument may be a character or string.  The result has the same type.
The argument object is not altered--the value is a copy.
Optional argument ASCII-ONLY non-nil means to return only ASCII character."
  (if (stringp obj)
      (japanese-string-conversion obj 'japanese-hankaku-region ascii-only)
    (or (and (not ascii-only)
	     (get-char-code-property obj 'jisx0201))
	(get-char-code-property obj 'ascii)
	obj)))

(defun japanese-zenkaku (obj)
  "Convert argument to `zenkaku' and return that.
The argument may be a character or string.  The result has the same type.
The argument object is not altered--the value is a copy."
  (if (stringp obj)
      (japanese-string-conversion obj 'japanese-zenkaku-region)
    (or (get-char-code-property obj 'jisx0208)
	obj)))

(defun japanese-replace-region (from to string)
  "Replace the region specified by FROM and TO to STRING."
  (goto-char to)
  (replace-region-contents from to
                           (if (stringp string)
                               string
                             (string string))
                           0))

(defun japanese-katakana-region (from to &optional hankaku)
  "Convert Japanese `hiragana' chars in the region to `katakana' chars."
  (interactive "r\nP")
  (save-excursion
    (goto-char from)
    (while (< (point) to)
      (let* ((ch (following-char))
             (composition (and (not hankaku)
                               (get-char-code-property ch 'kana-composition)))
             (slot (and composition
                        (assq (char-after (1+ (point))) composition))))
        (cond (slot
               (japanese-replace-region (point) (+ (point) 2) (cdr slot)))
              ((get-char-code-property ch (if hankaku 'jisx0201 'katakana))
               (japanese-replace-region (point) (1+ (point))
                (get-char-code-property ch (if hankaku 'jisx0201 'katakana))))
              (t (forward-char 1)))))))

(defun japanese-hiragana-region (from to)
  "Convert Japanese `katakana' chars in the region to `hiragana' chars."
  (interactive "r")
  (save-excursion
    (goto-char from)
    (while (< (point) to)
      (let* ((ch (following-char))
             (composition (get-char-code-property ch 'kana-composition))
             (slot (and composition
                        (assq (char-after (1+ (point))) composition))))
        (cond (slot
               (japanese-replace-region (point) (+ (point) 2)
                (get-char-code-property (cdr slot) 'hiragana)))
              ((get-char-code-property ch 'hiragana)
               (japanese-replace-region (point) (1+ (point))
                (get-char-code-property ch 'hiragana)))
              (t (forward-char 1)))))))

(defun japanese-hankaku-region (from to &optional ascii-only)
  "Convert Japanese `zenkaku' chars in the region to `hankaku' chars."
  (interactive "r\nP")
  (save-excursion
    (goto-char from)
    (while (< (point) to)
      (let ((hankaku (or (and (not ascii-only)
                              (get-char-code-property (following-char) 'jisx0201))
                         (get-char-code-property (following-char) 'ascii))))
        (if hankaku
            (japanese-replace-region (point) (1+ (point)) hankaku)
          (forward-char 1))))))

(defun japanese-zenkaku-region (from to &optional katakana-only)
  "Convert `hankaku' chars in the region to Japanese `zenkaku' chars."
  (interactive "r\nP")
  (save-excursion
    (goto-char from)
    (while (< (point) to)
      (let* ((ch (following-char))
             (hira (get-char-code-property ch 'hiragana))
             (kata (get-char-code-property ch 'katakana)))
        ;; hankaku chars carry jisx0208 only via the zenkaku side; the
        ;; reverse lookup is the table on the hankaku char itself.
        (if (and (not (and katakana-only hira))
                 (get-char-code-property ch 'jisx0208))
            (japanese-replace-region (point) (1+ (point))
             (get-char-code-property ch 'jisx0208))
          (forward-char 1))))))

;;; composite.el
(define-minor-mode global-auto-composition-mode
  "Toggle Auto Composition mode in all buffers.

For more information on Auto Composition mode, see
`auto-composition-mode'."
  :global t
  :variable (default-value 'auto-composition-mode))


;;; cl-preloaded.el / cl-generic.el / oclosure.el struct descriptors.
;;; GNU defines these via `cl-defstruct' with `:include' parents; remacs's
;;; cl-defstruct doesn't emit child accessors for inherited slots, so the
;;; parent slots are inlined in GNU's order (record layout: tag at 0,
;;; slots from 1).

(cl-defstruct (cl-structure-class
               (:conc-name cl--struct-class-)
               (:predicate cl--struct-class-p)
               (:constructor nil)
               (:constructor cl--struct-new-class
                (name docstring parents type named slots index-table
                      children-sym tag print))
               (:copier nil))
  "The type of CL structs descriptors."
  name docstring parents slots index-table tag type named print children-sym)

(cl-defstruct (cl-slot-descriptor
               (:conc-name cl--slot-descriptor-)
               (:constructor nil)
               (:constructor cl--make-slot-descriptor
                (name &optional initform type props))
               (:copier cl--copy-slot-descriptor-1))
  "Descriptor of structure slot."
  name initform type props)

(cl-defstruct (cl--class
               (:constructor nil)
               (:copier nil))
  "Abstract supertype of all type descriptors."
  name docstring parents slots index-table)

(defun cl--class-allparents (class)
  "Return the list of all the ancestors of CLASS, linearized."
  (cons (cl--class-name class)
        (let* ((parents (cl--class-parents class))
               (aps (mapcar #'cl--class-allparents parents)))
          (if (null (cdr aps)) ;; Single-inheritance fast-path.
              (car aps)
            (merge-ordered-lists
             ;; Add the list of immediate parents, to control which
             ;; linearization is chosen.  doi:10.1145/236337.236343
             (nconc aps (list (mapcar #'cl--class-name parents))))))))

(cl-defstruct (built-in-class
               (:conc-name built-in-class--)
               (:predicate built-in-class-p)
               (:constructor nil)
               (:copier nil))
  "Type descriptors for built-in types."
  name docstring parents slots index-table non-abstract-supertype)

(defun built-in-class--make
    (name docstring parent-types &optional non-abstract-supertype)
  (record 'built-in-class name docstring
          (mapcar (lambda (type)
                    (or (get type 'cl--class)
                        (error "Unknown type: %S" type)))
                  parent-types)
          nil nil non-abstract-supertype))

(cl-defstruct (cl-derived-type-class
               (:conc-name cl-derived-type-class-)
               (:predicate cl-derived-type-class-p)
               (:constructor nil)
               (:copier nil))
  "Type descriptors for derived types."
  name docstring parents slots index-table)

(defun cl--derived-type-class-make (name docstring parent-types)
  (record 'cl-derived-type-class name docstring
          (mapcar (lambda (type)
                    (or (get type 'cl--class)
                        (error "Unknown type: %S" type)))
                  parent-types)
          nil nil))

(cl-defstruct (cl--generic-generalizer
               (:conc-name cl--generic-generalizer-)
               (:predicate cl--generic-generalizer-p)
               (:constructor nil)
               (:constructor cl-generic-make-generalizer
                (name priority tagcode-function specializers-function)))
  name priority tagcode-function specializers-function)

(cl-defstruct (cl--generic-method
               (:conc-name cl--generic-method-)
               (:predicate nil)
               (:constructor nil)
               (:constructor cl--generic-make-method
                (specializers qualifiers call-con function)))
  "Type of `cl-generic' method objects."
  specializers qualifiers call-con function)

(defun cl--struct-cl--generic-method-p (x)
  (and (recordp x) (eq (aref x 0) 'cl--generic-method)))

(cl-defstruct (cl--generic
               (:conc-name cl--generic-)
               (:predicate nil)
               (:constructor nil)
               (:constructor cl--generic-make (name)))
  (name nil) dispatches method-table options lazy-function)

(defun cl--struct-cl--generic-p (x)
  (and (recordp x) (eq (aref x 0) 'cl--generic)))

(cl-defstruct (oclosure--class
