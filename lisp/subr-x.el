;;; from /tmp/x_files.el
(define-minor-mode auto-save-visited-mode
  "Toggle automatic saving of file-visiting buffers to their files.\n\nWhen this mode is enabled, file-visiting buffers are automatically\nsaved to their files.  This is in contrast to `auto-save-mode', which\nauto-saves those buffers to a separate file, leaving the original\nfile intact.  See Info node `Saving' for details of the save process.\n\nThe user option `auto-save-visited-interval' controls how often to\nauto-save a buffer into its visited file.\n\nYou can use `auto-save-visited-predicate' to control which\nbuffers are saved.\n\nYou can also set the buffer-local value of the variable\n`auto-save-visited-mode' to nil.  A buffer where the buffer-local\nvalue of this variable is nil is ignored for the purpose of\n`auto-save-visited-mode', even if `auto-save-visited-mode' is\nenabled.\n\nFor more details, see Info node `(emacs) Auto Save Files'."
  :group 'auto-save :global t
  (when auto-save--timer (cancel-timer auto-save--timer))
  (setq auto-save--timer
	(when auto-save-visited-mode
	  (run-with-idle-timer auto-save-visited-interval :repeat
			       #'save-some-buffers :no-prompt
			       (lambda nil
				 (and buffer-file-name
				      auto-save-visited-mode
				      (not
				       (and buffer-auto-save-file-name
					    auto-save-visited-file-name))
				      (or
				       (not
					(file-remote-p
					 buffer-file-name))
				       (not
					remote-file-name-inhibit-auto-save-visited))
				      (or
				       (not
					(functionp
					 auto-save-visited-predicate))
				       (funcall
					auto-save-visited-predicate))))))))

