;; files.el (GNU loaddefs cookie set): autorevert guard macro.
(defvar inhibit-auto-revert-buffers 'nil
  "List of buffers that auto-revert is currently inhibited for.")
(defmacro inhibit-auto-revert (&rest body)
  "Eval BODY, making auto-revert check less aggressively for changed files.
The buffers that BODY visits are put on `inhibit-auto-revert-buffers'
while it runs, and removed afterwards."
  (declare (indent 0) (debug (body)))
  (let ((buf (make-symbol "buf")))
    `(progn
       (dolist (,buf inhibit-auto-revert-buffers)
         (unless (buffer-live-p ,buf)
           (setq inhibit-auto-revert-buffers
                 (delq ,buf inhibit-auto-revert-buffers))))
       (let ((,buf (and (not (memq (current-buffer) inhibit-auto-revert-buffers))
                        (current-buffer))))
         (unwind-protect
             (progn
               (when ,buf (add-to-list 'inhibit-auto-revert-buffers ,buf))
               ,@body)
           (when ,buf
             (setq inhibit-auto-revert-buffers
                   (delq ,buf inhibit-auto-revert-buffers))))))))

