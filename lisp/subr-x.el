(defun vc-menu-map-filter (orig-binding)
  (if (and (symbolp orig-binding) (fboundp orig-binding))
      (setq orig-binding (indirect-function orig-binding)))
  (let
      ((ext-binding
	(when vc-mode
	  (vc-call-backend
	   (if buffer-file-name (vc-backend buffer-file-name)
	     (vc-responsible-backend default-directory))
	   'extra-menu))))
    (if (null ext-binding) orig-binding
      (append orig-binding '((ext-menu-separator "--")) ext-binding))))

