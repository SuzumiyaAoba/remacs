(defun coding-system-change-text-conversion (coding-system coding)
  "Return a coding system which differs from CODING-SYSTEM in text conversion.\nThe returned coding system converts text by CODING\nbut end-of-line as the same way as CODING-SYSTEM.\nIf CODING is nil, the returned coding system detects\nhow text is formatted automatically while decoding."
  (let ((eol-type (coding-system-eol-type coding-system)))
    (coding-system-change-eol-conversion (if coding coding 'undecided)
					 (if (numberp eol-type)
					     (aref [unix dos mac]
						   eol-type)))))

(defun toggle-enable-multibyte-characters (&optional arg)
  "Change whether this buffer uses multibyte characters.\nWith ARG, use multibyte characters if the ARG is positive.\n\nNote that this command does not convert the byte contents of\nthe buffer; it only changes the way those bytes are interpreted.\nIn general, therefore, this command *changes* the sequence of\ncharacters that the current buffer contains.\n\nWe suggest you avoid using this command unless you know what you are\ndoing.  If you use it by mistake, and the buffer is now displayed\nwrong, use this command again to toggle back to the right mode."
  (interactive "P")
  (let
      ((new-flag
	(if (null arg) (null enable-multibyte-characters)
	  (> (prefix-numeric-value arg) 0))))
    (set-buffer-multibyte new-flag))
  (force-mode-line-update))

