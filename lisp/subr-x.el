(defun revert-buffer-insert-file-contents-delicately
    (file-name _auto-save-p)
  "Optional function for `revert-buffer-insert-file-contents-function'.\nThe function `revert-buffer-with-fine-grain' uses this function by binding\n`revert-buffer-insert-file-contents-function' to it.\n\nAs with `revert-buffer-insert-file-contents--default-function', FILE-NAME is\nthe name of the file and AUTO-SAVE-P is non-nil if this is an auto-save file.\nSince calling `replace-region-contents' can take a long time, depending of\nthe number of changes made to the buffer, it uses the value of the variable\n`revert-buffer-with-fine-grain-max-seconds' as a maximum time to try delicately\nreverting the buffer.  If it fails, it does a delete+insert.  For more details,\nsee `replace-region-contents'."
  (cond
   ((not (file-exists-p file-name))
    (error
     (if buffer-file-number "File %s no longer exists"
       "Cannot revert nonexistent file %s")
     file-name))
   ((not (file-readable-p file-name))
    (error
     (if buffer-file-number "File %s no longer readable"
       "Cannot revert unreadable file %s")
     file-name))
   (t
    (let*
	((buf (current-buffer))
	 (success
	  (save-excursion
	    (save-restriction
	      (widen)
	      (with-temp-buffer
		(insert-file-contents file-name)
		(let ((temp-buf (current-buffer)))
		  (set-buffer buf)
		  (let ((buffer-file-name nil))
		    (replace-region-contents (point-min) (point-max)
					     temp-buf
					     revert-buffer-with-fine-grain-max-seconds))))))))
      (defun revert-buffer-with-fine-grain-success-p nil success))
    (set-buffer-modified-p nil) (set-visited-file-modtime))))

(defun revert-buffer-with-fine-grain (&optional ignore-auto noconfirm)
  "Revert buffer preserving markers, overlays, etc.\nThis command is an alternative to `revert-buffer' because it tries to be as\nnon-destructive as possible, preserving markers, properties and overlays.\nBinds `revert-buffer-insert-file-contents-function' to the function\n`revert-buffer-insert-file-contents-delicately'.\n\nWith a prefix argument, offer to revert from latest auto-save file.  For more\ndetails on the arguments, see `revert-buffer'."
  (interactive (list (not current-prefix-arg)))
  (let
      ((revert-buffer-insert-file-contents-function
	#'revert-buffer-insert-file-contents-delicately))
    (revert-buffer ignore-auto noconfirm t)
    (when (fboundp 'revert-buffer-with-fine-grain-success-p)
      (prog1 (revert-buffer-with-fine-grain-success-p)
	(fmakunbound 'revert-buffer-with-fine-grain-success-p)))))

(defun recover-this-file nil
