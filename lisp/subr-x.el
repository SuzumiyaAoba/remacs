the value of the variable with `setq'." :type 'boolean :set (lambda (symbol value) (set-default symbol value) (let ((locsym (get-language-info current-language-environment 'cjk-locale-symbol))) (when locsym (update-cjk-ambiguous-char-widths locsym)))) :version "30.1" :group 'display)

