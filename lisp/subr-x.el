(defun recover-file (file)
  "Visit file FILE, but get contents from its last auto-save file."
  (interactive "FRecover file: ") (setq file (expand-file-name file))
  (if (auto-save-file-name-p (file-name-nondirectory file))
      (user-error "%s is an auto-save file"
		  (abbreviate-file-name file)))
  (let
      ((file-name
	(let ((buffer-file-name file)) (make-auto-save-file-name))))
    (cond
     ((and (file-exists-p file) (not (file-exists-p file-name)))
      (error "Auto save file %s does not exist"
	     (abbreviate-file-name file-name)))
     ((if (file-exists-p file)
	  (not (file-newer-than-file-p file-name file))
	(not (file-exists-p file-name)))
      (user-error "Auto-save file %s not current"
		  (abbreviate-file-name file-name)))
     ((with-temp-buffer-window "*Directory*" nil
			       #'(lambda (window _value)
				   (with-selected-window window
				     (unwind-protect
					 (let
					     ((prompt
					       (format
						"Recover auto save file %s? "
						file-name))
					      (choices
					       '(("yes" 121
						  "recover auto save file")
						 ("no" 110
						  "don't recover auto save file")
						 ("diff" 61
						  "show changes between auto save file and current file")))
					      ans)
					   (while
					       (equal "diff"
						      (setq ans
							    (read-answer
							     prompt
							     choices)))
					     (diff file file-name))
					   (equal ans "yes"))
				       (when (window-live-p window)
					 (quit-restore-window window
							      'kill)))))
	(with-current-buffer standard-output
	  (let
	      ((switches
		(connection-local-value dired-listing-switches)))
	    (if (file-symlink-p file)
		(setq switches (concat switches " -L")))
	    (insert-directory-safely file switches)
	    (insert-directory-safely file-name switches))))
      (switch-to-buffer (find-file-noselect file t))
      (let
	  ((inhibit-read-only t)
	   (coding-system buffer-file-coding-system)
	   (coding-system-for-read 'auto-save-coding))
	(erase-buffer) (insert-file-contents file-name nil)
	(set-buffer-file-coding-system coding-system)
	(set-buffer-auto-saved))
      (after-find-file nil nil t))
     (t (user-error "Recover-file canceled")))))

(defun recover-session nil
  "Recover auto save files from a previous Emacs session.\nThis command first displays a Dired buffer showing you the\nprevious sessions that you could recover from.\nTo choose one, move point to the proper line and then type C-c C-c.\nThen you'll be asked about a number of files to recover."
  (interactive)
  (if (null auto-save-list-file-prefix)
      (error
       "You set `auto-save-list-file-prefix' to disable making session files"))
  (let
      ((dir (file-name-directory auto-save-list-file-prefix))
       (nd (file-name-nondirectory auto-save-list-file-prefix)))
    (unless (file-directory-p dir) (make-directory dir t))
    (unless
	(directory-files dir nil
			 (if (string= "" nd)
			     directory-files-no-dot-files-regexp
			   (concat "\\`" (regexp-quote nd)))
			 t)
      (error "No previous sessions to recover")))
  (let ((ls-lisp-support-shell-wildcards t))
    (dired (concat auto-save-list-file-prefix "*")
	   (concat (connection-local-value dired-listing-switches)
		   " -t"))
    (when (bound-and-true-p dired-omit-mode) (dired-omit-mode -1)))
  (use-local-map (nconc (make-sparse-keymap) (current-local-map)))
  (define-key (current-local-map) "" 'recover-session-finish)
  (save-excursion
    (goto-char (point-min))
    (or (looking-at " Move to the session you want to recover,")
	(let ((inhibit-read-only t))
	  (insert
	   " To recover a session, move to it and type C-c C-c.\n"
	   (substitute-command-keys
	    " To delete a session file, type \\[dired-flag-file-deletion] on its line to flag\n the file for deletion, then \\[dired-do-flagged-delete] to delete flagged files.\n\n"))))))

(defun recover-session-finish nil
  "Choose one saved session to recover auto-save files from.\nThis command is used in the special Dired buffer created by\n\\[recover-session]."
  (interactive)
  (let
      ((file (dired-get-filename)) files
       (buffer (get-buffer-create " *recover*")))
    (dired-unmark 1) (dired-do-flagged-delete t)
    (unwind-protect
	(with-current-buffer buffer
	  (erase-buffer) (insert-file-contents file)
	  (while (not (eobp))
	    (let (thisfile autofile)
	      (if (eolp)
		  (progn
		    (forward-line 1)
		    (unless (eolp)
		      (setq autofile
			    (buffer-substring-no-properties (point)
							    (line-end-position)))
		      (setq thisfile
			    (expand-file-name
			     (substring
			      (file-name-nondirectory autofile) 1 -1)
			     (file-name-directory autofile))))
		    (forward-line 1))
		(progn
		  (setq thisfile
			(buffer-substring-no-properties (point)
							(progn
							  (end-of-line)
							  (point))))
		  (forward-line 1)
		  (setq autofile
			(buffer-substring-no-properties (point)
							(progn
							  (end-of-line)
							  (point))))
		  (forward-line 1)))
	      (if (and autofile (file-exists-p autofile))
		  (setq files (cons thisfile files)))))
	  (setq files (nreverse files))
	  (if files
	      (map-y-or-n-p "Recover %s? "
			    (lambda (file)
			      (condition-case nil
				  (save-excursion (recover-file file))
				(error
				 (message "Failed to recover `%s'"
					  file))))
			    files '("file" "files" "recover"))
	    (message "No files can be recovered from this session now")))
      (kill-buffer buffer))))

(defun list-directory (dirname &optional verbose)
  "Display a list of files in or matching DIRNAME, a la `ls'.\nDIRNAME is globbed by the shell if necessary.\nPrefix arg (second arg if noninteractive) means supply -l switch to `ls'.\nActions controlled by variables `list-directory-brief-switches'\nand `list-directory-verbose-switches'."
  (interactive
   (let ((pfx current-prefix-arg))
     (list
      (read-file-name
       (if pfx "List directory (verbose): "
	 "List directory (brief): ")
       nil default-directory
       (lambda (file)
	 (or (file-directory-p file)
	     (insert-directory-wildcard-in-dir-p
	      (file-name-as-directory (expand-file-name file))))))
      pfx)))
  (let
      ((switches
	(if verbose list-directory-verbose-switches
	  list-directory-brief-switches))
       buffer)
    (or dirname (setq dirname default-directory))
    (setq dirname (expand-file-name dirname))
    (with-output-to-temp-buffer "*Directory*"
      (setq buffer standard-output)
      (buffer-disable-undo standard-output) (princ "Directory ")
      (princ dirname) (terpri)
      (with-current-buffer "*Directory*"
	(let ((wildcard (not (file-directory-p dirname))))
	  (insert-directory dirname switches wildcard (not wildcard)))))
    (with-current-buffer buffer
      (setq default-directory
	    (if (file-accessible-directory-p dirname)
		(file-name-as-directory dirname)
	      (file-name-directory (directory-file-name dirname)))))))

(defun restart-emacs nil
  "Kill the current Emacs process and start a new one.\nThis goes through the same shutdown procedure as\n`save-buffers-kill-emacs', but instead of killing Emacs and\nexiting, it re-executes Emacs (using the same command line\narguments as the running Emacs)."
  (interactive) (save-buffers-kill-emacs nil t))


;;; from /tmp/f_vc-hooks.el
(put 'vc-mode 'risky-local-variable t)

(make-variable-buffer-local 'vc-mode)

(put 'vc-mode 'permanent-local t)

(defun vc-mode (&optional _arg)
  "Version Control minor mode.\nThis minor mode is automatically activated whenever you visit a file under\ncontrol of one of the revision control systems in `vc-handled-backends'.\nVC commands are globally reachable under the prefix \\[vc-prefix-map]:\n\\{vc-prefix-map}"
  nil)

(define-globalized-minor-mode vc-auto-revert-mode auto-revert-mode
  vc-turn-on-auto-revert-mode-for-tracked-files :group 'vc :version
  "31.1")

(defun vc-turn-on-auto-revert-mode-for-tracked-files nil
  "Turn on Auto Revert mode in buffers visiting VCS-tracked files."
  (when (vc-backend buffer-file-name) (auto-revert-mode 1)))

(defmacro vc-error-occurred (&rest body)
  `(condition-case nil (progn ,@body nil) (error t)))

(defun vc--repo-setprop (backend property value)
  "Set per-repository VC PROPERTY to VALUE and return the value."
  (vc-file-setprop (vc-root-dir backend) property value))

(defun vc--repo-getprop (backend property)
  "Get per-repository VC PROPERTY."
  (vc-file-getprop (vc-root-dir backend) property))

(defun vc--repo-clearprops (backend)
  "Clear all VC whole-repository properties."
  (vc-file-clearprops (vc-root-dir backend)))

(defun vc-make-backend-sym (backend sym)
  "Return BACKEND-specific version of VC symbol SYM."
  (intern
   (concat "vc-" (downcase (symbol-name backend)) "-"
	   (symbol-name sym))))

(defun vc-find-backend-function (backend fun)
  "Return BACKEND-specific implementation of FUN.\nIf there is no such implementation, return the default implementation;\nif that doesn't exist either, return nil."
  (let*
      ((read-symbol-shorthands nil)
       (f (vc-make-backend-sym backend fun)))
    (if (fboundp f) f
      (require
       (intern (concat "vc-" (downcase (symbol-name backend)))))
      (if (fboundp f) f
	(let ((def (vc-make-backend-sym 'default fun)))
	  (require 'vc) (if (fboundp def) (cons def backend) nil))))))

(defun vc-call-backend (backend function-name &rest args)
  "Call BACKEND's implementation of FUNCTION-NAME with arguments ARGS.\nDoes\n\n    (apply #\\='vc-BACKEND-FUN ARGS)\n\nif vc-BACKEND-FUN exists (after trying to find it in vc-BACKEND.el)\nand otherwise does\n\n    (apply #\\='vc-default-FUN BACKEND ARGS)\n\nSee also the `vc-call' macro."
  (let ((f (assoc function-name (get backend 'vc-functions))))
    (if f (setq f (cdr f))
      (setq f (vc-find-backend-function backend function-name))
      (push (cons function-name f) (get backend 'vc-functions)))
    (cond
     ((null f) (signal 'vc-not-supported (list function-name backend)))
     ((consp f) (apply (car f) (cdr f) args)) (t (apply f args)))))

(defmacro vc-call (fun file &rest args)
  "A convenience macro for calling VC backend functions.\nFunctions called by this macro must accept FILE as the first argument.\nARGS specifies any additional arguments.  FUN should be unquoted."
  (macroexp-let2 nil file file
    `(vc-call-backend (vc-backend ,file) ',fun ,file ,@args)))

(defsubst vc-parse-buffer (pattern i)
  "Find PATTERN in the current buffer and return its Ith submatch."
  (goto-char (point-min))
  (if (re-search-forward pattern nil t) (match-string i)))

(defun vc-insert-file (file &optional limit blocksize)
  "Insert the contents of FILE into the current buffer.\n\nOptional argument LIMIT is a regexp.  If present, the file is inserted\nin chunks of size BLOCKSIZE (default 8 kByte), until the first\noccurrence of LIMIT is found.  Anything from the start of that occurrence\nto the end of the buffer is then deleted.  The function returns\nnon-nil if FILE exists and its contents were successfully inserted."
  (erase-buffer)
  (when (file-exists-p file)
    (if (not limit) (insert-file-contents file)
      (unless blocksize (setq blocksize 8192))
      (let ((filepos 0))
	(while
	    (and
	     (< 0
		(cadr
		 (insert-file-contents file nil filepos
				       (incf filepos blocksize))))
	     (progn
	       (beginning-of-line)
	       (let ((pos (re-search-forward limit nil 'move)))
		 (when pos
		   (delete-region (match-beginning 0) (point-max)))
		 (not pos)))))))
    (set-buffer-modified-p nil) t))

(defun vc-find-root (file witness)
  "Find the root of a checked out project.\nThe function walks up the directory tree from FILE looking for WITNESS.\nIf WITNESS if not found, return nil, otherwise return the root."
  (let
      ((locate-dominating-stop-dir-regexp
	(or vc-ignore-dir-regexp locate-dominating-stop-dir-regexp)))
    (locate-dominating-file file witness)))

(defun vc-registered (file)
  "Return non-nil if FILE is registered in a version control system.\n\nThis function performs the check each time it is called.  To rely\non the result of a previous call, use `vc-backend' instead.  If the\nfile was previously registered under a certain backend, then that\nbackend is tried first."
  (if
      (and (eq system-type 'android)
	   (string-match-p "/\\(content\\|assets\\)[/$]"
			   (expand-file-name file)))
      nil
    (let (handler)
      (cond
       ((and (file-name-directory file)
	     (string-match vc-ignore-dir-regexp
			   (file-name-directory file)))
	nil)
       ((setq handler (find-file-name-handler file 'vc-registered))
	(funcall handler 'vc-registered file))
       (t
	(catch 'found
	  (let ((backend (vc-file-getprop file 'vc-backend)))
	    (mapc
	     (lambda (b)
	       (and (vc-call-backend b 'registered file)
		    (vc-file-setprop file 'vc-backend b)
		    (throw 'found t)))
	     (if (or (not backend) (eq backend 'none))
		 vc-handled-backends
	       (cons backend vc-handled-backends))))
	  (vc-file-setprop file 'vc-backend 'none) nil))))))

(defun vc-backend (file-or-list)
  "Return the version control type of FILE-OR-LIST, nil if it's not registered.\nIf the argument is a list, the files must all have the same back end.\n\nThis function returns cached information.  To query the VCS regarding\nwhether FILE-OR-LIST is registered or unregistered, use `vc-registered'."
  (cond
   ((stringp file-or-list)
    (if
	(and (eq system-type 'android)
	     (string-match-p "/\\(content\\|assets\\)[/$]"
			     (expand-file-name file-or-list)))
	nil
      (let ((property (vc-file-getprop file-or-list 'vc-backend)))
	(cond ((eq property 'none) nil) (property)
	      (t
	       (if (vc-registered file-or-list)
		   (vc-file-getprop file-or-list 'vc-backend)
		 nil))))))
   ((and file-or-list (listp file-or-list))
    (vc-backend (car file-or-list)))
   (t nil)))

(defun vc-backend-subdirectory-name (file)
  "Return where the repository for the current directory is kept."
  (symbol-name (vc-backend file)))

(defun vc-checkout-model (backend files)
  "Indicate how FILES are checked out.\n\nIf FILES are not registered, this function always returns nil.\nFor registered files, the possible values are:\n\n  `implicit'   FILES are always writable, and checked out `implicitly'\n              when the user saves the first changes to the file.\n\n  `locking'   FILES are read-only if up-to-date; user must type\n              \\[vc-next-action] before editing.  Strict locking\n              is assumed.\n\n  `announce'  FILES are read-only if up-to-date; user must type\n              \\[vc-next-action] before editing.  But other users\n              may be editing at the same time."
  (vc-call-backend backend 'checkout-model files))

(defun vc-user-login-name (file)
  "Return the name under which the user accesses the given FILE."
  (or
   (and (file-remote-p file)
	(let
	    ((default-directory (file-name-directory file))
	     process-file-side-effects)
	  (with-temp-buffer
	    (if (not (zerop (process-file "whoami" nil t))) nil
	      (delete-region (1- (point-max)) (point-max))
	      (buffer-string)))))
   (user-login-name) (number-to-string (user-uid))))

(defun vc-state (file &optional backend)
  "Return the version control state of FILE.\n\nA return of nil from this function means we have no information on the\nstatus of this file.  Otherwise, the value returned is one of:\n\n  `up-to-date'       The working file is unmodified with respect to the\n                     latest version on the current branch, and not locked.\n\n  `edited'           The working file has been edited by the user.  If\n                     locking is used for the file, this state means that\n                     the current version is locked by the calling user.\n                     This status should *not* be reported for files\n                     which have a changed mtime but the same content\n                     as the repo copy.\n\n  USER               The current version of the working file is locked by\n                     some other USER (a string).\n\n  `needs-update'     The file has not been edited by the user, but there is\n                     a more recent version on the current branch stored\n                     in the repository.\n\n  `needs-merge'      The file has been edited by the user, and there is also\n                     a more recent version on the current branch stored in\n                     the repository.  This state can only occur if locking\n                     is not used for the file.\n\n  `unlocked-changes' The working version of the file is not locked,\n                     but the working file has been changed with respect\n                     to that version.  This state can only occur for files\n                     with locking; it represents an erroneous condition that\n                     should be resolved by the user (vc-next-action will\n                     prompt the user to do it).\n\n  `added'            Scheduled to go into the repository on the next commit.\n                     Often represented by vc-working-revision = \"0\" in VCSes\n                     with monotonic IDs like Subversion and Mercurial.\n\n  `removed'          Scheduled to be deleted from the repository on next commit.\n\n  `conflict'         The file contains conflicts as the result of a merge.\n                     For now the conflicts are text conflicts.  In the\n                     future this might be extended to deal with metadata\n                     conflicts too.\n\n  `missing'          The file is not present in the file system, but the VC\n                     system still tracks it.\n\n  `ignored'          The file showed up in a dir-status listing with a flag\n                     indicating the version-control system is ignoring it,\n                     Note: This property is not set reliably (some VCSes\n                     don't have useful directory-status commands) so assume\n                     that any file with vc-state nil might be ignorable\n                     without VC knowing it.\n\n  `unregistered'     The file is not under version control."
  (or (vc-file-getprop file 'vc-state)
      (when (> (length file) 0)
	(setq backend (or backend (vc-backend file)))
	(when backend (vc-state-refresh file backend)))))

(defun vc-state-refresh (file backend)
  "Quickly recompute the `state' of FILE."
  (vc-file-setprop file 'vc-state
		   (vc-call-backend backend 'state file)))

(defsubst vc-up-to-date-p (file)
  "Convenience function to check whether `vc-state' of FILE is `up-to-date'."
  (eq (vc-state file) 'up-to-date))

(defun vc-working-revision (file &optional backend)
  "Return the repository version from which FILE was checked out.\nIf FILE is not registered, this function always returns nil.\n\nThis function does not return nil without first confirming with the\nunderlying VCS that FILE is unregistered; this is in contrast to\n`vc-symbolic-working-revision'."
  (let ((abs (expand-file-name file)))
    (or (vc-file-getprop abs 'vc-working-revision)
	(let ((default-directory (file-name-directory abs)))
	  (and (setq backend (or backend (vc-backend file)))
	       (vc-file-setprop abs 'vc-working-revision
				(vc-call-backend backend
						 'working-revision
						 file)))))))

(defun vc-symbolic-working-revision (file &optional backend)
  "Return BACKEND's symbolic name for FILE's working revision.\nIf FILE names an existing directory, the BACKEND argument is mandatory.\nIf FILE is not registered according to cached information or names an\nexisting directory and BACKEND is nil, return nil.\nIf BACKEND does not have a symbolic name for the working revision or\nEmacs doesn't know what it is, call `vc-working-revision' instead.\n\nPrefer this function to `vc-working-revision' whenever a symbolic name\nwill do, for it avoids a call out to the underlying VCS."
  (let (cached-backend)
    (and
     (or (and (file-directory-p file) backend)
	 (setq cached-backend (vc-backend file)))
     (let*
	 ((backend (or backend cached-backend))
	  (fn
	   (vc-find-backend-function backend 'working-revision-symbol)))
       (if fn (funcall fn) (vc-working-revision file backend))))))

(defun vc-short-revision (file &optional backend)
  "Return the repository version for FILE in a shortened form.\nIf FILE is not registered, this function always returns nil."
  (let ((vc-use-short-revision t))
    (vc-call-backend (or backend (vc-backend file)) 'working-revision
		     file)))

(defun vc-default-registered (backend file)
  "Check if FILE is registered in BACKEND using vc-BACKEND-master-templates."
  (let ((sym (vc-make-backend-sym backend 'master-templates)))
    (unless (get backend 'vc-templates-grabbed)
      (put backend 'vc-templates-grabbed t))
    (let
	((result (vc-check-master-templates file (symbol-value sym))))
      (if (stringp result)
	  (vc-file-setprop file 'vc-master-name result)
	nil))))

(defun vc-possible-master (s dirname basename)
  (cond ((stringp s) (format s dirname basename))
	((functionp s)
	 (let ((result (catch 'found (funcall s dirname basename))))
	   (if (consp result) (car result) result)))))

(defun vc-check-master-templates (file templates)
  "Return non-nil if there is a master corresponding to FILE.\n\nTEMPLATES is a list of strings or functions.  If an element is a\nstring, it must be a control string as required by `format', with two\nstring placeholders, such as \"%sRCS/%s,v\".  The directory part of\nFILE is substituted for the first placeholder, the basename of FILE\nfor the second.  If a file with the resulting name exists, it is taken\nas the master of FILE, and returned.\n\nIf an element of TEMPLATES is a function, it is called with the\ndirectory part and the basename of FILE as arguments.  It should\nreturn non-nil if it finds a master; that value is then returned by\nthis function."
  (let
      ((dirname (or (file-name-directory file) ""))
       (basename (file-name-nondirectory file)))
    (catch 'found
      (mapcar
       (lambda (s)
	 (let ((trial (vc-possible-master s dirname basename)))
	   (when
	       (and trial (file-exists-p trial)
		    (or
		     (not
		      (string= dirname (file-name-directory trial)))
		     (not
		      (equal (file-attributes file)
			     (file-attributes trial)))))
	     (throw 'found trial))))
       templates))))

(defun vc-default-make-version-backups-p (_backend _file)
  "Return non-nil if unmodified versions should be backed up locally.\nThe default is to switch off this feature."
  nil)

(defun vc-version-backup-file-name (file &optional rev manual regexp)
  "Return a backup file name for REV or the current version of FILE.\nIf MANUAL is non-nil it means that a name for backups created by\nthe user should be returned; if REGEXP is non-nil that means to return\na regexp for matching all such backup files, regardless of the version."
  (if regexp
      (concat (regexp-quote (file-name-nondirectory file)) "\\.~.+"
	      (unless manual "\\.") "~")
    (expand-file-name
     (concat (file-name-nondirectory file) ".~"
	     (subst-char-in-string 47 95
				   (or rev (vc-working-revision file)))
	     (unless manual ".") "~")
     (file-name-directory file))))

(defun vc-delete-automatic-version-backups (file)
  "Delete all existing automatic version backups for FILE."
  (condition-case nil
      (mapc #'delete-file
	    (directory-files
	     (or (file-name-directory file) default-directory) t
	     (vc-version-backup-file-name file nil nil t)))
    (file-error nil)))

(defun vc-make-version-backup (file)
  "Make a backup copy of FILE, which is assumed in sync with the repository.\nBefore doing that, check if there are any old backups and get rid of them."
  (unless
      (and (fboundp 'msdos-long-file-names)
	   (not (with-no-warnings (msdos-long-file-names))))
    (vc-delete-automatic-version-backups file)
    (condition-case nil
	(copy-file file (vc-version-backup-file-name file) nil
		   'keep-date)
      (file-error
       (message
	(concat "Warning: Cannot make version backup; "
		"diff/revert therefore not local"))))))

(defun vc-before-save nil
  "Function to be called by `basic-save-buffer' (in files.el)."
  (let ((file buffer-file-name) backend)
    (ignore-errors
      (unless (file-exists-p file) (vc-file-clearprops file))
      (and (setq backend (vc-backend file)) (vc-up-to-date-p file)
	   (eq (vc-checkout-model backend (list file)) 'implicit)
	   (vc-call-backend backend 'make-version-backups-p file)
	   (vc-make-version-backup file)))))

(defun vc-after-save nil
  "Function to be called by `basic-save-buffer' (in files.el)."
  (let* ((file buffer-file-name) (backend (vc-backend file)))
    (cond ((null backend))
	  ((eq (vc-checkout-model backend (list file)) 'implicit)
	   (if
	       (time-equal-p (vc-file-getprop file 'vc-checkout-time)
			     (file-attribute-modification-time
			      (file-attributes file)))
	       (vc-file-setprop file 'vc-checkout-time nil))
	   (if (vc-state-refresh file backend)
	       (vc-mode-line file backend)))
	  ((eq (vc-file-getprop file 'vc-state) 'up-to-date)
	   (vc-file-setprop file 'vc-state nil)))
    (when vc-dir-buffers (vc-dir-resynch-file file))))

(defun vc-after-revert nil
  "Update VC-Dir contents after reverting a buffer from disk."
  (when-let* (vc-dir-buffers (backend (vc-backend buffer-file-name)))
    (vc-dir-resynch-file buffer-file-name)))

(defun vc-mode-line-state (state)
  "Return a list of data to display on the mode line.\nThe argument STATE should contain the version control state returned\nfrom `vc-state'.  The returned list includes three elements: the echo\nstring, the face name, and the indicator that usually is one character."
  (let (state-echo face indicator)
    (cond
     ((or (eq state 'up-to-date) (eq state 'needs-update))
      (setq state-echo "Up to date file")
      (setq face 'vc-up-to-date-state) (setq indicator "-"))
     ((stringp state)
      (setq state-echo (concat "File locked by" state))
      (setq face 'vc-locked-state)
      (setq indicator (concat ":" state ":")))
     ((eq state 'added) (setq state-echo "Locally added file")
      (setq face 'vc-locally-added-state) (setq indicator "@"))
     ((eq state 'conflict)
      (setq state-echo "File contains conflicts after the last merge")
      (setq face 'vc-conflict-state) (setq indicator "!"))
     ((eq state 'removed)
      (setq state-echo "File removed from the VC system")
      (setq face 'vc-removed-state) (setq indicator "!"))
     ((eq state 'missing)
      (setq state-echo
	    "File tracked by the VC system, but missing from the file system")
      (setq face 'vc-missing-state) (setq indicator "?"))
     ((eq state 'ignored)
      (setq state-echo "File tracked by the VC system, but ignored")
      (setq face 'vc-ignored-state) (setq indicator "!"))
     (t (setq state-echo "Locally modified file")
	(setq face 'vc-edited-state) (setq indicator ":")))
    (list state-echo face indicator)))

(defun vc-default-mode-line-string (backend file)
  "Return a string for `vc-mode-line' to put in the mode line for FILE.\nFormat:\n\n  \"BACKEND-REV\"        if the file is up-to-date\n  \"BACKEND:REV\"        if the file is edited (or locked by the calling user)\n  \"BACKEND:LOCKER:REV\" if the file is locked by somebody else\n  \"BACKEND@REV\"        if the file was locally added\n  \"BACKEND!REV\"        if the file contains conflicts or was removed\n  \"BACKEND?REV\"        if the file is under VC, but is missing\n\nThis function assumes that the file is registered."
  (pcase-let*
      ((backend-name (symbol-name backend))
       (state (vc-state file backend))
       (rev (vc-symbolic-working-revision file backend))
       (`(,state-echo ,face ,indicator) (vc-mode-line-state state))
       (state-string
	(concat
	 (and (not (eq vc-display-status 'no-backend)) backend-name)
	 indicator rev)))
    (propertize state-string 'face face 'help-echo
		(concat state-echo " under the " backend-name
			" version control system"))))

(defun vc-follow-link nil
  "If current buffer visits a symbolic link, visit the real file.\nIf the real file is already visited in another buffer, make that buffer\ncurrent, and kill the buffer that visits the link."
  (let*
      ((true-buffer (find-buffer-visiting buffer-file-truename))
       (this-buffer (current-buffer)))
    (if (eq true-buffer this-buffer)
	(let ((truename buffer-file-truename))
	  (kill-buffer this-buffer)
	  (set-buffer (find-file-noselect truename)))
      (set-buffer true-buffer) (kill-buffer this-buffer))))

