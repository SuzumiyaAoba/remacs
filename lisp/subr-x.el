;;; from /tmp/v_mouse.el
(defcustom mouse-yank-at-point nil
  "If non-nil, mouse yank commands yank at point instead of at click.\nThis also allows yanking text into an isearch without moving the\nmouse cursor to the echo area."
  :type 'boolean)

(defcustom mouse-1-double-click-prefer-symbols nil
  "If non-nil, double-clicking Mouse-1 attempts to select the symbol at click.\n\nIf nil, the default, double-clicking Mouse-1 on a word-constituent\ncharacter will select only the word at click location, which could\nselect fewer characters than the symbol at click."
  :type 'boolean :version "30.1")

(defcustom mouse-drag-and-drop-region-scroll-margin nil
  "If non-nil, the scroll margin inside a window when dragging text.\nIf the mouse moves this many lines close to the top or bottom of\na window while dragging text, then that window will be scrolled\ndown and up respectively."
  :type
  '(choice (const :tag "Don't scroll during mouse movement")
	   (integer :tag "This many lines from window top or bottom"))
  :version "29.1")

(defcustom mouse-drag-mode-line-buffer nil
  "If non-nil, allow dragging files from the mode line.\nWhen the buffer has an associated file, it can be dragged from\nthe buffer name portion of its mode line to other programs.\n\nThis option is only supported on X, Haiku and Nextstep (GNUstep\nor macOS)."
  :type 'boolean :version "29.1")

(defcustom mouse-wheel-buttons
  '((4 . wheel-up) (5 . wheel-down) (6 . wheel-left) (7 . wheel-right))
  "How to remap mouse button numbers to wheel events.\nThis is an alist of (NUMBER . SYMBOL) used to remap old-style mouse wheel\nevents represented as mouse button events.  It remaps mouse button\nNUMBER to the event SYMBOL.  SYMBOL must be one of `wheel-up', `wheel-down',\n`wheel-left', or `wheel-right'.\nThis is used only for events that come from sources known to generate such\nevents, such as X11 events when XInput2 is not used, or events coming from\na text terminal."
