;;; flymake.el --- minimal stub satisfying flymake autoloads -*- lexical-binding: t -*-

;; GNU's flymake.el is a full syntax-checking framework requiring
;; comint/compile/project.  remacs embeds this minimal version so that
;; the `flymake' autoloads generated by loaddefs.el resolve: loading
;; the library defines each autoloaded entry point, which is the
;; contract `autoload' checks.  Diagnostics are represented as
;; (LOCUS BEG END TYPE TEXT . DATA) lists.

(defvar flymake-diagnostic-types-alist nil)
(defvar flymake-diagnostic-functions nil)
(defvar-local flymake-mode nil)
(defvar-local flymake--diagnostics nil)

(defun flymake--log-1 (level sublog msg &rest args)
  "Do actual work for `flymake-log' (remacs stub backend)."
  (let ((warning-minimum-level :emergency)
        (warning-type-format
         (format " [%s %s]"
                 (or sublog 'flymake)
                 (replace-regexp-in-string "%" "%%"
                                           (buffer-name (current-buffer))))))
    (display-warning (list 'flymake sublog)
                     (apply #'format-message msg args)
                     (if (numberp level)
                         (or (nth level '(:emergency :error :warning :debug :debug))
                             :error)
                       level)
                     "*Flymake log*")))

(defmacro flymake-log (level msg &rest args)
  "Log, at level LEVEL, the message MSG formatted with ARGS.
Expands to `flymake--log-1' like GNU; MSG/ARGS are evaluated."
  (let* ((file (if (fboundp 'macroexp-file-name)
                   (macroexp-file-name)
                 (and (not load-file-name)
                      (bound-and-true-p byte-compile-current-file))))
         (sublog (if (stringp file)
                     (intern
                      (file-name-nondirectory
                       (file-name-sans-extension file))))))
    `(flymake--log-1 ,level ',sublog ,msg ,@args)))

(defun flymake-make-diagnostic (locus beg end type text &optional data _overlay-properties)
  "Make a Flymake diagnostic for LOCUS's region from BEG to END.
This stub returns a record compatible with Flymake diagnostic accessors."
  (let* ((info (if (stringp text) (list nil nil text) text))
         (code (cadr info))
         (diag (make-record 'flymake--diag 13 nil)))
    (when (numberp code)
      (setq info (list (car info) (number-to-string code) (caddr info))))
    (aset diag 1 (if (stringp locus) (expand-file-name locus) locus))
    (aset diag 2 beg)
    (aset diag 3 end)
    (aset diag 4 type)
    (aset diag 5 (car info))
    (aset diag 6 (cadr info))
    (aset diag 7 (caddr info))
    (aset diag 9 data)
    (aset diag 10 _overlay-properties)
    (aset diag 12 beg)
    (aset diag 13 end)
    diag))

(defun flymake-diagnostic-type (diag) (aref diag 4))
(defun flymake-diagnostic-backend (diag) (aref diag 8))
(defun flymake-diagnostic-origin (diag) (aref diag 5))
(defun flymake-diagnostic-code (diag) (aref diag 6))
(defun flymake-diagnostic-message (diag) (aref diag 7))
(defun flymake-diagnostic-data (diag) (aref diag 9))
(defun flymake-diagnostic-beg (diag) (aref diag 2))
(defun flymake-diagnostic-end (diag) (aref diag 3))
(defun flymake-diagnostic-buffer (diag) (aref diag 1))

(defun flymake-diagnostic-text (diag &optional parts)
  "Return diagnostic DIAG's text, optionally selecting PARTS."
  (let ((parts (or parts '(origin code message)))
        (origin (flymake-diagnostic-origin diag))
        (code (flymake-diagnostic-code diag))
        (message (flymake-diagnostic-message diag))
        (headline-seen nil)
        (prev nil)
        (result ""))
    (dolist (part parts result)
      (let ((text (pcase part
                    ('origin origin)
                    ('code (and code (concat "[" code "]")))
                    ('message message)
                    ('oneliner (and message
                                    (substring message 0
                                               (or (string-match "\n" message)
                                                   (length message))))))))
        (when (and (memq part '(origin code)) text)
          (setq headline-seen t))
        (when (and (memq part '(message oneliner)) headline-seen)
          (setq result (concat result ":")))
        (when prev
          (setq result (concat result " ")))
        (when text
          (setq result (concat result text)))
        (setq prev part)))))

(defun flymake-diagnostic-oneliner (diag &optional _nopaintp)
  "Return a one-line description of DIAG."
  (flymake-diagnostic-text diag '(origin code oneliner)))

(defun flymake-diag-region (buffer line &optional col)
  "Compute BUFFER's region (BEG . END) corresponding to LINE and COL.
If COL is nil, return a region for the whole line."
  (with-current-buffer buffer
    (save-excursion
      (save-restriction
        (widen)
        (goto-char (point-min))
        (forward-line (1- line))
        (if col
            (let ((beg (+ (point) (1- col)))
                  (end (line-end-position)))
              (and (<= beg end) (cons beg end)))
          (cons (point) (line-end-position)))))))

(defun flymake-diagnostics (&optional _beg _end)
  "Get Flymake diagnostics in the current buffer."
  flymake--diagnostics)

(defun flymake-mode (&optional arg)
  "Toggle Flymake mode on or off (stub)."
  (interactive)
  (setq flymake-mode
        (if (null arg)
            (not flymake-mode)
          (> (prefix-numeric-value arg) 0))))

(defun flymake-mode-on ()
  "Turn Flymake mode on."
  (flymake-mode 1))

(defun flymake-mode-off ()
  "Turn Flymake mode off."
  (flymake-mode 0))

(provide 'flymake)
;;; flymake.el ends here
