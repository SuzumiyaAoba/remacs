      (when (consp item)
        (define-key menu (vector (car item)) (cdr item)))))

  (when (mouse-posn-property (event-start click) 'mouse-face)
    (define-key menu [help-mode-push-button]
      `(menu-item "Follow Link" ,(lambda (event)
                                   (interactive "e")
