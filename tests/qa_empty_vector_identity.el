;;; -*- lexical-binding: nil; -*-
;; GNU shares the zero-vector across all construction paths (#368).
(dolist (empty (list [] (vector) (make-vector 0 nil) (vconcat)
                     (read "[]") (copy-sequence []) (reverse [])
                     (sort [] :lessp #'<) (substring [] 0)))
  (qa (eq empty []) t)
  (qa (eql empty []) t)
  (qa (let ((table (make-hash-table :test 'eq)))
        (puthash empty 'found table)
        (gethash [] table)) 'found)
  (qa (let ((table (make-hash-table :test 'eql)))
        (puthash [] 'found table)
        (gethash empty table)) 'found))
(qa (eq [a] (vector 'a)) nil)
(qa (eq (bool-vector) (bool-vector)) nil)
(qa (eq (record 'test) (record 'test)) nil)
;; Internal resizable obarray storage must not use the shared zero-vector.
(let ((a (obarray-make)) (b (obarray-make)))
  (intern "empty368-only-a" a)
  (qa (intern-soft "empty368-only-a" b) nil)
  (qa (length []) 0)
  (obarray-clear a)
  (qa (length []) 0))
;; The globally shared empty vector survives collection in weak tables.
(let ((table (make-hash-table :test 'eq :weakness 'key)))
  (puthash (vector) 'found table)
  (garbage-collect)
  (qa (gethash [] table) 'found))
(princ (qa--done))
