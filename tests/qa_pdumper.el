;;; -*- lexical-binding: t; -*-
;; Issue #112: real dump output/errors, and statistics for this session.
(defvar qa112-arg)
(defvar qa112-dir (make-temp-file "remacs-qa112-" t))
(defvar qa112-file (expand-file-name "image.pdmp" qa112-dir))
(defvar qa112-table nil)
(defvar qa112-overlay nil)
(defvar qa112-hook-ran nil)
(qa (let ((stats (pdumper-stats)))
      (or (null stats)
          (and (equal (mapcar #'car stats) '(dumped-with-pdumper load-time dump-file-name))
               (eq (cdr (assq 'dumped-with-pdumper stats)) t)
               (floatp (cdr (assq 'load-time stats)))
               (>= (cdr (assq 'load-time stats)) 0)
               (stringp (cdr (assq 'dump-file-name stats)))
               (file-name-absolute-p (cdr (assq 'dump-file-name stats)))))) t)
(unwind-protect
    (progn
      (dolist (qa112-arg '(nil t 1 []))
        (qa-err-data (dump-emacs-portable qa112-arg) 'wrong-type-argument (list 'stringp qa112-arg)))
      (qa (let ((before gcs-done))
            (condition-case nil (dump-emacs-portable 1) (error nil))
            (> gcs-done before)) t)
      (qa (let ((post-gc-hook (list (lambda () (setq qa112-hook-ran t)))))
            (setq qa112-hook-ran nil)
            (condition-case nil (dump-emacs-portable 1) (error nil))
            qa112-hook-ran) t)
      (qa (let ((command-line-processed 'saved))
            (condition-case nil (dump-emacs-portable 1) (error nil))
            command-line-processed) 'saved)
      (qa-err (dump-emacs-portable qa112-dir) 'file-error)
      (qa-err (dump-emacs-portable (expand-file-name "missing/image.pdmp" qa112-dir)) 'file-missing)
      (define-hash-table-test 'qa112-test #'eq #'sxhash-eq)
      (setq qa112-table (make-hash-table :test 'qa112-test))
      (qa-err-data (dump-emacs-portable qa112-file) 'error '("cannot dump hash tables with user-defined tests"))
      (qa (file-exists-p qa112-file) t)
      (qa-err-data (dump-emacs-portable qa112-file t) 'error '("cannot dump hash tables with user-defined tests"))
      (setq qa112-table nil)
      (setq qa112-overlay (make-overlay (point-min) (point-min)))
      (qa-err-data (dump-emacs-portable qa112-file) 'error '("dumping overlays is not yet implemented"))
      (qa (file-exists-p qa112-file) t)
      (delete-overlay qa112-overlay)
      (overlay-put qa112-overlay 'qa112-property 17)
      (qa (progn (dump-emacs-portable qa112-file) nil) nil)
      (qa (> (file-attribute-size (file-attributes qa112-file)) 100) t)
      ;; Producing a new image does not change where this process started.
      (qa (let ((before (pdumper-stats)))
            (dump-emacs-portable qa112-file 1)
            (equal before (pdumper-stats))) t)
      (qa (thread-join
           (make-thread (lambda ()
                          (condition-case error
                              (dump-emacs-portable 1)
                            (error error)))))
          '(error "This function can be called only in the main thread")))
  (when qa112-overlay (delete-overlay qa112-overlay))
  (setq qa112-table nil qa112-overlay nil)
  (delete-directory qa112-dir t))
(princ (qa--done)) (terpri)
