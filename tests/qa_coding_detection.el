;;; -*- lexical-binding: nil -*-
;; Coding detection regression for issue #82.
;; Every expected result was generated and verified with GNU Emacs 31.1.
;; Use literal bytes: encode-coding-string has a separate ISO-2022 encoder
;; gap (issue #12), so constructing fixtures with it would mask this bug.
;; Preserve both language environment and category priorities, even on error.
(let ((qa-detect-saved-language current-language-environment)
      (qa-detect-saved-priority (coding-system-priority-list)))
  (unwind-protect
      (progn

