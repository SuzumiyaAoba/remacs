;;; -*- lexical-binding: nil -*-
(defun qa61-scan (spec text backward &optional limit)
  (with-temp-buffer
    (insert text)
    (goto-char (if backward (point-max) (point-min)))
    (condition-case e
        (list (if backward (skip-chars-backward spec limit)
                (skip-chars-forward spec limit)) (point))
      (error e))))
(defvar qa61-chars '(0 9 10 13 31 32 33 48 57 65 70 90 91 92 93 95 97 102 122 127 128 159 160 178 192 233 255 256 768 888 945 1632 2307 8192 8203 8232 8233 8413 8544 12288 19968 57344 128512 1114111))
(defun qa61-class-results (name backward)
  (mapcar (lambda (c) (car (qa61-scan (concat "[:" name ":]") (string c) backward))) qa61-chars))
