;;; -*- lexical-binding: nil -*-
(dolist (fn '(insert-before-markers insert-before-markers-and-inherit))
 (dolist (text '("" "x" "éλ" "a\0b"))
  (with-temp-buffer
   (qa (funcall fn text) nil)
   (qa (buffer-string) text)
   (qa (point) (1+ (length text)))))
 (dolist (pos '(1 2 3 4))
  (with-temp-buffer
   (insert "abc")
   (goto-char pos)
   (let ((m1 (copy-marker pos nil)) (m2 (copy-marker pos t)))
    (qa (funcall fn "X" 233 "Y") nil)
    (qa (buffer-string) (concat (substring "abc" 0 (1- pos)) "XéY" (substring "abc" (1- pos))))
    (qa (point) (+ pos 3))
    (qa (marker-position m1) (+ pos 3))
    (qa (marker-position m2) (+ pos 3)))))
 (with-temp-buffer
  (insert "abcdef") (narrow-to-region 2 5) (goto-char 3)
  (qa (funcall fn "X") nil)
  (qa (buffer-string) "bXcd")
  (qa (point-min) 2) (qa (point-max) 6) (qa (point) 4)
  (widen) (qa (buffer-string) "abXcdef"))
 (with-temp-buffer
  (let ((s (propertize "xy" 'qa49 'tag)))
   (funcall fn s)
   (qa (buffer-string) "xy")
   (qa (get-text-property 1 'qa49) 'tag)
   (qa (get-text-property 2 'qa49) 'tag)))
 (with-temp-buffer
  (insert "x") (setq buffer-read-only t)
  (qa-err (funcall fn "y") 'buffer-read-only)
  (qa (buffer-string) "x")
  (qa (point) 2)))
(qa (with-temp-buffer (insert-before-markers "x") (buffer-string)) "x")

;; Active restrictions remain fixed at BEGV, including empty restrictions.
(dolist (fn '(insert insert-and-inherit insert-before-markers insert-before-markers-and-inherit))
 (dolist (bounds '((1 7) (2 5) (3 3)))
  (dolist (at-end '(nil t))
   (with-temp-buffer
    (insert "abcdef")
    (let ((lo (car bounds)) (hi (cadr bounds)))
     (narrow-to-region lo hi)
     (goto-char (if at-end hi lo))
     (let ((pos (point)) (tick (buffer-chars-modified-tick)))
      (qa (funcall fn) nil) (qa (funcall fn "") nil)
      (qa (buffer-chars-modified-tick) tick)
      (funcall fn "XY")
      (qa (point-min) lo) (qa (point-max) (+ hi 2))
      (qa (point) (+ pos 2))
      (qa (buffer-string)
          (if at-end (concat (substring "abcdef" (1- lo) (1- hi)) "XY")
            (concat "XY" (substring "abcdef" (1- lo) (1- hi)))))
      (widen)
      (qa (buffer-string) (concat (substring "abcdef" 0 (1- pos)) "XY" (substring "abcdef" (1- pos))))))))))
;; Inactive base/indirect restrictions and point are real insertion markers.
(dolist (fn '(insert insert-before-markers insert-before-markers-and-inherit))
 (dolist (reverse-direction '(nil t))
  (dolist (pos '(1 2 3 5 6))
   (with-temp-buffer
    (insert "abcdef")
    (let* ((base (current-buffer))
           (child (make-indirect-buffer base (generate-new-buffer-name "qa49-indirect")))
           (active (if reverse-direction child base))
           (inactive (if reverse-direction base child))
           (before (not (eq fn 'insert))))
     (unwind-protect
      (progn
       (with-current-buffer inactive (narrow-to-region 2 5) (goto-char (max 2 (min 5 pos))))
       (with-current-buffer active
        (goto-char pos) (funcall fn "XY")
        (qa (point-min) 1) (qa (point-max) 9) (qa (point) (+ pos 2)))
       (with-current-buffer inactive
        (qa (point-min) (if (or (< pos 2) (and before (= pos 2))) 4 2))
        (qa (point-max) (if (<= pos 5) 7 5))
        (let ((old-point (max 2 (min 5 pos))))
         (qa (point) (+ old-point (if (or (< pos old-point) (and before (= pos old-point))) 2 0))))))
      (kill-buffer child)))))))
(dolist (fn '(insert-before-markers insert-before-markers-and-inherit))
 (with-temp-buffer
  (let ((m (copy-marker 1 nil)))
   (qa-err (funcall fn "XY" 'invalid) 'wrong-type-argument)
   (qa (buffer-string) "XY") (qa (point-min) 1)
   (qa (point) 3) (qa (marker-position m) 3)))
 (with-temp-buffer
  (buffer-enable-undo) (insert "abc") (setq buffer-undo-list nil)
  (goto-char 1) (funcall fn "XY")
  (qa (progn (primitive-undo 1 buffer-undo-list) t) t)
  (qa (buffer-string) "abc") (qa (point-min) 1)))
;; String properties survive, while only the inherit variant inherits neighbors.
(dolist (fn '(insert-before-markers insert-before-markers-and-inherit))
 (with-temp-buffer
  (insert (propertize "ab" 'face 'bold)) (goto-char 2)
  (funcall fn (propertize "XY" 'help-echo "tag"))
  (qa (buffer-string) "aXYb")
  (qa (get-text-property 2 'help-echo) "tag")
  (qa (get-text-property 2 'face)
      (if (eq fn 'insert-before-markers-and-inherit) 'bold nil))
  (delete-region 2 4)
  (qa (buffer-string) "ab")
  (qa (get-text-property 1 'face) 'bold)
  (qa (get-text-property 2 'face) 'bold))
 (with-temp-buffer
  (let ((changes nil)
        (after-change-functions (list (lambda (beg end old) (push (list beg end old) changes)))))
   (funcall fn "éλ")
   (qa changes '((1 3 0)))
   (qa (point-min) 1)
   (qa (buffer-string) "éλ"))))
(princ (qa--done)) (terpri)
