;;; -*- lexical-binding: nil; -*-
;; Iterative spines, selective definitions and symbol arguments (#520/#521/#523).
(dolist (size '(300 700))
  (let ((source (make-sparse-keymap)))
    (dotimes (n size)
      (define-key source (vector (intern (format "copy-protocol-%d" n))) 'original))
    (let ((copy (copy-keymap source)))
      (define-key copy [copy-protocol-0] 'changed)
      (qa (lookup-key copy [copy-protocol-0]) 'changed)
      (qa (lookup-key source [copy-protocol-0]) 'original)
      (qa (eq (cdr copy) (cdr source)) nil))))
(let* ((source (make-sparse-keymap)) (child (make-sparse-keymap))
       (parent (make-sparse-keymap)) (prefix (make-symbol "copy-prefix"))
       (macro (vector 97 98))
       (command (list 'lambda nil (list 'interactive) (list 'ignore))))
  (define-key child "x" 'nested)
  (define-key source "a" child)
  (define-key source "b" child)
  (fset prefix child)
  (define-key source "s" prefix)
  (define-key source "v" macro)
  (define-key source "f" command)
  (set-keymap-parent source parent)
  (let ((copy (copy-keymap source)))
    (qa (eq (keymap-parent copy) parent) t)
    (qa (eq (lookup-key copy "v") macro) t)
    (qa (eq (lookup-key copy "f") command) t)
    (qa (eq (lookup-key copy "s") prefix) t)
    (qa (eq (lookup-key copy "a") child) nil)
    (qa (eq (lookup-key copy "a") (lookup-key copy "b")) nil)
    (define-key copy "ay" 'extra)
    (qa (lookup-key copy "ay") 'extra)
    (qa (lookup-key copy "by") nil)
    (qa (lookup-key source "ay") nil)))
(let* ((source (make-keymap)) (macro (vector 97 98))
       (child (make-sparse-keymap)))
  (define-key child "x" 'nested)
  (define-key source "v" macro)
  (define-key source "p" child)
  (let ((copy (copy-keymap source)))
    (qa (char-table-p (cadr copy)) t)
    (qa (eq (lookup-key copy "v") macro) t)
    (define-key copy "py" 'extra)
    (define-key copy (vector (cons 65 90)) 'upper)
    (qa (lookup-key copy "py") 'extra)
    (qa (lookup-key source "py") nil)))
;; New-style menus copy three wrapper cells and share their property tail.
(let* ((source (make-sparse-keymap)) (child (make-sparse-keymap))
       (label (copy-sequence "Label")) (properties (list :help "Help" :enable t))
       (menu (cons 'menu-item (cons label (cons child properties)))))
  (define-key source [menu] menu)
  (let ((definition (cdr (assq 'menu (cdr (copy-keymap source))))))
    (qa (eq definition menu) nil)
    (qa (eq (cadr definition) label) t)
    (qa (eq (nth 2 definition) child) nil)
    (qa (eq (nthcdr 3 definition) properties) t)))
;; Old-style label/help wrappers are copied, while their strings are shared.
(let* ((source (make-sparse-keymap)) (child (make-sparse-keymap))
       (label (copy-sequence "Label")) (help (copy-sequence "Help"))
       (menu (cons label (cons help child))))
  (define-key source [old-menu] menu)
  (let ((definition (cdr (assq 'old-menu (cdr (copy-keymap source))))))
    (qa (eq definition menu) nil)
    (qa (eq (car definition) label) t)
    (qa (eq (cadr definition) help) t)
    (qa (eq (cddr definition) child) nil)))
(let ((source (make-sparse-keymap)) (name (make-symbol "copy-source"))
      (alias (make-symbol "copy-source-alias")))
  (define-key source "a" 'command)
  (fset name source)
  (fset alias name)
  (qa (lookup-key (copy-keymap name) "a") 'command)
  (qa (lookup-key (copy-keymap alias) "a") 'command))
(qa-err-data (copy-keymap 42) 'wrong-type-argument '(keymapp 42))
;; GNU rejects excessive nested submaps explicitly; it never shares a
;; suffix merely because an ordinary map has a long binding spine.
(let ((source (make-sparse-keymap)))
  (dotimes (n 101)
    (let ((outer (make-sparse-keymap)))
      (define-key outer "p" source)
      (setq source outer)))
  (qa-err-data (copy-keymap source) 'error '("Possible infinite recursion when copying keymap")))
(princ (qa--done))
