;;; -*- lexical-binding: nil; -*-
;; Issue #19: GNU Emacs 31.1 function metadata ground truth.
(defun qa19-base (x) "the doc" x)
(defmacro qa19-macro (x) "macro doc" x)

;; Original reproductions, including fresh symbols for each autoload.
(qa (let ((alias (make-symbol "qa19-alias")))
      (defalias alias 'car "my doc") (documentation alias)) "my doc")
(qa (let ((alias (make-symbol "qa19-alias")))
      (defalias alias #'qa19-base) (documentation alias)) "the doc")
(qa (let ((alias (make-symbol "qa19-alias")))
      (defalias alias #'qa19-base) (documentation alias t)) "the doc")
(dolist (arguments '(("qa19-missing-file") ("qa19-missing-file" "doc" interactive)
                     ("qa19-missing-file" nil nil nil)))
  (qa (let ((symbol (make-symbol "qa19-autoload")))
        (eq (apply #'autoload symbol arguments) symbol)) t))

;; Follow complete function chains while consulting only the original
;; symbol's function-documentation override, exactly like doc.c.
(qa (let ((one (make-symbol "qa19-one")) (two (make-symbol "qa19-two")))
      (defalias two 'qa19-base) (defalias one two)
      (list (documentation one) (documentation one t))) '("the doc" "the doc"))
(qa (let ((root 'qa19-base))
      (dotimes (n 130)
        (let ((alias (make-symbol "qa19-long"))) (defalias alias root) (setq root alias)))
      (documentation root)) "the doc")
(qa (let ((one (make-symbol "qa19-one")) (two (make-symbol "qa19-two")))
      (defalias two 'qa19-base "middle override") (defalias one two)
      (list (documentation two) (documentation one))) '("middle override" "the doc"))
(qa (let ((one (make-symbol "qa19-one")) (two (make-symbol "qa19-two")))
      (defalias two 'qa19-base "middle override") (defalias one two "outer override")
      (list (documentation one) (documentation one t))) '("outer override" "outer override"))
(qa (let ((alias (make-symbol "qa19-built-in")))
      (defalias alias 'car)
      (list (stringp (documentation alias))
            (equal (documentation alias) (documentation 'car))
            (equal (documentation alias t) (documentation 'car t)))) '(t t t))
(qa (let ((alias (make-symbol "qa19-macro-alias")))
      (defalias alias 'qa19-macro) (documentation alias)) "macro doc")
(qa (let ((alias (make-symbol "qa19-raw")))
      (fset alias '(lambda (x) "raw lambda doc" x)) (documentation alias)) "raw lambda doc")
(qa (documentation '(lambda () "sole string")) "sole string")
(qa (let ((alias (make-symbol "qa19-raw-macro")))
      (defalias alias '(macro lambda (x) "raw macro doc" x)) (documentation alias)) "raw macro doc")
(qa (let ((alias (make-symbol "qa19-bytecode")))
      (defalias alias (make-byte-code 0 "\300\207" [nil] 1 "compiled doc"))
      (documentation alias)) "compiled doc")
(qa (let ((alias (make-symbol "qa19-bytecode")))
      (defalias alias (make-byte-code 0 "\300\207" [nil] 1 0))
      (documentation alias)) nil)
(qa (let ((alias (make-symbol "qa19-keyboard")))
      (defalias alias "abc") (documentation alias)) "Keyboard macro.")
(qa (let ((alias (make-symbol "qa19-keyboard")))
      (defalias alias [97 98 99]) (documentation alias t)) "Keyboard macro.")
(qa (let ((alias (make-symbol "qa19-keymap")))
      (defalias alias (make-sparse-keymap)) (documentation alias))
    "Prefix command (definition is a keymap associating keystrokes with commands).")
(qa (documentation '(lambda (x) x)) nil)
(qa (substitute-command-keys nil) nil)
(qa-err-data (documentation '(not-a-function)) 'invalid-function '((not-a-function)))

;; Missing definitions still report the original alias. An override can
;; document a void symbol, but an intermediate symbol's property is ignored.
(qa (let ((alias (make-symbol "qa19-void")) (target (make-symbol "qa19-target")))
      (put target 'function-documentation "target override") (defalias alias target)
      (list (documentation target)
            (condition-case err (documentation alias) (void-function (eq (cadr err) alias)))))
    '("target override" t))
(qa (let ((alias (make-symbol "qa19-void")) (target (make-symbol "qa19-target")))
      (defalias alias target "alias override") (documentation alias)) "alias override")
(qa (let ((saved (symbol-plist nil)))
      (unwind-protect (progn (put nil 'function-documentation "nil override") (documentation nil))
        (setplist nil saved))) "nil override")
(qa (let ((alias (make-symbol "qa19-redefined")))
      (defalias alias 'car "old override") (defalias alias 'cdr)
      (documentation alias)) "old override")
(qa (let ((alias (make-symbol "qa19-redefined")))
      (defalias alias 'car "old override") (put alias 'function-documentation nil)
      (defalias alias 'qa19-base) (documentation alias)) "the doc")
(qa (let ((alias (make-symbol "qa19-raw")))
      (defalias alias 'qa19-base "Use \\[forward-char].")
      (list (documentation alias t) (documentation alias)))
    '("Use \\[forward-char]." "Use C-f."))
(qa (let ((alias (make-symbol "qa19-evaluated")) (calls 0))
      (defalias alias 'qa19-base '(progn (setq calls (1+ calls)) "evaluated doc"))
      (list (documentation alias) (documentation alias t) calls))
    '("evaluated doc" "evaluated doc" 2))

;; Inherit the function value, not an advised symbol's private override.
(defun qa19-around (function &rest args) (apply function args))
(qa (let ((alias (make-symbol "qa19-advised-alias")))
      (unwind-protect
          (progn (advice-add 'qa19-base :around #'qa19-around)
                 (defalias alias 'qa19-base) (documentation alias))
        (advice-remove 'qa19-base #'qa19-around))) nil)
(qa (let ((alias (make-symbol "qa19-advised-alias")))
      (unwind-protect
          (progn (advice-add 'qa19-base :around #'qa19-around)
                 (defalias alias 'qa19-base "explicit alias doc") (documentation alias))
        (advice-remove 'qa19-base #'qa19-around))) "explicit alias doc")

;; Autoload replaces an autoload stub and returns the symbol again;
;; real definitions and aliases remain untouched and return nil.
(qa (let ((symbol (make-symbol "qa19-auto")))
      (autoload symbol "old-file" "old doc")
      (list (eq (autoload symbol "new-file" "new doc" t 'macro) symbol)
            (symbol-function symbol) (documentation symbol)))
    '(t (autoload "new-file" "new doc" t macro) "new doc"))
(qa (let ((symbol (make-symbol "qa19-auto")))
      (autoload symbol "old-file" "old doc" t 'macro)
      (list (eq (autoload symbol "new-file") symbol) (symbol-function symbol)))
    '(t (autoload "new-file" nil nil nil)))
(qa (let ((symbol (make-symbol "qa19-auto")))
      (autoload symbol "missing-file" "stub doc")
      (let ((alias (make-symbol "qa19-auto-alias")))
        (defalias alias symbol)
        (list (documentation alias) (documentation alias t) (autoloadp (symbol-function symbol)))))
    '("stub doc" "stub doc" t))
(qa (let ((symbol (make-symbol "qa19-real")))
      (fset symbol '(lambda () "real doc" nil))
      (let ((before (symbol-function symbol)))
        (list (autoload symbol "missing-file" "ignored doc")
              (eq before (symbol-function symbol)) (documentation symbol)))) '(nil t "real doc"))
(qa (let ((symbol (make-symbol "qa19-alias")))
      (defalias symbol 'qa19-base)
      (let ((before (symbol-function symbol)))
        (list (autoload symbol "missing-file") (eq before (symbol-function symbol))))) '(nil t))
(qa (let ((symbol (make-symbol "qa19-wrapped")))
      (fset symbol '(macro autoload "old-file" "wrapped doc" nil macro))
      (let ((before (symbol-function symbol)))
        (list (autoload symbol "new-file") (eq before (symbol-function symbol)) (documentation symbol))))
    '(nil t "wrapped doc"))
(qa-err-data (autoload 17 "missing-file") 'wrong-type-argument '(symbolp 17))
(qa-err-data (autoload 'qa19-base 17) 'wrong-type-argument '(stringp 17))
(qa (let ((symbol (make-symbol "qa19-history")))
      (autoload symbol "old-file")
      (let ((current-load-list nil))
        (list (eq (autoload symbol "new-file") symbol)
              (equal current-load-list (list (cons 'defun symbol)))))) '(t t))



;; Lazy docstrings in .elc files are byte offsets in that file, not
;; offsets in the default DOC. Use an explicit lisp-directory to make
;; both relative and absolute paths independent of installation layout.
(defun qa19-file-doc (bytes position &optional property relative)
  (let* ((file (make-temp-file "qa19-doc-"))
         (lisp-directory (file-name-directory file))
         (documentation-dynamic-reload nil)
         (function (make-symbol "qa19-file-function"))
         (reference (cons (if relative (file-name-nondirectory file) file) position)))
    (unwind-protect
        (progn
          (let ((coding-system-for-write 'no-conversion)) (write-region bytes nil file nil 'quiet))
          (if property (defalias function 'car reference)
            (fset function (list 'lambda nil reference nil)))
          (documentation function t))
      (delete-file file))))
(qa (qa19-file-doc "#@99 file doc\037" 5) "file doc")
(qa (qa19-file-doc "#@99 file doc\037" 5 t) "file doc")
(qa (qa19-file-doc "#@99 file doc\037" 5 nil t) "file doc")
(qa (qa19-file-doc "#@99 file doc\037" -5) "file doc")
(qa (qa19-file-doc "#@99 first\037second\037" 11) "second")
(qa (qa19-file-doc "#@99 日本語\037" 5) "日本語")
(qa (qa19-file-doc "#@99 a\001\001b\0010c\001_d\037" 5) (concat "a" (string 1) "b" (string 0) "c" (string 31) "d"))
(qa (string-to-list (qa19-file-doc (unibyte-string 35 64 57 57 32 193 134 31) 5)) '(4194246))
(qa (string-to-list (qa19-file-doc (unibyte-string 35 64 57 57 32 237 160 128 31) 5)) '(55296))
(qa (qa19-file-doc "#@99 file doc\037" 6) nil)
(qa (qa19-file-doc "#@99 file doc\037" 0) nil)
(qa-err-data (qa19-file-doc "#@99 \001x\037" 5) 'error
             (list (format "Invalid data in documentation file -- %c followed by code %03o" 1 ?x)))
(qa (let ((lisp-directory (file-name-as-directory temporary-file-directory))
          (documentation-dynamic-reload nil) (function (make-symbol "qa19-missing-doc")))
      (defalias function 'car '("qa19-no-such-doc-file.elc" . 5))
      (documentation function t)) "Cannot open doc string file \"qa19-no-such-doc-file.elc\"\n")


(qa-err-data (qa19-file-doc "#@99 \001\037" 5) 'error
             (list (format "Invalid data in documentation file -- %c followed by code %03o" 1 0)))


(qa (let ((documentation-dynamic-reload nil))
      (documentation '(lambda nil 1 nil))) nil)
(qa (let* ((offset (function-documentation (symbol-function 'car)))
           (function (make-symbol "qa19-negative-doc-offset")))
      (defalias function 'cdr (- offset))
      (equal (documentation function t) (documentation 'car t))) t)

(princ (qa--done))
