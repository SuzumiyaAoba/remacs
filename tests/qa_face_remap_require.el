;;; qa_face_remap_require.el --- Explicit face remapping registration -*- lexical-binding: t; -*-

(qa (featurep 'face-remap) nil)
(qa (list (assq 'text-scale-mode minor-mode-alist)
          (assq 'buffer-face-mode minor-mode-alist))
    '(nil nil))
(qa (require 'face-remap) 'face-remap)
(qa (list (assq 'text-scale-mode minor-mode-alist)
          (assq 'buffer-face-mode minor-mode-alist))
    '((text-scale-mode (" " text-scale-mode-lighter))
      (buffer-face-mode " BufFace")))
(qa (let ((minor-mode-alist (cons '(qa-face-remap-sentinel " Keep")
                                minor-mode-alist)))
      (load "face-remap" nil t)
      (load "face-remap" nil t)
      (list (mapcar (lambda (mode)
                      (length (delq nil (mapcar (lambda (entry) (eq (car entry) mode))
                                               minor-mode-alist))))
                    '(text-scale-mode buffer-face-mode))
            (assq 'qa-face-remap-sentinel minor-mode-alist)))
    '((1 1) (qa-face-remap-sentinel " Keep")))
(qa (list (and (memq 'text-scale-mode minor-mode-list) t)
          (and (memq 'buffer-face-mode minor-mode-list) t))
    '(t t))
(qa (with-temp-buffer
      (text-scale-set 2)
      (buffer-face-mode 1)
      (list text-scale-mode text-scale-mode-amount buffer-face-mode))
    '(t 2 t))

(princ (qa--done))
