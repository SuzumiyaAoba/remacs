;;; -*- lexical-binding: t; -*-
(defmacro qa129-ring (&rest body)
  `(let* ((kill-ring (list "a" "b" "c"))
          (kill-ring-yank-pointer (cdr kill-ring))
          (interprogram-paste-function nil) (interprogram-cut-function nil)
          (yank-pop-change-selection nil)) ,@body))
(qa (qa129-ring (current-kill 0 t)) "b")
(qa (qa129-ring (setq kill-ring-yank-pointer (list "unrelated")) (current-kill 0 t)) "c")
(qa (qa129-ring (setq kill-ring-yank-pointer nil) (current-kill 0 t)) "a")
(qa (qa129-ring (current-kill 1 t)) "c")
(qa (qa129-ring (current-kill -1 t)) "a")
(qa (qa129-ring (current-kill 4 t)) "c")
(qa (qa129-ring (let ((old kill-ring-yank-pointer))
                 (current-kill 1 t) (eq old kill-ring-yank-pointer))) t)
(qa (qa129-ring (current-kill 1) (eq kill-ring-yank-pointer (cddr kill-ring))) t)
(qa (qa129-ring (eq (current-kill 0 t) (cadr kill-ring))) t)
(qa (qa129-ring (setcar kill-ring-yank-pointer (propertize "b" 'tag 7))
                 (get-text-property 0 'tag (current-kill 0 t))) 7)
(qa-err-data (qa129-ring (setq kill-ring-yank-pointer 5) (current-kill 0))
             'wrong-type-argument '(sequencep 5))
(qa (qa129-ring (setq kill-ring-yank-pointer [x]) (current-kill 0 t)) "c")
(qa (qa129-ring (setq kill-ring-yank-pointer "x") (current-kill 0 t)) "c")
(qa-err-data (qa129-ring (current-kill 0.5)) 'wrong-type-argument '(integerp 1.5))
(qa-err-data (qa129-ring (current-kill "0")) 'wrong-type-argument '(number-or-marker-p "0"))
(qa-err-data (qa129-ring (setq kill-ring nil kill-ring-yank-pointer 5) (current-kill 0))
             'error '("Kill ring is empty"))
(qa (qa129-ring (let ((interprogram-paste-function (lambda () "PASTE")))
                 (list (current-kill 0 t) kill-ring (eq kill-ring-yank-pointer kill-ring))))
    '("PASTE" ("PASTE" "a" "b" "c") t))
(qa (qa129-ring (let ((interprogram-paste-function (lambda () '("P1" "P2"))))
                 (list (current-kill 0 t) kill-ring (eq kill-ring-yank-pointer kill-ring))))
    '("P1" ("P1" "P2" "a" "b" "c") t))
(qa (qa129-ring (let* ((external (list "P1" "P2"))
                      (interprogram-paste-function (lambda () external)))
                 (current-kill 0 t) external)) '("P1" "P2"))
(qa (qa129-ring (let ((interprogram-paste-function (lambda () nil))) (current-kill 0 t))) "b")
(qa (qa129-ring (let ((calls 0) (interprogram-paste-function (lambda () (setq calls (1+ calls)) nil)))
                 (current-kill 0 t) calls)) 1)
(qa (qa129-ring (let ((interprogram-paste-function (lambda () (error "paste called"))))
                 (current-kill 1 t))) "c")
(qa (qa129-ring (let ((calls nil)
                      (interprogram-cut-function (lambda (&rest values) (push values calls)))
                      (interprogram-paste-function (lambda () '("P1" "P2"))))
                 (current-kill 0) calls)) nil)
(qa (qa129-ring (let ((interprogram-paste-function (lambda () "PASTE"))) (current-kill 0.0 t))) "PASTE")
(qa (qa129-ring (let* ((paste (propertize "PASTE" 'tag 7))
                      (interprogram-paste-function (lambda () paste)))
                 (let ((result (current-kill 0 t)))
                   (list (eq result paste) (get-text-property 0 'tag result))))) '(t 7))
(qa (qa129-ring (let ((calls nil) (yank-pop-change-selection t)
                      (interprogram-cut-function (lambda (string) (push string calls))))
                 (list (current-kill 1) calls))) '("c" ("c")))
(qa (qa129-ring (let ((calls nil) (yank-pop-change-selection t)
                      (interprogram-cut-function (lambda (string) (push string calls))))
                 (current-kill 1 t) calls)) nil)
(qa (qa129-ring (let ((calls nil) (yank-pop-change-selection t)
                      (interprogram-cut-function (lambda (string) (push string calls))))
                 (current-kill -1) calls)) nil)
(qa-err-data (qa129-ring (let ((interprogram-paste-function (lambda () (error "paste failure"))))
                          (current-kill 0))) 'error '("paste failure"))
(qa-err-data (qa129-ring (let ((interprogram-paste-function (lambda () 7))) (current-kill 0)))
             'wrong-type-argument '(sequencep 7))
(qa (with-temp-buffer
      (qa129-ring
       (let ((kill-ring nil) (kill-ring-yank-pointer nil)
             (interprogram-paste-function (lambda () "PASTE")))
         (yank) (buffer-string)))) "PASTE")
(qa (with-temp-buffer
      (qa129-ring (setq kill-ring-yank-pointer (list "unrelated"))
                   (yank) (buffer-string))) "c")
(qa (with-temp-buffer
      (qa129-ring
       (let ((interprogram-paste-function (lambda () (propertize "PASTE" 'tag 7))))
         (yank) (get-text-property 1 'tag)))) 7)
(qa (with-temp-buffer
      (qa129-ring (yank '(4)) (list (buffer-string) (point) (mark t)))) '("b" 1 2))
(qa (qa129-ring
      (let ((old kill-ring) (interprogram-paste-function (lambda () "PASTE")))
        (current-kill 0) (eq (cdr kill-ring) old))) t)
(princ (qa--done))
