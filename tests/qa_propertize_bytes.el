;;; -*- lexical-binding: t; -*-
;; Issue #234: propertize copies representation metadata as well as text.
(defvar qa234-case)
(defvar qa234-bytes)
(defvar qa234-source)
(defvar qa234-result)
(defvar qa234-again)

(qa (let* ((source (unibyte-string 128 255))
           (result (propertize source 'face 'bold)))
      (list (multibyte-string-p result) (string-to-list result)
            (aref result 0) (vconcat result) (get-text-property 0 'face result)))
    '(nil (128 255) 128 [128 255] bold))

(dolist (qa234-case '((empty nil nil 0 nil)
                      (ascii nil (97 98) 2 ((0 2 (face bold))))
                      (bytes nil (128 255) 2 ((0 2 (face bold))))
                      (multi-ascii t (97 98) 2 ((0 2 (face bold))))
                      (unicode t (233 955) 4 ((0 2 (face bold))))
                      (raw-multi t (4194176 4194303) 4 ((0 2 (face bold))))))
  (qa (let* ((source (pcase (car qa234-case)
                       ('empty (unibyte-string))
                       ('ascii (unibyte-string 97 98))
                       ('bytes (unibyte-string 128 255))
                       ('multi-ascii (string-to-multibyte "ab"))
                       ('unicode "éλ")
                       ('raw-multi (string-as-multibyte (unibyte-string 128 255)))))
             (result (propertize source 'face 'bold)))
        (list (multibyte-string-p result) (string-to-list result)
              (string-bytes result) (object-intervals result)))
      (cdr qa234-case)))

;; Exhaust the complete byte domain, rather than checking only 128 and 255.
(let* ((qa234-bytes (number-sequence 0 255))
       (qa234-source (apply #'unibyte-string qa234-bytes))
       (qa234-result (propertize qa234-source 'face 'bold))
       (qa234-again (propertize qa234-result 'help-echo "copy")))
  (qa (multibyte-string-p qa234-result) nil)
  (qa (string-bytes qa234-result) 256)
  (qa (length qa234-result) 256)
  (qa (string-to-list qa234-result) qa234-bytes)
  (qa (append qa234-result nil) qa234-bytes)
  (qa (mapcar (lambda (n) (aref qa234-result n)) qa234-bytes) qa234-bytes)
  (qa (vconcat qa234-result) (apply #'vector qa234-bytes))
  (qa (object-intervals qa234-result) '((0 256 (face bold))))
  (qa (mapcar (lambda (n) (get-text-property n 'face qa234-result)) qa234-bytes)
      (make-list 256 'bold))
  (qa (string-to-list qa234-source) qa234-bytes)
  (qa (object-intervals qa234-source) nil)
  (qa (eq qa234-source qa234-result) nil)
  (qa (eq qa234-result qa234-again) nil)
  (qa (multibyte-string-p qa234-again) nil)
  (qa (string-to-list qa234-again) qa234-bytes)
  (qa (mapcar (lambda (n) (get-text-property n 'help-echo qa234-again)) qa234-bytes)
      (make-list 256 "copy"))
  (garbage-collect)
  (qa (string-to-list qa234-result) qa234-bytes)
  (qa (vconcat qa234-again) (apply #'vector qa234-bytes))
  (qa (string-bytes qa234-again) 256))

;; A result can outlive the source without losing its byte representation.
(qa (let ((result (propertize (unibyte-string 128 255) 'face 'bold)))
      (garbage-collect)
      (list (multibyte-string-p result) (string-to-list result)
            (aref result 1) (get-text-property 1 'face result)))
    '(nil (128 255) 255 bold))

(qa (let ((result (propertize (propertize (unibyte-string 128 255) 'face 'bold)
                              'help-echo "twice")))
      (garbage-collect)
      (list (multibyte-string-p result) (string-to-list result)
            (get-text-property 0 'face result) (get-text-property 1 'help-echo result)))
    '(nil (128 255) bold "twice"))

;; Copying without new property pairs also keeps the byte kind.
(qa (let ((result (propertize (unibyte-string 128 255))))
      (list (multibyte-string-p result) (string-to-list result) (object-intervals result)))
    '(nil (128 255) nil))

;; The copies have independent text and interval trees.
(qa (let* ((source (unibyte-string 128 255))
           (first (propertize source 'face 'bold))
           (second (propertize first 'face 'italic)))
      (aset first 0 42)
      (put-text-property 0 1 'face 'changed first)
      (list (mapcar #'string-to-list (list source first second))
            (mapcar #'multibyte-string-p (list source first second))
            (mapcar (lambda (s) (mapcar (lambda (n) (get-text-property n 'face s)) '(0 1)))
                    (list source first second))))
    '(((128 255) (42 255) (128 255)) (nil nil nil)
      ((nil nil) (changed bold) (italic italic))))

;; Property values themselves retain ordinary Lisp object identity.
(qa (let* ((payload (list 1))
           (source (propertize (unibyte-string 128 255) 'qa234 payload))
           (result (propertize source 'face 'bold)))
      (setcar payload 2)
      (list (eq (get-text-property 0 'qa234 source) payload)
            (eq (get-text-property 1 'qa234 result) payload)
            (get-text-property 0 'qa234 result)
            (string-to-list result) (multibyte-string-p result)))
    '(t t (2) (128 255) nil))

(princ (qa--done)) (terpri)
