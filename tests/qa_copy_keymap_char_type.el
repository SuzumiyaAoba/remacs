;;; -*- lexical-binding: nil; -*-
;; A copied full map's character trie remains an actual char-table (#516).
(let* ((source (make-keymap)) (child (make-sparse-keymap)))
  (define-key source "a" 'original)
  (define-key source (vector #x100) 'wide)
  (define-key child "x" 'nested)
  (define-key source "p" child)
  (let ((copy (copy-keymap source)))
    (qa (keymapp copy) t)
    (qa (char-table-p (cadr copy)) t)
    (qa (recordp (cadr copy)) nil)
    (qa (eq (cadr copy) (cadr source)) nil)
    (qa (lookup-key copy "a") 'original)
    (qa (lookup-key copy (vector #x100)) 'wide)
    (qa (lookup-key copy "px") 'nested)
    (define-key copy "py" 'extra)
    (define-key copy "a" 'changed)
    (qa (lookup-key copy "a") 'changed)
    (qa (lookup-key source "a") 'original)
    (qa (lookup-key copy "py") 'extra)
    (qa (lookup-key source "py") nil)
    (define-key copy (vector (cons 65 90)) 'upper)
    (qa (lookup-key copy "py") 'extra)
    (qa (lookup-key copy "a") 'changed)
    (qa (lookup-key copy "A") 'upper)
    (qa (lookup-key source "A") nil)))
(let* ((ordinary (record 'char-table 'test (make-vector 65 nil)))
       (source (make-sparse-keymap)))
  (define-key source "r" ordinary)
  (qa (eq (lookup-key (copy-keymap source) "r") ordinary) t)
  (qa (recordp ordinary) t)
  (qa (char-table-p ordinary) nil))
(princ (qa--done))
