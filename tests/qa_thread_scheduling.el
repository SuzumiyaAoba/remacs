;;; -*- lexical-binding: t; -*-
(require 'timer)
(defvar qa196-ready nil)
(defvar qa196-stage 0)
(defvar qa196-special 'global)
(qa-lex (progn
  (setq qa196-ready nil)
  (let ((worker (make-thread
                 (lambda ()
                  (let ((n 0))
                   (while (and (not qa196-ready) (< n 200))
                    (setq n (1+ n)) (sleep-for 0.005))
                   (if qa196-ready 'ready 'timed-out))))))
   (setq qa196-ready t) (thread-join worker)))
 'ready)
(qa-lex (progn
  (setq qa196-ready nil qa196-stage 0)
  (let ((worker (make-thread
                 (lambda ()
                  (setq qa196-stage 1)
                  (while (not qa196-ready) (thread-yield))
                  (setq qa196-stage 2)
                  qa196-stage)))
        (n 0))
   (while (= qa196-stage 0) (thread-yield))
   (let ((intermediate qa196-stage))
    (setq qa196-ready t)
    (list intermediate (thread-join worker) qa196-stage))))
 '(1 2 2))
(qa-lex (let ((qa196-special 'parent))
  (let ((worker (make-thread
                 (lambda ()
                  (let ((initial qa196-special))
                   (let ((qa196-special 'child))
                    (thread-yield)
                    (list initial qa196-special)))))))
   (list (thread-join worker) qa196-special)))
 '((global child) parent))
(qa-lex qa196-special
 'global)
(qa-lex (let ((x 1))
  (let ((worker (make-thread (lambda () (setq x (+ x 10)) x))))
   (setq x 2)
   (list (thread-join worker) x)))
 '(12 12))
(qa-lex (let ((a (get-buffer-create " qa196-a"))
       (b (get-buffer-create " qa196-b")))
  (unwind-protect
   (with-current-buffer a
    (let ((worker (make-thread
                   (lambda ()
                    (let ((initial (current-buffer)))
                     (set-buffer b) (thread-yield)
                     (list (eq initial a) (eq (current-buffer) b)))))))
     (list (thread-join worker) (eq (current-buffer) a))))
   (kill-buffer a) (kill-buffer b)))
 '((t t) t))

;; State must survive a suspension through nested interpreted calls.
(defun qa196-recursive (n)
  (if (= n 0) (progn (thread-yield) 7)
    (+ 1 (qa196-recursive (1- n)))))
(qa-lex (thread-join (make-thread (lambda () (qa196-recursive 80)))) 87)
(qa-lex (let ((clean nil))
          (let ((worker (make-thread
                         (lambda ()
                           (unwind-protect
                               (progn (thread-yield) (error "qa196-worker"))
                             (setq clean t))))))
            (thread-join worker)
            (list clean (thread-last-error t))))
        '(t (error "qa196-worker")))
;; A parent's condition handler cannot catch a worker's uncaught error.
(qa-lex (let ((caught nil))
          (condition-case nil
              (thread-join (make-thread (lambda () (thread-yield) (error "isolated"))))
            (error (setq caught t)))
          (list caught (thread-last-error t)))
        '(nil (error "isolated")))
(qa-lex (let ((first nil) (second nil))
          (setq first (make-thread (lambda () (thread-yield) 17)))
          (setq second (make-thread (lambda () (+ 1 (thread-join first)))))
          (list (thread-join second) (thread-join first))) '(18 17))
;; Worker sleep must let another worker run, as well as the main thread.
(qa-lex (let ((seen nil))
          (let ((first (make-thread (lambda () (sleep-for 0.02) seen)))
                (second (make-thread (lambda () (setq seen 'other)))))
            (list (thread-join first) (thread-join second)))) '(other other))
(qa-lex (let ((seen nil))
          (let ((worker (make-thread (lambda () (setq seen t)))))
            (sleep-for 0.02)
            (list seen (thread-join worker)))) '(t t))
;; A signaled sleeping worker unwinds; its handler can also catch the signal.
(qa-lex (let ((clean nil) (started nil))
          (let ((worker (make-thread
                         (lambda ()
                           (unwind-protect
                               (progn (setq started t) (sleep-for 0.05))
                             (setq clean t))))))
            (while (not started) (thread-yield))
            (thread-signal worker 'error '("wake"))
            (while (thread-live-p worker) (thread-yield))
            (thread-join worker)
            (list clean (thread-last-error t)))) '(t (error "wake")))
(qa-lex (let ((started nil))
          (let ((worker (make-thread
                         (lambda ()
                           (condition-case err
                               (progn (setq started t) (sleep-for 0.05))
                             (error (cadr err)))))))
            (while (not started) (thread-yield))
            (thread-signal worker 'error '("caught"))
            (while (thread-live-p worker) (thread-yield))
            (list (thread-join worker) (thread-last-error)))) '("caught" nil))
;; Rebinding on switches must not trigger variable watchers.
(qa-lex (let* ((events nil)
               (watcher (lambda (_symbol _value operation _where)
                          (push operation events))))
          (add-variable-watcher 'qa196-special watcher)
          (unwind-protect
              (let ((qa196-special 'parent))
                (thread-join
                 (make-thread (lambda ()
                                (let ((qa196-special 'child))
                                  (thread-yield) qa196-special)))))
            (remove-variable-watcher 'qa196-special watcher))
          (nreverse events)) '(let let unlet unlet))
(qa-lex (let ((qa196-special 'outer))
          (let ((qa196-special 'inner))
            (let ((worker (make-thread (lambda ()
                                        (setq qa196-special 'changed-global)
                                        (thread-yield) qa196-special))))
              (list (thread-join worker) qa196-special)))) '(changed-global inner))
(qa qa196-special 'changed-global)
(setq qa196-special 'global)
(qa-lex (with-temp-buffer
          (setq-local fill-column 50)
          (let ((fill-column 10))
            (let ((worker (make-thread
                           (lambda ()
                             (let ((initial fill-column))
                               (let ((fill-column 20))
                                 (thread-yield)
                                 (list initial fill-column)))))))
              (list (thread-join worker) fill-column)))) '((50 20) 10))
(qa-lex (progn
          (string-match "b" "abc")
          (let ((worker (make-thread
                         (lambda ()
                           (string-match "xy" "--xy--")
                           (thread-yield)
                           (list (match-beginning 0) (match-end 0))))))
            (list (thread-join worker) (match-beginning 0) (match-end 0)))) '((2 4) 1 2))
;; Recursive locking and contention: the worker cannot acquire until both
;; parent lock levels have been released.
(qa-lex (let ((mutex (make-mutex)) (entered nil))
          (mutex-lock mutex) (mutex-lock mutex)
          (let ((worker (make-thread (lambda ()
                                      (with-mutex mutex (setq entered t))
                                      'done))))
            (while (not (eq (thread--blocker worker) mutex)) (thread-yield))
            (let ((before entered) (blocked (eq (thread--blocker worker) mutex)))
              (mutex-unlock mutex) (thread-yield)
              (let ((once entered))
                (mutex-unlock mutex)
                (list before blocked once (thread-join worker) entered)))))
        '(nil t nil done t))
(qa-lex (let ((mutex (make-mutex)))
          (mutex-lock mutex)
          (unwind-protect
              (thread-join (make-thread
                            (lambda ()
                              (condition-case err (mutex-unlock mutex) (error err)))))
            (mutex-unlock mutex))) '(error "Cannot unlock mutex owned by another thread"))
;; Waiting releases all recursive levels, and restores them before returning.
(qa-lex (let* ((mutex (make-mutex))
               (condition (make-condition-variable mutex))
               (ready nil))
          (mutex-lock mutex) (mutex-lock mutex)
          (let ((worker (make-thread (lambda ()
                                      (with-mutex mutex
                                        (setq ready t)
                                        (condition-notify condition))
                                      'notified))))
            (condition-wait condition)
            (let ((first ready))
              (mutex-unlock mutex) (mutex-unlock mutex)
              (list first (thread-join worker))))) '(t notified))
(qa-lex (let* ((mutex (make-mutex))
               (condition (make-condition-variable mutex))
               (ready nil)
               (first (make-thread
                       (lambda ()
                         (with-mutex mutex
                           (while (not ready) (condition-wait condition))) 1)))
               (second (make-thread
                        (lambda ()
                          (with-mutex mutex
                            (while (not ready) (condition-wait condition))) 2))))
          (while (or (not (eq (thread--blocker first) condition))
                     (not (eq (thread--blocker second) condition)))
            (thread-yield))
          (with-mutex mutex (setq ready t) (condition-notify condition t))
          (list (thread-join first) (thread-join second))) '(1 2))
;; A suspended stack is a real owner for weak-table liveness.
(qa-lex (let ((table (make-hash-table :test 'eq :weakness 'key)) (ready nil) (release nil))
          (let ((worker (make-thread
                         (lambda ()
                           (let ((key (vector 196)))
                             (puthash key 'live table)
                             (setq ready t)
                             (while (not release) (thread-yield))
                             (gethash key table))))))
            (while (not ready) (thread-yield))
            (garbage-collect)
            (let ((count (hash-table-count table)))
              (setq release t)
              (list count (thread-join worker))))) '(1 live))
;; Timed input and process waits also release execution to workers.
(qa-lex (let ((ran nil))
          (let ((worker (make-thread (lambda () (setq ran t)))))
            (read-event nil nil 0.02)
            (list ran (thread-join worker)))) '(t t))
(qa-lex (let ((ran nil))
          (let ((worker (make-thread (lambda () (setq ran t)))))
            (accept-process-output nil 0.02)
            (list ran (thread-join worker)))) '(t t))
(qa-lex (let ((ran nil))
          (let ((first (make-thread (lambda () (read-event nil nil 0.02) ran)))
                (second (make-thread (lambda () (setq ran t)))))
            (list (thread-join first) (thread-join second)))) '(t t))
(qa-lex (let ((ran nil))
          (let ((first (make-thread (lambda () (accept-process-output nil 0.02) ran)))
                (second (make-thread (lambda () (setq ran t)))))
            (list (thread-join first) (thread-join second)))) '(t t))
(qa-lex (let ((worker (make-thread (lambda () (throw 'qa196-tag 42)))))
          (thread-join worker) (thread-last-error t)) '(no-catch qa196-tag 42))
;; Signals to the main thread are notifications; self-signals remain errors.
(qa-lex (let ((main (current-thread)))
          (thread-join (make-thread
                        (lambda () (thread-signal main 'error '("main notification")))))
          (sleep-for 0)
          'continued) 'continued)
(qa-lex (let ((main (current-thread)))
          (thread-join (make-thread (lambda () (thread-signal main 42 '(invalid)))))
          (sleep-for 0)
          (thread-last-error)) nil)
;; Signal observers run only after a condition waiter owns its mutex again.
(define-error 'qa196-signal "Condition waiter signal")
(qa-lex (let* ((mutex (make-mutex))
               (condition (make-condition-variable mutex))
               (held nil)
               (worker (make-thread
                        (lambda ()
                          (with-mutex mutex
                            (condition-case nil
                                (handler-bind
                                    ((qa196-signal
                                      (lambda (_)
                                        (condition-case nil
                                            (progn (mutex-unlock mutex)
                                                   (setq held t)
                                                   (mutex-lock mutex))
                                          (error (setq held nil))))))
                                  (condition-wait condition))
                              (qa196-signal 'caught)))))))
          (while (not (eq (thread--blocker worker) condition)) (thread-yield))
          (thread-signal worker 'qa196-signal nil)
          (while (thread-live-p worker) (thread-yield))
          (list (thread-join worker) held)) '(caught t))
