;;; -*- lexical-binding: nil; -*-
;; Exact exponent decomposition at floating-point boundaries (#540/#541).
(dolist (exponent '(-1000 -100 -10 -1 0 1 2 10 53 100 1000 1024))
  (dolist (sign '(1.0 -1.0))
    (let* ((mantissa (* sign 0.9999999999999999))
           (number (ldexp mantissa exponent))
           (parts (frexp number)))
      (qa (logb number) (1- exponent))
      (qa (car parts) mantissa)
      (qa (cdr parts) exponent)
      (qa (ldexp (car parts) (cdr parts)) number))))
(dolist (entry '((5.0e-324 0.5 -1073)
                 (1.0e-323 0.5 -1072)
                 (2.225073858507201e-308 0.9999999999999998 -1022)
                 (2.2250738585072014e-308 0.5 -1021)
                 (1.7976931348623157e+308 0.9999999999999999 1024)))
  (dolist (sign '(1.0 -1.0))
    (let* ((number (* sign (car entry)))
           (mantissa (* sign (cadr entry)))
           (exponent (caddr entry))
           (parts (frexp number)))
      (qa parts (cons mantissa exponent))
      (qa (logb number) (1- exponent))
      (qa (ldexp (car parts) (cdr parts)) number))))
;; Exact powers keep mantissa 0.5 and must not lose a bit of exponent.
(dolist (exponent '(-1074 -1022 -1000 -1 0 1 10 53 1000 1023))
  (let ((number (ldexp 1.0 exponent)))
    (qa (frexp number) (cons 0.5 (1+ exponent)))
    (qa (logb number) exponent)))
(dolist (zero '(0.0 -0.0))
  (let ((parts (frexp zero)))
    (qa (car parts) zero)
    (qa (copysign 1.0 (car parts)) (copysign 1.0 zero))
    (qa (cdr parts) 0)
    (qa (logb zero) -1.0e+INF)))
(dolist (infinity '(1.0e+INF -1.0e+INF))
  (qa (frexp infinity) (cons infinity 0))
  (qa (logb infinity) 1.0e+INF))
(qa (isnan (car (frexp 0.0e+NaN))) t)
(qa (cdr (frexp 0.0e+NaN)) 0)
(qa (isnan (logb 0.0e+NaN)) t)
(qa (frexp 0) '(0.0 . 0))
(qa (frexp 1024) '(0.5 . 11))
(qa-err-data (frexp 'invalid) 'wrong-type-argument '(numberp invalid))
(qa-err-data (logb nil) 'wrong-type-argument '(numberp nil))
(princ (qa--done))
