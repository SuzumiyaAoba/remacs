;;; -*- lexical-binding: nil; -*-
;; member-if follows live cdrs and allows late cyclic matches (#514, #515).
(let* ((new-tail (list 'target)) (source (list 'a 'old)) (calls 0))
  (qa (eq (member-if (lambda (item)
                       (setq calls (1+ calls))
                       (when (= calls 1) (setcdr source new-tail))
                       (eq item 'target)) source) new-tail) t)
  (qa calls 2)
  (qa source '(a target)))
(let ((source (list 'a 'old)) (calls 0))
  (qa (member-if (lambda (item) (setq calls (1+ calls)) (setcdr source nil) nil) source) nil)
  (qa calls 1)
  (qa source '(a)))
(let ((source (list 'original)) (token (list 'truthy)))
  (qa (eq (member-if (lambda (item) (setcar source 'changed) token) source) source) t)
  (qa source '(changed)))
;; A cyclic input can terminate through later predicate state, not just
;; through a change of its links. It is not a circular-list error.
(let ((source (list 'cycle)) (calls 0))
  (setcdr source source)
  (qa (eq (member-if (lambda (item) (setq calls (1+ calls)) (> calls 500000)) source) source) t)
  (qa calls 500001))
(let ((source (list 'cycle)) (calls 0))
  (setcdr source source)
  (qa (member-if (lambda (item)
                   (setq calls (1+ calls))
                   (when (= calls 10) (setcdr source nil))
                   nil) source) nil)
  (qa calls 10))
(qa (member-if 5 nil) nil)
(qa-err (member-if 5 '(a)) 'invalid-function)
(qa-err-data (member-if #'ignore 'atom) 'wrong-type-argument '(listp atom))
(qa-err-data (member-if #'ignore '(a . tail)) 'wrong-type-argument '(listp tail))
(let ((source (cons 'a (cons 'b 'tail))))
  (qa (eq (member-if (lambda (item) t) source) source) t))
;; The old limit also rejected finite lists over 500000 elements.
(let* ((source (make-list 500000 nil)) (end (last source)) (tail (list 'target)))
  (setcdr end tail)
  (unwind-protect
      (progn
        (qa (eq (member-if #'identity source) tail) t)
        (qa (member-if #'consp source) nil))
    (setcdr end source)))
(garbage-collect)
(princ (qa--done))
