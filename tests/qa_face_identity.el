;;; Face registries preserve symbol identity, not printed names. -*- lexical-binding: nil; -*-
;; #674: distinct symbols can share diagnostic, textual, or byte spellings.
(defun qa674-pair (first second)
  (make-face first)
  (make-face second)
  (set-face-attribute first nil :foreground "red")
  (set-face-attribute second nil :foreground "blue")
  (set-face-attribute first t :background "green")
  (set-face-attribute second t :background "yellow")
  (qa (eq first second) nil)
  (qa (face-attribute first :foreground nil t) "red")
  (qa (face-attribute second :foreground nil t) "blue")
  (qa (eq (face-name first) (symbol-name first)) t)
  (qa (face-attribute first :background t) "green")
  (qa (face-attribute second :background t) "yellow")
  (let ((alias (make-symbol "qa674-alias")))
    (put alias 'face-alias first)
    (qa (face-attribute alias :foreground nil t) "red")))
(dolist (code '(55296 1703936))
  (qa674-pair (intern (concat "qa674-" (string code)))
              (intern (concat "qa674-" (string 92) (format "x{%x}" code)))))
(qa674-pair (make-symbol "qa674-uninterned") (make-symbol "qa674-uninterned"))
(qa674-pair (intern (concat "qa674-byte-" (unibyte-string 128)))
            (intern (concat "qa674-byte-" (string 128))))
(let ((weak (make-hash-table :test 'eq :weakness 'key)))
  (let ((face (make-symbol "qa674-gc")))
    (make-face face)
    (puthash face t weak))
  (garbage-collect)
  (qa (hash-table-count weak) 1))
(princ (qa--done))
