    (qa (progn (string-match (regexp-quote old) old)
               (match-substitute-replacement new nil t old)) expected)
    (qa (with-temp-buffer
          (insert old) (goto-char 1)
          (re-search-forward (regexp-quote old))
          (replace-match new nil t) (buffer-string)) expected)
    (unless (equal old "")
      (qa (replace-regexp-in-string (regexp-quote old) new old nil t) expected))
    (qa (progn (string-match (regexp-quote old) old)
               (replace-match new t t old)) new)))

;; Case is applied after expanding back-references.
(qa (progn (string-match "X" "X") (replace-match "\\&y" nil nil "X")) "XY")
(qa (progn (string-match "Foo Bar" "Foo Bar")
           (replace-match "\\& one two" nil nil "Foo Bar")) "Foo Bar One Two")
;; Current buffer syntax determines initials even for string matches.
(qa (with-temp-buffer
      (modify-syntax-entry ?- "w")
      (string-match "Foo-bar" "Foo-bar")
      (replace-match "one-two" nil t "Foo-bar")) "One-two")
(qa (with-temp-buffer
      (modify-syntax-entry ?1 ".")
      (string-match "1A" "1A")
      (replace-match "xy" nil t "1A")) "xy")
(let ((case-symbols-as-words t))
  (qa (progn (string-match "Foo_bar" "Foo_bar")
             (replace-match "one_two" nil t "Foo_bar")) "One_two"))
;; Casing uses the current case table, including non-letter pairs.
(qa (with-temp-buffer
      (let ((table (copy-case-table (current-case-table))))
        (aset table ?@ ?!)
        (set-char-table-extra-slot table 0 nil)
        (set-char-table-extra-slot table 1 nil)
        (set-char-table-extra-slot table 2 nil)
        (set-case-table table)
        (string-match "@" "@")
        (replace-match "!a" nil t "@"))) "@A")
;; The ordinary replacement command path shares these rules.
(qa (with-temp-buffer
      (let ((case-fold-search t) (case-replace t))
        (insert "A a A") (goto-char 1)
        (perform-replace "a" "xy" nil nil nil)
        (buffer-string))) "XY xy XY")
(princ (qa--done))
