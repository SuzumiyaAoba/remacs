(qa (with-temp-buffer (insert "ab") (point)) 3)
(qa (with-temp-buffer (insert "ab" ?c) (list (buffer-string) (point))) '("abc" 4))
(qa (with-temp-buffer (insert "ab") (let ((mk (copy-marker 1))) (insert "X") (marker-position mk))) 1)
(qa (with-temp-buffer (insert "ab") (let ((mk (copy-marker 1))) (insert-before-markers "X") (marker-position mk))) 1)
(qa (with-temp-buffer (insert "ab") (let ((mk (copy-marker 3))) (insert "X") (marker-position mk))) 3)
(qa (with-temp-buffer (insert "ab") (let ((mk (copy-marker 3))) (insert-before-markers "X") (list (marker-position mk) (buffer-string)))) '(4 "abX"))
(qa (with-temp-buffer (insert "ab") (let ((mk (copy-marker 1 t))) (insert "X") (marker-position mk))) 1)
(qa (with-temp-buffer (insert "ab") (marker-insertion-type (copy-marker 1))) nil)
(qa (with-temp-buffer (insert "ab") (let ((m (point-marker))) (insert "Z") (list (marker-position m) (point)))) '(3 4))
(qa (with-temp-buffer (insert "ab") (list (markerp (point-marker))
                                         (marker-position (point-min-marker))
                                         (marker-position (point-max-marker))))
    '(t 1 3))

