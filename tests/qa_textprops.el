      (insert "c") (get-text-property 3 'x))
    nil)
(qa (with-temp-buffer (insert (propertize "ab" 'x 1)) (goto-char 1)
      (insert "c") (get-text-property 1 'x))
    nil)
;; insert-and-inherit inherits from preceding char unless rear-nonsticky
(qa (with-temp-buffer (insert (propertize "ab" 'x 1)) (goto-char (point-max))
      (insert-and-inherit "c") (get-text-property 3 'x))
    1)
(qa (with-temp-buffer (insert (propertize "ab" 'x 1 'rear-nonsticky '(x)))
      (goto-char (point-max)) (insert-and-inherit "c") (get-text-property 3 'x))
    nil)
;; ... and from following char only when front-sticky
(qa (with-temp-buffer (insert (propertize "ab" 'x 1)) (goto-char 1)
      (insert-and-inherit "c") (get-text-property 1 'x))
    nil)
(qa (with-temp-buffer (insert (propertize "ab" 'x 1 'front-sticky '(x)))
      (goto-char 1) (insert-and-inherit "c") (get-text-property 1 'x))
    1)
(qa (with-temp-buffer (insert (propertize "ab" 'x 1 'front-sticky t))
      (goto-char 1) (insert-and-inherit "c") (get-text-property 1 'x))
    1)
(qa (with-temp-buffer (insert (propertize "ab" 'x 1)) (goto-char (point-max))
      (insert-before-markers-and-inherit "c") (get-text-property 3 'x))
