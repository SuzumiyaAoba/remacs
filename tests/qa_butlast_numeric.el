;;; -*- lexical-binding: nil; -*-
;; Full numeric semantics in butlast / nbutlast (#490, #491, #492).
(dolist (n (list (expt 2 64) (1+ (expt 2 64)) (expt 2 127) (expt 2 200)))
  (dolist (op '(butlast nbutlast))
    (let ((source (list 'a 'b)))
      (qa (funcall op source n) nil)
      (qa source '(a b))
      (qa (eq (funcall op source (- n)) source) t))
    (qa (funcall op nil n) nil)))
(dolist (case '((0.5 1.5 0.5) (1.0 1.0 0.0) (1.5 0.5 -0.5)))
  (let ((n (car case)) (but-error (cadr case)) (nbut-error (nth 2 case)))
    (qa-err-data (butlast '(a b) n) 'wrong-type-argument (list 'integerp but-error))
    (qa-err-data (nbutlast (list 'a 'b) n) 'wrong-type-argument (list 'integerp nbut-error))))
(dolist (op '(butlast nbutlast))
  (dolist (n '(0 -1 0.0 -0.5 -1.0))
    (let ((source (list 'a 'b)))
      (qa (eq (funcall op source n) source) t)))
  (qa-err (funcall op (list 'a 'b) (make-marker)) 'error))
(qa (butlast nil -0.5) nil)
(qa (nbutlast nil -0.5) nil)
(qa (nbutlast '(a b) 2.0) nil)
(qa (nbutlast '(a b) 1.0e+INF) nil)
(qa (nbutlast '(a b) 0.0e+NaN) nil)
(qa-err-data (butlast '(a b) 1.0e+INF) 'wrong-type-argument '(integerp -1.0e+INF))
(qa (let ((source '(a b))) (eq (butlast source -1.0e+INF) source)) t)
;; Validation order differs: butlast compares N first; nbutlast takes length first.
(qa-err-data (butlast 'atom 'bad) 'wrong-type-argument '(number-or-marker-p bad))
(qa-err-data (nbutlast 'atom 'bad) 'wrong-type-argument '(sequencep atom))
(qa (butlast 'atom -1) 'atom)
(qa-err-data (nbutlast 'atom -1) 'wrong-type-argument '(sequencep atom))
(qa-err-data (nbutlast "abc" 1) 'wrong-type-argument '(listp "abc"))
(qa-err-data (nbutlast "abc" 2) 'wrong-type-argument '(consp "abc"))
(qa-err-data (nbutlast "abc" 0.5) 'wrong-type-argument '(integerp 1.5))
(qa-err-data (butlast '(a . b) (expt 2 200)) 'wrong-type-argument '(listp b))
(with-temp-buffer
  (insert "abc")
  (let ((marker (copy-marker 1)))
    (qa (butlast '(a b) marker) '(a))
    (qa (nbutlast (list 'a 'b) marker) '(a))))
;; Native calls to take/nthcdr observe redefinitions through trampolines.
(let ((take-save (symbol-function 'take)) (nth-save (symbol-function 'nthcdr)))
  (unwind-protect
      (progn
        (fset 'take (lambda (&rest args) (list 'seen-take args)))
        (fset 'nthcdr (lambda (&rest args) (list 'seen-nth args)))
        (qa (butlast '(a b) 1) '(seen-take (1 (a b))))
        (qa (nbutlast (list 'a 'b) 1) '(a b)))
    (fset 'take take-save)
    (fset 'nthcdr nth-save)))
(princ (qa--done))
