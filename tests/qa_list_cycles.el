;;; -*- lexical-binding: nil; -*-
(defun qa-cycle-index (value cells)
  (let ((index nil))
    (dotimes (n (length cells)) (when (eq value (aref cells n)) (setq index n))) index))
(defun qa-cycle-observe (function prefix period key &optional alist)
  (let* ((values (number-sequence 1 (+ prefix period)))
         (list (if alist (mapcar (lambda (n) (cons n n)) values) values))
         (cells (apply #'vector (mapcar (lambda (n) (nthcdr n list))
                                      (number-sequence 0 (1- (length list)))))))
    (setcdr (aref cells (1- (length cells))) (aref cells prefix))
    (condition-case err
        (progn (funcall function key list) '(returned))
      (circular-list
       (list (car err) (qa-cycle-index (cadr err) cells)
             (mapcar (lambda (cell) (qa-cycle-index (cdr cell) cells)) cells))))))

