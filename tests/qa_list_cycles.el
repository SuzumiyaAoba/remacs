;; Hits must return the original tail/pair before seeing a circular suffix.
(dolist (fn '(memq member memql))
  (qa (let ((list (list 1 2 3))) (setcdr (last list) list)
        (eq (funcall fn 2 list) (cdr list))) t))
(dolist (fn '(assq assoc rassq rassoc))
  (qa (let ((list (list (cons 1 1) (cons 2 2) (cons 3 3))))
        (setcdr (last list) list) (eq (funcall fn 2 list) (cadr list))) t))
(qa (let ((list (list "one" "two")))
      (setcdr (last list) list)
      (eq (member (copy-sequence "two") list) (cdr list))) t)
(qa (let ((list (list 1.5 2.5)))
      (setcdr (last list) list) (eq (memql (+ 1.0 1.5) list) (cdr list))) t)

;; TESTFN observes each cell in GNU's order, and cdr changes made by
;; the callback must be visible immediately after that call.
(qa (let* ((list (list (cons 1 1) (cons 2 2) (cons 3 3)))
           (third (cddr list)) (calls nil))
      (setcdr third list)
      (condition-case err
          (assoc 9 list (lambda (value key) (push (list value key) calls) nil))
        (circular-list (list (eq (cadr err) third) (nreverse calls)))))
    '(t ((1 9) (2 9) (3 9) (1 9) (2 9))))
(qa (let ((list (list (cons 1 1) (cons 2 2))) (calls 0))
      (list (assoc 9 list (lambda (value key) (setq calls (1+ calls)) (setcdr list nil) nil))
            calls)) '(nil 1))
(qa (let ((list (list (cons 1 1) (cons 2 2))))
      (catch 'found (assoc 9 list (lambda (value key) (throw 'found (list value key)))))) '(1 9))
(qa-err-data (assoc 9 '((1 . one) . bad) (lambda (value key) nil))
             'wrong-type-argument '(listp ((1 . one) . bad)))
(qa-err-data (memq 9 '(1 2 . bad)) 'wrong-type-argument '(listp (1 2 . bad)))
(qa-err-data (delq 1 '(1 2 . bad)) 'wrong-type-argument '(listp (2 . bad)))
(qa-err-data (delete 1 '(1 2 . bad)) 'wrong-type-argument '(listp (2 . bad)))
(qa-err-data (remove 1 '(1 2 . bad)) 'wrong-type-argument '(listp bad))

;; Ordinary deletion keeps aliasing, while remove copies the spine.
(qa (let ((list (list 1 2 3 2)))
      (list (eq (delq 9 list) list) (delete 2 list) list)) '(t (1 3) (1 3)))
(qa (let ((list (list 1 2 3)))
      (list (eq (remove 9 list) list) (remove 2 list) list)) '(nil (1 3) (1 2 3)))
(qa (let ((list (list 1 2 3))) (eq (remq 9 list) list)) t)
(qa (delete 2 [1 2 3 2]) [1 3])
(qa (remove 2 [1 2 3 2]) [1 3])
(qa (delete ?b "abcb") "ac")
(qa (remove ?b "abcb") "ac")

(princ (qa--done))
