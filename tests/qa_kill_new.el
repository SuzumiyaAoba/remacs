;;; -*- lexical-binding: t; -*-
(defmacro qa130-ring (&rest body)
 `(let ((kill-ring nil) (kill-ring-yank-pointer nil)
        (interprogram-cut-function nil) (interprogram-paste-function nil)
        (kill-transform-function nil) (kill-do-not-save-duplicates t)
        (save-interprogram-paste-before-kill nil) (kill-ring-max 60)) ,@body))
(qa (qa130-ring (let ((s (copy-sequence "a"))) (kill-new s) (eq (car kill-ring) s))) t)
(qa (qa130-ring (kill-new (propertize "ab" 'x 1)) (get-text-property 0 'x (car kill-ring))) 1)
(qa (qa130-ring (let ((s (string-to-multibyte "a"))) (kill-new s) (multibyte-string-p (car kill-ring)))) t)
(qa (qa130-ring (kill-new "a") (kill-new "a") kill-ring) '("a"))
(qa (qa130-ring (setq kill-ring (list "a" "b" "a")) (kill-new "a") kill-ring) '("a" "b" "a"))
(qa (qa130-ring (setq kill-ring (list "a" "b" "a")) (kill-new "b") kill-ring) '("b" "a" "b" "a"))
(qa (qa130-ring (kill-new "a") (kill-new (propertize "a" 'x 1))
                (list (length kill-ring) (get-text-property 0 'x (car kill-ring))
                      (get-text-property 0 'x (cadr kill-ring)))) '(2 1 nil))
(qa (qa130-ring (kill-new (propertize "a" 'x 1 'y 2))
                (kill-new (propertize "a" 'y 2 'x 1)) (length kill-ring)) 1)
(qa (qa130-ring (kill-new "a") (let ((old kill-ring)) (kill-new (copy-sequence "a")) (eq old kill-ring))) t)
(qa (qa130-ring (kill-new "a") (setq kill-ring-yank-pointer nil)
                (kill-new (copy-sequence "a")) (eq kill-ring-yank-pointer kill-ring)) t)
(qa (qa130-ring (let ((calls nil)
                      (interprogram-cut-function (lambda (s) (push s calls))))
                  (kill-new "a") (kill-new "a") (length calls))) 2)
(qa (qa130-ring (let* ((one (copy-sequence "a")) (two (copy-sequence "a")) (cut nil)
                       (interprogram-cut-function (lambda (s) (setq cut s))))
                  (kill-new one) (kill-new two)
                  (list (eq (car kill-ring) one) (eq cut two)))) '(t t))
(qa (qa130-ring (let ((kill-do-not-save-duplicates nil))
                  (kill-new "a") (kill-new "a") (length kill-ring))) 2)
(qa (qa130-ring (setq kill-ring (list "a" "b"))
                (let ((old kill-ring) (s (propertize "c" 'x 1)))
                  (kill-new s t)
                  (list (eq old kill-ring) (eq (car kill-ring) s)
                        (get-text-property 0 'x (car kill-ring)) (cdr kill-ring)))) '(t t 1 ("b")))
(qa (qa130-ring (let ((s (copy-sequence "a")))
                  (kill-new s t) (eq (car kill-ring) s))) t)

;; `kill-append' replaces with a fresh concatenation.  Appending to a
;; shared empty string must not change the empty string object itself.
(qa (qa130-ring
      (let* ((empty (make-string 0 ?A))
             (ring (list empty)))
        (setq kill-ring ring kill-ring-yank-pointer ring)
        (kill-append "Alpha be" nil)
        (list (length empty) (eq empty (car kill-ring))
              (car kill-ring) (eq ring kill-ring))))
    '(0 nil "Alpha be" t))

;; Prepending and appending follow kill-append's argument order.
(qa (qa130-ring
      (kill-new "middle")
      (kill-append "-end" nil)
      (kill-append "pre-" t)
      (car kill-ring))
    "pre-middle-end")

;; Preserve an existing yank-handler entry and add the merged string ahead
;; of it, as kill-new does when REPLACE is nil.
(qa (qa130-ring
      (let* ((old (propertize "old" 'yank-handler t))
             (ring (list old)))
        (setq kill-ring ring kill-ring-yank-pointer ring)
        (kill-append "new" nil)
        (list (car kill-ring) (eq (cadr kill-ring) old)
              (eq kill-ring ring))))
    '("oldnew" t nil))
(princ (qa--done))
