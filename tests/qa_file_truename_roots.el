;;; -*- lexical-binding: t; -*-
;; Issue #104: preserve a double root through symlink resolution, and
;; resolve components in their physical order before interpreting `..'.
(defvar qa104-case)
(defvar qa104-prefix)
(defvar qa104-base)
(qa-err-data (file-truename nil) 'wrong-type-argument '(arrayp nil))
(qa-err-data (file-truename t) 'wrong-type-argument '(arrayp t))
(qa-err-data (file-truename 'qa104-name) 'wrong-type-argument '(arrayp qa104-name))
(qa-err-data (file-truename 1) 'wrong-type-argument '(stringp 1))
(qa-err-data (file-truename 1.0) 'wrong-type-argument '(stringp 1.0))
(qa-err-data (file-truename [1]) 'wrong-type-argument '(stringp [1]))
(qa-err-data (file-truename '(a)) 'wrong-type-argument '(stringp (a)))
(qa (file-truename "/") "/")
(qa (file-truename "//") "//")
(qa (file-truename "///") "/")
(qa (file-truename "////") "/")

(let* ((directory (make-temp-file "qa104-roots-" t))
       (qa104-base (directory-file-name (file-truename directory))))
  (unwind-protect
      (progn
        (make-directory (concat qa104-base "/real/deep") t)
        (make-directory (concat qa104-base "/real/other"))
        (with-temp-file (concat qa104-base "/real/deep/leaf") (insert "data"))
        (make-symbolic-link "real/deep" (concat qa104-base "/link"))
        (make-symbolic-link (concat qa104-base "/real/deep") (concat qa104-base "/absolute"))
        (make-symbolic-link (concat "/" qa104-base "/real/deep") (concat qa104-base "/absolute-double"))
        (make-symbolic-link "real/deep/" (concat qa104-base "/link-slash"))
        (make-symbolic-link "../other" (concat qa104-base "/real/deep/next"))
        ;; Exactly two leading slashes survive; three or more collapse.
        (dolist (qa104-prefix '("" "/" "//" "///"))
          (dolist (qa104-case '(("" "") ("/" "/")
                               ("/link" "/real/deep") ("/link/" "/real/deep/")
                               ("/absolute" "/real/deep")
                               ("/absolute-double" "/real/deep")
                               ("/link-slash" "/real/deep/")
                               ("/link/.." "/real")
                               ("/link/missing" "/real/deep/missing")
                               ("/link/missing/.." "/real/deep")
                               ("/link/missing/../leaf" "/real/deep/leaf")
                               ("/link/missing/../next/new" "/real/other/new")
                               ("/missing/../leaf" "/leaf")
                               ("/missing/./tail/" "/missing/tail/")))
            (qa (file-truename (concat qa104-prefix qa104-base (car qa104-case)))
                (concat (if (or (equal (car qa104-case) "/absolute-double")
                                (and (equal qa104-prefix "/")
                                     (not (equal (car qa104-case) "/absolute"))))
                            "/" "")
                        qa104-base (cadr qa104-case)))))
        (qa (let ((default-directory (concat qa104-base "/"))) (file-truename "link/.."))
            (concat qa104-base "/real"))
        (qa (let ((default-directory (concat "/" qa104-base "/"))) (file-truename "link/.."))
            (concat "/" qa104-base "/real"))
        (qa (let ((process-environment (cons (concat "HOME=" qa104-base) process-environment)))
              (file-truename "~/link/..")) (concat qa104-base "/real")))
    (delete-directory directory t)))

(princ (qa--done)) (terpri)
