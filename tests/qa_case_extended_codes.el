;;; -*- lexical-binding: nil; -*-
;; Custom cases use Lisp character codes, not Rust proxies (#441).
(dolist (pair '((#xd800 #xd801) (#x110001 #x110002)
                (#x3fff7e #x3fff7f) (#x3fff80 #x3fff81)))
  (let ((upper (car pair)) (lower (cadr pair)))
    (with-temp-buffer
      (set-syntax-table (copy-syntax-table))
      (modify-syntax-entry upper "w")
      (modify-syntax-entry lower "w")
      (let ((table (make-char-table 'case-table nil)))
        (aset table upper lower)
        (set-case-table table))
      (qa (downcase upper) lower)
      (qa (upcase lower) upper)
      (qa (string-to-list (downcase (string upper lower))) (list lower lower))
      (qa (string-to-list (upcase (string upper lower))) (list upper upper))
      (qa (string-to-list (capitalize (string lower upper))) (list upper lower))
      (qa (string-to-list (upcase-initials (string lower upper))) (list upper upper))
      (dolist (op '(downcase-region upcase-region capitalize-region upcase-initials-region))
        (erase-buffer)
        (insert (string lower upper))
        (funcall op (point-min) (point-max))
        (qa (string-to-list (buffer-string))
            (cond ((eq op 'downcase-region) (list lower lower))
                  ((eq op 'capitalize-region) (list upper lower))
                  (t (list upper upper)))))
      (dolist (op '(downcase-word upcase-word capitalize-word))
        (erase-buffer)
        (insert (string lower upper))
        (goto-char (point-min))
        (funcall op 1)
        (qa (string-to-list (buffer-string))
            (cond ((eq op 'downcase-word) (list lower lower))
                  ((eq op 'capitalize-word) (list upper lower))
                  (t (list upper upper))))))))
;; Mappings can cross from ordinary Unicode into internal characters.
(with-temp-buffer
  (let ((table (make-char-table 'case-table nil)))
    (aset table #x110001 ?q)
    (set-case-table table)
    (qa (string-to-list (downcase (string #x110001))) '(113))
    (qa (string-to-list (upcase "q")) '(81))
    (qa (string-to-list (upcase (string-to-multibyte "q"))) '(1114113))))
(princ (qa--done))
