;;; -*- lexical-binding: t; -*-
;; Issue #94: numbered objects preserve GNU's cons-placeholder identity,
;; including nested labels and reuse of an already defined label number.
(defvar qa94-reader 'read)
(defun qa94-read (source)
  (let ((read-circle t))
    (if (eq qa94-reader 'read-from-string)
        (car (read-from-string source))
      (funcall qa94-reader source))))

(defun qa94-read-from-buffer (source)
  (with-temp-buffer
    (insert source)
    (goto-char (point-min))
    (read (current-buffer))))

;; `org-persist' reads circular data from a source buffer, not a string.
(qa (let ((buffer (generate-new-buffer " *qa94-reader-buffer*")))
      (unwind-protect
          (with-current-buffer buffer
            (insert "#1=(1 . #1#)")
            (goto-char (point-min))
            (let ((read-circle t))
              (let ((value (read (current-buffer))))
                (eq value (cdr value)))))
        (kill-buffer buffer)))
    t)

(dolist (qa94-reader '(read read-from-string read-positioning-symbols))
  (qa (let ((value (qa94-read "#1=(1 . #1#)")))
        (eq value (cdr value))) t)
  (qa (let ((value (qa94-read "#1=(#1#)")))
        (eq value (car value))) t)
  (qa (let ((value (qa94-read "#1=[1 2 #1#]")))
        (eq value (aref value 2))) t)
  (qa (let ((value (qa94-read "#1=#s(qa94 1 #1#)")))
        (eq value (aref value 2))) t)
  (qa (let* ((value (qa94-read "#1=(1 . #2=[#1# #2#])"))
             (vector (cdr value)))
        (list (eq value (aref vector 0)) (eq vector (aref vector 1)))) '(t t))
  (qa (let ((value (qa94-read "(#1=(1) #1# #2=[2] #2#)")))
        (list (eq (nth 0 value) (nth 1 value))
              (eq (nth 2 value) (nth 3 value)))) '(t t))
  ;; A new definition must replace the old mapping before its body reads.
  (qa (let* ((value (qa94-read "(#1=(1) #1=(2 . #1#) #1#)"))
             (old (nth 0 value)) (new (nth 1 value)))
        (list (eq new (cdr new)) (eq old (cdr new))
              (eq new (nth 2 value)))) '(t nil t))
  (qa (let* ((value (qa94-read "(#1=[1] #1=[2 #1#] #1#)"))
             (old (nth 0 value)) (new (nth 1 value)))
        (list (eq new (aref new 1)) (eq old (aref new 1))
              (eq new (nth 2 value)))) '(t nil t))
  ;; GNU copies the read cons into the outer placeholder, so nested cons
  ;; labels do not become aliases. Non-cons labels use substitution.
  (qa (let ((value (qa94-read "(#1=#2=(1) #1# #2#)")))
        (list (eq (nth 0 value) (nth 1 value))
              (eq (nth 0 value) (nth 2 value)))) '(t nil))
  (qa (let ((value (qa94-read "(#1=#2=[1] #1# #2#)")))
        (list (eq (nth 0 value) (nth 1 value))
              (eq (nth 0 value) (nth 2 value)))) '(t t))
  (qa (let* ((value (qa94-read "(#1=(#2=#1#) #2#)"))
             (outer (car value)) (inner (cadr value)))
        (list (eq outer (car outer)) (eq outer inner)
              (eq (car outer) inner) (car inner) (cdr inner))) '(nil nil t nil nil))
  ;; Completing an outer cons must retain the nested label's mapping.
  (qa (let* ((value (qa94-read "(#1=(#1# #1=(2 . #1#) #1#) #1#)"))
             (outer (car value)) (inner (nth 1 outer)))
        (list (eq outer (car outer)) (eq inner (cdr inner))
              (eq inner (nth 2 outer)) (eq inner (cadr value)))) '(t t t t))
  (qa (let ((value (qa94-read "#1=[#1# #1=[#1#] #1#]")))
        (list (eq value (aref value 0))
              (eq (aref value 1) (aref (aref value 1) 0))
              (eq (aref value 1) (aref value 2)))) '(t t t))
  (qa-err-data (qa94-read "#1=#1#") 'invalid-read-syntax '("nonsensical self-reference"))
  ;; Label scope ends with each read call.
  (qa-err-data (progn (qa94-read "#1=(1)") (qa94-read "#1#"))
               'invalid-read-syntax '("#1#")))

;; Buffer-backed reads must also fix up nested cons/vector and hash-table cycles.
(qa (let* ((read-circle t)
           (value (qa94-read-from-buffer "#1=(1 . #2=[#1# #2#])"))
           (vector (cdr value)))
      (list (eq value (aref vector 0)) (eq vector (aref vector 1))))
    '(t t))
(qa (let* ((read-circle t)
           (table (qa94-read-from-buffer
                   "#1=#s(hash-table size 1 test eq data (#1# #1#))"))
           key value)
      (maphash (lambda (current actual) (setq key current value actual)) table)
      (list (hash-table-count table) (consp key) (eq key value)
            (consp value) (eq value table) (eq (gethash key table) value)))
    '(1 t t t nil t))

;; Continuous numbering installs print-number-table as the label source.
;; A shared cons tail must still be printed with its label before the vector
;; that points back to it, or the printer can emit an invalid `#N=#N#'.
(qa (let* ((cell (list 'node))
           (vector (vector nil nil))
           (data nil)
           (print-circle t)
           (print-continuous-numbering t)
           (print-number-table nil)
           (read-circle t))
      (setcdr cell vector)
      (aset vector 0 cell)
      (aset vector 1 cell)
      (setq data (list (cons 'entry cell) (cons 'entry-vector vector)))
      (let* ((printed (prin1-to-string data))
             (copy (qa94-read-from-buffer printed))
             (copy-cell (cdr (car copy)))
             (copy-vector (cdr (cadr copy)))
             (readback (list (eq copy-cell (aref copy-vector 0))
                             (eq copy-vector (cdr copy-cell))
                             (eq copy-cell (aref copy-vector 1)))))
        (list printed readback)))
    '("((entry . #1=(node . #2=[#1# #1#])) (entry-vector . #2#))" (t t t)))

;; User-defined hash tests in print-number-table use the prepared identity
;; substitutions too. A shared list tail must stay dotted so its #N= label
;; remains at the first occurrence, and the printed graph must still read back.
(define-hash-table-test 'qa94-print-circle-identity #'eq (lambda (_key) 0))
(qa (progn
      ;; Reset GNU's process-global print_number_index before using a fresh table.
      (let ((print-circle t)) (print--preprocess nil))
      (let* ((cell (list 'node))
             (vector (vector nil nil))
             (data nil)
             (print-circle t)
             (print-continuous-numbering t)
             (print-number-table
              (make-hash-table :test 'qa94-print-circle-identity))
             (read-circle t))
        (setcdr cell vector)
        (aset vector 0 cell)
        (aset vector 1 cell)
        (setq data (list (cons 'entry cell) (cons 'entry-vector vector)))
        (let* ((printed (prin1-to-string data))
               (copy (qa94-read-from-buffer printed))
               (copy-cell (cdr (car copy)))
               (copy-vector (cdr (cadr copy))))
          (list printed
                (list (eq copy-cell (aref copy-vector 0))
                      (eq copy-vector (cdr copy-cell))
                      (eq copy-cell (aref copy-vector 1)))
                (hash-table-count print-number-table)))))
    '("((entry . #1=(node . #2=[#1# #1#])) (entry-vector . #2#))"
      (t t t) 2))

;; GNU preserves hash-table keys and values exactly as they were read.
;; A direct self-key remains the placeholder cons, so lookup by the resolved
;; table misses even though lookup by the key returned from maphash succeeds.
(qa (let* ((table (let ((read-circle t))
                    (read "#1=#s(hash-table size 1 test equal data ((a . #1#) 42))")))
           key)
      (maphash (lambda (current _value) (setq key current)) table)
      (list (hash-table-count table)
            (eq (cdr key) table)
            (eq (gethash key table) 42)
            (gethash (cons 'a table) table)))
    '(1 nil t nil))
(qa (let* ((table (let ((read-circle t))
                    (read "#1=#s(hash-table test equal data ((a . #1#) 42))")))
           (print-circle t)
           (printed (prin1-to-string table))
           (copy (let ((read-circle t)) (read printed))))
      (list printed (hash-table-count copy) (gethash '(a nil) copy)))
    '("#s(hash-table test equal data ((a nil) 42))" 1 42))
(qa (let* ((table (let ((read-circle t))
                    (read "#1=#s(hash-table size 1 test eq data (#1# 42))")))
           key)
      (maphash (lambda (current _value) (setq key current)) table)
      (list (hash-table-count table)
            (consp key)
            (eq key table)
            (gethash table table 'miss)
            (gethash key table 'miss)))
    '(1 t nil miss 42))
(qa (let ((read-circle t))
      (let ((table (read "#1=#s(hash-table size 1 test eq data (#1# #1#))")))
        (list (hash-table-count table) (eq table (gethash table table)))))
    '(1 nil))
(qa (let* ((table (let ((read-circle t))
                    (read "#1=#s(hash-table size 1 test eq data (#1# #1#))")))
           key value)
      (maphash (lambda (current actual) (setq key current value actual)) table)
      (list (consp key) (eq key value) (consp value) (eq value table)
            (eq (gethash key table) value)))
    '(t t t nil t))
(qa (let* ((table (let ((read-circle t))
                    (read "#1=#s(hash-table size 1 test eq data (self #1#))")))
           (value (gethash 'self table)))
      (list (hash-table-count table) (consp value) (eq (car value) nil)
            (eq (cdr value) nil) (eq value table)))
    '(1 t t t nil))
(qa (let* ((vector (let ((read-circle t))
                     (read "#1=[#s(hash-table test eq data (self #1#))]")))
           (table (aref vector 0))
           (value (gethash 'self table)))
      (list (hash-table-count table) (consp value) (eq value vector)
            (eq (car value) nil) (eq (cdr value) nil)))
    '(1 t nil t t))

;; The other original report examples already agree with GNU: circular
;; vectors are valid when enabled, this source ends at 8, and printing a
;; circular cdr is finite even with print-circle nil.
(qa (let ((read-circle t)) (read-from-string "#1=(a b)")) '((a b) . 8))
(qa (let ((read-circle nil)) (read "[a b]")) [a b])
(qa-err-data (let ((read-circle nil)) (read "#1=[a b #1#]"))
             'invalid-read-syntax '("#1="))
(qa (let ((print-circle t)) (prin1-to-string (qa94-read "#1=(1 . #1#)")))
    "#1=(1 . #1#)")
(qa (let ((print-circle nil)) (prin1-to-string (qa94-read "#1=(1 . #1#)")))
    "(1 . #0)")

;; A string's text-property values are part of the object graph printed
;; by `print-circle'; self-references must survive a read/print round trip.
(qa (let ((string (copy-sequence "x")))
      (put-text-property 0 1 'loop string string)
      (let* ((printed (let ((print-circle t)) (prin1-to-string string)))
             (copy (let ((read-circle t))
                     (car (read-from-string printed)))))
        (list printed (eq copy (get-text-property 0 'loop copy)))))
    '("#1=#(\"x\" 0 1 (loop #1#))" t))
(qa (let ((string (copy-sequence "x"))
          (print-circle t)
          (print-number-table nil))
      (put-text-property 0 1 'loop string string)
      (let ((printed (prin1-to-string string)))
        (list printed
              (gethash string print-number-table)
              (hash-table-count print-number-table))))
    '("#1=#(\"x\" 0 1 (loop #1#))" 1 1))

;; Circle preprocessing counts charset properties even when printing hides
;; them, matching GNU's unused definition label.
(qa (let ((string (copy-sequence "x")))
      (put-text-property 0 1 'charset string string)
      (let ((print-circle t) (print-charset-text-property nil))
        (prin1-to-string string)))
    "#1=\"x\"")

;; A property may point through another container before returning to its
;; string; reader fixups must descend through that value graph.
(qa (let* ((string (copy-sequence "x"))
           (vector (vector nil)))
      (put-text-property 0 1 'loop vector string)
      (aset vector 0 string)
      (let* ((printed (let ((print-circle t)) (prin1-to-string string)))
             (copy (let ((read-circle t))
                     (car (read-from-string printed))))
             (property (get-text-property 0 'loop copy)))
        (list printed (eq copy (aref property 0)))))
    '("#1=#(\"x\" 0 1 (loop [#1#]))" t))

;; A lexical closure's environment can point back to the closure itself.
(qa (let ((function (eval '(let ((function nil))
                             (setq function (lambda () function))
                             function)
                           t))
          (print-circle t)
          (print-level nil)
          (print-length nil))
      (prin1-to-string function))
    "#1=#[nil (function) ((function . #1#))]")

;; Reader fixups must also descend into the body of a function literal.
(qa (let ((read-circle t))
      (let ((function (read "#1=#[nil ((quote #1#)) nil]")))
        (eq (funcall function) function)))
    t)
(qa (let ((read-circle t))
      (let ((function (read "#1=#[nil (function) ((function . #1#) t)]")))
        (eq (funcall function) function)))
    t)
(qa (let ((read-circle t))
      (let ((function (read "#1=#[0 \"\\300\\207\" [#1#] 1]")))
        (eq (funcall function) function)))
    t)
(qa (let ((read-circle t))
      (let ((function (read "#1=#[#1# ((quote ok)) nil]")))
        (list (eq function (aref function 0))
              (condition-case nil (func-arity function)
                (invalid-function 'invalid))
              (condition-case nil (funcall function)
                (invalid-function 'invalid)))))
    '(t invalid invalid))
(qa (let ((read-circle t))
      (let ((function (read "#1=#[nil (function) #1#]")))
        (list (eq function (aref function 2))
              (condition-case nil (funcall function)
                (wrong-type-argument 'wrong-type-argument)))))
    '(t wrong-type-argument))

(princ (qa--done)) (terpri)
