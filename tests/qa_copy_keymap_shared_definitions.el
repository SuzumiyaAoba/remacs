;;; -*- lexical-binding: nil; -*-
;; copy-keymap copies maps/wrappers but shares ordinary definitions (#521).
(qa (let* ((map (make-sparse-keymap))
           (vector-definition [97 98])
           (function-definition (list 'lambda nil (list 'interactive) (list 'ignore))))
      (define-key map "v" vector-definition)
      (define-key map "f" function-definition)
      (let ((copy (copy-keymap map)))
        (list (eq (lookup-key copy "v") vector-definition)
              (eq (lookup-key copy "f") function-definition))))
    '(t t))
(qa (let ((parent (make-sparse-keymap)) (child (make-sparse-keymap)))
      (set-keymap-parent child parent)
      (eq (keymap-parent (copy-keymap child)) parent))
    t)
(qa (let ((map (make-sparse-keymap)) (prefix (make-sparse-keymap)))
      (define-key prefix "x" 'original)
      (define-key map "p" prefix)
      (let ((copy (copy-keymap map)))
        (let ((copied-prefix (lookup-key copy "p")))
          (define-key copied-prefix "y" 'copy-only)
          (list (eq copied-prefix prefix)
                (lookup-key copied-prefix "y")
                (lookup-key prefix "y")))))
    '(nil copy-only nil))
(qa (let* ((map (make-sparse-keymap))
           (command (list 'lambda nil (list 'interactive) (list 'ignore)))
           (wrapper (list 'menu-item "Label" command)))
      (define-key map "m" wrapper)
      (let ((copy (copy-keymap map)))
        (let ((copied-wrapper (cdr (assq ?m (cdr copy)))))
          (list (eq copied-wrapper wrapper)
                (eq (nth 2 copied-wrapper) command)
                (eq (lookup-key copy "m") command)))))
    '(nil t t))
(princ (qa--done))
