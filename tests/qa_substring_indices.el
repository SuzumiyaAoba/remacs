;;; -*- lexical-binding: nil; -*-
;; GNU rejects bignum bounds with integerp before range checking (#546).
(dolist (function '(substring substring-no-properties))
  (dolist (source (list "abc" "" (string-as-multibyte "abc")
                        (unibyte-string 65 128 255)))
    (dolist (bound (list (1+ most-positive-fixnum) (1- most-negative-fixnum)
                         (expt 2 64) (- (expt 2 64)) (expt 2 200)))
      (qa-err-data (funcall function source bound)
                   'wrong-type-argument (list 'integerp bound))
      (qa-err-data (funcall function source nil bound)
                   'wrong-type-argument (list 'integerp bound))
      ;; Both type checks precede the range check of a negative start.
      (qa-err-data (funcall function source -10 bound)
                   'wrong-type-argument (list 'integerp bound))
      (qa-err-data (funcall function source bound 'later)
                   'wrong-type-argument (list 'integerp bound)))
    (qa-err-data (funcall function source 0 1.0)
                 'wrong-type-argument '(integerp 1.0)))
  (qa-err-data (funcall function nil (expt 2 64))
               'wrong-type-argument
               (list (if (eq function 'substring) 'arrayp 'stringp) nil)))
(let ((source (propertize "abc" 'tag 'value)))
  (qa (substring source -2 -1) "b")
  (qa (get-text-property 0 'tag (substring source -2 -1)) 'value)
  (qa (text-properties-at 0 (substring-no-properties source -2 -1)) nil))
(dolist (bound (list (expt 2 64) (- (expt 2 64))))
  (qa-err-data (substring [a b c] bound)
               'wrong-type-argument (list 'integerp bound))
  (qa-err-data (substring [a b c] 0 bound)
               'wrong-type-argument (list 'integerp bound)))
(qa (substring [a b c] -2 -1) [b])
(princ (qa--done))
