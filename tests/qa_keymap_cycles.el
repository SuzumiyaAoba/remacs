;;; -*- lexical-binding: nil; -*-
(defun qa68-set-parent (map parent)
  (condition-case e (progn (set-keymap-parent map parent) 'accepted)
    (error e)))
;; Both sparse and full keymaps reject self inheritance before mutation.
(dolist (dense '(nil t))
  (let ((map (if dense (make-keymap "map") (make-sparse-keymap "map"))))
    (define-key map [a] 'own-command)
    (let ((spine (cdr map)))
      (qa (qa68-set-parent map map) '(error "Cyclic keymap inheritance"))
      (qa (null (keymap-parent map)) t)
      (qa (eq (cdr map) spine) t))))
;; Two-map cycles, all sparse/full combinations, keep the original parent.
(dolist (dense-a '(nil t))
  (dolist (dense-b '(nil t))
    (let ((a (if dense-a (make-keymap) (make-sparse-keymap)))
          (b (if dense-b (make-keymap) (make-sparse-keymap)))
          (old (make-sparse-keymap)))
      (define-key old [z] 'inherited-command)
      (define-key b [b] 'own-command)
      (set-keymap-parent a b)
      (set-keymap-parent b old)
      (let ((spine (cdr b)) (result (qa68-set-parent b a)))
        (qa result '(error "Cyclic keymap inheritance"))
        (qa (eq (keymap-parent b) old) t)
        (qa (eq (cdr b) spine) t)
        ;; A broken baseline must not enter lookup on its accepted cycle.
        (when (equal result '(error "Cyclic keymap inheritance"))
          (qa (lookup-key a [z]) 'inherited-command)
          (qa (lookup-key a [b]) 'own-command))))))
;; Indirect ancestry, including a chain longer than arbitrary walk limits.
(dolist (count '(3 17 80 300))
  (let* ((root (make-sparse-keymap)) (leaf root))
    (dotimes (_ count)
      (let ((next (if (zerop (% _ 2)) (make-keymap) (make-sparse-keymap))))
        (set-keymap-parent leaf next)
        (setq leaf next)))
    (qa (qa68-set-parent leaf root) '(error "Cyclic keymap inheritance"))))
;; Non-cyclic operations and identity (not structural equality).
(let ((a (make-sparse-keymap)) (b (make-sparse-keymap))
      (other (make-sparse-keymap)))
  (qa (equal a b) t)
  (qa (eq (set-keymap-parent a b) b) t)
  (qa (eq (set-keymap-parent a b) b) t)
  (qa (eq (set-keymap-parent a other) other) t)
  (qa (set-keymap-parent a nil) nil)
  (qa (null (keymap-parent a)) t)
  (qa (eq (set-keymap-parent b a) a) t))
;; An embedded map is a lookup element, not a parent link.
(let* ((child (make-sparse-keymap)) (parent (list 'keymap child)))
  (qa (keymap-parent parent) nil)
  (qa (eq (set-keymap-parent child parent) parent) t)
  (qa (eq (keymap-parent child) parent) t))
;; Parent tails naming a keymap must participate in cycle detection.
(let ((a (make-sparse-keymap)) (b (make-sparse-keymap)))
  (fset 'qa68-parent-map a)
  (unwind-protect
      (progn
        (setcdr b 'qa68-parent-map)
        (qa (eq (keymap-parent b) a) t)
        (qa (qa68-set-parent a b) '(error "Cyclic keymap inheritance"))
        (qa (null (keymap-parent a)) t))
    (fmakunbound 'qa68-parent-map)))
;; Invalid arguments still fail before changing a valid child's parent.
(dolist (bad '(nil 1 t "map" [keymap] (not-keymap)))
  (qa-err-data (set-keymap-parent bad nil) 'wrong-type-argument (list 'keymapp bad)))
(let ((map (make-sparse-keymap)) (old (make-sparse-keymap)))
  (set-keymap-parent map old)
  (dolist (bad '(1 t "map" [keymap] (not-keymap)))
    (qa-err-data (set-keymap-parent map bad) 'wrong-type-argument (list 'keymapp bad))
    (qa (eq (keymap-parent map) old) t)))
;; GNU can loop forever on externally corrupted ancestry.  Our visited
;; guard additionally rejects that input without changing the child.
(when qa--remacs
  (let ((a (make-sparse-keymap)) (b (make-sparse-keymap))
        (child (make-sparse-keymap)))
    (setcdr a b)
    (setcdr b a)
    (qa (qa68-set-parent child a) '(error "Cyclic keymap inheritance"))
    (qa (null (keymap-parent child)) t)))
(princ (qa--done)) (terpri)
