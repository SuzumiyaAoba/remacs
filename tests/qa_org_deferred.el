;;; qa_org_deferred.el --- Deferred Org values survive source expansion -*- lexical-binding: t; -*-
(require 'org-element-ast)

(defun qa339-alias (property auto)
  (org-element-deferred-create-alias property auto))
(defun qa339-create (auto function &rest args)
  (apply #'org-element-deferred-create auto function args))
(defun qa339-direct-call (value)
  (org-element-deferred-create t #'list value :tail))

(qa (org-element-deferred-create nil #'org-element-property-2 :raw-value)
    '[org-element-deferred org-element-property-2 (:raw-value) nil])
(qa (org-element-deferred-create t #'list 1 2)
    '[org-element-deferred list (1 2) t])
(qa (org-element-deferred-create nil #'list)
    '[org-element-deferred list nil nil])
(qa (org-element-deferred-create-alias :raw-value)
    '[org-element-deferred org-element-property-2 (:raw-value) nil])
(qa (qa339-alias :title t)
    '[org-element-deferred org-element-property-2 (:title) t])
(qa (qa339-create t #'list :first :second)
    '[org-element-deferred list (:first :second) t])
(qa (qa339-direct-call :value)
    '[org-element-deferred list (:value :tail) t])
(qa (funcall (byte-compile (lambda (value)
                           (org-element-deferred-create t #'list value :tail))) :compiled)
    '[org-element-deferred list (:compiled :tail) t])
(qa (org-element-deferred-create-list '(1 2) t)
    '[org-element-deferred org-element--deferred-resolve-list (1 2) t])
(qa (org-element-deferred-create-list nil)
    '[org-element-deferred org-element--deferred-resolve-list nil nil])
(qa (let* ((args (list 1 2)) (value (org-element-deferred-create-list args)))
      (list (eq args (org-element-deferred-args value))
            (org-element-deferred-p value)))
    '(t t))
(qa (let* ((alias (org-element-deferred-create-alias :raw-value))
           (node (list 'headline (list :raw-value "Title" :title alias))))
      (list (org-element-property :title node)
            (eq alias (org-element-property-raw :title node))))
    '("Title" t))
(qa (let* ((alias (org-element-deferred-create-alias :raw-value t))
           (node (list 'headline (list :raw-value "Title" :title alias))))
      (list (org-element-property :title node)
            (org-element-property-raw :title node)))
    '("Title" "Title"))
(qa (let* ((alias (org-element-deferred-create-alias :raw-value))
           (value (org-element-deferred-create-list (list :first alias :last)))
           (node '(headline (:raw-value "Title"))))
      (org-element--deferred-resolve-force value node))
    '(:first "Title" :last))

(princ (qa--done))
