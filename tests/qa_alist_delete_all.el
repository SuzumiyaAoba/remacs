;;; -*- lexical-binding: nil; -*-
;; No finite-list cutoff; assq delegates to live assoc-delete-all/eq (#528/#529).
(let* ((a (cons 'remove 1)) (b (cons 'keep 2)) (c (cons 'remove 3))
       (d (cons 'other 4)) (source (list a b c d)) (kept (cdr source)))
  (qa (eq (assq-delete-all 'remove source) kept) t)
  (qa kept '((keep . 2) (other . 4)))
  (qa (eq (car kept) b) t)
  (qa (eq (cadr kept) d) t))
(let* ((a (cons 'a 'remove)) (b (cons 'b 'keep)) (c (cons 'c 'remove))
       (d (cons 'd 'other)) (source (list a b c d)) (kept (cdr source)))
  (qa (eq (rassq-delete-all 'remove source) kept) t)
  (qa kept '((b . keep) (d . other)))
  (qa (eq (car kept) b) t)
  (qa (eq (cadr kept) d) t))
(dolist (op '(assq-delete-all rassq-delete-all))
  (qa (funcall op 'absent nil) nil)
  (qa-err-data (funcall op 'absent 'atom) 'wrong-type-argument '(listp atom))
  (qa-err-data (funcall op 'absent '(nil . tail)) 'wrong-type-argument '(listp tail)))
(qa (assq-delete-all 'remove (list 'ignored (cons 'remove 1) 42 nil (cons 'keep 2)))
    '(ignored 42 nil (keep . 2)))
(qa (rassq-delete-all 'remove (list 'ignored (cons 'a 'remove) 42 nil (cons 'b 'keep)))
    '(ignored 42 nil (b . keep)))
;; A later dotted-tail error retains deletions already performed.
(let ((source (cons (cons 'keep 1) (cons (cons 'remove 2) 'tail))))
  (qa-err-data (assq-delete-all 'remove source) 'wrong-type-argument '(listp tail))
  (qa source '((keep . 1) . tail)))
(let ((source (cons (cons 'a 'keep) (cons (cons 'b 'remove) 'tail))))
  (qa-err-data (rassq-delete-all 'remove source) 'wrong-type-argument '(listp tail))
  (qa source '((a . keep) . tail)))
(let ((saved (symbol-function 'assoc-delete-all)) (result nil) (seen nil))
  (unwind-protect
      (progn
        (fset 'assoc-delete-all (lambda (&rest args) (setq seen args) 'intercepted))
        (setq result (assq-delete-all 'target '((other . 1)))))
    (fset 'assoc-delete-all saved))
  (qa result 'intercepted)
  (qa seen '(target ((other . 1)) eq)))
;; Restore eq before asserting, so its redefinition cannot affect the harness.
(let ((saved (symbol-function 'eq)) (assq-result nil) (rassq-result nil))
  (unwind-protect
      (progn
        (fset 'eq (lambda (&rest args) t))
        (setq assq-result (assq-delete-all 'target (list (cons 'other 1))))
        (setq rassq-result (rassq-delete-all 'target (list (cons 'other 1)))))
    (fset 'eq saved))
  (qa assq-result nil)
  (qa rassq-result '((other . 1))))
;; Both a long retained spine and a long matching head run are finite.
(let* ((source (make-list 500001 nil)) (end (last source)))
  (unwind-protect
      (dolist (op '(assq-delete-all rassq-delete-all))
        (qa (eq (funcall op 'absent source) source) t)
        (qa (length source) 500001))
    (setcdr end source)))
(dolist (op '(assq-delete-all rassq-delete-all))
  (let* ((matching (if (eq op 'assq-delete-all) (cons 'target 'value) (cons 'key 'target)))
         (source (make-list 500001 matching)) (end (last source))
         (kept (list (cons 'keep 'keep))))
    (setcdr end kept)
    (unwind-protect
        (qa (eq (funcall op 'target source) kept) t)
      (setcdr end source))))
(garbage-collect)
(princ (qa--done))
