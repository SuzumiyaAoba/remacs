;; char-tables & category tables — GNU 31.1 verified.
;; Facts pinned:
;;  - make-char-table takes 1-2 args (PURPOSE symbol + INIT, default nil);
;;    extra slots come from the `char-table-extra-slots' property on
;;    PURPOSE (integer 0..10, though larger values are accepted).
;;  - char-table-range: nil → the default value; a cons → the value of
;;    the car only (reversed conses accepted); a fixnum must be a valid
;;    character code — MAX_CHAR is #x3FFFFF, so #x110000 is a valid
;;    internal char but #x400000 errors.
;;  - set-char-table-range: t fills ALL character cells but leaves the
;;    default untouched; nil sets only the default; a reversed cons is
;;    silently a no-op; returns VALUE itself.
;;  - lookup order: cell → table default → parent chain.  An explicitly
;;    nil cell still falls through to default/parent.
;;  - aref/aset work on char-tables like single-char range ops; aref
;;    checks fixnump first, then characterp.
;;  - map-char-table calls back with ascending EQ-merged ranges; a cons
;;    key is a shared cons mutated in place by GNU, so the callback must
;;    copy it; values compared with EQ, not equal.
;;  - equal on char-tables compares contents (t for identical tables);
;;    length is 4194304.
;;  - a category table is a char-table with purpose `category-table',
;;    a bool-vector default, and TWO extra slots; slot 0 holds a
;;    95-element docstring vector indexed by CATEGORY - 32.
;;  - char-category-set takes ONLY a char and uses the current buffer's
;;    category table; equal category sets are shared (eq) objects.
;;  - modify-category-entry requires a category previously defined via
;;    define-category; RESET non-nil removes the category.
;;  - in-category and char-table-extra-slots do not exist in 31.1.

;; == char-table-p / make-char-table / subtype ==
(qa (char-table-p (make-char-table 'qact nil)) t)
(qa (char-table-p (make-char-table 'qact 'x)) t)
(qa (char-table-p [1 2]) nil)
(qa (char-table-p "s") nil)
(qa (char-table-p nil) nil)
(qa (char-table-p 7) nil)
(qa (char-table-p (make-bool-vector 2 t)) nil)
(qa (char-table-p (make-category-table)) t)
(qa (char-table-p (standard-syntax-table)) t)
(qa (char-table-p (make-display-table)) t)
;; subtype echoes the purpose symbol
(qa (char-table-subtype (make-char-table 'qact nil)) 'qact)
(qa (char-table-subtype (make-char-table nil nil)) nil)
(qa (char-table-subtype (standard-syntax-table)) 'syntax-table)
(qa (char-table-subtype (make-display-table)) 'display-table)
(qa (char-table-subtype (make-category-table)) 'category-table)
;; INIT defaults to nil; PURPOSE must be a symbol
(qa-err (make-char-table) 'wrong-number-of-arguments)
(qa-err (make-char-table 'qact nil 'x) 'wrong-number-of-arguments)
(qa-err-data (make-char-table 7 nil) 'wrong-type-argument '(symbolp 7))
(qa-err-data (make-char-table "s" nil) 'wrong-type-argument '(symbolp "s"))
(qa (char-table-range (make-char-table 'qact) ?a) nil)

;; == char-table-range ==
;; init value applies to every unset char
(qa (char-table-range (make-char-table 'qact 99) ?q) 99)
(qa (char-table-range (make-char-table 'qact 99) #x3FFFFF) 99)
;; nil reads the default value
(qa (char-table-range (make-char-table 'qact 'dv) nil) 'dv)
;; cons range returns the value of the CAR only
(qa (let ((ct (make-char-table 'qact nil)))
      (set-char-table-range ct ?b 'vb)
      (list (char-table-range ct '(?a . ?b))
            (char-table-range ct '(?b . ?c))))
    '(nil vb))
;; reversed cons is accepted: still reads the car
(qa (let ((ct (make-char-table 'qact nil)))
      (set-char-table-range ct ?z 'vz)
      (char-table-range ct '(?z . ?a)))
    'vz)
;; internal char space extends past Unicode max
(qa (char-table-range (make-char-table 'qact nil) #x110000) nil)
(qa (char-table-range (make-char-table 'qact 'd) #x3FFFFF) 'd)
(qa-err (char-table-range (make-char-table 'qact nil) #x400000) 'error)
(qa-err (char-table-range (make-char-table 'qact nil) -1) 'error)
(qa-err (char-table-range (make-char-table 'qact nil) 'sym) 'error)
(qa-err (char-table-range (make-char-table 'qact nil) "a") 'error)
(qa-err (char-table-range (make-char-table 'qact nil) t) 'error)
(qa-err-data (char-table-range (make-char-table 'qact nil) '("a" . ?b))
             'wrong-type-argument '(characterp "a"))
(qa-err-data (char-table-range (make-char-table 'qact nil) '(?a . "b"))
             'wrong-type-argument '(characterp "b"))
(qa-err-data (char-table-range (make-char-table 'qact nil) '(?a . #x400000))
             'wrong-type-argument '(characterp 4194304))
(qa-err-data (char-table-range [1] ?a) 'wrong-type-argument '(char-table-p [1]))

;; == set-char-table-range ==
;; returns VALUE itself
(qa (set-char-table-range (make-char-table 'qact nil) ?a 'va) 'va)
;; set-char-table-range returns the value object itself
(qa (let ((ct (make-char-table 'qact nil)) (v (list 1)))
      (eq (set-char-table-range ct ?a v) v))
    t)
;; char, cons, nil, t ranges
(qa (let ((ct (make-char-table 'qact nil)))
      (set-char-table-range ct '(?a . ?z) 'az)
      (list (char-table-range ct ?a) (char-table-range ct ?m)
            (char-table-range ct ?z) (char-table-range ct ?A)))
    '(az az az nil))
;; range crossing the 256 boundary
(qa (let ((ct (make-char-table 'qact nil)))
      (set-char-table-range ct '(?\xFE . ?\u0102) 'cross)
      (list (char-table-range ct ?\xFE) (char-table-range ct ?\xFF)
            (char-table-range ct ?\u0100) (char-table-range ct ?\u0102)
            (char-table-range ct ?\u0103)))
    '(cross cross cross cross nil))
;; nil sets only the default; existing cells unaffected
(qa (let ((ct (make-char-table 'qact nil)))
      (set-char-table-range ct nil 'dft)
      (set-char-table-range ct ?a 'va)
      (list (char-table-range ct nil) (char-table-range ct ?a)
            (char-table-range ct ?z)))
    '(dft va dft))
;; t fills every character cell — even ones already set — but NOT
;; the default value
(qa (let ((ct (make-char-table 'qact nil)))
      (set-char-table-range ct ?a 'va)
      (set-char-table-range ct t 'tv)
      (list (char-table-range ct ?a) (char-table-range ct ?z)
            (char-table-range ct nil)))
    '(tv tv nil))
(qa (let ((ct (make-char-table 'qact 'def)))
      (set-char-table-range ct t 'tv)
      (list (char-table-range ct nil) (char-table-range ct ?m)))
    '(def tv))
;; after t-fill, a cons range still wins locally
(qa (let ((ct (make-char-table 'qact nil)))
      (set-char-table-range ct t 'tv)
      (set-char-table-range ct '(?m . ?o) 'mo)
      (list (char-table-range ct ?l) (char-table-range ct ?m)
            (char-table-range ct ?o) (char-table-range ct ?p)))
    '(tv mo mo tv))
;; overlapping cons ranges: last set wins per char
(qa (let ((ct (make-char-table 'qact nil)))
      (set-char-table-range ct '(?a . ?c) 'ac)
      (set-char-table-range ct '(?b . ?d) 'bd)
      (list (char-table-range ct ?a) (char-table-range ct ?b)
            (char-table-range ct ?c) (char-table-range ct ?d)
            (char-table-range ct ?e)))
    '(ac bd bd bd nil))
;; reversed cons: returns VALUE, silently sets nothing
(qa (let ((ct (make-char-table 'qact nil)))
      (list (set-char-table-range ct '(?z . ?a) 'va)
            (char-table-range ct ?a) (char-table-range ct ?m)
            (char-table-range ct ?z)))
    '(va nil nil nil))
;; error paths
(qa-err (set-char-table-range (make-char-table 'qact nil) "a" 1) 'error)
(qa-err (set-char-table-range (make-char-table 'qact nil) -1 1) 'error)
(qa-err (set-char-table-range (make-char-table 'qact nil) 'sym 1) 'error)
(qa-err (set-char-table-range (make-char-table 'qact nil) #x400000 'v) 'error)
(qa-err-data (set-char-table-range (make-char-table 'qact nil) '(?a . "b") 1)
             'wrong-type-argument '(characterp "b"))
(qa-err-data (set-char-table-range (make-char-table 'qact nil) '("a" . ?b) 1)
             'wrong-type-argument '(characterp "a"))
(qa-err-data (set-char-table-range (make-char-table 'qact nil) '(?a ?b) 'v)
             'wrong-type-argument '(characterp (98)))
(qa-err-data (set-char-table-range [1] ?a 1)
             'wrong-type-argument '(char-table-p [1]))

;; == aref / aset / misc sequence ops ==
(qa (aref (make-char-table 'qact 'init) ?a) 'init)
(qa (let ((ct (make-char-table 'qact nil)))
      (aset ct ?a 'v)
      (char-table-range ct ?a))
    'v)
(qa (let ((ct (make-char-table 'qact nil)))
      (set-char-table-range ct ?a 'v)
      (aref ct ?a))
    'v)
(qa-err-data (aref (make-char-table 'qact nil) "x")
                'wrong-type-argument '(fixnump "x"))
(qa-err (aref (make-char-table 'qact nil) -1) 'wrong-type-argument)
(qa-err (aref (make-char-table 'qact nil) #x400000) 'wrong-type-argument)
(qa-err-data (aset (make-char-table 'qact nil) "x" 'v)
             'wrong-type-argument '(fixnump "x"))
(qa-err (aset (make-char-table 'qact nil) -1 'v) 'wrong-type-argument)
;; type predicates
(qa (let ((ct (make-char-table 'qact nil)))
      (list (vectorp ct) (sequencep ct) (listp ct) (consp ct)
            (arrayp ct) (char-or-string-p ct)))
    '(nil t nil nil t nil))
;; length covers the whole internal char space
(qa (length (make-char-table 'qact nil)) 4194304)

;; == parents ==
(qa (char-table-parent (make-char-table 'qact nil)) nil)
(qa (let ((ct (make-char-table 'qact nil)) (p (make-char-table 'qact nil)))
      (set-char-table-parent ct p)
      (eq (char-table-parent ct) p))
    t)
;; set-char-table-parent returns the parent
(qa (let ((ct (make-char-table 'qact nil)) (p (make-char-table 'qact nil)))
      (eq (set-char-table-parent ct p) p))
    t)
;; parent supplies values for unset cells
(qa (let ((ct (make-char-table 'qact nil)) (p (make-char-table 'qact 'pv)))
      (set-char-table-parent ct p)
      (char-table-range ct ?a))
    'pv)
;; parent chain
(qa (let ((ct (make-char-table 'qact nil))
          (p1 (make-char-table 'qact 'p1v))
          (p2 (make-char-table 'qact 'p2v)))
      (set-char-table-parent ct p1)
      (set-char-table-parent p1 p2)
      (list (char-table-range ct ?a)
            (char-table-range p1 ?a)
            (eq (char-table-parent p1) p2)))
    '(p1v p1v t))
;; child's own cells shadow the parent, even when set before/after
(qa (let ((ct (make-char-table 'qact nil)) (p (make-char-table 'qact 'pv)))
      (set-char-table-parent ct p)
      (set-char-table-range ct ?a 'av)
      (list (char-table-range ct ?a) (char-table-range ct ?b)))
    '(av pv))
(qa (let ((ct (make-char-table 'qact nil)) (p (make-char-table 'qact nil)))
      (set-char-table-parent ct p)
      (set-char-table-range p ?a 'pa)
      (set-char-table-range ct ?a 'ca)
      (list (char-table-range ct ?a) (char-table-range ct ?b)))
    '(ca nil))
;; child's own default beats the parent — lookup is cell, default, parent
(qa (let ((ct (make-char-table 'qact 'childinit)) (p (make-char-table 'qact 'pv)))
      (set-char-table-parent ct p)
      (char-table-range ct ?a))
    'childinit)
;; an explicitly nil cell falls through to the parent too
(qa (let ((ct (make-char-table 'qact nil)) (p (make-char-table 'qact 'pv)))
      (set-char-table-parent ct p)
      (set-char-table-range ct ?a nil)
      (char-table-range ct ?a))
    'pv)
;; removing the parent restores own defaults
(qa (let ((ct (make-char-table 'qact nil)) (p (make-char-table 'qact 'pv)))
      (set-char-table-parent ct p)
      (set-char-table-parent ct nil)
      (list (char-table-parent ct) (char-table-range ct ?a)))
    '(nil nil))
;; cycles are rejected
(qa-err (let ((ct (make-char-table 'qact nil)))
          (set-char-table-parent ct ct))
        'error)
(qa-err (let ((a (make-char-table 'qact nil)) (b (make-char-table 'qact nil)))
          (set-char-table-parent a b)
          (set-char-table-parent b a))
        'error)
(qa-err-data (set-char-table-parent (make-char-table 'qact nil) [1])
             'wrong-type-argument '(char-table-p [1]))
(qa-err-data (set-char-table-parent (make-char-table 'qact nil) 7)
             'wrong-type-argument '(char-table-p 7))
(qa-err-data (char-table-parent [1])
             'wrong-type-argument '(char-table-p [1]))
(qa-err-data (char-table-subtype [1])
             'wrong-type-argument '(char-table-p [1]))

;; == extra slots ==
;; plain purpose: no extra slots
(qa-err (char-table-extra-slot (make-char-table 'qact nil) 0)
        'args-out-of-range)
(qa-err (set-char-table-extra-slot (make-char-table 'qact nil) 0 'x)
        'args-out-of-range)
;; slots counted from the purpose symbol's char-table-extra-slots prop
(qa (progn
      (put 'qact3 'char-table-extra-slots 3)
      (let ((ct (make-char-table 'qact3 nil)))
        (list (char-table-extra-slot ct 0) (char-table-extra-slot ct 1)
              (char-table-extra-slot ct 2))))
    '(nil nil nil))
(qa (let ((ct (make-char-table 'qact3 nil)))
      (set-char-table-extra-slot ct 1 'one)
      (list (char-table-extra-slot ct 0) (char-table-extra-slot ct 1)
            (char-table-extra-slot ct 2)))
    '(nil one nil))
(qa-err (char-table-extra-slot (make-char-table 'qact3 nil) 3)
        'args-out-of-range)
(qa-err (char-table-extra-slot (make-char-table 'qact3 nil) -1)
        'args-out-of-range)
;; set-char-table-extra-slot returns the value
(qa (let ((ct (make-char-table 'qact3 nil)))
      (set-char-table-extra-slot ct 0 'v0))
    'v0)
;; property of 0 → still no extra slots
(qa (progn (put 'qact0 'char-table-extra-slots 0)
           (condition-case nil
               (progn (char-table-extra-slot (make-char-table 'qact0 nil) 0) 'noerr)
             (args-out-of-range 'oor)))
    'oor)
;; 10 slots is the documented max; larger values are still accepted
(qa (progn (put 'qact10 'char-table-extra-slots 10)
           (char-table-extra-slot (make-char-table 'qact10 nil) 9))
    nil)
(qa-err (char-table-extra-slot (make-char-table 'qact10 nil) 10)
        'args-out-of-range)
(qa (progn (put 'qact11 'char-table-extra-slots 11)
           (char-table-extra-slot (make-char-table 'qact11 nil) 10))
    nil)
;; bad property values
(qa (progn (put 'qactneg 'char-table-extra-slots -1)
           (condition-case nil
               (progn (make-char-table 'qactneg nil) 'noerr)
             (wrong-type-argument 'wta)))
    'wta)
(qa (progn (put 'qactsym 'char-table-extra-slots 'sym)
           (condition-case nil
               (progn (make-char-table 'qactsym nil) 'noerr)
             (wrong-type-argument 'wta)))
    'wta)
(qa (progn (put 'qactfloat 'char-table-extra-slots 1.5)
           (condition-case nil
               (progn (make-char-table 'qactfloat nil) 'noerr)
             (wrong-type-argument 'wta)))
    'wta)
;; a category table has exactly two extra slots
(qa (char-table-extra-slot (make-category-table) 1) nil)
(qa-err (char-table-extra-slot (make-category-table) 2)
        'args-out-of-range)
;; a display table has many extra slots
(qa (char-table-extra-slot (make-display-table) 0) nil)
(qa (let ((dt (make-display-table)))
      (set-char-table-extra-slot dt 0 's0)
      (set-char-table-extra-slot dt 5 's5)
      (list (char-table-extra-slot dt 0) (char-table-extra-slot dt 1)
            (char-table-extra-slot dt 5)))
    '(s0 nil s5))
;; non-char-table / non-fixnum N
(qa-err-data (char-table-extra-slot [1] 0)
             'wrong-type-argument '(char-table-p [1]))
(qa-err-data (char-table-extra-slot (make-display-table) 1.5)
             'wrong-type-argument '(fixnump 1.5))
(qa-err-data (set-char-table-extra-slot [1] 0 'v)
             'wrong-type-argument '(char-table-p [1]))

;; == map-char-table ==
;; single char → fixnum key
(qa (let ((ct (make-char-table 'qact nil)) (acc nil))
      (set-char-table-range ct ?a 'va)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '((97 va)))
;; cons range → one cons key, copied inside the callback
(qa (let ((ct (make-char-table 'qact nil)) (acc nil))
      (set-char-table-range ct '(?a . ?c) 'ac)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '(((97 . 99) ac)))
;; ascending order regardless of set order; singles are fixnums
(qa (let ((ct (make-char-table 'qact nil)) (acc nil))
      (set-char-table-range ct ?z 'vz)
      (set-char-table-range ct ?a 'va)
      (set-char-table-range ct '(?d . ?f) 'vdf)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '((97 va) ((100 . 102) vdf) (122 vz)))
;; contiguous same-value ranges merge (EQ comparison)
(qa (let ((ct (make-char-table 'qact nil)) (acc nil))
      (set-char-table-range ct '(?a . ?c) 'v)
      (set-char-table-range ct '(?d . ?f) 'v)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '(((97 . 102) v)))
;; disjoint same-value ranges stay separate
(qa (let ((ct (make-char-table 'qact nil)) (acc nil))
      (set-char-table-range ct '(?a . ?c) 'v)
      (set-char-table-range ct '(?x . ?z) 'v)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '(((97 . 99) v) ((120 . 122) v)))
;; merging is EQ: equal-but-distinct objects do not merge
(qa (let ((ct (make-char-table 'qact nil)) (acc nil))
      (set-char-table-range ct ?a (list 1))
      (set-char-table-range ct ?b (list 1))
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '((97 (1)) (98 (1))))
;; shared value object does merge
(qa (let ((ct (make-char-table 'qact nil)) (acc nil) (v (list 1)))
      (set-char-table-range ct '(?a . ?b) v)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '(((97 . 98) (1))))
;; a t-fill or init default reports the whole space as one range
(qa (let ((ct (make-char-table 'qact nil)) (acc nil))
      (set-char-table-range ct t 'dft)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '(((0 . 4194303) dft)))
(qa (let ((ct (make-char-table 'qact 'init)) (acc nil))
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '(((0 . 4194303) init)))
;; empty table: no calls, returns nil
(qa (let ((ct (make-char-table 'qact nil)) (acc nil))
      (list (map-char-table (lambda (k v) (push (list k v) acc)) ct) acc))
    '(nil nil))
;; parent's values are mapped through unset cells
(qa (let ((ct (make-char-table 'qact nil)) (p (make-char-table 'qact nil))
          (acc nil))
      (set-char-table-range p ?a 'pa)
      (set-char-table-range p ?b 'pb)
      (set-char-table-parent ct p)
      (set-char-table-range ct ?a 'ca)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '((97 ca) (98 pb)))
;; parent's DEFAULT floods every unset cell
(qa (let ((ct (make-char-table 'qact nil)) (p (make-char-table 'qact 'pv))
          (acc nil))
      (set-char-table-parent ct p)
      (set-char-table-range ct ?a nil)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '(((0 . 4194303) pv)))
;; ranges above ASCII
(qa (let ((ct (make-char-table 'qact nil)) (acc nil))
      (set-char-table-range ct '(?\u0100 . ?\u010F) 'uu)
      (map-char-table (lambda (k v)
                        (push (list (if (consp k) (cons (car k) (cdr k)) k) v)
                              acc))
                      ct)
      (nreverse acc))
    '(((256 . 271) uu)))
(qa-err-data (map-char-table #'ignore [1])
             'wrong-type-argument '(char-table-p [1]))

;; == equal / copy-sequence / optimize-char-table ==
(qa (eq (make-char-table 'qact nil) (make-char-table 'qact nil)) nil)
(qa (let ((ct (make-char-table 'qact nil))) (eq ct ct)) t)
;; equal compares contents
(qa (equal (make-char-table 'qact nil) (make-char-table 'qact nil)) t)
(qa (let ((ct (make-char-table 'qact nil))) (equal ct ct)) t)
(qa (let ((a (make-char-table 'qact nil)) (b (make-char-table 'qact nil)))
      (set-char-table-range a ?a 1)
      (equal a b))
    nil)
(qa (equal (make-char-table 'x nil) (make-char-table 'y nil)) nil)
(qa (equal (make-char-table 'qact nil) [1 2 3]) nil)
;; copy-sequence produces an independent char-table
(qa (let ((ct (make-char-table 'qact3 nil)))
      (set-char-table-extra-slot ct 0 'e0)
      (set-char-table-range ct ?a 'va)
      (let ((cc (copy-sequence ct)))
        (list (char-table-p cc) (char-table-subtype cc)
              (char-table-range cc ?a) (char-table-extra-slot cc 0)
