;;; -*- lexical-binding: nil; -*-
;; Overlays are opaque identity objects, not vectors/sequences (#484).
(with-temp-buffer
  (let ((overlay (make-overlay 1 1)))
    (qa (list (overlayp overlay) (vectorp overlay)
              (sequencep overlay) (arrayp overlay))
        '(t nil nil nil))
    (qa (condition-case err (length overlay)
          (error (list (car err) (cadr err) (eq (caddr err) overlay))))
        '(wrong-type-argument sequencep t))
    (qa (condition-case err (length< overlay 1)
          (error (list (car err) (cadr err) (eq (caddr err) overlay))))
        '(wrong-type-argument sequencep t))
    (qa (length= overlay -1) nil)
    (qa (condition-case err (elt overlay 'invalid-index)
          (error (list (car err) (cadr err) (eq (caddr err) overlay))))
        '(wrong-type-argument sequencep t))
    (qa (condition-case err (aref overlay 0)
          (error (list (car err) (cadr err) (eq (caddr err) overlay))))
        '(wrong-type-argument arrayp t))
    (qa (condition-case err (aref overlay 'invalid-index)
          (error (list (car err) (cadr err))) )
        '(wrong-type-argument fixnump))
    (qa (condition-case err (aset overlay 0 'changed)
          (error (list (car err) (cadr err) (eq (caddr err) overlay))))
        '(wrong-type-argument arrayp t))
    (qa (condition-case err (copy-sequence overlay)
          (error (list (car err) (cadr err) (eq (caddr err) overlay))))
        '(wrong-type-argument sequencep t))
    (qa (condition-case err (vconcat overlay)
          (error (list (car err) (cadr err) (eq (caddr err) overlay))))
        '(wrong-type-argument sequencep t))
    (overlay-put overlay 'qa484-property 'preserved)
    (qa (overlay-get overlay 'qa484-property) 'preserved)
    (qa (list (overlay-start overlay) (overlay-end overlay)) '(1 1))))
(princ (qa--done))
