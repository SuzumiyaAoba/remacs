;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "map:mapcar-vector" '(let ((sequence (vector 1 2 3)) (seen nil)) (let ((value (mapcar (lambda (x) (push x seen) (aset sequence 1 9) x) sequence))) (list value (nreverse seen) sequence))))
(audit-check "map:mapcar-list" '(let ((sequence (list 1 2 3)) (seen nil)) (let ((value (mapcar (lambda (x) (push x seen) (setcar (cdr sequence) 9) x) sequence))) (list value (nreverse seen) sequence))))
(audit-check "map:mapcar-string" '(let ((sequence (copy-sequence "abc")) (seen nil)) (let ((value (mapcar (lambda (x) (push x seen) (aset sequence 1 ?X) x) sequence))) (list value (nreverse seen) sequence))))
(audit-check "map:mapc-vector" '(let ((sequence (vector 1 2 3)) (seen nil)) (let ((value (mapc (lambda (x) (push x seen) (aset sequence 1 9) x) sequence))) (list (eq value sequence) (nreverse seen) sequence))))
(audit-check "map:mapc-list" '(let ((sequence (list 1 2 3)) (seen nil)) (let ((value (mapc (lambda (x) (push x seen) (setcar (cdr sequence) 9) x) sequence))) (list (eq value sequence) (nreverse seen) sequence))))
(audit-check "map:mapc-string" '(let ((sequence (copy-sequence "abc")) (seen nil)) (let ((value (mapc (lambda (x) (push x seen) (aset sequence 1 ?X) x) sequence))) (list (eq value sequence) (nreverse seen) sequence))))
(audit-check "map:mapconcat-vector" '(let ((sequence (vector 1 2 3)) (seen nil)) (let ((value (mapconcat (lambda (x) (push x seen) (aset sequence 1 9) (number-to-string x)) sequence ","))) (list value (nreverse seen) sequence))))
(audit-check "map:mapconcat-list" '(let ((sequence (list 1 2 3)) (seen nil)) (let ((value (mapconcat (lambda (x) (push x seen) (setcar (cdr sequence) 9) (number-to-string x)) sequence ","))) (list value (nreverse seen) sequence))))
(audit-check "map:mapconcat-string" '(let ((sequence (copy-sequence "abc")) (seen nil)) (let ((value (mapconcat (lambda (x) (push x seen) (aset sequence 1 ?X) (number-to-string x)) sequence ","))) (list value (nreverse seen) sequence))))
(audit-check "map:list-tail-delete" '(let ((sequence (list 1 2 3))) (mapcar (lambda (x) (setcdr sequence nil) x) sequence)))
(audit-check "map:mapcan-vector" '(let ((sequence (vector 1 2 3))) (mapcan (lambda (x) (aset sequence 1 9) (list x)) sequence)))
(audit-check "map:vector-properties" '(let* ((s (propertize "abc" 'face 'bold)) (parts (mapcar (lambda (x) (char-to-string x)) s))) (list parts (get-text-property 0 'face s))))
(princ "AUDIT-DONE\n")
