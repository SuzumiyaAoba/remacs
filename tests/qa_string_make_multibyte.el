;;; -*- lexical-binding: t; -*-
;; GNU's make/to variants differ on ASCII; unchanged representations retain
;; identity and properties, while conversion allocates and drops properties.
(defun qa119-result (string &optional function)
  (let ((result (funcall (or function #'string-make-multibyte) string)))
    (list (eq string result) (multibyte-string-p result)
          (string-to-list result) (string-bytes result)
          (text-properties-at 0 result))))

(qa (qa119-result "") '(t nil nil 0 nil))
(qa (qa119-result "abc") '(t nil (97 98 99) 3 nil))
(qa (qa119-result (unibyte-string 97 98 99)) '(t nil (97 98 99) 3 nil))
(qa (qa119-result (unibyte-string 0)) '(t nil (0) 1 nil))
(qa (qa119-result (unibyte-string 127)) '(t nil (127) 1 nil))
(qa (qa119-result (unibyte-string 0 127)) '(t nil (0 127) 2 nil))
(qa (qa119-result (unibyte-string 128)) '(nil t (4194176) 2 nil))
(qa (qa119-result (unibyte-string 255)) '(nil t (4194303) 2 nil))
(qa (qa119-result (unibyte-string 0 127 128 255))
    '(nil t (0 127 4194176 4194303) 6 nil))
(qa (qa119-result "é") '(t t (233) 2 nil))
(qa (qa119-result "aé😀") '(t t (97 233 128512) 7 nil))
(qa (qa119-result (string-to-multibyte "abc")) '(t t (97 98 99) 3 nil))
(qa (qa119-result (string-to-multibyte (unibyte-string 128)))
    '(t t (4194176) 2 nil))

(qa (qa119-result (propertize "abc" 'face 'bold))
    '(t nil (97 98 99) 3 (face bold)))
(qa (qa119-result (propertize "é" 'face 'bold))
    '(t t (233) 2 (face bold)))
(qa (qa119-result (propertize (unibyte-string 128 255) 'face 'bold))
    '(nil t (4194176 4194303) 4 nil))
(qa (let* ((string (copy-sequence "abc"))
           (result (string-make-multibyte string)))
      (aset result 0 ?X)
      (list string result (eq string result))) '("Xbc" "Xbc" t))
(qa (let* ((string (unibyte-string 128))
           (result (string-make-multibyte string)))
      (put-text-property 0 1 'qa119 'converted result)
      (list (text-properties-at 0 string)
            (get-text-property 0 'qa119 result) (eq string result))) '(nil converted nil))

;; The shared conversion routine must still force ASCII when explicitly
;; requested by string-to-multibyte and preserve already-multibyte objects.
(qa (qa119-result "abc" #'string-to-multibyte) '(nil t (97 98 99) 3 nil))
(qa (qa119-result "" #'string-to-multibyte) '(nil t nil 0 nil))
(qa (qa119-result "é" #'string-to-multibyte) '(t t (233) 2 nil))
(qa (qa119-result (propertize "é" 'face 'bold) #'string-to-multibyte)
    '(t t (233) 2 (face bold)))
(qa (qa119-result (propertize "abc" 'face 'bold) #'string-to-multibyte)
    '(nil t (97 98 99) 3 nil))
(qa-err-data (string-make-multibyte nil) 'wrong-type-argument '(stringp nil))
(qa-err-data (string-make-multibyte 5) 'wrong-type-argument '(stringp 5))
(qa-err-data (string-make-multibyte []) 'wrong-type-argument '(stringp []))

(princ (qa--done))
