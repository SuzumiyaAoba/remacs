;;; -*- lexical-binding: nil; -*-
;; Every hash test uses the same LIFO free-slot policy (#538).
(defun qa538-keys (table)
  (let (result)
    (maphash (lambda (key _value) (push key result)) table)
    (nreverse result)))
(dolist (test '(eq eql equal))
  (let ((table (make-hash-table :test test)))
    (dolist (key '(a b c d)) (puthash key key table))
    (remhash 'a table)
    (remhash 'c table)
    ;; Repeated/absent deletion must not duplicate free slots.
    (remhash 'c table)
    (remhash 'absent table)
    ;; Updating an occupied slot must leave the free list untouched.
    (puthash 'b 'updated table)
    (let ((copy (copy-hash-table table)))
      (dolist (target (list table copy))
        (puthash 'x 'x target)
        (qa (qa538-keys target) '(b x d))
        (qa (gethash 'b target) 'updated)
        (puthash 'y 'y target)
        (qa (qa538-keys target) '(y b x d))
        (qa (hash-table-count target) 4)
        ;; New entries append only after all free slots are used.
        (puthash 'z 'z target)
        (qa (qa538-keys target) '(y b x d z)))
      (qa (eq table copy) nil))
    (clrhash table)
    (puthash 'fresh 'fresh table)
    (qa (qa538-keys table) '(fresh))
    (qa (hash-table-count table) 1)))
;; Slot reuse is visible to an already-running maphash cursor.
(dolist (test '(eq eql equal))
  (let ((table (make-hash-table :test test)) (seen nil))
    (dolist (key '(a b c d)) (puthash key key table))
    (maphash (lambda (key _value)
               (push key seen)
               (when (eq key 'a)
                 (remhash 'a table)
                 (remhash 'c table)
                 (puthash 'x 'x table)))
             table)
    (qa (nreverse seen) '(a b x d))
    (qa (qa538-keys table) '(b x d))))
(fmakunbound 'qa538-keys)
(princ (qa--done))
