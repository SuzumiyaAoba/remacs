;;; -*- lexical-binding: t; -*-
(defvar qa-dispatch-chars nil)
(defvar qa-dispatch-reader nil)
(defun qa-dispatch-source (&optional unread)
  (if unread (push unread qa-dispatch-chars) (pop qa-dispatch-chars)))

;; t and the read-char symbol both call the public minibuffer entry point.
(dolist (qa-dispatch-reader '(read read-positioning-symbols))
  (qa (let ((original (symbol-function 'read-minibuffer))
            (result (list 'shared)) prompts)
        (unwind-protect
            (progn
              (fset 'read-minibuffer
                    (lambda (prompt) (push prompt prompts) result))
              (let ((standard-input t))
                (list (eq (funcall qa-dispatch-reader t) result)
                      (eq (funcall qa-dispatch-reader 'read-char) result)
                      (eq (funcall qa-dispatch-reader nil) result)
                      prompts)))
          (fset 'read-minibuffer original)))
      '(t t t ("Lisp expression: " "Lisp expression: " "Lisp expression: ")))
  (qa-err-data (let ((standard-input nil)) (funcall qa-dispatch-reader))
      'void-function '(nil))
  (qa-err-data (funcall qa-dispatch-reader 42) 'invalid-function '(42)))

(qa (let ((qa-dispatch-chars (string-to-list "(aa bb) tail"))
          (symbols-with-pos-enabled nil))
      (let ((value (read-positioning-symbols 'qa-dispatch-source)))
        (list (mapcar #'bare-symbol value) (mapcar #'symbol-with-pos-pos value)
              qa-dispatch-chars))) '((aa bb) (1 4) (32 116 97 105 108)))
(qa (let ((qa-dispatch-chars (string-to-list "  aa bb"))
          (symbols-with-pos-enabled nil) (standard-input 'qa-dispatch-source))
      (list (symbol-with-pos-pos (read-positioning-symbols))
            (symbol-with-pos-pos (read-positioning-symbols)) qa-dispatch-chars)) '(2 1 nil))
(qa (let ((qa-dispatch-chars (string-to-list "aa"))
          (symbols-with-pos-enabled t))
      (let ((value (read-positioning-symbols 'qa-dispatch-source)))
        (list (symbolp value) (bare-symbol-p value) (symbol-with-pos-p value)
              (bare-symbol value) (symbol-with-pos-pos value)))) '(t nil t aa 0))
(qa (let ((qa-dispatch-chars '(34 4194303 34)))
      (let ((value (read-positioning-symbols 'qa-dispatch-source)))
        (list (multibyte-string-p value) (string-to-list value)))) '(nil (255)))
(qa-err-data (let ((qa-dispatch-chars '(40 97)))
               (read-positioning-symbols 'qa-dispatch-source)) 'end-of-file nil)
(qa-err-data (read-positioning-symbols (lambda (&optional _) (signal 'file-error '("callback"))))
    'file-error '("callback"))
(princ (qa--done)) (terpri)
