;;; -*- lexical-binding: nil; -*-
;; Invalid print-unreadable-function values must retain the default printer.
(defmacro qa71-macro (&rest args) nil)
(defalias 'qa71-macro-alias 'qa71-macro)
(defalias 'qa71-special-alias 'if)
(let ((marker (make-marker)))
  (dolist (callback (list nil t 7 "invalid" [invalid] marker
                        'qa71-undefined 'print-unreadable-object
                        'qa71-macro 'qa71-macro-alias 'if 'qa71-special-alias
                        (symbol-function 'qa71-macro) (symbol-function 'if)
                        '(autoload "missing") '(closure nil nil nil)
                        '(keymap) '(invalid)))
    (let ((print-unreadable-function callback))
      (qa (functionp callback) nil)
      (qa (prin1-to-string marker) "#<marker in no buffer>")
      (qa (prin1-to-string marker t) "#<marker in no buffer>")
      (qa (with-output-to-string (prin1 marker)) "#<marker in no buffer>")
      (qa (with-output-to-string (princ marker)) "#<marker in no buffer>")
      (qa (with-output-to-string (print marker)) "\n#<marker in no buffer>\n")
      (qa (prin1-to-string (list marker [a])) "(#<marker in no buffer> [a])")))
  ;; Autoloads with non-nil TYPE are macros/keymaps, not functions.  A
  ;; missing file proves classification does not try to load the definition.
  (dolist (type '(t macro keymap invalid))
    (fmakunbound 'qa71-autoload)
    (autoload 'qa71-autoload "/qa71-missing-file" nil nil type)
    (defalias 'qa71-autoload-alias 'qa71-autoload)
    (dolist (callback '(qa71-autoload qa71-autoload-alias))
      (let ((print-unreadable-function callback))
        (qa (functionp callback) nil)
        (qa (prin1-to-string marker) "#<marker in no buffer>")
        (qa (prin1-to-string marker t) "#<marker in no buffer>"))))
  ;; GNU's predicate is deliberately shallow, including short/dotted
  ;; autoload records.  Check classification without invoking them.
  (dolist (definition '((autoload) (autoload . tail)
                        (autoload "missing") (autoload "missing" nil nil)
                        (autoload "missing" nil nil nil)
                        (autoload "missing" nil nil . tail)))
    (fset 'qa71-short-autoload definition)
    (qa (functionp 'qa71-short-autoload) t))
  (defun qa71-callback (object escaped)
    (if (eq object marker) (if escaped "ESCAPED" "PLAIN") "WRONG"))
  (defalias 'qa71-callback-alias 'qa71-callback)
  (dolist (callback (list 'qa71-callback 'qa71-callback-alias
                        (symbol-function 'qa71-callback)
                        '(lambda (object escaped)
                           (if (eq object marker)
                               (if escaped "ESCAPED" "PLAIN") "WRONG"))))
    (let ((print-unreadable-function callback))
      (qa (functionp callback) t)
      (qa (prin1-to-string marker) "ESCAPED")
      (qa (prin1-to-string marker t) "PLAIN")
      (qa (with-output-to-string (prin1 marker)) "ESCAPED")
      (qa (with-output-to-string (princ marker)) "PLAIN")
      (qa (with-output-to-string (print marker)) "\nESCAPED\n")
      (qa (prin1-to-string (vector marker marker)) "[ESCAPED ESCAPED]")))
  ;; The princ fallback must record each unreadable object only once.
  (let ((calls 0)
        (print-unreadable-function (lambda (o e) (setq calls (1+ calls)) "X")))
    (qa (prin1-to-string (vector marker marker) t) "[X X]")
    (qa calls 2))
  (let ((calls 0)
        (print-unreadable-function (lambda (o e) (setq calls (1+ calls)) nil)))
    (qa (prin1-to-string marker t) "#<marker in no buffer>")
    (qa calls 1))
  (let ((print-unreadable-function #'ignore))
    (qa (prin1-to-string marker) "#<marker in no buffer>")
    (qa (prin1-to-string marker t) "#<marker in no buffer>"))
  (let ((print-unreadable-function (lambda (o e) (error "callback error"))))
    (qa-err (prin1-to-string marker) 'error)
    (qa-err (prin1-to-string marker t) 'error))
  (let ((print-unreadable-function (lambda (o e) (throw 'qa71-tag 'caught))))
    (qa (catch 'qa71-tag (prin1-to-string marker)) 'caught)
    (qa (catch 'qa71-tag (prin1-to-string marker t)) 'caught)))
(qa-lex (let ((label "CLOSURE")
              (print-unreadable-function nil))
          (setq print-unreadable-function (lambda (o e) label))
          (prin1-to-string (make-marker))) "CLOSURE")
(princ (qa--done)) (terpri)
