;;; Distinguish Unicode private use from internal extended characters. -*- lexical-binding: nil; -*-
;; #624: Rust char proxy ranges must never alias actual Emacs characters.
(dolist (pair '((983168 . 4) (983296 . 4) (57344 . 3)
                (1048576 . 4) (55296 . 3) (1703936 . 4)))
  (let* ((code (car pair))
         (text (char-to-string code))
         (name (concat "qa-wide-" text)))
    (qa (string-to-list text) (list code))
    (qa (string-bytes text) (cdr pair))
    (qa (string-to-list (substring (concat "A" text "B") 1 2)) (list code))
    (qa (string-to-list (symbol-name (intern name))) (append '(113 97 45 119 105 100 101 45) (list code)))
    (with-temp-buffer
      (insert "A" text "B")
      (qa (string-to-list (buffer-substring-no-properties 2 3)) (list code))
      (qa (char-after 2) code))))
(let ((table (make-hash-table :test 'equal))
      (private (char-to-string 983168))
      (byte8 (string-as-multibyte (unibyte-string 128))))
  (puthash private 'private table)
  (puthash byte8 'byte8 table)
  (qa (hash-table-count table) 2)
  (qa (gethash private table) 'private)
  (qa (gethash byte8 table) 'byte8)
  (qa (equal private byte8) nil))
(let* ((private (concat "qa-buffer-" (char-to-string 983296)))
       (surrogate (concat "qa-buffer-" (char-to-string 55296)))
       (first (generate-new-buffer private))
       (second (generate-new-buffer surrogate)))
  (unwind-protect
      (progn
        (qa (eq first second) nil)
        (qa (get-buffer private) first)
        (qa (get-buffer surrogate) second)
        (qa (string-to-list (buffer-name first)) (string-to-list private))
        (qa (string-to-list (buffer-name second)) (string-to-list surrogate)))
    (kill-buffer first)
    (kill-buffer second)))
(princ (qa--done))
