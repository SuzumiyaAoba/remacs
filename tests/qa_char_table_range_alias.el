;; Issue #29: range keys are a mutable shared cons, not complements.
(defun qa29-observe (config)
  (let* ((sets (nth 0 config)) (init (nth 1 config)) (parent (nth 2 config))
         (stop (nth 3 config)) (table (make-char-table 't init))
         (raw nil) (copies nil) (states nil) (retained nil) (count 0))
    (when parent (set-char-table-parent table (make-char-table 't parent)))
    (dolist (entry sets) (set-char-table-range table (car entry) (cdr entry)))
    (catch 'qa29-stop
      (map-char-table
       (lambda (key value)
         (push (mapcar (lambda (old) (cons (car old) (cdr old))) retained) states)
         (push (list key value) raw)
         (push (list (if (consp key) (cons (car key) (cdr key)) key) value) copies)
         (when (consp key) (push key retained))
         (setq count (1+ count))
         (when (eq count stop) (throw 'qa29-stop nil))) table))
    (list (nreverse raw) (nreverse copies) (nreverse states)
          (and (cdr retained) (eq (car retained) (cadr retained))))))

