;;; -*- lexical-binding: nil; -*-
;; A positioned symbol's public class follows the current dynamic flag (#571).
(let* ((symbols-with-pos-enabled nil)
       (value (position-symbol 'alpha 1)))
  (let ((symbols-with-pos-enabled t))
    (let ((table (make-hash-table :test 'eq)))
      (puthash value 'found table)
      (qa (list (type-of value) (symbolp value) (symbol-name value)
                (value< value 'beta)
                (eq value 'alpha) (equal value 'alpha) (gethash 'alpha table))
          '(symbol t "alpha" t t t found))))
  (let ((symbols-with-pos-enabled nil))
    (qa (list (type-of value) (symbolp value) (eq value 'alpha)
              (equal value 'alpha))
        '(symbol-with-pos nil nil nil))
    (qa-err (symbol-name value) 'wrong-type-argument)))

(let* ((symbols-with-pos-enabled t)
       (value (position-symbol 'beta 2)))
  (let ((symbols-with-pos-enabled nil))
    (qa (list (type-of value) (symbolp value) (symbol-with-pos-p value)
              (eq value 'beta) (equal value 'beta))
        '(symbol-with-pos nil t nil nil))))

;; Hash keys follow the flag at each operation; existing tables are not rehashed.
(let* ((symbols-with-pos-enabled nil)
       (value (position-symbol 'gamma 3))
       (table (make-hash-table :test 'eq)))
  (puthash value 'found table)
  (let ((symbols-with-pos-enabled t))
    (qa (list (eq value 'gamma) (gethash 'gamma table) (gethash value table))
        '(t nil nil)))
  (let ((symbols-with-pos-enabled nil))
    (qa (list (eq value 'gamma) (gethash 'gamma table) (gethash value table))
        '(nil nil found))))
(princ (qa--done))
