;;; -*- lexical-binding: nil; -*-
;; Issue #33: gensym never skips names that already exist in an obarray.
(dolist (prefix '("qa33-prefix" "" "g" 5 -5 nil))
  (dolist (start '(0 1 7 -1 42))
    (let* ((gensym-counter start)
           (name (format "%s%d" (or prefix "g") start))
           (existing (intern name))
           (generated (gensym prefix)))
      (qa (symbol-name generated) name)
      (qa gensym-counter (1+ start))
      (qa (eq generated existing) nil)
      (qa (eq (intern name) existing) t)
      (qa (symbol-name (gensym prefix)) (format "%s%d" (or prefix "g") (1+ start)))
      (qa gensym-counter (+ start 2)))))
(let ((gensym-counter 0))
  (qa (mapcar #'symbol-name (list (gensym) (gensym "pfx") (gensym 5))) '("g0" "pfx1" "52"))
  (qa gensym-counter 3))
(let ((gensym-counter 20))
  (make-symbol "unused")
  (qa (symbol-name (gensym "qa33-")) "qa33-20")
  (qa gensym-counter 21))
(princ (qa--done))
