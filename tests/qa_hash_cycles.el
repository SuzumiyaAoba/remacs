;;; -*- lexical-binding: t; -*-
;; Issue #192: cyclic equal keys use structural collision checks.
;; All expected values are verified with GNU Emacs 31.1.
(defun qa192-cdr-ring (values)
  (let ((ring (copy-sequence values))) (setcdr (last ring) ring) ring))
(defun qa192-car-ring (n tail)
  (let ((nodes nil) (i 0))
    (while (< i n) (push (cons nil tail) nodes) (setq i (1+ i)))
    (let ((remaining nodes))
      (while remaining
        (setcar (car remaining) (or (cadr remaining) (car nodes)))
        (setq remaining (cdr remaining))))
    (car nodes)))
(defun qa192-vector-ring (n label)
  (let ((nodes nil) (i 0))
    (while (< i n) (push (vector nil label) nodes) (setq i (1+ i)))
    (let ((remaining nodes))
      (while remaining
        (aset (car remaining) 0 (or (cadr remaining) (car nodes)))
        (setq remaining (cdr remaining))))
    (car nodes)))
(defun qa192-record-ring (n label)
  (let ((nodes nil) (i 0))
    (while (< i n) (push (record 'r nil label) nodes) (setq i (1+ i)))
    (let ((remaining nodes))
      (while remaining
        (aset (car remaining) 1 (or (cadr remaining) (car nodes)))
        (setq remaining (cdr remaining))))
    (car nodes)))
(defun qa192-mixed-ring (n label)
  (let ((nodes nil) (i 0))
    (while (< i n) (push (record 'mixed nil) nodes) (setq i (1+ i)))
    (let ((remaining nodes))
      (while remaining
        (aset (car remaining) 1 (vector (or (cadr remaining) (car nodes)) label))
        (setq remaining (cdr remaining))))
    (car nodes)))
(defun qa192-wrap-vector (value n)
  (dotimes (_ n) (setq value (vector value))) value)
(defun qa192-local-hash-keys (h)
  (let ((keys nil)) (maphash (lambda (k _v) (push k keys)) h) (nreverse keys)))

(defun qa192-same (a b)
  (let ((h (make-hash-table :test 'equal)))
    (puthash a 42 h)
    (let ((found (gethash b h 'missing)))
      (puthash b 43 h)
      (let ((copy (copy-hash-table h)))
        (list found (hash-table-count h) (gethash a h)
              (eq (car (qa192-local-hash-keys h)) a)
              (gethash b copy) (remhash b h) (hash-table-count h)
              (gethash a h 'missing) (gethash a copy))))))
(defun qa192-distinct (a b)
  (let ((h (make-hash-table :test 'equal)))
    (puthash a 42 h)
    (let ((missing (gethash b h 'missing)))
      (puthash b 43 h)
      (list missing (hash-table-count h) (gethash a h) (gethash b h)
            (remhash b h) (hash-table-count h) (gethash a h)))))

(qa (let* ((a (list 1)) (b (list 1))
           (h (make-hash-table :test 'equal)))
      (setcdr a a) (setcdr b b) (puthash a 42 h) (gethash b h)) 42)
(qa (qa192-same (qa192-cdr-ring '(1)) (qa192-cdr-ring '(1))) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (qa192-cdr-ring '(1)) (qa192-cdr-ring '(1 1))) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (qa192-cdr-ring '(1 2)) (qa192-cdr-ring '(1 2 1 2))) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (cons 1 (qa192-cdr-ring '(1))) (qa192-cdr-ring '(1))) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (qa192-car-ring 1 nil) (qa192-car-ring 2 nil)) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (qa192-vector-ring 1 7) (qa192-vector-ring 2 7)) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (qa192-record-ring 1 7) (qa192-record-ring 2 7)) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (qa192-mixed-ring 1 7) (qa192-mixed-ring 2 7)) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (vector (qa192-cdr-ring '(1 2))) (vector (qa192-cdr-ring '(1 2 1 2)))) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (qa192-cdr-ring (make-list 1009 1)) (qa192-cdr-ring (make-list 1013 1))) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (qa192-wrap-vector 1 200) (qa192-wrap-vector 1 200)) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (make-list 1000 1) (make-list 1000 1)) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (make-vector 1000 1) (make-vector 1000 1)) '(42 1 43 t 43 nil 0 missing 43))
(qa (qa192-same (cons (qa192-cdr-ring '(1)) "same") (cons (qa192-cdr-ring '(1 1)) (copy-sequence "same"))) '(42 1 43 t 43 nil 0 missing 43))
(qa (let ((a (qa192-vector-ring 1 7)))
      (qa192-same (vector a a)
                  (vector (qa192-vector-ring 1 7) (qa192-vector-ring 2 7))))
    '(42 1 43 t 43 nil 0 missing 43))

;; Different values can have the same bounded hash. Never merge them.
(qa (qa192-distinct (qa192-cdr-ring '(1 2)) (qa192-cdr-ring '(1 3))) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct (qa192-car-ring 1 7) (qa192-car-ring 1 8)) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct (qa192-vector-ring 1 7) (qa192-vector-ring 1 8)) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct (qa192-record-ring 1 7) (qa192-record-ring 1 8)) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct (qa192-mixed-ring 1 7) (qa192-mixed-ring 1 8)) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct '(1 1 1) (qa192-cdr-ring '(1))) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct '(1 1 . 1) (qa192-cdr-ring '(1))) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct (qa192-record-ring 1 7) (vector 'r (qa192-record-ring 1 7) 7)) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct (qa192-wrap-vector (qa192-vector-ring 1 7) 4) (qa192-wrap-vector (qa192-vector-ring 1 8) 4)) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct (qa192-cdr-ring (append (make-list 40 1) '(7))) (qa192-cdr-ring (append (make-list 40 1) '(8)))) '(missing 2 42 43 nil 1 42))
(qa (qa192-distinct (append (make-list 1000 1) '(7)) (append (make-list 1000 1) '(8))) '(missing 2 42 43 nil 1 42))
(qa (let ((a (make-vector 9 0)) (b (make-vector 9 0)))
      (aset a 7 a) (aset b 7 b) (aset a 8 7) (aset b 8 8)
      (list (= (sxhash-equal a) (sxhash-equal b)) (qa192-distinct a b)))
    '(t (missing 2 42 43 nil 1 42)))
(qa (let ((a (qa192-wrap-vector (qa192-vector-ring 1 7) 4))
          (b (qa192-wrap-vector (qa192-vector-ring 1 8) 4)))
      (= (sxhash-equal a) (sxhash-equal b))) t)

;; Eq/eql continue to use identity, not the structural fallback.
(qa (let ((h (make-hash-table :test 'eq))
          (a (qa192-cdr-ring '(1))) (b (qa192-cdr-ring '(1))))
      (puthash a 42 h) (puthash b 43 h)
      (list (hash-table-count h) (gethash a h) (gethash b h))) '(2 42 43))
(qa (let ((h (make-hash-table :test 'eql))
          (a (qa192-cdr-ring '(1))) (b (qa192-cdr-ring '(1))))
      (puthash a 42 h) (puthash b 43 h)
      (list (hash-table-count h) (gethash a h) (gethash b h))) '(2 42 43))


;; Mixed normalized/fallback entries, deletion, reuse, copy, and clear.
(qa (let* ((a (qa192-cdr-ring '(1))) (b (qa192-cdr-ring '(2)))
           (h (make-hash-table :test 'equal :size 1)))
      (puthash a 1 h) (puthash 'plain 2 h) (puthash b nil h)
      (remhash (qa192-cdr-ring '(1 1)) h)
      (puthash (qa192-cdr-ring '(3)) 3 h)
      (let ((copy (copy-hash-table h)))
        (list (hash-table-count h) (gethash 'plain h)
              (gethash (qa192-cdr-ring '(2 2)) h 'missing)
              (gethash (qa192-cdr-ring '(3 3)) h)
              (eq (clrhash h) h) (hash-table-count h)
              (hash-table-count copy) (gethash (qa192-cdr-ring '(3)) copy))))
    '(3 2 nil 3 t 0 3 3))

;; Original key retained by maphash, even after replacement and copying.
(qa (let* ((a (qa192-vector-ring 1 7)) (b (qa192-vector-ring 2 7))
           (h (make-hash-table :test 'equal)) (seen nil))
      (puthash a 42 h) (puthash b 43 h)
      (maphash (lambda (k v) (setq seen (list (eq k a) v))) h)
      seen) '(t 43))

;; The reader must insert through the same collision-checked path.
(qa (let ((h (read "#s(hash-table test equal data (#1=(1 . #1#) 42))")))
      (list (hash-table-count h) (gethash (qa192-cdr-ring '(1 1)) h))) '(1 42))
(qa (let ((h (read "#s(hash-table test equal data (#1=(1 . #1#) 42 #2=(1 1 . #2#) 43))")))
      (list (hash-table-count h) (gethash (qa192-cdr-ring '(1)) h))) '(1 43))
(qa (let* ((print-circle t) (h (make-hash-table :test 'equal)))
      (puthash (qa192-vector-ring 1 7) 42 h)
      (let ((copy (read (prin1-to-string h))))
        (list (hash-table-count copy) (gethash (qa192-vector-ring 2 7) copy)))) '(1 42))

;; Collision comparison signals GNU's depth error without modifying data.
(qa (let ((h (make-hash-table :test 'equal))
          (a (qa192-vector-ring 201 7)) (b (qa192-vector-ring 201 7)))
      (puthash a 42 h)
      (list (gethash a h)
            (condition-case err (gethash b h) (error err))
            (condition-case err (puthash b 43 h) (error err))
            (condition-case err (remhash b h) (error err))
            (hash-table-count h) (gethash a h)))
    '(42 (error "Stack overflow in equal") (error "Stack overflow in equal")
         (error "Stack overflow in equal") 1 42))
(qa (let ((h (make-hash-table :test 'equal))
          (a (qa192-wrap-vector 1 201)) (b (qa192-wrap-vector 1 201)))
      (puthash a 42 h)
      (list (gethash a h) (condition-case err (gethash b h) (error err))))
    '(42 (error "Stack overflow in equal")))

;; GNU's cyclic-list equality has directional edge cases. Hash first,
;; then compare query to stored key, in collision-chain order.
(defun qa192-asymmetric (wrapped reuse resize reverse)
  (let* ((a (qa192-cdr-ring '(0 1)))
         (b (list 0 1 0 1 0))
         (h (make-hash-table :test 'equal :size 2)))
    (setcdr (last b) (last b))
    (when wrapped
      (setq a (qa192-wrap-vector a 4) b (qa192-wrap-vector b 4)))
    (when reverse (let ((tmp a)) (setq a b b tmp)))
    (when reuse (puthash 'temporary 'temp h))
    (puthash a 'a h)
    (when reuse (remhash 'temporary h))
    (puthash b 'b h)
    (when resize (dotimes (n 8) (puthash n n h)))
    (list (hash-table-count h) (gethash a h) (gethash b h))))
(qa (qa192-asymmetric nil nil nil nil) '(2 a b))
(qa (qa192-asymmetric t nil nil nil) '(2 b b))
(qa (qa192-asymmetric t t nil nil) '(2 b b))
(qa (qa192-asymmetric t t t nil) '(10 a b))
(qa (qa192-asymmetric t nil nil t) '(1 b b))

;; Hashing special values inside cyclic keys preserves recursion depth.
;; Char-table defaults and overlay plists are kept outside their handles.
(qa (let* ((ct (make-char-table 'qa192)) (ov (make-overlay 1 1))
           (a (list ct ov)) (b (list ct ov)))
      (unwind-protect
          (progn (set-char-table-range ct nil ct)
                 (overlay-put ov 'qa192 ov)
                 (setcdr (last a) a) (setcdr (last b) b)
                 (qa192-same a b))
        (delete-overlay ov))) '(42 1 43 t 43 nil 0 missing 43))
(qa (let ((a (make-vector 5000 -170141183460469231731687303715884105728))
          (b (make-vector 5000 -170141183460469231731687303715884105728)))
      (qa192-same a b)) '(42 1 43 t 43 nil 0 missing 43))

(princ (qa--done))
