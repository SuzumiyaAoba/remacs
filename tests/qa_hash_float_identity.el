;;; -*- lexical-binding: nil; -*-
;; Issue #27: eq float keys use heap identity; eql keys compare values.
;; The runtime fix predates this report's resolution (b7b9e4a6).

(qa (let ((table (make-hash-table :test 'eq)))
      (puthash 1.5 'value table)
      (list (gethash 1.5 table) (gethash (+ 0.0 1.5) table))) '(nil nil))
(qa (let ((table (make-hash-table :test 'eq)))
      (puthash 1.5 'value table) (gethash 1.5 table)) nil)
(qa (let ((table (make-hash-table :test 'eql)))
      (puthash 1.5 'value table)
      (list (gethash 1.5 table) (gethash (+ 0.0 1.5) table))) '(value value))

;; A retained float object can be looked up: identity does not mean
;; floats are unusable keys. Exercise finite values, zeros, infinity, NaN.
(dolist (qa27-value '(1.5 -2.25 0.0 -0.0 1.0e+INF 0.0e+NaN))
  (qa (let ((table (make-hash-table :test 'eq)) (key qa27-value))
        (puthash key 'value table)
        (list (gethash key table) (hash-table-count table))) '(value 1))
  (qa (let ((table (make-hash-table :test 'eq)) (key qa27-value))
        (puthash key 'old table) (puthash key 'new table)
        (list (gethash key table) (hash-table-count table))) '(new 1)))

(qa (let ((table (make-hash-table :test 'eq))
          (one (+ 1.0 0.5)) (two (+ 1.0 0.5)))
      (puthash one 'one table) (puthash two 'two table)
      (list (eq one two) (equal one two) (hash-table-count table)
            (gethash one table) (gethash two table) (gethash (+ 1.0 0.5) table)))
    '(nil t 2 one two nil))
(qa (let ((table (make-hash-table :test 'eql))
          (one (+ 1.0 0.5)) (two (+ 1.0 0.5)))
      (puthash one 'one table) (puthash two 'two table)
      (list (hash-table-count table) (gethash one table) (gethash two table)))
    '(1 two two))
(qa (let ((table (make-hash-table :test 'eq)) (key (+ 1.0 0.5)))
      (puthash key 'value table)
      (remhash (+ 1.0 0.5) table)
      (list (hash-table-count table) (gethash key table))) '(1 value))
(qa (let ((table (make-hash-table :test 'eq)) (key (+ 1.0 0.5)))
      (puthash key 'value table) (remhash key table)
      (list (hash-table-count table) (gethash key table 'absent))) '(0 absent))
(qa (let ((table (make-hash-table :test 'eq)) (key (+ 1.0 0.5)) (seen nil))
      (puthash key 'value table)
      (maphash (lambda (stored value) (setq seen (list (eq stored key) value))) table)
      seen) '(t value))
(qa (let* ((table (make-hash-table :test 'eq)) (key (+ 1.0 0.5)))
      (puthash key 'value table)
      (let ((copy (copy-hash-table table)))
        (list (gethash key copy) (gethash (+ 1.0 0.5) copy) (hash-table-count copy))))
    '(value nil 1))
(qa (let ((table (make-hash-table :test 'eq)) (key (+ 1.0 0.5)))
      (puthash key nil table)
      (list (gethash key table 'absent) (gethash (+ 1.0 0.5) table 'absent)))
    '(nil absent))
(qa (let ((table (make-hash-table :test 'eq)) (key (+ 1.0 0.5)))
      (puthash key 'value table) (garbage-collect) (gethash key table)) 'value)
(qa (let ((table (make-hash-table :test 'eq)) (key (+ 1.0 0.5)))
      (puthash key 'value table) (clrhash table)
      (list (hash-table-count table) (gethash key table 'absent))) '(0 absent))

;; The identity/value distinction still applies alongside integer keys.
(dolist (qa27-test '(eq eql equal))
  (qa (let ((table (make-hash-table :test qa27-test)) (float (+ 1.0 0.0)))
        (puthash 1 'integer table) (puthash float 'float table)
        (list (gethash 1 table) (gethash float table) (hash-table-count table)))
      '(integer float 2)))

(princ (qa--done)) (terpri)
