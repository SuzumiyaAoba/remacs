;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "locals:change-major-hook" '(with-temp-buffer (let ((seen nil)) (setq-local audit-r2-local 7) (add-hook 'change-major-mode-hook (lambda () (push (list audit-r2-local major-mode) seen)) nil t) (kill-all-local-variables) seen)))
(audit-check "locals:permanent-local-hook" '(let ((fn (make-symbol "audit-r2-permanent"))) (fset fn (lambda () nil)) (put fn 'permanent-local-hook t) (with-temp-buffer (add-hook 'after-save-hook fn nil t) (kill-all-local-variables) (list (local-variable-p 'after-save-hook) (and (memq fn after-save-hook) t)))))
(audit-check "locals:permanent-hook-filter" '(let ((a (make-symbol "audit-r2-permanent")) (b (make-symbol "audit-r2-ordinary"))) (fset a (lambda () nil)) (fset b (lambda () nil)) (put a 'permanent-local-hook t) (with-temp-buffer (add-hook 'after-save-hook a nil t) (add-hook 'after-save-hook b nil t) (kill-all-local-variables) (list (and (memq a after-save-hook) t) (and (memq b after-save-hook) t)))))
(audit-check "locals:permanent-clear" '(with-temp-buffer (setq-local audit-r2-local 7) (put 'audit-r2-local 'permanent-local t) (kill-all-local-variables t) (local-variable-p 'audit-r2-local)))
(audit-check "locals:major-hook-error" '(with-temp-buffer (setq-local audit-r2-local 7) (add-hook 'change-major-mode-hook (lambda () (error "audit-stop")) nil t) (list (condition-case e (kill-all-local-variables) (error (car e))) (local-variable-p 'audit-r2-local))))
(audit-check "locals:makunbound-dynamic" '(progn (defvar audit-r2-var 1) (list (let ((audit-r2-var 2)) (makunbound 'audit-r2-var) (boundp 'audit-r2-var)) audit-r2-var)))
(audit-check "locals:set-default-dynamic" '(progn (defvar audit-r2-var 1) (list (let ((audit-r2-var 2)) (set-default 'audit-r2-var 3) audit-r2-var) audit-r2-var)))
(audit-check "locals:kill-local-dynamic" '(progn (defvar audit-r2-var 1) (with-temp-buffer (setq-local audit-r2-var 10) (list (let ((audit-r2-var 20)) (kill-local-variable 'audit-r2-var) (list audit-r2-var (local-variable-p 'audit-r2-var))) audit-r2-var (local-variable-p 'audit-r2-var)))))
(audit-check "locals:default-after-kill-buffer" '(progn (defvar audit-r2-var 1) (let ((b (generate-new-buffer " *audit-r2-local*"))) (with-current-buffer b (setq-local audit-r2-var 10) (let ((audit-r2-var 20)) (kill-buffer b))) audit-r2-var)))
(audit-check "locals:kill-buffer-query-local" '(let ((b (generate-new-buffer " *audit-r2-query*"))) (unwind-protect (progn (with-current-buffer b (setq-local kill-buffer-query-functions (list (lambda () nil)))) (list (kill-buffer b) (buffer-live-p b))) (with-current-buffer b (setq kill-buffer-query-functions nil)) (kill-buffer b))))
(audit-check "locals:kill-buffer-hook-local" '(let ((b (generate-new-buffer " *audit-r2-kill*")) (seen nil)) (with-current-buffer b (add-hook 'kill-buffer-hook (lambda () (setq seen (eq (current-buffer) b))) nil t)) (kill-buffer b) seen))
(audit-check "locals:buffer-local-toplevel" '(progn (defvar audit-r2-var 1) (with-temp-buffer (setq-local audit-r2-var 10) (let ((audit-r2-var 20)) (list audit-r2-var (buffer-local-toplevel-value 'audit-r2-var (current-buffer)))))))
(audit-check "locals:case-table-after-kill" '(with-temp-buffer (set-case-table (copy-case-table (standard-case-table))) (kill-all-local-variables) (eq (current-case-table) (standard-case-table))))
(audit-check "locals:default-directory-preserved" '(with-temp-buffer (setq default-directory "/tmp/") (kill-all-local-variables) default-directory))
(audit-check "locals:permanent-local-value" '(with-temp-buffer (setq-local audit-r2-local 7) (put 'audit-r2-local 'permanent-local t) (kill-all-local-variables) (list audit-r2-local (local-variable-p 'audit-r2-local))))
(princ "AUDIT-DONE\n")
