;;; -*- lexical-binding: nil; -*-
;; Issue #20: each expectation verified against GNU Emacs 31.1.

(qa-err-data (buffer-local-boundp 'qa20-missing nil) 'wrong-type-argument '(bufferp nil))
(qa-err-data (string-search "a" "abc" -1) 'args-out-of-range '(-1))
(qa-err-data (string-search "a" "abc" 4) 'args-out-of-range '(4))
(qa-err-data (string-search "" "" -1) 'args-out-of-range '(-1))
(qa-err-data (string-search "a" "abc" 1.5) 'wrong-type-argument '(fixnump 1.5))
(qa-err-data (string-search "a" "abc" 'x) 'wrong-type-argument '(fixnump x))
(qa (string-search "" "abc" 3) 3)

;; Byte comparison uses Emacs string storage, including unibyte and
;; multibyte raw-byte characters, rather than Rust's proxy UTF-8 bytes.
(qa (string-distance "日" "日本") 1)
(qa (string-distance "日" "日本" t) 3)
(qa (string-distance "" "日本" t) 6)
(qa (string-distance "é" "e") 1)
(qa (string-distance "é" "e" t) 2)
(qa (string-distance "kitten" "sitting" t) 3)
(qa (string-distance (unibyte-string 255) "" t) 1)
(qa (string-distance (string 4194303) "" t) 2)
(qa (string-distance (string #xd800) "" t) 3)
(qa (string-distance (string #x200000) "" t) 5)
(qa (string-distance (unibyte-string 255) (string 4194303)) 1)
(qa (string-distance (unibyte-string 255) (string 4194303) t) 2)
(qa (string-distance (propertize "abc" 'face 'bold) "abc" t) 0)
(qa-err-data (string-distance nil "") 'wrong-type-argument '(stringp nil))
(qa-err-data (string-distance "" 2 t) 'wrong-type-argument '(stringp 2))

(dolist (function '(round truncate floor ceiling))
  (dolist (number '(1.0e+INF -1.0e+INF 0.0e+NaN))
    (qa (condition-case err (funcall function number) (error err)) '(overflow-error))))
(qa (round 2.5) 2)
(qa (round 3.5) 4)
(qa (floor -2.5) -3)
(qa (ceiling -2.5) -2)

;; The current GNU source also retains this progn; the older report's
;; stripped expansion was not the 31.1 -Q behavior.
(qa (macroexpand-all '(defun qa20-expanded () (with-suppressed-warnings ((a)) (g))))
    '(defalias 'qa20-expanded #'(lambda nil (progn (g)))))
(qa-err (func-arity (eval '(lambda (a &optional (b 2) &rest r) a) t)) 'invalid-function)
(qa (interactive-form 'find-file)
    '(interactive (byte-code "\300\301\302 \"\207"
                            [find-file-read-args "Find file: " confirm-nonexistent-file-or-buffer] 3)))
(qa (let ((read-function (symbol-function 'find-file-read-args))
          (confirm-function (symbol-function 'confirm-nonexistent-file-or-buffer))
          (calls nil))
      (unwind-protect
          (progn
            (fset 'confirm-nonexistent-file-or-buffer
                  (lambda () (push 'confirmed calls) 'must-exist))
            (fset 'find-file-read-args
                  (lambda (prompt match) (push (list prompt match) calls) '("chosen")))
            (list (eval (cadr (interactive-form 'find-file))) (reverse calls)))
        (fset 'find-file-read-args read-function)
        (fset 'confirm-nonexistent-file-or-buffer confirm-function)))
    '(("chosen") (confirmed ("Find file: " must-exist))))

(qa (coding-system-p nil) t)
(qa (mapcar #'coding-system-p
            '(emacs-internal emacs-internal-unix emacs-internal-dos emacs-internal-mac
              binary-dos unix-unix utf-8-unix-dos utf-8-dos shift_jis-mac))
    '(t nil nil nil nil nil nil t t))
(qa-err-data (coding-system-base 'emacs-internal-unix)
             'coding-system-error '(emacs-internal-unix))
(qa (coding-system-base 'emacs-internal) 'utf-8-emacs)
(qa (coding-system-change-eol-conversion 'shift_jis 'mac) 'japanese-shift-jis-mac)
(qa (coding-system-change-text-conversion 'utf-8-dos 'iso-8859-1) 'iso-latin-1-dos)
(qa (let* ((plist (coding-system-plist 'utf-8))
           (length-before (length plist)))
      (coding-system-put 'utf-8 :qa20-first 7)
      (coding-system-put 'utf-8 :qa20-second 8)
      (coding-system-put 'utf-8 :qa20-first 9)
      (list (eq plist (coding-system-plist 'utf-8))
            (- (length plist) length-before)
            (last plist 4) (coding-system-get 'utf-8 :qa20-first)))
    '(t 4 (:qa20-first 9 :qa20-second 8) 9))
(qa (unencodable-char-position nil nil 'iso-8859-1 2 "日本") '(0 1))
(qa (unencodable-char-position nil nil 'iso-8859-1 nil "a日b本") 1)
(qa (unencodable-char-position -2 -1 'iso-8859-1 2 "日本語") '(1))
(qa (unencodable-char-position nil -1 'iso-8859-1 2 "日本語") '(0 1))
(qa (unencodable-char-position 1 nil 'iso-8859-1 2 "日本語") '(1 2))
(qa (unencodable-char-position nil nil 'iso-8859-1 0 "日本") '(0 1))
(qa (unencodable-char-position nil nil 'iso-8859-1 -1 "abc") nil)
(qa-err-data (unencodable-char-position nil nil 'iso-8859-1 -1 "日")
             'wrong-type-argument '(wholenump -1))
(qa (unencodable-char-position nil nil nil 2 "日本") '(0 1))
(qa (unencodable-char-position nil nil 'iso-8859-1 2 (unibyte-string 255)) nil)
(qa (unencodable-char-position 'bad 'bounds 'raw-text 'count 'string) nil)
(qa-err-data (unencodable-char-position -4 nil 'iso-8859-1 2 "日本")
             'args-out-of-range '("日本" -4 nil))
(qa-err-data (unencodable-char-position nil 1.5 'iso-8859-1 2 "日本")
             'wrong-type-argument '(integerp 1.5))
(qa (encode-coding-char ?é 'us-ascii) nil)
(qa (encode-coding-char ?日 'undecided) nil)
(qa (encode-coding-char 4194303 'utf-8) nil)

;; The meeting tail depends on the traversal's starting point.
(dolist (function '(length reverse))
  (qa (let ((source (list 1 2 3)))
        (setcdr (cddr source) source)
        (unwind-protect
            (condition-case err (funcall function source)
              (circular-list (list (eq (cadr err) (cddr source)) (car (cadr err)))))
          (setcdr (cddr source) nil)))
      '(t 3)))
(dolist (function '(copy-sequence copy-alist))
  (qa (let ((source (list 1 2 3)))
        (setcdr (cddr source) source)
        (unwind-protect
            (condition-case err (funcall function source)
              (circular-list (eq (cadr err) source)))
          (setcdr (cddr source) nil))) t))
(qa (let ((source (list 1 2 3)))
      (setcdr (cddr source) source)
      (condition-case err (nreverse source)
        (circular-list (list (eq (cadr err) source) source)))) '(t (1)))
(qa (let ((source (list 1 2 3)))
      (setcdr (cddr source) (cdr source))
      (condition-case err (nreverse source)
        (circular-list (list (eq (cadr err) source) source)))) '(t (1)))
(qa (let ((source (list 1)))
      (setcdr source source)
      (unwind-protect
          (condition-case err (nreverse source)
            (circular-list (and (eq (cadr err) source) (eq (cdr source) source))))
        (setcdr source nil))) t)
(qa (let ((source (list 1 2 3)))
      (setcdr (cddr source) 'tail)
      (condition-case err (nreverse source) (wrong-type-argument err)))
    '(wrong-type-argument listp (1)))
(qa (nreverse '(1 2 3)) '(3 2 1))

;; A bare defvar is part of a trivial closure's printed environment.
(qa-prin1 (eval '(progn (defvar qa20-dynamic) (lambda () qa20-dynamic)) t)
          "#[nil (qa20-dynamic) (qa20-dynamic t)]")
(qa-prin1
 (eval '(progn (defvar qa20-arity-special)
               (fset 'qa20-arity-f (lambda (a b) a))
               (condition-case err (macroexpand-1 '(when x) '((when . qa20-arity-f)))
                 (wrong-number-of-arguments err))) t)
 "(wrong-number-of-arguments #[(a b) (a) (qa20-arity-special t)] 1)")
(qa (let ((print-circle t)) (prin1-to-string (read-from-string "#1='(a . #1#)")))
    "(#1='(a . #1#) . 13)")
(qa-err-data (read "#^[]") 'invalid-read-syntax '("Invalid size char-table"))
(qa-err-data (read "?\\u{41}") 'error '("Non-hex character used for Unicode escape: { (123)"))
(qa-err-data (read "?\\u00g0") 'error '("Non-hex character used for Unicode escape: g (103)"))

(princ (qa--done)) (terpri)
