;;; -*- lexical-binding: t -*-
;;; Buffer history, GNU window.el command dispatch and selection semantics.
(setq inhibit-message t)
(qa (fboundp 'window-normalize-buffer-to-switch-to) t)
(qa (fboundp 'help--docstring-quote) t)
(defvar qbh-a (get-buffer-create "qbh-a"))
(defvar qbh-b (get-buffer-create "qbh-b"))
(defvar qbh-c (get-buffer-create "qbh-c"))
(defvar qbh-hidden (get-buffer-create " qbh-hidden"))
(defvar qbh-frame (selected-frame))
(defvar qbh-window (selected-window))
(defun qbh-names (list)
  (delq nil (mapcar (lambda (b) (and (memq b (list qbh-a qbh-b qbh-c qbh-hidden)) (buffer-name b))) list)))
(defun qbh-order (&optional frame) (qbh-names (buffer-list frame)))
(defun qbh-visited () (qbh-names (frame-parameter nil 'buffer-list)))
(defun qbh-buried () (qbh-names (frame-parameter nil 'buried-buffer-list)))
(qa (qbh-order) '("qbh-a" "qbh-b" "qbh-c" " qbh-hidden"))
(qa (qbh-visited) nil)
(qa (qbh-buried) nil)
(qa (progn (set-buffer qbh-c) (qbh-order)) '("qbh-a" "qbh-b" "qbh-c" " qbh-hidden"))
(qa (progn (switch-to-buffer qbh-a) (qbh-visited)) '("qbh-a"))
(qa (progn (switch-to-buffer qbh-b) (qbh-order)) '("qbh-b" "qbh-a" "qbh-c" " qbh-hidden"))
(qa (qbh-visited) '("qbh-b" "qbh-a"))
(qa (progn (switch-to-buffer qbh-c) (qbh-order)) '("qbh-c" "qbh-b" "qbh-a" " qbh-hidden"))
(qa (qbh-visited) '("qbh-c" "qbh-b" "qbh-a"))
(qa (progn (set-buffer qbh-a) (qbh-visited)) '("qbh-c" "qbh-b" "qbh-a"))
(qa (buffer-name (other-buffer qbh-b t)) "qbh-c")
(qa (buffer-name (other-buffer "qbh-c" t)) "qbh-c")
(qa (buffer-name (other-buffer nil t)) "qbh-c")
(qa (buffer-name (other-buffer 42 t)) "qbh-c")
(qa (buffer-name (other-buffer qbh-c t)) "qbh-b")
(qa (buffer-name (other-buffer nil nil)) "qbh-b")
(qa (progn (bury-buffer qbh-b) (qbh-order)) '("qbh-c" "qbh-a" " qbh-hidden" "qbh-b"))
(qa (qbh-visited) '("qbh-c" "qbh-a"))
(qa (qbh-buried) '("qbh-b"))
(qa (buffer-name (last-buffer nil t)) "qbh-b")
(qa (progn (bury-buffer qbh-a) (qbh-buried)) '("qbh-a" "qbh-b"))
(qa (qbh-order qbh-frame) '("qbh-c" " qbh-hidden" "qbh-b" "qbh-a"))
(qa (buffer-name (last-buffer nil t)) "qbh-a")
(qa (buffer-name (last-buffer qbh-a t)) "qbh-b")
(qa (buffer-name (last-buffer "qbh-a" t)) "qbh-a")
(qa (progn (switch-to-buffer qbh-b) (qbh-buried)) '("qbh-a"))
(qa (qbh-visited) '("qbh-b" "qbh-c"))
(qa (progn (switch-to-buffer qbh-a t) (qbh-visited)) '("qbh-b" "qbh-c"))
(qa (qbh-buried) '("qbh-a"))
(qa (qbh-order) '("qbh-b" "qbh-c" " qbh-hidden" "qbh-a"))
(qa (progn (select-window qbh-window) (qbh-visited)) '("qbh-a" "qbh-b" "qbh-c"))
(qa (qbh-buried) nil)
;; Merely displaying and setting current buffer don't record selection.
(defvar qbh-saved-order (buffer-list))
(defvar qbh-saved-visited (frame-parameter nil 'buffer-list))
(qa (progn (set-window-buffer nil qbh-c) (equal (buffer-list) qbh-saved-order)) t)
(qa (equal (frame-parameter nil 'buffer-list) qbh-saved-visited) t)
(qa (progn (set-buffer qbh-b) (equal (buffer-list) qbh-saved-order)) t)
;; NORECORD is any non-nil value and leaves use-time untouched.
(defvar qbh-use (window-use-time))
(qa (progn (select-window qbh-window t) (= qbh-use (window-use-time))) t)
(qa (progn (select-window qbh-window 'mark-for-redisplay) (= qbh-use (window-use-time))) t)
(qa (equal (buffer-list) qbh-saved-order) t)
(qa (progn (select-window qbh-window) (> (window-use-time) qbh-use)) t)
(qa (car (qbh-visited)) "qbh-c")
;; Frame arguments and predicate dispatch.
(qa (equal (buffer-list 42) (buffer-list)) t)
(qa (equal (buffer-list t) (buffer-list)) t)
(qa (equal (buffer-list "no frame") (buffer-list)) t)
(qa-err (other-buffer nil nil 42) 'wrong-type-argument)
(qa-err (last-buffer nil nil 42) 'wrong-type-argument)
(modify-frame-parameters nil '((buffer-predicate . (lambda (b) (eq b qbh-a)))))
(qa (buffer-name (other-buffer nil t)) "qbh-a")
(qa (buffer-name (last-buffer nil t)) "qbh-a")
(qa (buffer-name (other-buffer qbh-a t)) "*scratch*")
(qa (buffer-name (last-buffer qbh-a t)) "*scratch*")
(modify-frame-parameters nil '((buffer-predicate . (lambda (_b) (error "qbh predicate")))))
(qa-err (other-buffer nil t) 'error)
(qa-err (last-buffer nil t) 'error)
(modify-frame-parameters nil '((buffer-predicate)))
(modify-frame-parameters nil '((buffer-predicate . (lambda (b) (eq b qbh-c)))))
(qa (buffer-name (other-buffer nil nil)) "qbh-c")
(qa (buffer-name (last-buffer nil nil)) "*scratch*")
(qa (buffer-name (last-buffer nil t)) "qbh-c")
;; Hidden names remain excluded even when visible buffers are allowed.
(modify-frame-parameters nil '((buffer-predicate . (lambda (b) (eq b qbh-hidden)))))
(qa (buffer-name (other-buffer nil t)) "*scratch*")
(qa (buffer-name (last-buffer nil t)) "*scratch*")
(modify-frame-parameters nil '((buffer-predicate)))
;; Frame lists are filtered, independently settable, and composed in order.
(modify-frame-parameters nil (list (cons 'buffer-list (list qbh-a 42 qbh-c)) (cons 'buried-buffer-list (list qbh-b "qbh-a"))))
(qa (qbh-visited) '("qbh-a" "qbh-c"))
(qa (qbh-buried) '("qbh-b"))
(qa (qbh-order qbh-frame) '("qbh-a" "qbh-c" " qbh-hidden" "qbh-b"))
(qa (buffer-name (other-buffer nil t)) "qbh-a")
(qa (buffer-name (last-buffer nil t)) "qbh-b")
;; Kill removes both histories, and dead-buffer burial is harmless.
(qa (progn (kill-buffer qbh-b) (qbh-buried)) nil)
;; GNU 31.1 crashes on bury-buffer-internal of a dead buffer; keep remacs safe.
(when qa--remacs (qa (bury-buffer-internal qbh-b) nil))
(qa-err (bury-buffer-internal "qbh-a") 'wrong-type-argument)
(qa-err (bury-buffer qbh-b) 'error)
(qa-err (bury-buffer "qbh-does-not-exist") 'error)
(qa (progn (kill-buffer qbh-a) (qbh-visited)) '("qbh-c"))
;; Lisp dispatch must respect redefinitions rather than bypassing commands.
(defvar qbh-old-last (symbol-function 'last-buffer))
(defvar qbh-old-switch (symbol-function 'switch-to-buffer))
(fset 'last-buffer (lambda (&rest _) 'qbh-sentinel))
(fset 'switch-to-buffer (lambda (buffer &rest _) buffer))
(qa (unbury-buffer) 'qbh-sentinel)
(fset 'last-buffer qbh-old-last)
(fset 'switch-to-buffer qbh-old-switch)
;; Hook failures propagate after the history mutation.
(switch-to-buffer qbh-c)
(let ((buffer-list-update-hook (list (lambda () (error "qbh hook")))))
  (qa-err (bury-buffer-internal qbh-c) 'error))
(qa (qbh-buried) '("qbh-c"))
(let ((buffer-list-update-hook (list (lambda () (error "qbh hook")))))
  (qa-err (select-window qbh-window) 'error))
(qa (qbh-visited) '("qbh-c"))
(qa (qbh-buried) nil)
;; A no-argument bury removes current buffer from its selected window.
(qa (progn (bury-buffer) (eq (window-buffer) qbh-c)) nil)
(qa (eq (current-buffer) (window-buffer)) t)
(qa (progn (unbury-buffer) (buffer-name)) "qbh-c")
(kill-buffer qbh-c)
(kill-buffer qbh-hidden)


;; Window integration regressions.
;;; -*- lexical-binding: t -*-
(setq inhibit-message t)
(defvar qeh-a (get-buffer-create "qeh-a"))
(defvar qeh-b (get-buffer-create "qeh-b"))
(defvar qeh-hidden (get-buffer-create " qeh-hidden"))
(dolist (b (list qeh-a qeh-b qeh-hidden))
  (with-current-buffer b (erase-buffer) (insert "012345678901234567890123456789")))
(delete-other-windows)
(switch-to-buffer qeh-a)
(goto-char 9)
(select-window (selected-window))
(qa (point) 9)
(select-window (selected-window) t)
(qa (point) 9)
(with-current-buffer qeh-b (goto-char 17))
(set-window-buffer nil qeh-b)
(qa (eq (current-buffer) qeh-a) t)
(qa (point) 9)
(qa (window-point) 17)
(select-window (selected-window) t)
(qa (point) 17)
;; KEEP-MARGINS preserves window point/scroll only when buffer unchanged.
(defvar qeh-w1 (selected-window))
(defvar qeh-w2 (split-window qeh-w1 nil 'right))
(set-window-point qeh-w2 5)
(set-window-buffer qeh-w2 qeh-b t)
(qa (window-point qeh-w2) 5)
(set-window-buffer qeh-w2 qeh-b)
(qa (window-point qeh-w2) 17)
(set-window-point qeh-w2 5)
(select-window qeh-w2 t)
(qa (point) 5)
(qa (window-point qeh-w1) 17)
(select-window qeh-w1 t)
(qa (point) 17)
(qa (window-point qeh-w2) 5)
;; Outgoing buffer start is reused when subsequently displayed elsewhere.
(set-window-start qeh-w2 4)
(set-window-buffer qeh-w2 qeh-a)
(set-window-buffer qeh-w2 qeh-b)
(qa (window-start qeh-w2) 4)
;; GNU record-window-buffer owns next-history and insignificant filtering.
(set-window-buffer qeh-w2 qeh-hidden)
(set-window-prev-buffers qeh-w2 nil)
(set-window-next-buffers qeh-w2 (list qeh-a))
(set-window-buffer qeh-w2 qeh-b)
(qa (window-prev-buffers qeh-w2) nil)
(qa (window-next-buffers qeh-w2) nil)
(set-window-buffer qeh-w2 qeh-a)
(set-window-next-buffers qeh-w2 (list qeh-b qeh-a))
(set-window-buffer qeh-w2 qeh-a t)
(qa (window-next-buffers qeh-w2) (list qeh-b))
;; Recording a known previous buffer updates the existing markers.
(set-window-buffer qeh-w2 qeh-b)
(defvar qeh-entry (assq qeh-a (window-prev-buffers qeh-w2)))
(set-window-buffer qeh-w2 qeh-a)
(set-window-prev-buffers qeh-w2 (list qeh-entry))
(set-window-point qeh-w2 13)
(set-window-buffer qeh-w2 qeh-b)
(qa (eq (nth 1 qeh-entry) (nth 1 (assq qeh-a (window-prev-buffers qeh-w2)))) t)
(qa (marker-position (nth 2 qeh-entry)) 13)
;; Cyclic enumeration starts at selected, not the frame's first leaf.
(defvar qeh-w3 (split-window qeh-w2 nil 'below))
(set-window-buffer qeh-w1 qeh-a)
(set-window-buffer qeh-w2 qeh-b)
(set-window-buffer qeh-w3 qeh-a)
(select-window qeh-w2 t)
(qa (eq (get-buffer-window qeh-a) qeh-w3) t)
(qa (get-buffer-window-list qeh-a) (list qeh-w3 qeh-w1))
;; Configuration restore explicitly advances selected-window use-time.
(defvar qeh-config (current-window-configuration))
(defvar qeh-use (window-use-time qeh-w2))
(select-window qeh-w1 t)
(set-window-configuration qeh-config)
(qa (eq (selected-window) qeh-w2) t)
(qa (> (window-use-time qeh-w2) qeh-use) t)
;; Frame parameter setters preserve duplicates and ignore non-list tails.
(set-frame-parameter nil 'buffer-list (cons qeh-a (cons 7 (cons qeh-a 'tail))))
(qa (frame-parameter nil 'buffer-list) (list qeh-a qeh-a))
(qa (cdr (assq 'buffer-list (frame-parameters))) (list qeh-a qeh-a))


(delete-other-windows)
(dolist (buffer (list qeh-a qeh-b qeh-hidden)) (kill-buffer buffer))
(delete-other-windows)
(defvar qls-a (get-buffer-create "qls-a"))
(defvar qls-b (get-buffer-create "qls-b"))
(defvar qls-c (get-buffer-create "qls-c"))
(with-current-buffer qls-a (insert "012345678901234567890123456789"))
(switch-to-buffer qls-a)
(goto-char 17)
(defvar qls-w1 (selected-window))
(defvar qls-w2 (split-window qls-w1 nil 'right))
(defvar qls-w3 (split-window qls-w2 nil 'below))
(set-window-point qls-w2 5)
(set-window-buffer qls-w3 qls-b)
(select-window qls-w2 t)
(select-window qls-w3 t)
(set-window-buffer qls-w1 qls-c)
(qa (with-current-buffer qls-a (point)) 5)
(delete-other-windows)
(dolist (buffer (list qls-a qls-b qls-c)) (kill-buffer buffer))
;; C primitives do not dispatch their internal operations through redefined Lisp cells.
(defvar qbh-frame-parameter-fn (symbol-function 'frame-parameter))
(defvar qbh-get-window-fn (symbol-function 'get-buffer-window))
(fset 'frame-parameter (lambda (&rest _) (error "must not call Lisp frame-parameter")))
(qa (bufferp (other-buffer nil t)) t)
(fset 'frame-parameter qbh-frame-parameter-fn)
(fset 'get-buffer-window (lambda (&rest _) (error "must not call Lisp get-buffer-window")))
(qa (bufferp (other-buffer nil nil)) t)
(fset 'get-buffer-window qbh-get-window-fn)
;; Predicates may create a candidate during the frame-local search.
(defvar qbh-predicate-a (get-buffer-create "qbh-predicate-a"))
(defvar qbh-predicate-created nil)
(set-frame-parameter nil 'buffer-list (list qbh-predicate-a))
(set-frame-parameter nil 'buffer-predicate
                     (lambda (buffer)
                       (if (eq buffer qbh-predicate-a)
                           (progn (setq qbh-predicate-created
                                        (get-buffer-create "qbh-predicate-created")) nil)
                         (eq buffer qbh-predicate-created))))
(qa (buffer-name (other-buffer nil t)) "qbh-predicate-created")
(set-frame-parameter nil 'buffer-predicate nil)
(kill-buffer qbh-predicate-a)
(kill-buffer qbh-predicate-created)
;; Fallback conditions are suppressed, while nonlocal throws propagate.
(defvar qbh-scratch-fn (symbol-function 'get-scratch-buffer-create))
(set-frame-parameter nil 'buffer-predicate (lambda (_buffer) nil))
(fset 'get-scratch-buffer-create (lambda () (throw 'qbh-escape 77)))
(qa (catch 'qbh-escape (other-buffer nil t)) 77)
(fset 'get-scratch-buffer-create (lambda () (error "fallback error")))
(qa (other-buffer nil t) nil)
(fset 'get-scratch-buffer-create (lambda () (signal 'quit nil)))
(qa (condition-case nil (other-buffer nil t) (quit 'escaped)) nil)
(fset 'get-scratch-buffer-create qbh-scratch-fn)
(set-frame-parameter nil 'buffer-predicate nil)
;; Killing the selected buffer must use frame-local candidate order.
(defvar qkh-a (get-buffer-create "qkh-a"))
(defvar qkh-b (get-buffer-create "qkh-b"))
(defvar qkh-c (get-buffer-create "qkh-c"))
(switch-to-buffer qkh-a)
(switch-to-buffer qkh-b)
(set-window-prev-buffers nil nil)
(set-window-next-buffers nil nil)
(set-frame-parameter nil 'buffer-list (list qkh-c qkh-a qkh-b))
(qa (kill-buffer qkh-b) t)
(qa (eq (current-buffer) qkh-c) t)
(qa (eq (window-buffer) qkh-c) t)
(qa (frame-parameter nil 'buffer-list) (list qkh-c qkh-a))
(kill-buffer qkh-a)
(kill-buffer qkh-c)
;; Previous-window history wins over frame order, with the frame predicate applied.
(setq qkh-a (get-buffer-create "qkh-a") qkh-b (get-buffer-create "qkh-b") qkh-c (get-buffer-create "qkh-c"))
(switch-to-buffer qkh-a)
(switch-to-buffer qkh-b)
(set-frame-parameter nil 'buffer-list (list qkh-c qkh-a qkh-b))
(qa (kill-buffer qkh-b) t)
(qa (eq (current-buffer) qkh-a) t)
(qa (eq (window-buffer) qkh-a) t)
(setq qkh-b (get-buffer-create "qkh-b"))
(switch-to-buffer qkh-b)
(set-frame-parameter nil 'buffer-predicate (lambda (buffer) (eq buffer qkh-c)))
(qa (kill-buffer qkh-b) t)
(qa (eq (current-buffer) qkh-c) t)
(qa (eq (window-buffer) qkh-c) t)
;; Killing an unshown, noncurrent buffer doesn't run the frame predicate.
(defvar qkh-count 0)
(defvar qkh-unshown (get-buffer-create "qkh-unshown"))
(set-frame-parameter nil 'buffer-predicate (lambda (_buffer) (setq qkh-count (1+ qkh-count)) t))
(kill-buffer qkh-unshown)
(qa qkh-count 0)
(set-frame-parameter nil 'buffer-predicate nil)
(kill-buffer qkh-a)
(kill-buffer qkh-c)
(setq qkh-a (get-buffer-create "qkh-a") qkh-b (get-buffer-create "qkh-b"))
(switch-to-buffer qkh-a)
(switch-to-buffer qkh-b)
(let ((kill-buffer-quit-windows t)) (qa (kill-buffer qkh-b) t))
(qa (buffer-live-p qkh-b) nil)
(qa (eq (window-buffer) qkh-a) t)
(kill-buffer qkh-a)
(delete-other-windows)
(switch-to-buffer (get-buffer-create "qkh-dedicated"))
(split-window-right)
(set-window-dedicated-p nil t)
(qa (kill-buffer-and-window) nil)
(qa (length (window-list)) 1)
(qa (get-buffer "qkh-dedicated") nil)
(defvar qkh-dedicated-window (split-window-right))
(split-window-below)
(set-window-buffer qkh-dedicated-window (get-buffer-create "qkh-explicit-dedicated"))
(set-window-dedicated-p qkh-dedicated-window t)
(qa (progn (quit-window t qkh-dedicated-window) (window-live-p qkh-dedicated-window)) nil)
(qa (length (window-list)) 2)
(qa (get-buffer "qkh-explicit-dedicated") nil)
(delete-other-windows)
;; The loadup guard must not suppress missing helpers after initialization.
(defvar qkh-unrecord-fn (symbol-function 'unrecord-window-buffer))
(setq qkh-unshown (get-buffer-create "qkh-unshown"))
(fmakunbound 'unrecord-window-buffer)
(qa-err (kill-buffer qkh-unshown) 'void-function)
(qa (buffer-live-p qkh-unshown) t)
(fset 'unrecord-window-buffer qkh-unrecord-fn)
(kill-buffer qkh-unshown)
(princ (qa--done))
