;;; -*- lexical-binding: nil; -*-
;; VECTORS-AND-RECORDS traverses actual records (#468), not opaque types (#469).
(let* ((leaf (propertize "shared leaf" 'tag 'value))
       (inner (record 'inner (list leaf)))
       (source (record 'outer (list 'a inner) (vector inner)))
       (copy (copy-tree source t)))
  (qa (recordp copy) t)
  (qa copy source)
  (qa (eq source copy) nil)
  (qa (eq (aref source 1) (aref copy 1)) nil)
  (qa (eq (aref source 2) (aref copy 2)) nil)
  (let ((a (cadr (aref copy 1))) (b (aref (aref copy 2) 0)))
    (qa (recordp a) t)
    (qa (recordp b) t)
    (qa (eq a inner) nil)
    (qa (eq b inner) nil)
    (qa (eq a b) nil)
    (qa (eq (car (aref a 1)) leaf) t)
    (setcar (aref a 1) 'changed)
    (qa (car (aref inner 1)) leaf)
    (qa (car (aref b 1)) leaf))
  (qa (eq (copy-tree source) source) t)
  (qa (eq (copy-tree source nil) source) t)
  (qa (eq (copy-tree (cons 'head source)) source) nil)
  (qa (eq (cdr (copy-tree (cons 'head source))) source) t)
  (qa (eq (cdr (copy-tree (cons 'head source) t)) source) nil))
(dolist (value (list (bool-vector t nil) (make-char-table 'test)
                    (obarray-make) (current-window-configuration)))
  (qa (recordp value) nil)
  (qa (eq (copy-tree value t) value) t)
  (qa (eq (car (copy-tree (list value) t)) value) t)
  (qa (eq (aref (copy-tree (vector value) t) 0) value) t))
(qa (recordp (record 'test)) t)
(qa (recordp []) nil)
(qa (recordp '(test)) nil)
(qa (eq (copy-tree [] t) []) t)
;; Ordinary records can use the same tags and layouts as opaque types.
(dolist (value (list (record 'bool-vector [1 0])
                    (record 'char-table 'test (make-vector 65 nil))))
  (qa (recordp value) t)
  (qa (bool-vector-p value) nil)
  (qa (char-table-p value) nil)
  (qa (eq (copy-tree value t) value) nil)
  (qa (recordp (copy-sequence value)) t)
  (qa (recordp (read (prin1-to-string value))) t))
(dolist (value (list (bool-vector t) (make-char-table 'test)))
  (qa (recordp (copy-sequence value)) nil)
  (qa (recordp (read (prin1-to-string value))) nil))
(dolist (pair (list (cons (bool-vector t nil) (record 'bool-vector [1 0]))
                    (cons (make-char-table 'test) (record 'char-table 'test (make-vector 65 nil)))))
  (let ((opaque (car pair)) (ordinary (cdr pair)) (table (make-hash-table :test 'equal)))
    (qa (equal opaque ordinary) nil)
    (qa (equal ordinary opaque) nil)
    (puthash opaque 'opaque table)
    (puthash ordinary 'ordinary table)
    (qa (hash-table-count table) 2)
    (qa (gethash (copy-sequence opaque) table) 'opaque)
    (qa (gethash (copy-sequence ordinary) table) 'ordinary)))
(princ (qa--done))
