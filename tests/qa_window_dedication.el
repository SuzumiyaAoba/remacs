;;; -*- lexical-binding: nil; -*-
;; Issue #83: dedication flags retain their original Lisp identity.
(let* ((window (selected-window))
       (original (window-buffer window))
       (old-flag (window-dedicated-p window))
       (buffer (generate-new-buffer " *qa83-other*")))
  (unwind-protect
      (progn
        (dolist (flag (list nil t 'side 'display 'x 0 1 "weak" '(weak) [weak]))
          (qa (eq (set-window-dedicated-p window flag) flag) t)
          (qa (eq (window-dedicated-p window) flag) t)
          (qa (eq (window-dedicated-p) flag) t)
          ;; Reassigning the existing buffer must preserve dedication.
          (qa (set-window-buffer window original) nil)
          (qa (eq (window-dedicated-p window) flag) t)
          (let ((configuration (current-window-configuration)))
            (set-window-dedicated-p window nil)
            (set-window-configuration configuration)
            (qa (eq (window-dedicated-p window) flag) t))
          (let ((state (window-state-get window)))
            (qa (eq (cdr (assq 'dedicated (cddr (assq 'buffer state)))) flag) t)
            (set-window-dedicated-p window nil)
            (window-state-put state window)
            (qa (equal (window-dedicated-p window) flag) t))
          (if (eq flag t)
              (progn
                (qa-err (set-window-buffer window buffer) 'error)
                (qa (eq (window-buffer window) original) t)
                (qa (window-dedicated-p window) t))
            (qa (set-window-buffer window buffer) nil)
            (qa (window-dedicated-p window) nil)
            (set-window-buffer window original)))
        (dolist (flag (list nil t 'side 'display '(weak) [weak]))
          (set-window-dedicated-p window nil)
          (window--display-buffer original window 'window (list (cons 'dedicated flag)))
          (qa (eq (window-dedicated-p window) flag) t)
          (set-window-dedicated-p window nil)
          (let ((display-buffer-mark-dedicated flag))
            (window--display-buffer original window 'window nil)
            (qa (eq (window-dedicated-p window) flag) t)))
        (qa-err-data (set-window-dedicated-p 5 'x) 'wrong-type-argument '(window-live-p 5))
        (qa-err-data (window-dedicated-p 5) 'wrong-type-argument '(window-live-p 5)))
    (set-window-dedicated-p window nil)
    (set-window-buffer window original)
    (set-window-dedicated-p window old-flag)
    (kill-buffer buffer)))
;; The minibuffer is a live window and participates in configurations too.
(let* ((window (minibuffer-window)) (old (window-dedicated-p window)))
  (unwind-protect
      (dolist (flag (list nil t 'side '(weak)))
        (set-window-dedicated-p window flag)
        (let ((configuration (current-window-configuration)))
          (set-window-dedicated-p window nil)
          (set-window-configuration configuration)
          (qa (eq (window-dedicated-p window) flag) t)))
    (set-window-dedicated-p window old)))
(princ (qa--done))
