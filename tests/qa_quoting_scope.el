;;; -*- lexical-binding: nil -*-
;; C variable declarations must remain dynamic in lexical Lisp code.
(qa (special-variable-p 'text-quoting-style) t)
(qa (special-variable-p 'print-gensym-alist) nil)
(qa (boundp 'print-gensym-alist) nil)
(qa-lex (let ((print-gensym-alist '((x . 9))))
          (funcall (lambda () (boundp 'print-gensym-alist)))) nil)
(qa-lex (let ((print-gensym-alist '((x . 9))))
          (funcall (lambda () print-gensym-alist))) '((x . 9)))
(qa-lex (let ((text-quoting-style 'grave)) (format-message "a `%s' b" "x")) "a `x' b")
(qa-lex (let ((text-quoting-style 'straight)) (format-message "a `%s' b" "x")) "a 'x' b")
(qa-lex (let ((text-quoting-style 'curve)) (format-message "a `%s' b" "x")) "a ‘x’ b")
(qa-lex (let ((text-quoting-style 'curved)) (format-message "a `%s' b" "x")) "a ‘x’ b")
(qa-lex (let ((text-quoting-style 'grave)) (format-message "a \\`%s\\' b" "x")) "a \\`x\\' b")
(qa-lex (let ((text-quoting-style 'straight)) (format-message "a \\`%s\\' b" "x")) "a \\'x\\' b")
;; The variable's dynamic binding is visible across function boundaries.
(defun qa64-style () (text-quoting-style))
(defun qa64-message () (format-message "`%s'" "x"))
(qa-lex (let ((text-quoting-style 'grave)) (qa64-style)) 'grave)
(qa-lex (let ((text-quoting-style 'straight)) (qa64-style)) 'straight)
(qa-lex (let ((text-quoting-style 'curve)) (qa64-style)) 'curve)
(qa-lex (let ((text-quoting-style 'grave)) (qa64-message)) "`x'")
(qa-lex (let ((text-quoting-style 'straight)) (qa64-message)) "'x'")
(qa-lex (let* ((text-quoting-style 'grave)
              (first (qa64-message)))
          (list first (let ((text-quoting-style 'straight)) (qa64-message))
                (qa64-message))) '("`x'" "'x'" "`x'"))
(qa-lex (let ((text-quoting-style 'grave))
          (condition-case nil
              (let ((text-quoting-style 'straight)) (error "qa64"))
            (error nil))
          (qa64-message)) "`x'")
(qa-lex (let ((text-quoting-style 'grave))
          (catch 'qa64 (let ((text-quoting-style 'straight)) (throw 'qa64 nil)))
          (qa64-message)) "`x'")
;; Only the format's quotes are converted, not argument strings.
(qa-lex (let ((text-quoting-style 'straight)) (format-message "`%s'" "`x'")) "'`x''")
(qa-lex (let ((text-quoting-style 'curve)) (format-message "`%s'" "`x'")) "‘`x'’")
(qa-lex (let ((text-quoting-style 'straight)) (format "`%s'" "x")) "`x'")
(qa (eval (car (get 'text-quoting-style 'standard-value))) nil)
(qa (get 'text-quoting-style 'standard-value) '(nil))
(qa (get 'text-quoting-style 'custom-type) nil)
(qa (boundp 'cus-start--preload) nil)
(qa (special-variable-p 'cus-start--preload) nil)
(qa (get 'transient-mark-mode 'standard-value) '((not noninteractive)))
(qa (stringp temporary-file-directory) t)
(qa (file-name-absolute-p temporary-file-directory) t)
;; Runtime loading installs full customization metadata, without losing
;; the dynamic C-variable declaration or changing its saved default.
(load "cus-start" nil t)
(qa (car (get 'text-quoting-style 'custom-type)) 'choice)
(qa (get 'text-quoting-style 'standard-value) '(nil))
(qa (special-variable-p 'text-quoting-style) t)
(qa-lex (let ((text-quoting-style 'grave)) (qa64-message)) "`x'")
(qa (boundp 'cus-start--preload) nil)
(princ (qa--done)) (terpri)
