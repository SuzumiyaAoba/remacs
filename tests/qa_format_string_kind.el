;;; -*- lexical-binding: t; -*-
(defun qa-format-kind (format &rest arguments)
  (let ((value (apply #'format format arguments)))
    (list (multibyte-string-p value) (string-to-list value))))
(qa (let ((format (propertize (unibyte-string 255) 'tag t)))
      (list (eq (format format) format) (eq (format format 'unused) format))) '(t t))
(qa (let ((format (make-string 1 ?x t)))
      (list (eq (format format) format) (multibyte-string-p (format format)))) '(t t))
(qa (let ((source (propertize "plain" 'tag t)))
      (eq (format-message source) source)) t)
(qa (qa-format-kind "%s" (unibyte-string 255)) '(nil (255)))
(qa (qa-format-kind "%s" (make-string 1 ?x t)) '(t (120)))
(qa (qa-format-kind "%s" (string #x3fffff)) '(t (4194303)))
(qa (qa-format-kind "%S" (unibyte-string 255)) '(nil (34 92 51 55 55 34)))
(qa (qa-format-kind "%S" (make-string 1 ?x t)) '(nil (34 120 34)))
(qa (qa-format-kind "%S" (string #x3fffff)) '(nil (34 92 51 55 55 34)))
(qa (qa-format-kind "%c" #x3fffff) '(t (4194303)))
(qa (qa-format-kind "%s" "x" (make-string 1 ?x t)) '(nil (120)))
(qa (qa-format-kind "%.0s" (string #x3fffff)) '(t nil))
(qa (qa-format-kind "%2$s" (make-string 1 ?x t) "y") '(t (121)))
(qa (let ((format (make-string 2 ?s t)))
      (aset format 0 ?%) (qa-format-kind format "x")) '(nil (120)))
(qa (let ((source (make-string 1 ?x t)))
      (list (eq (format "%s" source) source)
            (multibyte-string-p (format "%sx" source))
            (multibyte-string-p (format "%d" 1 source)))) '(t t t))
(qa (let* ((source (make-string 2 ?x t)) (_ (aset source 0 ?#)) (_ (aset source 1 ?:))
           (symbol (read (concat source "qa-format-symbol"))))
      (multibyte-string-p (format "%s" symbol))) t)
(qa (let ((symbol (read "#:qa-format-symbol")))
      (multibyte-string-p (format "%S" symbol))) nil)
(qa (let* ((symbol (make-symbol "abc")) (tag (list 'tag)))
      (put-text-property 0 1 'qa tag (symbol-name symbol))
      (eq (get-text-property 0 'qa (format "%s" symbol)) tag)) t)
(qa (mapcar (lambda (byte)
               (string-to-list (format "%s" (unibyte-string byte))))
             (number-sequence 128 255))
    (mapcar #'list (number-sequence 128 255)))
(princ (qa--done)) (terpri)
