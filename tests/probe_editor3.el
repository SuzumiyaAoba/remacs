;; probe_editor3 — real executions of editor subrs (files, windows,
;; kill ring, regions, completion, syntax scanning)

;; ---- file operations on real files ----
(let ((f "/tmp/probe-e3-file.txt")
      (d "/tmp/probe-e3-dir"))
  (ignore-errors (delete-file f))
  (ignore-errors (make-directory d t))
  (write-region "hello\nworld\nline three\n" nil f nil 'quiet)
  (file-exists-p f)
  (file-readable-p f)
  (file-writable-p f)
  (file-regular-p f)
  (file-symlink-p f)
  (file-directory-p d)
  (file-executable-p "/bin/sh")
  (file-attributes f)
  (file-modes f)
  (file-newer-than-file-p f d)
  (file-name-absolute-p f)
  (file-name-directory f)
  (file-name-nondirectory f)
  (file-name-extension f)
  (file-name-sans-extension f)
  (file-name-base f)
  (file-name-as-directory d)
  (directory-file-name d)
  (file-name-concat d "inner.txt")
  (abbreviate-file-name f)
  (expand-file-name "x" d)
  (expand-file-name f)
  (substitute-in-file-name f)
  (file-name-all-completions "probe" "/tmp")
  (file-name-completion "probe-e3" "/tmp")
  (directory-files "/tmp" nil "^probe-e3")
  (directory-files-and-attributes "/tmp" nil "^probe-e3" t)
  (copy-file f "/tmp/probe-e3-copy.txt" t)
  (rename-file "/tmp/probe-e3-copy.txt" "/tmp/probe-e3-renamed.txt" t)
  (set-file-modes "/tmp/probe-e3-renamed.txt" 420)
  (set-file-times "/tmp/probe-e3-renamed.txt")
  (ignore-errors (make-temp-name "/tmp/probe-e3"))
  (delete-file "/tmp/probe-e3-renamed.txt")
  (with-temp-buffer
    (insert-file-contents f)
    (buffer-string))
  (with-temp-buffer
    (insert-file-contents-literally f)
    (buffer-string))
  (with-temp-buffer
    (set-visited-file-name f)
    (save-buffer)
    (write-file "/tmp/probe-e3-written.txt"))
  (write-region 1 3 f nil 'quiet)
  (append-to-file 1 4 f)
  (delete-file "/tmp/probe-e3-written.txt")
  (delete-file f)
  (delete-directory d))

