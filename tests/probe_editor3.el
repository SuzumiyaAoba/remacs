;; ---- kill ring / yank ----
(with-temp-buffer
  (insert "kill this text and more words here\n")
  (goto-char (point-min))
  (kill-word 1)
  (backward-kill-word 1)
  (kill-line)
  (goto-char (point-min))
  (copy-region-as-kill (point-min) (point-max))
  (yank)
  (current-kill 0)
  (current-kill 1 t)
  (rotate-yank-pointer 1)
  (yank-pop)
  (kill-new "probe-kill")
  (kill-append " more" nil)
  kill-ring
  (boundp 'kill-ring-yank-pointer)
  (ignore-errors (zap-to-char 1 ?x)))

;; ---- regions / mark ----
(with-temp-buffer
  (insert "Region Text Here\nsecond line\n")
  (goto-char (point-min))
  (push-mark (point-max))
  (activate-mark)
  (region-active-p)
  (region-beginning)
  (region-end)
  (upcase-region (point-min) (point-max))
  (downcase-region (point-min) (+ 4 (point-min)))
  (capitalize-region (point-min) (point-max))
  (upcase-word 1)
  (downcase-word 1)
  (capitalize-word 1)
  (deactivate-mark)
  (mark)
  (mark-marker)
  (set-mark (point-min))
  (goto-char (point-max))
  (exchange-point-and-mark)
  (delete-trailing-whitespace)
  (delete-horizontal-space)
  (delete-indentation)
  (count-words-region (point-min) (point-max))
  (count-words (point-min) (point-max)))

;; ---- completion ----
(let ((col '("alpha" "alpine" "beta" "gamma")))
  (try-completion "al" col)
  (try-completion "zzz" col)
  (try-completion "" col)
  (all-completions "al" col)
  (all-completions "" col)
  (test-completion "alpha" col)
  (test-completion "zzz" col)
  (completion-boundaries "al" col nil "pha")
  (all-completions "a" obarray)
  (apropos-internal "buffer")
  (apropos-internal "buf" #'commandp))

;; ---- documentation / key description ----
(documentation 'car)
(documentation 'cons t)
(documentation-property 'car 'variable-documentation)
(describe-key (kbd "C-n"))
(ignore-errors (describe-bindings))
(help-function-arglist 'let)
(single-key-description 65)
(single-key-description ?\C-a)
(text-char-description 65)
(text-char-description ?\C-a)
(key-description [?\C-x ?\C-f])
(key-description "\C-x\C-f")
(substitute-command-keys "\\[next-line]")
(substitute-command-keys "\\{global-map}")
(where-is-internal 'next-line)
(where-is-internal 'self-insert-command)
(this-command-keys)
(this-command-keys-vector)
(commandp 'next-line)
(commandp 'car)
(command-remapping 'self-insert-command)

;; ---- syntax scanning ----
(with-temp-buffer
  (insert "(a (b c) \"str ; x\" d) ; comment\n(e f)\n")
  (goto-char (point-min))
  (syntax-ppss)
  (syntax-ppss 8)
  (parse-partial-sexp (point-min) (point-max))
  (parse-partial-sexp (point-min) 8)
  (syntax-table)
  (syntax-table-p (syntax-table))
  (standard-syntax-table)
  (copy-syntax-table)
  (set-syntax-table (syntax-table))
  (char-syntax ?a)
  (char-syntax ?\s)
  (char-syntax ?\()
  (modify-syntax-entry ?x "w")
  (ignore-errors (matching-paren ?\()))
(with-temp-buffer
  (ignore-errors (emacs-lisp-mode))
  (insert "(defun f (x) \"doc\" (list x))\n;; c\n(let ((y 1)) y)\n")
  (goto-char (point-min))
  (ignore-errors (beginning-of-defun))
  (ignore-errors (end-of-defun))
  (ignore-errors (forward-list))
  (ignore-errors (backward-list))
  (ignore-errors (down-list))
  (ignore-errors (backward-up-list))
  (ignore-errors (up-list))
  (syntax-ppss))

;; ---- scrolling / display ----
(recenter)
(recenter 0)
;; GNU signals end-of-buffer/beginning-of-buffer when the scroll
;; cannot complete (scroll-error-top-bottom nil), so wrap them.
(ignore-errors (scroll-up 1))
(ignore-errors (scroll-down 1))
(ignore-errors (scroll-up-command 1))
(ignore-errors (scroll-down-command 1))
(scroll-other-window 1)
(scroll-left 1)
(scroll-right 1)
(what-line)
(what-cursor-position)
(line-number-at-pos)
(current-column)
(move-to-column 0)
(ignore-errors (beginning-of-visual-line))
(ignore-errors (end-of-visual-line))
(posn-at-point)
(posn-at-x-y 0 0)
(tabify 1 10)
(untabify 1 10)
(goto-line 1)
(track-mouse)

;; ---- misc commands ----
(digit-argument 4)
(universal-argument)
(negative-argument 2)
(prefix-numeric-value '(4))
(prefix-numeric-value 7)
(forward-line -1)
(with-temp-buffer (insert "ab") (goto-char 2) (transpose-chars 1))
(execute-extended-command 4)
(ignore-errors (call-interactively 'next-line))
(called-interactively-p 'interactive)
(interactive-p)
(command-execute 'ignore)
(condition-case e (read-number "n: " 5) (error e))
(condition-case e (read-string "s: " "def") (error e))
(condition-case e (read-variable 'next-line) (error e))
(condition-case e (read-regexp "re: ") (error e))

;; ---- shell command ----
(shell-command-to-string "echo probe")
(call-process "echo" nil nil nil "probe")
(call-process-region "a b c" nil "tr" nil nil nil "a-z" "A-Z")

;; ---- overlays ----
(with-temp-buffer
  (insert "overlay text here")
  (let ((ov (make-overlay 1 5)))
    (overlay-put ov 'face 'bold)
    (overlay-get ov 'face)
    (overlay-start ov)
    (overlay-end ov)
    (overlay-buffer ov)
    (overlayp ov)
    (move-overlay ov 2 6)
    (overlays-at 3)
    (overlays-in 1 10)
    (next-overlay-change 1)
    (previous-overlay-change 10)
    (overlay-properties ov)
    (delete-overlay ov))
  (remove-overlays))
