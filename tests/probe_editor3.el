  (window-width w)
  (window-body-width w)
  (window-edges w)
  (window-margins w)
  (window-hscroll w)
  (set-window-hscroll w 0)
  (window-minibuffer-p w)
  (window-dedicated-p w)
  (set-window-dedicated-p w nil)
  (window-parameter w 'test)
  (set-window-parameter w 'test 1)
  (window-parameter w 'test)
  (window-parameters w)
  (window-frame w)
  (window-at 1 1)
