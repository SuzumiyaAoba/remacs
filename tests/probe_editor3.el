(other-buffer)
(ignore-errors (next-buffer))
(ignore-errors (previous-buffer))
(last-buffer)
(selected-frame)
(framep (selected-frame))
(window-frame (selected-window))
(frame-first-window)
(frame-selected-window)
(select-frame (selected-frame))
(set-frame-selected-window (selected-frame) (selected-window))
(frame-parameters)
