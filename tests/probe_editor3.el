(ignore-errors (make-frame-invisible (selected-frame) t))
(make-frame-visible (selected-frame))
(lower-frame)
(raise-frame)
(frame-list)
(visible-frame-list)
(ignore-errors (frames-on-display-list))
(ignore-errors (frame-or-buffer-changed-p))
(selected-window)
(minibuffer-window)
