;;; -*- lexical-binding: t; -*-
;; Issue #106: validate first, then apply in reverse; report actual TTY
;; state for names/fonts, and preserve the frame's minibuffer ownership.
(defvar qa106-argument)
(defvar qa106-value)
(defvar qa106-saved-name)
(let ((qa106-saved-name (frame-parameter nil 'name)))
  (unwind-protect
      (progn
        (qa (modify-frame-parameters nil nil) nil)
        (dolist (qa106-argument '(bad 5 1.0 "x" [1]))
          (qa-err-data (modify-frame-parameters nil qa106-argument)
                       'wrong-type-argument (list 'listp qa106-argument)))
        (qa-err-data (modify-frame-parameters nil '(1)) 'wrong-type-argument '(listp 1))
        (qa-err-data (modify-frame-parameters nil '((qa106-unapplied . 1) . bad))
                     'wrong-type-argument '(listp bad))
        (qa-err-data (modify-frame-parameters nil '((qa106-unapplied . 1) 7))
                     'wrong-type-argument '(listp 7))
        (qa (frame-parameter nil 'qa106-unapplied) nil)
        (qa (let ((parameters (list '(qa106-unapplied . 1))))
              (setcdr parameters parameters)
              (condition-case error (modify-frame-parameters nil parameters)
                (circular-list (eq (cadr error) parameters)))) t)
        (qa (frame-parameter nil 'qa106-unapplied) nil)
        (qa (modify-frame-parameters nil '((qa106-duplicate . 1) (qa106-duplicate . 2))) nil)
        (qa (frame-parameter nil 'qa106-duplicate) 1)
        (qa (modify-frame-parameters nil '((42 . numeric) (nil . 3))) nil)
        (qa (assq 42 (frame-parameters)) '(42 . numeric))
        (qa (frame-parameter nil nil) 3)
        (qa (modify-frame-parameters nil '(nil)) nil)
        (qa (assq nil (frame-parameters)) '(nil))
        (qa (set-frame-parameter nil 42 'setter) nil)
        (qa (assq 42 (frame-parameters)) '(42 . setter))
        (qa-err-data (frame-parameter nil 42) 'wrong-type-argument '(symbolp 42))

        (qa (modify-frame-parameters nil '((name . "TEST"))) nil)
        (qa (frame-parameter nil 'name) "TEST")
        (qa (cdr (assq 'name (frame-parameters))) "TEST")
        (qa (string-match-p "#<frame TEST " (prin1-to-string (selected-frame))) 0)
        (qa-err-data (modify-frame-parameters nil '((name . 1))) 'wrong-type-argument '(stringp 1))
        (qa (frame-parameter nil 'name) "TEST")
        (qa (cdr (assq 'name (frame-parameters))) "TEST")
        (qa (condition-case error
                (modify-frame-parameters nil '((qa106-first . 1) (name . 5) (qa106-last . 3)))
              (wrong-type-argument
               (list error (frame-parameter nil 'qa106-first)
                     (frame-parameter nil 'qa106-last) (frame-parameter nil 'name))))
            '((wrong-type-argument stringp 5) nil 3 "TEST"))
        (qa (let ((name (propertize "properties" 'qa106 7)))
              (set-frame-parameter nil 'name name)
              (list (eq (frame-parameter nil 'name) name)
                    (eq (cdr (assq 'name (frame-parameters))) name)
                    (get-text-property 0 'qa106 (frame-parameter nil 'name)))) '(t t 7))
        (qa (let ((name (frame-parameter nil 'name)))
              (set-frame-parameter nil 'name (copy-sequence name))
              (eq name (frame-parameter nil 'name))) t)
        (qa (let ((name (copy-sequence "F9")))
              (set-frame-parameter nil 'name name)
              (aset name 0 ?X)
              (list (frame-parameter nil 'name)
                    (string-match-p "#<frame X9 " (prin1-to-string (selected-frame)))
                    (eq name (frame-parameter nil 'name)))) '("X9" 0 t))
        (qa (set-frame-parameter nil 'name nil) nil)
        (qa (frame-parameter nil 'name) "F2")
        (qa (eq (frame-parameter nil 'name) (frame-parameter nil 'name)) t)
        (qa (set-frame-parameter nil 'name "F123") nil)
        (qa (set-frame-parameter nil 'name nil) nil)
        (qa (frame-parameter nil 'name) "F123")
        (qa (set-frame-parameter nil 'name "") nil)
        (qa (frame-parameter nil 'name) "")
        (qa (set-frame-parameter nil 'name nil) nil)
        (qa (frame-parameter nil 'name) "F3")

        (qa (modify-frame-parameters nil '((minibuffer . t))) nil)
        (qa (set-frame-parameter nil 'minibuffer (minibuffer-window)) nil)
        (qa (frame-parameter nil 'minibuffer) t)
        (dolist (qa106-value '(nil only 1 "x" [x]))
          (qa-err-data (modify-frame-parameters nil (list (cons 'minibuffer qa106-value)))
                       'error '("Can’t change the ‘minibuffer’ parameter of this frame"))
          (qa (frame-parameter nil 'minibuffer) t))
        (qa-err-data (set-frame-parameter nil 'minibuffer (selected-window))
                     'error '("The ‘minibuffer’ parameter does not specify a valid minibuffer window"))
        (qa-err-data (let ((text-quoting-style 'straight))
                       (set-frame-parameter nil 'minibuffer 'only))
                     'error '("Can't change the 'minibuffer' parameter of this frame"))
        (dolist (qa106-value '(nil t 1 "x" "Monospace-12" [x]))
          (qa (modify-frame-parameters nil (list (cons 'font qa106-value))) nil)
          (qa (frame-parameter nil 'font) "tty")
          (qa (cdr (assq 'font (frame-parameters))) "tty")))
    (set-frame-parameter nil 'name qa106-saved-name)
    (set-frame-parameter nil 'font "tty")))

(princ (qa--done)) (terpri)
