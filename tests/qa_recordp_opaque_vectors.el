;;; -*- lexical-binding: nil; -*-
;; recordp excludes opaque vector types, but uses object identity for
;; record-backed font specs and obarrays (#477).
(qa (mapcar #'recordp (list (bool-vector t)
                            (make-char-table 'test)
                            (record 'test)))
    '(nil nil t))
(qa (recordp (record 'font-spec '(:family "ordinary"))) t)
(qa (recordp (font-spec :family "opaque")) nil)
(qa (obarrayp (record 'obarray [] 3)) nil)
(qa (recordp (record 'obarray [] 3)) t)
(qa (recordp (obarray-make)) nil)
;; Opaque font-spec and obarray slots are not Lisp sequences/arrays (#481).
(dolist (object (list (font-spec) obarray (obarray-make)))
  (qa (condition-case err (length object)
        (error (list (car err) (cadr err) (eq (caddr err) object))))
      '(wrong-type-argument sequencep t))
  (qa (condition-case err (length< object 1)
        (error (list (car err) (cadr err) (eq (caddr err) object))))
      '(wrong-type-argument sequencep t))
  (qa (condition-case err (elt object 'bad-index)
        (error (list (car err) (cadr err) (eq (caddr err) object))))
      '(wrong-type-argument sequencep t))
  (qa (condition-case err (aref object 0)
        (error (list (car err) (cadr err) (eq (caddr err) object))))
      '(wrong-type-argument arrayp t))
  (qa (condition-case err (aset object 0 'changed)
        (error (list (car err) (cadr err) (eq (caddr err) object))))
      '(wrong-type-argument arrayp t)))
(qa (length= (record 'font-spec '(:family "ordinary")) 2) t)
(princ (qa--done))
