;;; -*- lexical-binding: t; -*-
(defvar treesit-extra-load-path nil)
(setq treesit-extra-load-path
      (cons (expand-file-name "~/.emacs.d/tree-sitter") treesit-extra-load-path))
(defvar qa212-results nil)

(defun qa212-run (function)
  (with-temp-buffer
    (insert "[1,2]")
    (let* ((base (current-buffer))
           (one (make-indirect-buffer base " *qa212-one*"))
           (two (make-indirect-buffer base " *qa212-two*"))
           (p (treesit-parser-create 'json base))
           (q (treesit-parser-create 'json one))
           (r (treesit-parser-create 'json two)))
      (unwind-protect
          (funcall function base one two p q r)
        (dolist (parser (list p q r)) (ignore-errors (treesit-parser-delete parser)))
        (when (buffer-live-p one) (kill-buffer one))
        (when (buffer-live-p two) (kill-buffer two))))))

(defun qa212-description (parser)
  (let ((node (treesit-parser-root-node parser)))
    (list (treesit-node-string node) (treesit-node-start node) (treesit-node-end node))))

(defun qa212-identity (base one two p q r)
  (list (eq p q) (eq q r)
        (eq (treesit-parser-buffer p) base)
        (eq (treesit-parser-buffer q) one)
        (eq (treesit-parser-buffer r) two)
        (equal (treesit-parser-list base) (list p))
        (equal (treesit-parser-list one) (list q))
        (equal (treesit-parser-list two) (list r))
        (eq p (treesit-parser-create 'json base))
        (eq q (treesit-parser-create 'json one))
        (eq r (treesit-parser-create 'json two))
        (with-current-buffer one (eq q (treesit-parser-create 'json)))
        (with-current-buffer two (equal (treesit-parser-list) (list r)))
        (eq (treesit-node-parser (treesit-parser-root-node q)) q)
        (with-current-buffer one
          (treesit-node-eq (treesit-buffer-root-node) (treesit-parser-root-node q)))
        (with-current-buffer one
          (eq (treesit-node-parser (cdar (treesit-query-capture 'json '((number) @n)))) q))))

(defun qa212-tags (base one two p q r)
  (let ((tagged (treesit-parser-create 'json one nil 'inside))
        (other-tagged (treesit-parser-create 'json base nil 'inside))
        (extra (treesit-parser-create 'json one t)))
    (unwind-protect
        (list (eq tagged other-tagged) (eq extra q)
              (eq tagged (treesit-parser-create 'json one nil 'inside))
              (eq other-tagged (treesit-parser-create 'json base nil 'inside))
              (equal (treesit-parser-list one 'json 'inside) (list tagged))
              (equal (treesit-parser-list base 'json 'inside) (list other-tagged))
              (length (treesit-parser-list one))
              (length (treesit-parser-list base))
              (length (treesit-parser-list two))
              (length (treesit-parser-list one 'json t))
              (equal (treesit-parser-list two) (list r))
              (eq (treesit-parser-buffer extra) one))
      (treesit-parser-delete tagged)
      (treesit-parser-delete other-tagged)
      (treesit-parser-delete extra))))

(defun qa212-context (base one two p q r)
  (with-current-buffer one (narrow-to-region 2 3))
  (let ((before (list (qa212-description p) (qa212-description q) (qa212-description r)))
        (old-p (treesit-parser-root-node p))
        (old-q (treesit-parser-root-node q)))
    (with-current-buffer base
      (goto-char 2) (delete-char 1) (insert "null"))
    (let* ((passive (list (treesit-node-check old-p 'outdated) (treesit-node-check old-q 'outdated)))
           (indirect (list (qa212-description q)
                           (treesit-node-check old-p 'outdated) (treesit-node-check old-q 'outdated)))
           (full (list (qa212-description p) (qa212-description r)
                       (treesit-node-check old-p 'outdated) (treesit-node-check old-q 'outdated))))
      ;; Reverse the editing direction: edit the restricted indirect view.
      (with-current-buffer one
        (goto-char 2) (delete-char 4) (insert "false"))
      (list before passive indirect full
            (list (qa212-description p) (qa212-description q) (qa212-description r))
            (with-current-buffer two
              (eq (treesit-node-parser (treesit-buffer-root-node 'json)) r))))))

(defun qa212-lifetime (base one two p q r)
  (treesit-parser-root-node p)
  (treesit-parser-root-node q)
  (treesit-parser-root-node r)
  ;; Deleting the base parser must keep the indirect parsers intact.
  (treesit-parser-delete p)
  (let ((after-delete (list (null (treesit-parser-list base))
                            (equal (treesit-parser-list one) (list q))
                            (equal (treesit-parser-list two) (list r)))))
    (kill-buffer one)
    (list after-delete
          (not (eq (treesit-parser-create 'json base) p))
          (eq (treesit-parser-create 'json two) r)
          (qa212-description (treesit-parser-create 'json base)) (qa212-description r))))

(if (and (fboundp 'treesit-language-available-p) (treesit-language-available-p 'json))
    (progn
      (require 'treesit)
      ;; Original audit: indirect creation is distinct and listed locally.
      (qa (qa212-run (lambda (_base one _two p q _r)
                       (list (eq p q) (length (treesit-parser-list one))))) '(nil 1))
      (let ((qa212-results (qa212-run #'qa212-identity)))
        (qa (nth 0 qa212-results) nil)
        (qa (nth 1 qa212-results) nil)
        (qa (nth 2 qa212-results) t)
        (qa (nth 3 qa212-results) t)
        (qa (nth 4 qa212-results) t)
        (qa (nth 5 qa212-results) t)
        (qa (nth 6 qa212-results) t)
        (qa (nth 7 qa212-results) t)
        (qa (nth 8 qa212-results) t)
        (qa (nth 9 qa212-results) t)
        (qa (nth 10 qa212-results) t)
        (qa (nth 11 qa212-results) t)
        (qa (nth 12 qa212-results) t)
        (qa (nth 13 qa212-results) t)
        (qa (nth 14 qa212-results) t)
        (qa (nth 15 qa212-results) t))
      (qa (qa212-run #'qa212-tags) '(nil nil t t t t 2 1 1 3 t t))
      (let ((qa212-results (qa212-run #'qa212-context)))
        (qa (nth 0 qa212-results)
            '(("(document (array (number) (number)))" 1 6)
              ("(document (number))" 2 3)
              ("(document (array (number) (number)))" 1 6)))
        (qa (nth 1 qa212-results) '(nil nil))
        (qa (nth 2 qa212-results) '(("(document (null))" 2 6) nil t))
        (qa (nth 3 qa212-results)
            '(("(document (array (null) (number)))" 1 9)
              ("(document (array (null) (number)))" 1 9) t t))
        (qa (nth 4 qa212-results)
            '(("(document (array (false) (number)))" 1 10)
              ("(document (false))" 2 7)
              ("(document (array (false) (number)))" 1 10)))
        (qa (nth 5 qa212-results) t))
      (qa (qa212-run #'qa212-lifetime)
          '((t t t) t t ("(document (array (number) (number)))" 1 6)
            ("(document (array (number) (number)))" 1 6)))
      (qa (qa212-run
           (lambda (base one two p q r)
             (treesit-parser-root-node q)
             (kill-buffer one)
             (list (buffer-live-p one) (treesit-parser-p q)
                   (eq (treesit-parser-buffer q) one)
                   (eq (treesit-parser-create 'json base) p)
                   (eq (treesit-parser-create 'json two) r)
                   (qa212-description p) (qa212-description r))))
          '(nil t t t t ("(document (array (number) (number)))" 1 6)
            ("(document (array (number) (number)))" 1 6)))
      (qa (qa212-run
           (lambda (_base _one _two p q r)
             (treesit-parser-set-included-ranges q '((2 . 3)))
             (list (treesit-parser-included-ranges p)
                   (treesit-parser-included-ranges q)
                   (treesit-parser-included-ranges r)
                   (qa212-description p) (qa212-description q) (qa212-description r))))
          '(nil ((2 . 3)) nil ("(document (array (number) (number)))" 1 6)
            ("(document (number))" 2 3) ("(document (array (number) (number)))" 1 6))))
  (princ "SKIP qa_treesit_indirect: JSON grammar unavailable\n"))
(princ (qa--done)) (terpri)
