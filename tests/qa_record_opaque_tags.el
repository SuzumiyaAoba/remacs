;;; -*- lexical-binding: nil; -*-
;; Font/obarray identities are not ordinary record tags (#477).
(dolist (tag '(font-spec obarray))
  (let* ((record (record tag (list 'payload))) (copy (copy-tree record t)))
    (qa (recordp record) t)
    (qa (fontp record) nil)
    (qa (obarrayp record) nil)
    (qa (recordp copy) t)
    (qa copy record)
    (qa (eq copy record) nil)
    (qa (eq (aref record 1) (aref copy 1)) nil)
    (qa (eq (copy-tree record nil) record) t)
    (qa (recordp (read (prin1-to-string record))) t)))
(let ((font (font-spec :family "Monospace")) (table (obarray-make)))
  (qa (fontp font) t)
  (qa (fontp font 'font-spec) t)
  (qa (obarrayp table) t)
  (qa (obarrayp obarray) t)
  (qa (recordp font) nil)
  (qa (recordp table) nil)
  (qa-err-data (copy-sequence font) 'wrong-type-argument (list 'sequencep font))
  (qa-err-data (copy-sequence table) 'wrong-type-argument (list 'sequencep table))
  (qa (eq (copy-tree font t) font) t)
  (qa (eq (copy-tree table t) table) t)
  (qa (eq (car (copy-tree (list font table) t)) font) t)
  (qa (eq (cadr (copy-tree (list font table) t)) table) t)
  (qa (font-get font :family) 'Monospace)
  (let ((key (intern "real-table" table)))
    (qa (intern-soft "real-table" table) key)))
(let ((legacy (make-vector 7 0)))
  (qa (obarrayp legacy) nil)
  (let ((key (intern "legacy-table" legacy)))
    (qa (intern-soft "legacy-table" legacy) key)))
(let ((ordinary (record 'obarray [] 3)))
  (qa-err-data (intern "no" ordinary) 'wrong-type-argument (list 'obarrayp ordinary)))
(let ((ordinary (record 'font-spec nil)))
  (qa-err-data (font-get ordinary :family) 'wrong-type-argument (list 'font ordinary))
  (qa-err-data (font-put ordinary :family "no") 'wrong-type-argument (list 'font-spec ordinary)))
;; Obarrays have identity equality, unlike content-comparable font specs.
(let ((a (obarray-make)) (b (obarray-make)) (table (make-hash-table :test 'equal)))
  (qa (equal a a) t)
  (qa (equal a b) nil)
  (qa (equal (list a) (list b)) nil)
  (qa (equal (vector a) (vector b)) nil)
  (puthash a 'first table)
  (puthash b 'second table)
  (qa (hash-table-count table) 2)
  (qa (gethash a table) 'first)
  (qa (gethash b table) 'second)
  (qa (gethash (obarray-make) table 'missing) 'missing)
  (intern "changed" a)
  (qa (gethash a table) 'first))
(qa (equal (font-spec) (font-spec)) t)
(princ (qa--done))
