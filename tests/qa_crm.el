;;; -*- lexical-binding: t; -*-
;; minibuf.c delegates before implementation-specific input validation.
(qa (featurep 'crm) nil)
(qa (autoloadp (symbol-function 'completing-read-multiple)) t)
(qa (let ((completing-read-function (lambda (&rest arguments) arguments)))
      (completing-read 17 'table 'predicate 'match 'initial 'hist 'def 'inherit))
    '(17 table predicate match initial hist def inherit))
(qa (let ((completing-read-function (lambda (&rest arguments) arguments)))
      (completing-read 'prompt 'table)) '(prompt table nil nil nil nil nil nil))
(qa (let* ((prompt (propertize "P:" 'tag t))
           (completing-read-function (lambda (&rest arguments) (car arguments))))
      (eq (completing-read prompt nil) prompt)) t)
(qa (let ((completing-read-function (lambda (&rest _) 'custom-result)))
      (completing-read nil nil)) 'custom-result)
(qa-err-data (let ((completing-read-function nil)) (completing-read "P:" nil))
    'void-function '(nil))
(qa (let ((completing-read-function (lambda (&rest _) "a,b")))
      (completing-read-multiple "P:" nil)) '("a" "b"))
(qa (featurep 'crm) t)
(qa (let ((crm-separator "[:;]+") (crm-prompt "[CRM%s] %p") seen
          (completing-read-function
           (lambda (&rest arguments) (setq seen arguments) "a;b::c")))
      (let ((parts (completing-read-multiple "P:" 'table 'predicate 'match 'initial 'hist 'def 'inherit)))
        (list parts (car seen) (eq (cadr seen) #'crm--collection-fn) (nthcdr 2 seen))))
    '(("a" "b" "c") "[CRM[:;]+] P:" t (predicate match initial hist def inherit)))
(qa (let ((completing-read-function (lambda (&rest _) " a,b ")))
      (completing-read-multiple "P:" nil)) '(" a" "b "))
(qa (let ((completing-read-function (lambda (&rest _) ",a,,b,")))
      (completing-read-multiple "P:" nil)) '("a" "b"))
(qa (let ((completing-read-function (lambda (&rest _) "  ")))
      (completing-read-multiple "P:" nil)) '("  "))
(qa (let* ((tag (list 'tag)) (input (propertize "a,b" 'qa-tag tag))
           (completing-read-function (lambda (&rest _) input)))
      (mapcar (lambda (string) (eq (get-text-property 0 'qa-tag string) tag))
              (completing-read-multiple "P:" nil))) '(t t))
(qa (let ((completing-read-function (lambda (&rest _) (unibyte-string 255 44 254))))
      (mapcar (lambda (string) (list (multibyte-string-p string) (string-to-list string)))
              (completing-read-multiple "P:" nil))) '((nil (255)) (nil (254))))
(qa (let* ((separator (propertize ";+" 'separator ";" 'description "semicolon list"))
           (crm-separator separator) seen
           (completing-read-function (lambda (prompt &rest _) (setq seen prompt) "a;b")))
      (list (completing-read-multiple "P:" nil) seen))
    '(("a" "b") "[semicolon list] P:"))
(princ (qa--done)) (terpri)
