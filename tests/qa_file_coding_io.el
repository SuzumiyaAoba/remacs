;; Issue #14: tests/file_coding_io.rs constructs exact binary fixtures.
(defvar qa-file-coding-io-dir)
(defun qa-io-read (name coding visit &optional unibyte beg end)
 (let* ((file (expand-file-name name qa-file-coding-io-dir))
        (coding-system-for-read coding) (last-coding-system-used 'before)
        (buffer (if visit (find-file-noselect file t) (generate-new-buffer " *q14*"))))
  (unwind-protect
   (with-current-buffer buffer
    (when unibyte (set-buffer-multibyte nil))
    (let ((ret (unless visit (insert-file-contents file nil beg end))))
     (list (cadr ret) (string-to-list (buffer-string)) last-coding-system-used
           buffer-file-coding-system enable-multibyte-characters (point)
           (get-text-property 1 'charset))))
   (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer))))

(defun qa-io-bytes (path)
  (with-temp-buffer (set-buffer-multibyte nil)
    (insert-file-contents-literally path) (string-to-list (buffer-string))))
(defun qa-io-write (text coding local operation &optional unibyte)
  (let ((file (make-temp-file (expand-file-name "out-" qa-file-coding-io-dir))))
    (unwind-protect
        (with-temp-buffer
          (when unibyte (set-buffer-multibyte nil))
          (unless (eq local 'inherit) (setq buffer-file-coding-system local))
          (insert text)
          (let ((coding-system-for-write coding) (require-final-newline nil))
            (cond ((eq operation 'save) (set-visited-file-name file) (save-buffer))
                  ((eq operation 'write-file) (write-file file))
                  ((eq operation 'append) (append-to-file nil nil file))
                  (t (write-region nil nil file nil 'quiet)))
            (let ((used last-coding-system-used))
              (list (qa-io-bytes file) used buffer-file-coding-system)) ))
      (delete-file file))))
