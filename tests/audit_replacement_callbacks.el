;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "replace-string:start-0" '(condition-case e (replace-regexp-in-string "b" "X" "abc" t t nil 0) (error (car e))))
(audit-check "replace-string:start-1" '(condition-case e (replace-regexp-in-string "b" "X" "abc" t t nil 1) (error (car e))))
(audit-check "replace-string:start--1" '(condition-case e (replace-regexp-in-string "b" "X" "abc" t t nil -1) (error (car e))))
(audit-check "replace-string:start-3" '(condition-case e (replace-regexp-in-string "b" "X" "abc" t t nil 3) (error (car e))))
(audit-check "replace-string:start-4" '(condition-case e (replace-regexp-in-string "b" "X" "abc" t t nil 4) (error (car e))))
(audit-check "replace-string:start-1.5" '(condition-case e (replace-regexp-in-string "b" "X" "abc" t t nil 1.5) (error (car e))))
(audit-check "replace-string:subexp-nil" '(condition-case e (replace-regexp-in-string "a\\(b\\)" "X" "abc" t t nil) (error (car e))))
(audit-check "replace-string:subexp-0" '(condition-case e (replace-regexp-in-string "a\\(b\\)" "X" "abc" t t 0) (error (car e))))
(audit-check "replace-string:subexp-1" '(condition-case e (replace-regexp-in-string "a\\(b\\)" "X" "abc" t t 1) (error (car e))))
(audit-check "replace-string:subexp-2" '(condition-case e (replace-regexp-in-string "a\\(b\\)" "X" "abc" t t 2) (error (car e))))
(audit-check "replace-string:subexp--1" '(condition-case e (replace-regexp-in-string "a\\(b\\)" "X" "abc" t t -1) (error (car e))))
(audit-check "replace-string:subexp-1.5" '(condition-case e (replace-regexp-in-string "a\\(b\\)" "X" "abc" t t 1.5) (error (car e))))
(audit-check "replace-string:subexp-'x" '(condition-case e (replace-regexp-in-string "a\\(b\\)" "X" "abc" t t 'x) (error (car e))))
(audit-check "replace-string:callback-subexp" '(let ((seen nil)) (list (replace-regexp-in-string "a\\(b\\)" (lambda (s) (push s seen) "X") "abc abc" t t 1) (nreverse seen))))
(audit-check "replace-string:callback-matches" '(let ((seen nil)) (list (replace-regexp-in-string "a\\(b\\)" (lambda (s) (push (list s (match-data)) seen) "X") "abc abc" t t) (nreverse seen))))
(audit-check "replace-string:callback-clobber-match" '(replace-regexp-in-string "a\\(b\\)" (lambda (s) (string-match "x" "x") "X") "abc" t t 1))
(audit-check "replace-string:callback-empty" '(let ((seen nil)) (list (replace-regexp-in-string "" (lambda (s) (push s seen) "X") "ab" t t) (nreverse seen))))
(audit-check "replace-string:preserve-match-error" '(progn (string-match "b" "abc") (let ((before (match-data))) (condition-case nil (replace-regexp-in-string "a" (lambda (_) (error "stop")) "abc") (error nil)) (equal before (match-data)))))
(audit-check "replace-string:lookbehind-anchors" '(replace-regexp-in-string "^" "X" "a\nb" t t))
(audit-check "replace-string:empty-at-end" '(replace-regexp-in-string "$" "X" "ab" t t))
(audit-check "replace-string:inhibit-case" '(let ((case-fold-search nil)) (replace-regexp-in-string "a" "xy" "A a" nil t)))
(audit-check "replace-string:zero-length-repetition" '(replace-regexp-in-string "a*" "X" "baac" t t))
(audit-check "replace-string:source-identity" '(let ((s (copy-sequence "abc"))) (eq s (replace-regexp-in-string "z" "X" s))))
(audit-check "replace-string:callback-match-modification" '(replace-regexp-in-string "a" (lambda (s) (aset s 0 ?x) s) "aba" t t))
(princ "AUDIT-DONE\n")
