;;; -*- lexical-binding: nil; -*-
;; copy-keymap retains char-table types and deep-copy independence (#516).
(qa (let ((keymap (make-keymap)))
      (define-key keymap "a" 'ascii-command)
      (let ((copy (copy-keymap keymap)))
        (list (lookup-key keymap "a")
              (lookup-key copy "a")
              (char-table-p (cadr copy)))))
    '(ascii-command ascii-command t))
(qa (let ((keymap (make-keymap)))
      (define-key keymap (vector #x100) 'nonascii-command)
      (let ((copy (copy-keymap keymap)))
        (list (lookup-key keymap (vector #x100))
              (lookup-key copy (vector #x100)))))
    '(nonascii-command nonascii-command))
(qa (let ((keymap (make-keymap)))
      (define-key keymap "ab" 'deep-command)
      (let ((copy (copy-keymap keymap)))
        (define-key copy "ac" 'new-command)
        (list (lookup-key keymap "ac")
              (lookup-key copy "ab")
              (lookup-key copy "ac"))))
    '(nil deep-command new-command))
(qa (let* ((record (record 'ordinary-keymap-value [1]))
           (keymap (make-sparse-keymap)))
      (define-key keymap "a" record)
      (eq (lookup-key (copy-keymap keymap) "a") record))
    t)
(princ (qa--done))
