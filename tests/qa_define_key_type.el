;;; -*- lexical-binding: nil; -*-
;; Issue #32: define-key requires a vector or string, before mutation.
(let ((map (make-sparse-keymap)))
  (define-key map "a" 'existing)
  (dolist (key (list nil t 'bad 5 1.5 '(97) '(97 . 98)
                     (make-marker) (current-buffer) (make-hash-table)
                     (make-bool-vector 1 t) (make-char-table 'qa32-table)
                     (record 'qa32-record)))
    (dolist (remove '(nil t))
      (let ((before (copy-tree map)))
        (qa-err-data (define-key map key 'replacement remove)
                     'wrong-type-argument (list 'arrayp key))
        (qa (equal map before) t)))))
(dolist (map (list (make-sparse-keymap) (make-keymap)))
  (qa (define-key map "a" 'first) 'first)
  (qa (lookup-key map [97]) 'first)
  (qa (define-key map [98] 'second) 'second)
  (qa (lookup-key map "b") 'second)
  (qa (define-key map [qa32-event] 'event-command) 'event-command)
  (qa (lookup-key map [qa32-event]) 'event-command)
  (qa (define-key map "" 'unused) nil)
  (qa (define-key map [] 'unused) nil)
  (qa-err-data (define-key map nil nil) 'wrong-type-argument '(arrayp nil))
  (qa-err-data (define-key map '(97) nil t) 'wrong-type-argument '(arrayp (97)))
  (qa (lookup-key map "a") 'first))
;; Keymap validation still comes first.
(dolist (map '(nil 1 "not-a-map"))
  (qa-err-data (define-key map 'bad 'command) 'wrong-type-argument (list 'keymapp map)))
(princ (qa--done))
