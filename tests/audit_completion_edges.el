;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "completion:try-completion-invalid" '(let ((completion-regexp-list (list "["))) (condition-case e (try-completion "foo" '("foo" "foobar")) (error (car e)))))
(audit-check "completion:try-completion-non-string" '(let ((completion-regexp-list (list 42))) (condition-case e (try-completion "foo" '("foo" "foobar")) (error (car e)))))
(audit-check "completion:try-completion-negated" '(let ((completion-regexp-list (list (cons "foo" nil)))) (condition-case e (try-completion "foo" '("foo" "foobar")) (error (car e)))))
(audit-check "completion:try-completion-input-identity" '(let ((input (propertize "foo" 'audit 42))) (try-completion input (lambda (s p a) (list (eq s input) (get-text-property 0 'audit s))))))
(audit-check "completion:try-completion-match-data" '(progn (string-match "b" "abc") (let ((before (match-data)) (completion-regexp-list '("o"))) (try-completion "foo" '("foo" "foobar")) (equal before (match-data)))))
(audit-check "completion:all-completions-invalid" '(let ((completion-regexp-list (list "["))) (condition-case e (all-completions "foo" '("foo" "foobar")) (error (car e)))))
(audit-check "completion:all-completions-non-string" '(let ((completion-regexp-list (list 42))) (condition-case e (all-completions "foo" '("foo" "foobar")) (error (car e)))))
(audit-check "completion:all-completions-negated" '(let ((completion-regexp-list (list (cons "foo" nil)))) (condition-case e (all-completions "foo" '("foo" "foobar")) (error (car e)))))
(audit-check "completion:all-completions-input-identity" '(let ((input (propertize "foo" 'audit 42))) (all-completions input (lambda (s p a) (list (eq s input) (get-text-property 0 'audit s))))))
(audit-check "completion:all-completions-match-data" '(progn (string-match "b" "abc") (let ((before (match-data)) (completion-regexp-list '("o"))) (all-completions "foo" '("foo" "foobar")) (equal before (match-data)))))
(audit-check "completion:test-completion-invalid" '(let ((completion-regexp-list (list "["))) (condition-case e (test-completion "foo" '("foo" "foobar")) (error (car e)))))
(audit-check "completion:test-completion-non-string" '(let ((completion-regexp-list (list 42))) (condition-case e (test-completion "foo" '("foo" "foobar")) (error (car e)))))
(audit-check "completion:test-completion-negated" '(let ((completion-regexp-list (list (cons "foo" nil)))) (condition-case e (test-completion "foo" '("foo" "foobar")) (error (car e)))))
(audit-check "completion:test-completion-input-identity" '(let ((input (propertize "foo" 'audit 42))) (test-completion input (lambda (s p a) (list (eq s input) (get-text-property 0 'audit s))))))
(audit-check "completion:test-completion-match-data" '(progn (string-match "b" "abc") (let ((before (match-data)) (completion-regexp-list '("o"))) (test-completion "foo" '("foo" "foobar")) (equal before (match-data)))))
(audit-check "completion:hide-spaces-''" '(all-completions "" '(" abc" "alpha" " hidden" "beta") nil t))
(audit-check "completion:hide-spaces-' '" '(all-completions " " '(" abc" "alpha" " hidden" "beta") nil t))
(audit-check "completion:hide-spaces-'a'" '(all-completions "a" '(" abc" "alpha" " hidden" "beta") nil t))
(audit-check "completion:unibyte-result" '(let* ((s (unibyte-string 255 65)) (out (try-completion "" (list s)))) (list (multibyte-string-p out) (string-to-list out))))
(audit-check "completion:multibyte-ascii-result" '(let* ((s (string-to-multibyte "abc")) (out (try-completion "" (list s)))) (multibyte-string-p out)))
(princ "AUDIT-DONE\n")
