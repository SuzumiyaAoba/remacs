;;; -*- lexical-binding: nil; -*-
;; string-join delegates property/byte-kind handling to concat (#555).
(let* ((first (propertize "a" 'tag 'first))
       (last (propertize "b" 'tag 'last))
       (separator (propertize "-" 'tag 'separator))
       (result (string-join (list first last) separator)))
  (qa result "a-b")
  (qa (mapcar (lambda (n) (get-text-property n 'tag result)) '(0 1 2))
      '(first separator last))
  (qa (get-text-property 0 'tag first) 'first)
  (qa (get-text-property 0 'tag last) 'last)
  (qa (get-text-property 0 'tag separator) 'separator))
(let ((source (make-string 1 65 t)) (separator (make-string 0 65 t)))
  (qa (multibyte-string-p (string-join (list source))) t)
  (qa (multibyte-string-p (string-join '("a" "b") separator)) nil)
  (qa (eq (string-join (list separator)) separator) t)
  (qa (eq (string-join (list separator separator)) separator) t))
(qa (string-join '([65] (66)) [45]) "A-B")
(qa (string-join nil 'invalid) "")
(qa (string-join '("a") 'invalid) "a")
(qa-err-data (string-join '("a" 42) 'invalid)
             'wrong-type-argument '(sequencep invalid))
(qa-err-data (string-join '(42 "a") 'invalid)
             'wrong-type-argument '(sequencep 42))
(qa-err-data (string-join '("a" "b") (bool-vector))
             'wrong-type-argument (list 'sequencep (bool-vector)))
;; Empty string separators are omitted by mapconcat (#556).
(let ((separator (make-string 0 65 t)))
  (qa (multibyte-string-p (mapconcat #'identity '("a" "b") separator)) nil)
  (qa (eq (mapconcat #'identity '("" "") separator) "") t))
(princ (qa--done))
