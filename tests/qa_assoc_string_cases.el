;;; -*- lexical-binding: nil; -*-
;; GNU minibuf.c delegates internally to compare-strings (#530-#532).
(qa (assoc-string "Σ" '("ς") t) "ς")
(qa (assoc-string "Σ" '("ς")) nil)
(qa (assoc-string "ß" '("ẞ") t) "ẞ")
(qa (assoc-string "ß" '("SS") t) nil)
(qa (assoc-string "s" '("ſ") t) nil)
(qa (assoc-string "I" '("ı") t) nil)
(qa (assoc-string nil '((nil . value))) '(nil . value))
(qa (assoc-string "NIL" '((nil . value)) t) '(nil . value))
(qa (assoc-string "nil" '(nil ("nil" . later))) nil)
(qa (assoc-string 42 nil) nil)
(qa (assoc-string 42 '(1 2 . tail)) nil)
(qa-err-data (assoc-string 42 '(nil)) 'wrong-type-argument '(stringp 42))
(qa-err-data (assoc-string 42 '((nil . value))) 'wrong-type-argument '(stringp 42))
(qa (assoc-string "missing" '("a" . tail)) nil)
(let* ((name (propertize "MiXeD" 'tag 'value)) (sym (make-symbol name))
       (entry (cons sym 'value)) (source (list 42 entry)))
  (qa (eq (assoc-string "mixed" source t) entry) t)
  (qa (eq (assoc-string sym source) entry) t)
  (aset name 0 ?Z)
  (qa (eq (assoc-string "zixed" source t) entry) t))
(dotimes (byte 256)
  (let* ((unibyte (unibyte-string byte)) (multi (string-to-multibyte unibyte))
         (entry (cons multi 'value)))
    (qa (eq (assoc-string unibyte (list entry)) entry) t)
    (qa (eq (assoc-string unibyte (list entry) t) entry) t)
    (qa (eq (assoc-string (make-symbol unibyte) (list entry)) entry) t)))
(with-temp-buffer
  (let ((table (make-char-table 'case-table nil)))
    (aset table #x110001 #x110002)
    (set-case-table table)
    (qa (assoc-string (string #x110001) (list (string #x110002)) t) (string #x110002))
    (qa (assoc-string "a" '("A") t) nil)))
(with-temp-buffer
  (set-buffer-multibyte nil)
  (qa (assoc-string (string 196) (list (string 228)) t) nil))
;; Internal C comparison ignores a redefinition of compare-strings.
(let ((saved (symbol-function 'compare-strings)) result)
  (unwind-protect
      (progn
        (fset 'compare-strings (lambda (&rest args) t))
        (setq result (assoc-string "wanted" '("other") t)))
    (fset 'compare-strings saved))
  (qa result nil))
;; No visit cap on finite lists; non-comparable elements remain ignored.
(let* ((source (make-list 500001 42)) (end (last source))
       (entry (cons "target" 'value)) (tail (list entry)))
  (setcdr end tail)
  (unwind-protect
      (qa (eq (assoc-string "target" source) entry) t)
    (setcdr end source)))
(garbage-collect)
(princ (qa--done))
