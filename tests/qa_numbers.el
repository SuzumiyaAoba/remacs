;; numbers — fixnum/bignum promotion, float edge cases, bitwise ops,
;; transcendental functions, seeded random.
;; GNU-verified absent in 31.1: `gcd', `lcm' (only cl-gcd/cl-lcm in
;; cl-lib), `float-epsilon', `least-positive-float',
;; `least-positive-normalized-float', variable `e' — checks skipped.
;; `/=' is strictly binary in GNU (unlike the variadic < <= > >=).

;; == numeric equality: = vs eql vs eq vs equal ==
(qa (= 1 1.0) t)
(qa (= 1.0 1) t)
(qa (eql 1 1.0) nil)
(qa (eql 1.0 1) nil)
(qa (eql 1 1) t)
(qa (eql 2.0 2.0) t)
(qa (eq 1 1.0) nil)
(qa (eq 100 100) t)
;; fresh bignums are heap objects: eq nil, eql/= t
(qa (eq (1+ most-positive-fixnum) (1+ most-positive-fixnum)) nil)
(qa (eql (1+ most-positive-fixnum) (1+ most-positive-fixnum)) t)
(qa (equal 1 1.0) nil)
(qa (equal 2.0 2.0) t)
;; signed zeros: = equates them, eql and equal do not
(qa (= 0.0 -0.0) t)
(qa (eql 0.0 -0.0) nil)
(qa (equal 0.0 -0.0) nil)
;; IEEE: NaN never equals NaN
(qa (= (sqrt -1) (sqrt -1)) nil)

;; == comparisons ==
;; /= takes exactly two args in GNU (wrong-number-of-arguments otherwise)
(qa (/= 1 2) t)
(qa (/= 1 1) nil)
(qa (/= 1.0 1) nil)
(qa-err (/=) 'wrong-number-of-arguments)
(qa-err-data (/= 1 2 3) 'wrong-number-of-arguments '(/= 3))
;; < <= > >= are variadic; a single arg is vacuously true
(qa (= 1) t)
(qa (< 1) t)
(qa (< 1 2.0 3) t)
(qa (<= 1 1.0 2) t)
(qa (>= 3 3 3.0) t)
(qa (> 3 2.5 2) t)
(qa (< 1 1) nil)
(qa (< most-positive-fixnum (1+ most-positive-fixnum)) t)
(qa-err (< 1 'a) 'wrong-type-argument)
(qa-err-data (> 1 'a) 'wrong-type-argument '(number-or-marker-p a))

;; == + - * /: arities and contagion ==
(qa (+) 0)
(qa (*) 1)
(qa (-) 0)
(qa (- 5) -5)
(qa (- 5.0) -5.0)
(qa (- 1 2 3) -4)
;; unary / is reciprocal: integer result for int, float for float
(qa (/ 5) 0)
(qa (/ 5.0) 0.2)
;; integer division truncates toward zero
(qa (/ -7 2) -3)
(qa (/ -7 -2) 3)
(qa (/ 7 -2) -3)
(qa (/ 3.0 2) 1.5)
(qa (/ 3 2.0) 1.5)
;; integer /0 signals; float /0 yields infinities/NaN
(qa-err (% 7 0) 'arith-error)
(qa-err (mod 7 0) 'arith-error)
(qa (/ 1.0 0) 1.0e+INF)
(qa (/ 1 0.0) 1.0e+INF)
(qa (floatp (/ 0.0 0.0)) t)
(qa-prin1 (/ -1.0 0.0) "-1.0e+INF")
(qa (1+ 2.5) 3.5)
(qa (1- 2.5) 1.5)
(qa (1+ -1.5) -0.5)
(qa (+ 1.5 2) 3.5)
(qa (* 2 3.5) 7.0)
(qa (+ 0.1 0.2) 0.30000000000000004)
(qa (equal (+ 0.1 0.2) 0.3) nil)

;; == fixnum limits, bignum promotion (GNU: 62-bit fixnums) ==
(qa most-positive-fixnum 2305843009213693951)
(qa most-negative-fixnum -2305843009213693952)
(qa (bignump 1) nil)
(qa (bignump 1.0) nil)
(qa (fixnump 1) t)
(qa (fixnump 1.0) nil)
(qa (fixnump most-positive-fixnum) t)
(qa (bignump (1+ most-positive-fixnum)) t)
(qa (bignump (1- most-negative-fixnum)) t)
(qa (fixnump (1+ most-positive-fixnum)) nil)
(qa (integerp (1+ most-positive-fixnum)) t)
(qa (natnump (1+ most-positive-fixnum)) t)
(qa (natnump (1- most-negative-fixnum)) nil)
;; abs of most-negative-fixnum cannot be a fixnum
(qa (abs most-negative-fixnum) 2305843009213693952)
(qa (bignump (abs most-negative-fixnum)) t)
(qa-prin1 (1+ most-positive-fixnum) "2305843009213693952")
(qa-prin1 (1- most-negative-fixnum) "-2305843009213693953")
(qa-prin1 (* most-positive-fixnum 2) "4611686018427387902")
;; integer division of min by -1 promotes to bignum, not overflow
(qa (/ most-negative-fixnum -1) 2305843009213693952)
(qa (% most-negative-fixnum -1) 0)

;; == predicates ==
(qa (numberp 5) t)
(qa (numberp "x") nil)
(qa (numberp (sqrt -1)) t)
(qa (numberp (make-marker)) nil)
(qa (integerp 1.0) nil)
(qa (integerp ?a) t)
(qa (floatp 1) nil)
(qa (floatp (sqrt -1)) t)
(qa (natnump 0) t)
(qa (natnump -1) nil)
(qa (natnump 1.0) nil)
(qa (natnump 'a) nil)
(qa (wholenump 'a) nil)
(qa (zerop 0) t)
(qa (zerop 0.0) t)
(qa (zerop -0.0) t)
(qa (plusp 0) nil)
(qa (plusp -0.0) nil)
(qa (minusp -0.0) nil)
(qa (minusp most-negative-fixnum) t)
(qa (oddp 3) t)
(qa (oddp -3) t)
(qa (evenp 4) t)
;; parity predicates reject floats and require integer-or-marker
(qa-err (oddp 3.0) 'wrong-type-argument)
(qa-err-data (evenp 4.0) 'wrong-type-argument '(integer-or-marker-p 4.0))
;; parity works on bignums too
(qa (oddp most-positive-fixnum) t)
(qa (oddp (1+ most-positive-fixnum)) nil)
(qa (evenp (1+ most-positive-fixnum)) t)
(qa (oddp (+ 2 most-positive-fixnum)) t)

;; == rounding family: always integer results ==
(qa (truncate 7.9) 7)
(qa (truncate -7.9) -7)
(qa (floor 7.9) 7)
(qa (floor -7.1) -8)
(qa (ceiling 7.1) 8)
(qa (ceiling -7.9) -7)
(qa (floor -0.5) -1)
(qa (ceiling -0.5) 0)
;; GNU round is ties-to-even, NOT away-from-zero
(qa (round 2.5) 2)
(qa (round 3.5) 4)
(qa (round -2.5) -2)
(qa (round -3.5) -4)
(qa (round 0.5) 0)
(qa (round -0.5) 0)
(qa (round 1.5) 2)
;; two-arg forms divide first (sign of divisor ignored)
(qa (floor 7 2) 3)
(qa (floor -7 2) -4)
(qa (floor 7 -2) -4)
(qa (ceiling 7 2) 4)
(qa (ceiling -7 2) -3)
(qa (truncate -7 2) -3)
(qa (truncate 7 -2) -3)
(qa (truncate -7 -2) 3)
(qa (round 7 2) 4)
(qa (round 5 2) 2)
(qa (round 9 2) 4)
(qa (truncate 7.0 2.0) 3)
;; rounding on bignums stays exact
(qa (truncate (expt 2 70) 7) 168655945816773043346)
(qa (floor (expt 2 70) 3) 393530540239137101141)
(qa-err-data (floor 'a) 'wrong-type-argument '(numberp a))
(qa-err-data (round) 'wrong-number-of-arguments '(round 0))

;; == % and mod ==
;; % keeps dividend sign; mod keeps divisor sign
(qa (% -7 3) -1)
(qa (% 7 -3) 1)
(qa (% -7 -3) -1)
(qa (mod -7 3) 2)
(qa (mod 7 -3) -2)
(qa (mod -7 -3) -1)
;; % rejects floats entirely; mod accepts them
(qa-err (% 7.5 2) 'wrong-type-argument)
(qa-err-data (% -7.5 2) 'wrong-type-argument '(integer-or-marker-p -7.5))
(qa (mod 7.5 2) 1.5)
(qa (mod -7.5 2) 0.5)
(qa (mod 7 2.0) 1.0)
(qa (mod 5 2.5) 0.0)
;; zero remainder under negative dividend is -0.0
(qa-prin1 (mod -5 2.5) "-0.0")
(qa (mod (expt 2 70) 7) 2)

;; == abs, max, min ==
(qa (abs -5.5) 5.5)
(qa (abs 0) 0)
;; max/min return the winning argument itself — no coercion.
;; On ties the first argument wins, so type is observable via prin1.
(qa (max 1 2.5) 2.5)
(qa (max 1.0 2) 2)
(qa (min 1 2.5) 1)
(qa (min 3 1.5 2) 1.5)
(qa-prin1 (max 1 1.0) "1")
(qa-prin1 (max 1.0 1) "1.0")
(qa-prin1 (min 2 2.0) "2")
(qa (max 5) 5)
(qa-err (max) 'wrong-number-of-arguments)
(qa-err-data (min 1 'a) 'wrong-type-argument '(number-or-marker-p a))

;; == bitwise ==
(qa (logand 60 13) 12)
(qa (logior 60 13) 61)
(qa (logxor 60 13) 49)
(qa (logand) -1)
(qa (logior) 0)
(qa (logxor) 0)
(qa (logand 5) 5)
(qa (lognot 0) -1)
(qa (lognot -1) 0)
(qa (lognot most-negative-fixnum) 2305843009213693951)
(qa (logior -1 most-positive-fixnum) -1)
(qa (logior most-negative-fixnum most-positive-fixnum) -1)
(qa (logxor -1 most-positive-fixnum) -2305843009213693952)
(qa (logand -1 13) 13)
;; bitwise ops are bignum-transparent
(qa (logxor (1+ most-positive-fixnum) most-positive-fixnum) 4611686018427387903)
(qa (lognot (1+ most-positive-fixnum)) -2305843009213693953)
(qa (logand (1+ most-positive-fixnum) most-positive-fixnum) 0)
;; logcount of a negative counts 0-bits in its infinite-width complement
(qa (logcount -1) 0)
(qa (logcount -2) 1)
(qa (logcount most-negative-fixnum) 61)
(qa (ash 1 4) 16)
(qa (ash 256 -4) 16)
(qa (ash -256 -4) -16)
(qa (ash -2 -1) -1)
(qa (ash 1 -100) 0)
(qa (ash -1 -100) -1)
;; ash promotes beyond fixnum width
(qa (ash 1 62) 4611686018427387904)
(qa (bignump (ash 1 62)) t)
(qa (ash -1 62) -4611686018427387904)
(qa (ash 1 100) 1267650600228229401496703205376)
;; lsh also produces bignums in GNU (no wraparound), but a negative
;; COUNT right-shifts the 62-bit representation arithmetically
;; except negatives go through the unsigned representation
(qa (lsh 1 4) 16)
(qa (lsh 1 62) 4611686018427387904)
(qa (lsh 256 -4) 16)
(qa (lsh -1 1) -2)
(qa (lsh -256 -4) 288230376151711728)
(qa (lsh -2 -1) 2305843009213693951)
(qa (lsh (1+ most-positive-fixnum) -1) 1152921504606846976)
;; lsh wants number-or-marker first, then integerp; ash wants integerp
(qa-err-data (lsh 'a 1) 'wrong-type-argument '(number-or-marker-p a))
(qa-err-data (lsh 1 1.5) 'wrong-type-argument '(integerp 1.5))
(qa-err-data (ash 'a 1) 'wrong-type-argument '(integerp a))
(qa-err-data (logand 'a 1) 'wrong-type-argument '(integer-or-marker-p a))
(qa-err-data (lognot 1.5) 'wrong-type-argument '(integerp 1.5))
(qa-err (logcount) 'wrong-number-of-arguments)
(qa-err-data (ash 1) 'wrong-number-of-arguments '(ash 1))

;; == expt ==
(qa (expt 2 62) 4611686018427387904)
(qa (bignump (expt 2 62)) t)
(qa-prin1 (expt 2 63) "9223372036854775808")
(qa (expt 2 -2) 0.25)
(qa (expt 0 0) 1)
(qa (expt 0 0.0) 1.0)
(qa (expt 0 -1) 1.0e+INF)
(qa (expt -2 3) -8)
(qa (expt -2.0 3) -8.0)
(qa (expt 2.0 3) 8.0)
(qa (expt -2 0.5) 0.0e+NaN)
(qa (expt 10 18) 1000000000000000000)
(qa-err (expt 2) 'wrong-number-of-arguments)
(qa-err-data (expt 'a 2) 'wrong-type-argument '(numberp a))

;; == transcendentals ==
(qa (sqrt 4) 2.0)
(qa (sqrt 2) 1.4142135623730951)
;; GNU has no complex numbers: negative real -> NaN float
(qa (sqrt -1) 0.0e+NaN)
(qa (isnan (sqrt -1)) t)
(qa (isnan (sqrt -1.0)) t)
(qa (isnan 0.0) nil)
(qa-err-data (isnan 1) 'wrong-type-argument '(floatp 1))
(qa (exp 0) 1.0)
(qa (exp 1) 2.718281828459045)
(qa (log 1) 0.0)
(qa (log 8 2) 3.0)
(qa (log 10 10) 1.0)
;; log of 0 is -INF, log of negative is NaN — never an error
(qa (log 0) -1.0e+INF)
(qa (isnan (log -1)) t)
(qa (log 8 1) 1.0e+INF)
(qa (sin 0) 0.0)
(qa (cos 0) 1.0)
(qa (tan 0) 0.0)
(qa (asin 0.5) 0.5235987755982988)
(qa (asin 1) 1.5707963267948966)
(qa (isnan (asin 2)) t)
(qa (acos 0.5) 1.0471975511965976)
(qa (atan 1) 0.7853981633974483)
;; two-arg atan is the quadrant-aware atan2
(qa (atan 1 1) 0.7853981633974483)
(qa (atan -1 -1) -2.356194490192345)
(qa (atan 1 -1) 2.356194490192345)
(qa (atan 0 -1) 3.141592653589793)
;; pi is a defconst; `e' does not exist in 31.1
(qa pi 3.141592653589793)
(qa (cos pi) -1.0)
(qa-prin1 (sin pi) "1.2246467991473532e-16")

;; == float printing and reading ==
(qa-prin1 -0.0 "-0.0")
(qa-prin1 (/ 0.0 -1.0) "-0.0")
(qa-prin1 (* -1 0.0) "-0.0")
(qa-prin1 (+ 0.0 -0.0) "0.0")
(qa-prin1 100.0 "100.0")
(qa-prin1 1e+20 "1e+20")
(qa-prin1 (float most-negative-fixnum) "-2.305843009213694e+18")
;; overflow/underflow at read time
(qa (car (read-from-string "1e999")) 1.0e+INF)
(qa (car (read-from-string "1e-999")) 0.0)
(qa (car (read-from-string "-1.0e+INF")) -1.0e+INF)
(qa (isnan (car (read-from-string "0.0e+NaN"))) t)
(qa (= (car (read-from-string "1e999")) 1.0e+INF) t)
;; radix literals read as integers; C-style and underscore forms don't
(qa (car (read-from-string "#x1F")) 31)
(qa (car (read-from-string "#b101")) 5)
(qa (car (read-from-string "#o17")) 15)
(qa (car (read-from-string "#36rZ")) 35)
(qa (symbolp (car (read-from-string "0x10"))) t)
(qa (symbolp (car (read-from-string "1_000"))) t)
(qa (car (read-from-string "10.")) 10)
(qa (car (read-from-string ".5")) 0.5)
(qa (car (read-from-string "2e3")) 2000.0)
(qa (floatp 2e3) t)
(qa (string-to-number "1e3") 1000.0)
(qa (string-to-number "0x10" 16) 0)
(qa (number-to-string -0.0) "-0.0")
(qa (number-to-string (1+ most-positive-fixnum)) "2305843009213693952")

;; == markers participate in integer arithmetic ==
(qa (= 97 ?a) t)
(qa (with-temp-buffer (= (point-marker) 1)) t)
(qa (with-temp-buffer (+ (point-marker) 1)) 2)
(qa (with-temp-buffer (mod (point-min-marker) 2)) 1)
(qa (with-temp-buffer (oddp (point-min-marker))) t)
;; a marker pointing nowhere signals plain `error' with this message
(qa-err-data (+ (make-marker) 1) 'error '("Marker does not point anywhere"))
(qa-err-data (oddp (make-marker)) 'error '("Marker does not point anywhere"))
;; a stray marker errors even under lsh's first type check
(qa-err-data (lsh (make-marker) 1) 'error '("Marker does not point anywhere"))

;; == seeded random is deterministic ==
;; (random "seed") reseeds from the string; a positive fixnum LIMIT
;; seeds nondeterministically instead — pin only string-seeded runs.
(qa (progn (random "qa-num") (list (random 100) (random 1000) (random 2)))
    '(19 52 1))
(qa (progn (random "qa-num") (random 100)) 19)
;; same string seed => identical sequence
(qa (progn (random "rseed") (list (random 100) (random 50))) '(96 11))
;; unbounded random after a seed returns a fixnum (can be negative)
(qa (progn (random "qa-num") (list (random) (random)))
    '(-1118851393238298685 766841751068498052))
(qa (fixnump (progn (random "z") (random))) t)
(qa (progn (random "s") (random 1)) 0)
(qa-err-data (random 0) 'args-out-of-range '(0))
(qa-err (random -5) 'args-out-of-range)

;; == misc errors ==
(qa-err-data (+ 'a) 'wrong-type-argument '(number-or-marker-p a))
(qa-err-data (1+ 'a) 'wrong-type-argument '(number-or-marker-p a))
(qa-err-data (abs 'a) 'wrong-type-argument '(numberp a))
(qa-err-data (zerop nil) 'wrong-type-argument '(number-or-marker-p nil))
(qa-err-data (/= 1 'a) 'wrong-type-argument '(number-or-marker-p a))
(qa-err (float) 'wrong-number-of-arguments)
(qa-err-data (float 1 2) 'wrong-number-of-arguments '(float 2))
(qa (float 3) 3.0)
(qa (float (1+ most-positive-fixnum)) 2.305843009213694e+18)
(qa (mod 0 3) 0)

(princ (qa--done))
