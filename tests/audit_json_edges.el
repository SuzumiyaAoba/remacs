;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "json:null-nil" '(json-serialize [nil] :null-object nil))
(audit-check "json:false-nil" '(json-serialize [nil] :false-object nil))
(audit-check "json:sentinel-objects" '(let ((x (list 1))) (json-serialize (vector x) :null-object x)))
(audit-check "json:sentinel-integer" '(json-serialize [42] :null-object 42))
(audit-check "json:sentinel-string" '(let ((x (copy-sequence "null"))) (json-serialize (vector x) :null-object x)))
(audit-check "json:parse-narrow" '(with-temp-buffer (insert "[1,2]") (narrow-to-region 1 4) (goto-char 1) (list (condition-case e (json-parse-buffer) (error (car e))) (point))))
(audit-check "json:parse-error-point" '(with-temp-buffer (insert "[1, bad]") (goto-char 1) (list (condition-case e (json-parse-buffer) (error (car e))) (point))))
(audit-check "json:parse-trailing-point" '(with-temp-buffer (insert "42   true") (goto-char 1) (list (json-parse-buffer) (point))))
(audit-check "json:duplicate-key" '(json-parse-string "{\"a\":1,\"a\":2}" :object-type 'alist))
(audit-check "json:large-int" '(json-parse-string "12345678901234567890123456789012345678901234567890"))
(audit-check "json:serialize-large-int" '(json-serialize 12345678901234567890123456789012345678901234567890))
(audit-check "json:utf8-input" '(string-to-list (json-parse-string (unibyte-string 34 195 169 34))))
(audit-check "json:invalid-utf8-input" '(condition-case e (json-parse-string (unibyte-string 34 255 34)) (error (car e))))
(audit-check "json:utf8-serialize" '(string-to-list (json-serialize (unibyte-string 195 169))))
(audit-check "json:invalid-utf8-serialize" '(condition-case e (json-serialize (unibyte-string 255)) (error (car e))))
(audit-check "json:insert-unibyte" '(with-temp-buffer (set-buffer-multibyte nil) (json-insert "é") (string-to-list (buffer-string))))
(audit-check "json:parse-nul-key" '(json-parse-string "{\"a\\u0000b\":1}" :object-type 'alist))
(audit-check "json:serialize-nul" '(json-serialize (string ?a 0 ?b)))
(audit-check "json:serialize-nul-key" '(json-serialize (list (cons (intern (string ?a 0 ?b)) 1))))
(audit-check "json:float-overflow" '(condition-case e (json-parse-string "1e9999") (error (car e))))
(audit-check "json:float-negative-zero" '(let ((x (json-parse-string "-0.0"))) (list (floatp x) (copysign 1.0 x))))
(princ "AUDIT-DONE\n")
