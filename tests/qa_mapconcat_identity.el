;;; -*- lexical-binding: nil; -*-
;; Only mapconcat's exact identity symbol bypasses the function cell (#557).
(let ((saved (symbol-function 'identity)) (calls 0))
  (unwind-protect
      (progn
        (fset 'identity (lambda (_input) (setq calls (1+ calls)) "changed"))
        (fset 'qa557-alias 'identity)
        (qa (mapconcat #'identity '("a" "b") "-") "a-b")
        (qa (string-join '("a" "b") "-") "a-b")
        (qa calls 0)
        (qa (mapconcat #'identity ["a" "b"] "-") "a-b")
        (qa calls 0)
        (qa (mapconcat #'identity "ab" "-") "changed-changed")
        (qa (mapconcat #'identity (bool-vector t nil) "-") "changed-changed")
        (qa calls 4)
        (setq calls 0)
        ;; mapcar and ordinary function objects retain normal dispatch.
        (qa (mapcar #'identity '("a" "b")) '("changed" "changed"))
        (qa calls 2)
        (qa (mapconcat (symbol-function 'identity) '("a" "b") "-")
            "changed-changed")
        (qa calls 4)
        (qa (mapconcat #'qa557-alias '("a" "b") "-") "changed-changed")
        (qa calls 6)
        (qa (mapconcat (lambda (input) (identity input)) '("a" "b") "-")
            "changed-changed")
        (qa calls 8)
        ;; Matching symbol names do not select the special path.
        (let ((function (make-symbol "identity")))
          (fset function (lambda (_) "uninterned"))
          (qa (mapconcat function '("a" "b") "-") "uninterned-uninterned"))
        (fmakunbound 'identity)
        (qa (mapconcat #'identity '("a" "b") "-") "a-b")
        (qa (string-join '("a" "b") "-") "a-b")
        (qa-err (mapcar #'identity '("a")) 'void-function)
        ;; Sequence and concat validation still apply to the original values.
        (qa-err (mapconcat #'identity "ab" "-") 'void-function)
        (qa-err (mapconcat #'identity (bool-vector t nil) "-") 'void-function)
        (qa (mapconcat #'identity ["a" "b"] "-") "a-b")
        (qa-err-data (mapconcat #'identity '(97) "-")
                     'wrong-type-argument '(sequencep 97))
        (qa-err-data (mapconcat #'identity 42 "-")
                     'wrong-type-argument '(sequencep 42))
        (qa (mapconcat #'identity nil 'invalid) "")
        (let* ((source (propertize "a" 'tag 'kept))
               (result (mapconcat #'identity (list source))))
          (qa result "a")
          (qa (get-text-property 0 'tag result) 'kept)))
    (fset 'identity saved)
    (fmakunbound 'qa557-alias)))
(let ((calls 0))
  (advice-add 'identity :before (lambda (&rest _) (setq calls (1+ calls)))
              '((name . qa557-before)))
  (unwind-protect
      (progn
        (setq calls 0)
        (qa (mapconcat #'identity '("a" "b") "-") "a-b")
        (qa (string-join '("a" "b") "-") "a-b")
        (qa calls 0)
        (qa (mapcar #'identity '("a" "b")) '("a" "b"))
        (qa calls 2))
    (advice-remove 'identity 'qa557-before)))
(princ (qa--done))
