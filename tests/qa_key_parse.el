(qa (key-parse "2*;; ignore this\n b") [98])
(qa (key-parse "a\tb\nc\fd") [97 98 99 100])
(qa (key-parse "<as df>") [as\ df])
(qa (key-parse "2*<<ignore>>")
    (vconcat (key-parse "<<ignore>>") (key-parse "<<ignore>>")))
(qa (vectorp (key-parse "a")) t)
(qa (key-parse nil) [])
(qa (key-parse "") [])
(qa (key-parse []) [])
(qa (let ((case-fold-search t)) (key-parse "2*ret")) [114 101 116 114 101 116])
(qa (progn (string-match "a" "a")
           (let ((saved (match-data)))
             (key-parse "2*C-x <left>") (equal saved (match-data)))) t)
(qa-err (key-parse "0*C-ab") (quote error))
(qa-err-data (key-parse 5) (quote wrong-type-argument) (quote (sequencep 5)))
(qa-err-data (key-parse [a]) (quote wrong-type-argument) (quote (stringp [a])))
(princ (qa--done))
