;;; -*- lexical-binding: t; -*-
;; GNU keymap.el key-parse must not be replaced by the bootstrap parser (#296).
(qa (append (key-parse "3*C-x") nil) (quote (24 24 24)))
(qa (append (key-parse "2*a") nil) (quote (97 97)))
(qa (key-parse "3*C-x") (key-parse "C-x C-x C-x"))
(qa (key-parse "2*a") (key-parse "a a"))
(qa (key-parse "0*a") [])
(qa (key-parse "-1*a") [])
(qa (key-parse "+2*a") [97 97])
(qa (key-parse "01*a") [97])
(qa (key-parse "x2*a") [])
(qa (key-parse "1x2*a") [97])
(qa (key-parse "1.5*a") [97])
(qa (length (key-parse "1e2*a")) 100)
(qa (key-parse "2*ab") [97 98 97 98])
(qa (key-parse "2*C-x C-f") [24 24 6])
(qa (key-parse "2*<left>") [left left])
(qa (key-parse "2*C-<home>") [C-home C-home])
(qa (key-parse "2*SPC") [32 32])
(qa (key-parse "2*日") [26085 26085])
(qa (key-parse "2*") [50 42])
(qa (key-parse "*a") [42 97])
(qa (key-parse "2*3*a") [51 42 97 51 42 97])
