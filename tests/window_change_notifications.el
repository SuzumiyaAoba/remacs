;;; -*- lexical-binding: t; -*-
;; Host provides qa289-notify: GNU redisplay, or the Rust notification phase.
(defvar qa289-log nil)
(defvar qa289-target nil)
(defun qa289-old (window)
  (let ((old (window-old-buffer window)))
    (if (bufferp old) (buffer-name old) old)))
(defun qa289-note (name window)
  (push (list name (qa289-old window) (buffer-name (window-buffer window))) qa289-log))
(defun qa289-prepare ()
  (delete-other-windows)
  (switch-to-buffer "*scratch*")
  (dolist (hook '(window-buffer-change-functions window-size-change-functions
                 window-selection-change-functions window-state-change-functions
                 window-configuration-change-hook window-state-change-hook))
    (set-default hook nil))
  (setq qa289-log nil)
  (qa289-notify))
(defun qa289-basic ()
  (qa289-prepare)
  (let* ((window (selected-window)) (a (get-buffer-create "qa289-a"))
         (b (get-buffer-create "qa289-b")))
    (qa289-note 'initial window)
    (qa289-notify) (qa289-note 'after-display window)
    (let ((saved (current-window-configuration)))
      (set-window-buffer window a) (qa289-note 'set-a window)
      (set-window-buffer window b) (qa289-note 'set-b window)
      (qa289-notify) (qa289-note 'after-b-display window)
      (set-window-configuration saved) (qa289-note 'restored-across-display window)
      (qa289-notify) (qa289-note 'after-restored-display window))
    (let ((saved (current-window-configuration)))
      (set-window-buffer window a) (set-window-configuration saved)
      (qa289-note 'restored-without-display window))
    (let ((other (split-window window 20 'right)))
      (qa289-note 'fresh-split other)
      (qa289-notify) (qa289-note 'split-after-display other)
      (set-window-buffer other b) (delete-window other)
      (push (list 'deleted (qa289-old other)) qa289-log)))
  (nreverse qa289-log))
(defun qa289-dead ()
  (qa289-prepare)
  (let* ((root (selected-window)) (other (split-window root 20 'right)))
    (qa289-notify)
    (push (list 'recorded (qa289-old other)) qa289-log)
    (let ((saved (current-window-configuration)))
      (delete-window other) (qa289-notify)
      (push (list 'deleted (qa289-old other)) qa289-log)
      (set-window-configuration saved)
      (push (list 'restored-after-deletion (qa289-old other)) qa289-log)
      (qa289-notify)
      (push (list 'restored-after-display (qa289-old other)) qa289-log)))
  (nreverse qa289-log))
(defun qa289-observe (scope object)
  (push (list scope (cond ((windowp object) 'window) ((framep object) 'frame) (t object))
              (buffer-name) (qa289-old qa289-target)
              (buffer-name (window-buffer qa289-target))) qa289-log))
(defun qa289-local (object) (qa289-observe 'local object))
(defun qa289-global (object)
  (qa289-notify) ; A nested redisplay must not publish history early.
  (qa289-observe 'global object))
(defun qa289-hooks ()
  (qa289-prepare)
  (let* ((window (selected-window)) (a (get-buffer-create "qa289-hook-a"))
         (b (get-buffer-create "qa289-hook-b")))
    (setq qa289-target window)
    (set-window-buffer window a) (qa289-notify)
    (with-current-buffer a (setq-local window-buffer-change-functions '(qa289-local t)))
    (with-current-buffer b (setq-local window-buffer-change-functions '(qa289-local t)))
    (set-default 'window-buffer-change-functions '(qa289-global))
    (unwind-protect
        (progn
          (set-window-buffer window b) (qa289-observe 'before nil)
          (qa289-notify) (qa289-observe 'after nil))
      (with-current-buffer a (kill-local-variable 'window-buffer-change-functions))
      (with-current-buffer b (kill-local-variable 'window-buffer-change-functions))
      (set-default 'window-buffer-change-functions nil)))
  (nreverse qa289-log))
(defun qa289-mutating ()
  (qa289-prepare)
  (let* ((window (selected-window)) (a (get-buffer-create "qa289-mutate-a"))
         (b (get-buffer-create "qa289-mutate-b")) (c (get-buffer-create "qa289-mutate-c")))
    (setq qa289-target window)
    (set-window-buffer window a) (qa289-notify)
    (with-current-buffer a
      (setq-local window-buffer-change-functions
                  (list (lambda (w) (qa289-observe 'old w) (set-window-buffer w c)))))
    (with-current-buffer b
      (setq-local window-buffer-change-functions
                  (list (lambda (w) (qa289-observe 'new w)))))
    (unwind-protect
        (progn
          (set-window-buffer window b) (qa289-notify)
          (qa289-observe 'after nil))
      (with-current-buffer a (kill-local-variable 'window-buffer-change-functions))
      (with-current-buffer b (kill-local-variable 'window-buffer-change-functions))))
  (nreverse qa289-log))
(defun qa289-throw ()
  (qa289-prepare)
  (let* ((window (selected-window)) (next (get-buffer-create "qa289-throw")))
    (set-default 'window-buffer-change-functions (list (lambda (_frame) (throw 'qa289-exit 9))))
    (unwind-protect
        (progn
          (set-window-buffer window next)
          (let ((result (catch 'qa289-exit (qa289-notify))))
            (list result (qa289-old window) inhibit-redisplay)))
      (set-default 'window-buffer-change-functions nil))))
