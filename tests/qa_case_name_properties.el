;;; -*- lexical-binding: t; -*-
;; GNU's unibyte and multibyte case paths intentionally differ.
(defun qa124-tags (string)
  (let (tags)
    (dotimes (n (length string) (nreverse tags))
      (push (get-text-property n 'tag string) tags))))
(defun qa124-case (function)
  (let ((input (copy-sequence "aBc")))
    (dotimes (n 3) (put-text-property n (1+ n) 'tag (1+ n) input))
    (let ((output (funcall function input)))
      (list output (qa124-tags output) (multibyte-string-p output)
            (eq input output) (qa124-tags input)))))
(qa (qa124-case 'upcase) '("ABC" (1 2 3) nil nil (1 2 3)))
(qa (qa124-case 'downcase) '("abc" (1 2 3) nil nil (1 2 3)))
(qa (qa124-case 'capitalize) '("Abc" (1 2 3) nil nil (1 2 3)))
(qa (qa124-case 'upcase-initials) '("ABc" (1 2 3) nil nil (1 2 3)))
(qa (let* ((input (propertize (string-to-multibyte "abc") 'tag 1))
           (output (upcase input)))
      (list output (qa124-tags output) (multibyte-string-p output) (eq input output)))
    '("ABC" (nil nil nil) t nil))
(qa (let* ((input (propertize "aßc" 'tag 1)) (output (upcase input)))
      (list output (qa124-tags output) (multibyte-string-p output))) '("ASSC" (nil nil nil nil) t))
(qa (let* ((input (propertize "aßc" 'tag 1)) (output (downcase input)))
      (list output (qa124-tags output) (eq input output))) '("aßc" (nil nil nil) nil))
(qa (let* ((input (propertize (unibyte-string 223) 'tag 9)) (output (upcase input)))
      (list (string-to-list output) (qa124-tags output) (multibyte-string-p output))) '((223) (9) nil))
(qa (let ((input (copy-sequence ""))) (eq input (upcase input))) t)
(qa (let ((input (string-to-multibyte ""))) (eq input (downcase input))) t)

(defun qa124-region (function text)
  (with-temp-buffer
    (insert text)
    (dotimes (n (length text)) (put-text-property (1+ n) (+ n 2) 'tag (1+ n)))
    (goto-char 2)
    (let ((marker (copy-marker 2)))
      (funcall function (point-min) (point-max))
      (list (buffer-string) (qa124-tags (buffer-string)) (point) (marker-position marker)))))
(qa (qa124-region 'upcase-region "aBc") '("ABC" (1 2 3) 2 2))
(qa (qa124-region 'downcase-region "aBc") '("abc" (1 2 3) 2 2))
(qa (qa124-region 'capitalize-region "aBc") '("Abc" (1 2 3) 2 2))
(qa (qa124-region 'upcase-initials-region "aBc") '("ABc" (1 2 3) 2 2))
(qa (qa124-region 'upcase-region "aßc") '("ASSC" (1 1 2 3) 2 2))
(qa (qa124-region 'upcase-region "123") '("123" (1 2 3) 2 2))

(qa (let* ((name (propertize "qa124-make" 'tag 7)) (symbol (make-symbol name)))
      (list (eq name (symbol-name symbol)) (qa124-tags (symbol-name symbol))
            (eq (symbol-name symbol) (symbol-name symbol)))) '(t (7 7 7 7 7 7 7 7 7 7) t))
(qa (let* ((name (propertize "qa124-live" 'tag 7)) (symbol (make-symbol name)))
      (put-text-property 0 1 'tag 9 name)
      (get-text-property 0 'tag (symbol-name symbol))) 9)
(qa (let* ((name (propertize (make-temp-name "qa124-intern-") 'tag 7)) (symbol (intern name)))
      (unwind-protect
          (list (eq name (symbol-name symbol)) (get-text-property 0 'tag (symbol-name symbol)))
        (unintern symbol nil))) '(t 7))
(qa (let* ((name (propertize (make-temp-name "qa124-intern-") 'tag 7))
           (symbol (intern name)) (second (propertize (copy-sequence name) 'tag 9)))
      (unwind-protect
          (list (eq symbol (intern second)) (eq name (symbol-name symbol))
                (get-text-property 0 'tag (symbol-name symbol)))
        (unintern symbol nil))) '(t t 7))
(qa (let* ((obarray (obarray-make)) (name (propertize "qa124-custom" 'tag 7))
           (symbol (intern name obarray)))
      (list (eq name (symbol-name symbol)) (get-text-property 0 'tag (symbol-name symbol))
            (eq symbol (intern (copy-sequence name) obarray)))) '(t 7 t))
(qa (eq (symbol-name 'car) (symbol-name 'car)) t)
(qa (eq (symbol-name nil) (symbol-name nil)) t)
(qa (let* ((name (propertize (string-to-multibyte "qa124-multi") 'tag 1))
           (symbol (make-symbol name)))
      (list (eq name (symbol-name symbol)) (multibyte-string-p (symbol-name symbol)))) '(t t))
(qa (let* ((name (propertize "qa124-gc" 'tag 7)) (symbol (make-symbol name)))
      (garbage-collect)
      (list (eq name (symbol-name symbol)) (get-text-property 0 'tag (symbol-name symbol)))) '(t 7))
(qa (multibyte-string-p (propertize (string-to-multibyte "abc") 'tag 1)) t)
(qa (qa124-region 'upcase-region "ß") '("SS" (nil 1) 3 2))
(qa (with-temp-buffer
      (insert "aß") (put-text-property 1 2 'tag 1) (put-text-property 2 3 'tag 2)
      (put-text-property 1 2 'rear-nonsticky t)
      (upcase-region 1 3) (qa124-tags (buffer-string))) '(1 nil 2))
(qa (with-temp-buffer
      (insert "aß") (put-text-property 1 2 'tag 1) (put-text-property 2 3 'tag 2)
      (put-text-property 2 3 'front-sticky '(tag))
      (upcase-region 1 3) (qa124-tags (buffer-string))) '(1 1 2))
(qa (with-temp-buffer
      (insert "aßc") (goto-char 3)
      (let ((before (copy-marker 2)) (after (copy-marker 2 t)) (inside (copy-marker 3)))
        (upcase-region 1 4)
        (list (point) (marker-position before) (marker-position after) (marker-position inside))))
    '(4 2 2 3))
(qa (with-temp-buffer
      (buffer-enable-undo)
      (insert (propertize "aßc" 'tag 7)) (put-text-property 2 3 'tag 9)
      (setq buffer-undo-list nil) (goto-char 2)
      (upcase-region 1 4)
      (let ((undo-in-progress t)) (primitive-undo 1 buffer-undo-list))
      (list (buffer-string) (qa124-tags (buffer-string)))) '("aßc" (7 9 7)))
(qa (with-temp-buffer
      (insert "ZaßcY")
      (dotimes (n 5) (put-text-property (1+ n) (+ n 2) 'tag (1+ n)))
      (upcase-region 2 4)
      (list (buffer-string) (qa124-tags (buffer-string)))) '("ZASScY" (1 2 2 3 4 5)))
(qa (with-temp-buffer
      (insert "aßc")
      (dotimes (n 3) (put-text-property (1+ n) (+ n 2) 'tag (1+ n)))
      (goto-char 1) (upcase-word 1)
      (list (buffer-string) (qa124-tags (buffer-string)) (point))) '("ASSC" (1 1 2 3) 5))
(qa (with-temp-buffer
      (let* ((seen nil)
             (after-change-functions
              (list (lambda (beg _end old)
                      (when (= old 0) (push (get-text-property beg 'tag) seen))))))
        (primitive-undo 1 (list (cons (propertize "xy" 'tag 7) 1)))
        (list (buffer-string) (qa124-tags (buffer-string)) seen))) '("xy" (7 7) (7)))
(qa (with-temp-buffer
      (insert "aß")
      (let ((key (copy-sequence "key")))
        (set-text-properties 1 2 (list key 7 'anchor t))
        (set-text-properties 2 3 (list key 9 'anchor t))
        (upcase-region 1 3)
        (equal-including-properties (buffer-substring 2 3)
                                    (propertize "S" key 7 'anchor t)))) t)
(qa (with-temp-buffer
      (insert "aß")
      (let ((key (copy-sequence "key")))
        (set-text-properties 1 2 (list key 7 'anchor t 'rear-nonsticky (list key)))
        (set-text-properties 2 3 (list key 9 'anchor t))
        (upcase-region 1 3)
        (equal-including-properties (buffer-substring 2 3)
                                    (propertize "S" 'anchor t)))) t)
(princ (qa--done))
