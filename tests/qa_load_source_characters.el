;;; #782: utf-8-emacs source characters retain their real codes. -*- lexical-binding: nil; -*-
(let ((file (make-temp-file "qa-source-characters-" nil ".el"))
      (qa782-value nil) (qa782-symbol nil))
  (unwind-protect
      ;; A compiler header selects the direct reader even with an .el suffix.
      (dolist (compiled '(nil t))
	(dolist (entry '(
			 ((244 144 128 129) (1114113))
			 ((245 128 128 129) (1310721))
			 ((246 160 128 128) (1703936))
			 ((246 162 128 128) (1712128))
			 ((248 136 128 128 128) (2097152))
			 ((238 128 128) (57344))
			 ((243 176 130 128) (983168))
			 ((237 160 128) (4194285 4194208 4194176) (55296))
			 ((255) (4194303))
			 ((226 130) (4194274 4194178))
			 ((192 128) (4194240 4194176) (4194176))
			 ((195 169 255) (233 4194303))
			 ((247 191 191 191) (2097151))
			 ((248 143 191 189 191) (4194175))
			 ((248 143 191 190 128) (4194176))
			 ((248 143 191 191 191) (4194303))
			 ((248 144 128 128 128) (4194296 4194192 4194176 4194176 4194176) (0) t)
			 ((224 128 128) (4194272 4194176 4194176) (0) t)
			 ((240 128 128 128) (4194288 4194176 4194176 4194176) (0) t)
			 ((248 128 128 128 128) (4194296 4194176 4194176 4194176 4194176) (0) t)
			 ((249 128 128 128 128) (4194297 4194176 4194176 4194176 4194176) (0) t)
			 ((255 128 128 128 128) (4194303 4194176 4194176 4194176 4194176) (0) t)

			 ))
          (let ((expected (if (and compiled (cddr entry)) (caddr entry) (cadr entry))))
            (with-temp-buffer
              (set-buffer-multibyte nil)
              (when compiled
		(insert ";ELC\037\0\0\0\n;;; in Emacs version 31.1\n"))
              (insert ";;; -*- coding: utf-8-emacs; lexical-binding: nil; -*-\n(setq qa782-value \"")
              (insert (apply #'unibyte-string (car entry)))
              (insert "\"")
              (unless (nth 3 entry)
                (insert " qa782-symbol '")
                (insert (apply #'unibyte-string (car entry))))
              (insert ")\n")
              (let ((coding-system-for-write 'no-conversion))
		(write-region (point-min) (point-max) file nil 'silent)))
            (qa (load file nil t t) t)
            (let ((multibyte
                   (catch 'multi
                     (dolist (code expected)
                       (when (and (>= code 128) (< code 4194176))
			 (throw 'multi t))))))
              (qa (string-to-list qa782-value)
                  (if multibyte expected
                    (mapcar (lambda (code) (if (>= code 4194176) (- code 4194048) code)) expected)))
              (qa (multibyte-string-p qa782-value) multibyte))
            (unless (nth 3 entry)
              (qa (string-to-list (symbol-name qa782-symbol)) expected)))))
    (delete-file file)))
(princ (qa--done))
