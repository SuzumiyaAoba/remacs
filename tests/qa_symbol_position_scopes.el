;;; -*- lexical-binding: nil; -*-
;; Dynamic views, including byte-code setters/binders and nonlocal exits (#571).
;; Run before buffer-local forwarding changes watcher unbinding notifications.
(qa (let* ((symbols-with-pos-enabled nil) (events nil)
               (p (position-symbol 'qa571-scope 1))
               (watcher (lambda (_symbol _value operation _where)
                          (push (list operation (symbolp p) (eq p 'qa571-scope)) events))))
  (add-variable-watcher 'symbols-with-pos-enabled watcher)
  (unwind-protect
      (progn (setq symbols-with-pos-enabled t)
             (let ((symbols-with-pos-enabled nil)) nil)
             (setq symbols-with-pos-enabled nil)
             (nreverse events))
    (remove-variable-watcher 'symbols-with-pos-enabled watcher))) '((set nil nil) (let t t) (set nil nil) (unlet nil nil) (set t t)))
(let* ((symbols-with-pos-enabled nil) (p (position-symbol 'qa571-scope 1)))
  (qa (symbolp p) nil)
  (let ((symbols-with-pos-enabled t))
    (qa (symbolp p) t)
    (qa (eq p 'qa571-scope) t)
    (let ((symbols-with-pos-enabled nil)) (qa (eq p 'qa571-scope) nil))
    (qa (eq p 'qa571-scope) t))
  (qa (symbolp p) nil)
  (qa (catch 'done (let ((symbols-with-pos-enabled t)) (throw 'done (symbolp p)))) t)
  (qa (symbolp p) nil)
  (qa (condition-case nil
          (let ((symbols-with-pos-enabled t)) (error "unwind"))
        (error (symbolp p))) nil)
  ;; These operations execute EQ after byte-code state changes.
  (let ((fn (byte-compile '(lambda (value)
                            (setq symbols-with-pos-enabled t)
                            (eq value 'qa571-scope)))))
    (qa (funcall fn p) t)
    (qa (eq p 'qa571-scope) t))
  (setq symbols-with-pos-enabled nil)
  (let ((fn (byte-compile
             '(lambda (value)
                (let ((symbols-with-pos-enabled t))
                  (list (eq value 'qa571-scope)
                        (let ((symbols-with-pos-enabled nil)) (eq value 'qa571-scope))
                        (eq value 'qa571-scope)))))))
    (qa (funcall fn p) '(t nil t))
    (qa (eq p 'qa571-scope) nil))
  (with-temp-buffer
    (make-local-variable 'symbols-with-pos-enabled)
    (setq symbols-with-pos-enabled t)
    (qa (symbolp p) t)
    (with-temp-buffer (qa (symbolp p) nil))
    (qa (eq p 'qa571-scope) t))
  (qa (eq p 'qa571-scope) nil))
;; User-controlled record slots do not create positioned symbols (#579).
(dolist (enabled '(nil t))
  (let ((symbols-with-pos-enabled enabled))
    (dolist (fake (list (record 'symbol-with-pos 'qa571-scope 1)
                       (record #x5eedcafe1 'qa571-scope 1)))
      (qa (recordp fake) t)
      (qa (symbol-with-pos-p fake) nil)
      (qa (symbolp fake) nil)
      (qa (eq (remove-pos-from-symbol fake) fake) t)
      (qa-err (bare-symbol fake) 'wrong-type-argument)
      (qa (aref fake 1) 'qa571-scope)
      (qa (recordp (copy-sequence fake)) t))))
(defvar qa571-thread-records nil)
(setq qa571-thread-records nil)
(let* ((symbols-with-pos-enabled nil) (p (position-symbol 'qa571-scope 1))
       (worker (make-thread
                (apply-partially
                 (lambda (value)
                   (let ((symbols-with-pos-enabled t))
                     (setq qa571-thread-records (list (symbolp value) (eq value 'qa571-scope)))
                     (thread-yield)
                     (setq qa571-thread-records
                           (append qa571-thread-records (list (symbolp value) (eq value 'qa571-scope))))))
                 p))))
  (thread-yield)
  (qa (eq p 'qa571-scope) nil)
  (thread-join worker)
  (qa qa571-thread-records '(t t t t))
  (qa (eq p 'qa571-scope) nil))
(princ (qa--done))
