;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(require 'cl-lib)
(cl-defstruct (audit-r2-boa (:constructor nil)
              (:constructor audit-r2-create (auto fn &rest args)) (:type vector) :named)
  fn args auto)
(defun audit-r2-alias (keyword &optional auto)
  (audit-r2-create auto #'identity keyword))
(defun audit-r2-many (a b)
  (audit-r2-create t #'identity a b))
(defun audit-r2-zero () (audit-r2-create nil #'identity))
(audit-check "constructor:direct" '(audit-r2-create nil #'identity :raw-value))
(audit-check "constructor:alias" '(audit-r2-alias :raw-value))
(audit-check "constructor:many" '(audit-r2-many 1 2))
(audit-check "constructor:zero" '(audit-r2-zero))
(audit-check "constructor:funcall" '(funcall #'audit-r2-create nil #'identity :raw-value))
(princ "AUDIT-DONE\n")
