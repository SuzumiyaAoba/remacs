;;; -*- lexical-binding: nil; -*-
;; Representation conversions preserve no-op identity and properties (#421).
(dotimes (byte 256)
  (let ((source (propertize (unibyte-string byte) 'tag byte)))
    (dolist (op '(string-to-unibyte string-as-unibyte string-make-unibyte))
      (let ((result (funcall op source)))
        (qa (eq source result) t)
        (qa (get-text-property 0 'tag result) byte)
        (qa (multibyte-string-p result) nil)
        (qa (aref result 0) byte)))))
(dolist (source (list "" "abc" (unibyte-string)
                     (unibyte-string 65 255)))
  (dolist (op '(string-to-unibyte string-as-unibyte string-make-unibyte))
    (qa (eq source (funcall op source)) t)))
(dolist (source (list (string-to-multibyte "") (string-to-multibyte "abc")
                     (string #x100) (string #x3fffff) (string #x110007)))
  (dolist (op '(string-as-multibyte string-to-multibyte))
    (qa (eq source (funcall op source)) t)))
(let ((source (propertize (string #x100 #x110007) 'tag 'value)))
  (qa (get-text-property 0 'tag (string-as-multibyte source)) 'value))
;; Actual conversions allocate a copy and omit properties.
(dolist (op '(string-to-unibyte string-as-unibyte string-make-unibyte))
  (let* ((source (propertize (string-to-multibyte "abc") 'tag 'value))
         (result (funcall op source)))
    (qa (eq source result) nil)
    (qa (multibyte-string-p result) nil)
    (qa (text-properties-at 0 result) nil)
    (qa (get-text-property 0 'tag source) 'value)))
(let* ((source (propertize (unibyte-string 65) 'tag 'value))
       (result (string-as-multibyte source)))
  (qa (eq source result) nil)
  (qa (multibyte-string-p result) t)
  (qa (text-properties-at 0 result) nil))
(dolist (op '(string-to-unibyte string-as-unibyte string-make-unibyte string-as-multibyte))
  (qa-err-data (funcall op 42) 'wrong-type-argument '(stringp 42)))
(princ (qa--done))
