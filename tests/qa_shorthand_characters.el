;;; -*- lexical-binding: t; -*-
(defun qa-shorthand-characters (mode)
  (mapcar
   (lambda (code)
     (let* ((obarray (obarray-make))
            (read-symbol-shorthands (list (cons "s-" (string code))))
            (symbol (if (eq mode 'buffer)
                        (with-temp-buffer (insert "s-x") (goto-char 1) (read (current-buffer)))
                      (funcall mode "s-x")))
            (name (symbol-name symbol)))
       (list (multibyte-string-p name) (string-to-list name))))
   '(55296 1114112 4194176 4194303)))
(qa (qa-shorthand-characters 'intern)
    '((t (55296 120)) (t (1114112 120)) (t (4194176 120)) (t (4194303 120))))
(qa (qa-shorthand-characters 'buffer)
    '((t (55296 120)) (t (1114112 120)) (t (4194176 120)) (t (4194303 120))))
(qa (qa-shorthand-characters 'read)
    '((nil (237 160)) (nil (244 144)) (nil (192 128)) (nil (193 191))))
(qa (let* ((obarray (obarray-make))
           (one (intern (unibyte-string 193 191)))
           (two (intern (string #x3fffff))))
      (list (eq one two) (length (symbol-name one)) (length (symbol-name two))
            (string-bytes (symbol-name one)) (string-bytes (symbol-name two))))
    '(nil 2 1 2 2))
(princ (qa--done)) (terpri)
