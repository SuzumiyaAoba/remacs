;;; -*- lexical-binding: t; -*-
;; Basic face specs and source-load isolation, verified with GNU 31.1.
(qa (face-attribute 'fixed-pitch :family) "Monospace")
(qa (get 'fixed-pitch 'face-defface-spec) '((t :family "Monospace")))
(qa (face-attribute 'fixed-pitch :family (selected-frame)) "Monospace")
(qa (face-attribute 'fixed-pitch :family t) 'unspecified)
(qa (get 'fixed-pitch 'face-override-spec) nil)
(qa (face-attribute 'default :fontset) 'unspecified)
(qa (face-id 'default) 0)
(qa (featurep 'icons) nil)
(qa (get 'icon 'face-defface-spec) nil)
(qa (get 'icon-button 'face-defface-spec) nil)
(qa (get 'icon 'face) nil)
(qa (get 'icon-button 'face) nil)
(qa (gethash 'icon face--new-frame-defaults) nil)
(qa (gethash 'icon-button face--new-frame-defaults) nil)
(qa (facep 'icon) nil)
(qa (facep 'icon-button) nil)
(qa (memq 'icon (face-list)) nil)
(qa (memq 'icon-button (face-list)) nil)
(defvar qa--face-file nil)
(let ((qa--face-file (make-temp-file "qa-basic-faces-" nil ".el")))
  (unwind-protect
      (progn
        (with-temp-file qa--face-file
          (insert ";;; -*- lexical-binding: t; -*-\n(+ 1 2)\n"))
        (qa (load qa--face-file nil t t) t)
        (qa (facep 'icon) nil)
        (qa (facep 'icon-button) nil)
        (with-temp-file qa--face-file
          (insert ";;; -*- lexical-binding: t; -*-\n(error \"qa source failure\")\n"))
        (qa-err (load qa--face-file nil t t) 'error)
        (qa (facep 'icon) nil)
        (qa (facep 'icon-button) nil))
    (delete-file qa--face-file)))
(let ((theme (get 'fixed-pitch 'theme-face)))
  (unwind-protect
      (progn
        (put 'fixed-pitch 'theme-face
             '((qa-face-theme ((t :family "QA Theme Mono")))))
        (face-spec-recalc 'fixed-pitch (selected-frame))
        (qa (face-attribute 'fixed-pitch :family) "QA Theme Mono")
        (qa (get 'fixed-pitch 'face-override-spec) nil)
        (put 'fixed-pitch 'theme-face nil)
        (face-spec-recalc 'fixed-pitch (selected-frame))
        (qa (face-attribute 'fixed-pitch :family) "Monospace"))
    (put 'fixed-pitch 'theme-face theme)
    (face-spec-recalc 'fixed-pitch (selected-frame))))
(let ((old (face-attribute 'fixed-pitch :family)))
  (unwind-protect
      (progn
        (set-face-attribute 'fixed-pitch nil :family "QA Mono")
        (qa (face-attribute 'fixed-pitch :family) "QA Mono")
        (qa (get 'fixed-pitch 'face-defface-spec) '((t :family "Monospace")))
        (face-spec-set 'fixed-pitch (get 'fixed-pitch 'face-defface-spec)
                       'face-defface-spec)
        (qa (face-attribute 'fixed-pitch :family) "Monospace"))
    (set-face-attribute 'fixed-pitch nil :family old)))
(qa (require 'icons) 'icons)
(qa (not (null (facep 'icon))) t)
(qa (not (null (facep 'icon-button))) t)
(qa (face-attribute 'icon :underline) nil)
(qa (integerp (face-id 'icon)) t)
(qa (integerp (face-id 'icon-button)) t)
(set-face-attribute 'icon nil :underline t)
(qa (require 'icons) 'icons)
(qa (face-attribute 'icon :underline) t)
(qa (load "icons" nil t) t)
(qa (face-attribute 'icon :underline) t)
(qa (face-id 'default) 0)
(princ (qa--done)) (terpri)
