;; lists2 — destructive list ops, sharing semantics, places.  GNU-verified:
;; rplaca/rplacd return NEWVAL (like setcar/setcdr), not the cell, in 31.1.
;; nreverse on a string returns a NEW string (strings are not modified in
;; place); on lists/vectors it mutates.  delq/delete only relink cdrs, so a
;; variable holding the head is left stale when the head is deleted.
;; nconc's last argument may be anything; every earlier arg must be a cons.
;; mapcan requires list results (error consp otherwise).  length</length=
;; count conses of a dotted list without error, unlike length.
;; add-to-ordered-list needs a SPECIAL variable (symbol-value) and stores
;; the order in the element's `list-order' symbol property; elements stay
;; bare.  alist-get's value is the pair's CDR (setfable as a place; REMOVE
;; arg deletes the pair).  pushnew/remove-if/list* are NOT defined in 31.1
;; (cl-pushnew/cl-remove-if/cl-list* are).  copy-alist copies each pair but
;; shares nested cars/cdrs; copy-tree copies conses recursively but shares
;; vectors; copy-sequence copies only the top conses.
(require 'cl-lib)

;; == rplaca/rplacd: return the NEW value (like setcar/setcdr) ==
(let ((l (list 'a 'b)))
  (qa (rplaca l 'x) 'x)
  (qa l '(x b)))
(let ((l (list 'a 'b)))
  (qa (rplacd l 'x) 'x)
  (qa l '(a . x)))
(let ((l (list 'a 'b)))
  (qa (rplacd l (list 'z)) '(z))
  (qa l '(a z)))
(let ((l (list 'a 'b)))
  (qa-same (eq (rplaca l 'x) l) nil))
(qa-err-data (rplaca 'x 'y) 'wrong-type-argument '(consp x))
(qa-err-data (rplacd 'x 'y) 'wrong-type-argument '(consp x))
(qa-err-data (rplaca nil 'y) 'wrong-type-argument '(consp nil))
(let ((l (list 'a 'b)))
  (qa (setcar l 'x) 'x))
(let ((l (list 'a 'b)))
  (qa (setcdr l 'x) 'x))

;; == nconc: multi-arg flattening; only the LAST arg may be a non-list ==
(qa (nconc (list 'a) (list 'b) (list 'c)) '(a b c))
(qa (nconc nil nil 'x) 'x)
(qa (nconc 'x) 'x)
(qa (nconc (list 'a)) '(a))
(qa (nconc (list 'a) [1 2]) '(a . [1 2]))
(qa-err-data (nconc (list 'a) 'x (list 'b)) 'wrong-type-argument '(consp x))
(qa-err-data (nconc [1] '(2)) 'wrong-type-argument '(consp [1]))
(qa-err-data (nconc 5 nil) 'wrong-type-argument '(consp 5))

;; == circular lists via nconc ==
(let ((l (list 1)))
  (nconc l l)
  (qa (safe-length l) 1)
  (qa (proper-list-p l) nil)
  (qa (listp l) t))
(let ((l (list 1 2 3)))
  (nconc l l)
  (qa (safe-length l) 5)
  (qa (length= l 6) nil)
  (qa (length< l 100) nil)
  (qa (length> l 2) t))
(let ((l (list 1)))
  (setcdr l l)
  (qa (listp l) t)
  (qa (proper-list-p l) nil))

;; == nreverse / reverse: mutation vs fresh ==
(let* ((l (list 1 2 3)) (lastc (cddr l)))
  (qa-same (nreverse l) lastc))
(let ((l (list 'a)))
  (qa-same (nreverse l) l))
(let ((l (list 'a 'b 'c)))
  (reverse l)
  (qa l '(a b c)))
(let ((s (copy-sequence "abc")))
  (let ((r (nreverse s)))
    (qa r "cba")
    (qa s "abc")
    (qa-same (eq r s) nil)))
(let ((v (vector 3 1 2)))
  (qa (nreverse v) [2 1 3])
  (qa v [2 1 3]))
(qa (nreverse nil) nil)
(qa (nreverse [1]) [1])
(qa-err-data (nreverse '(a b . c)) 'wrong-type-argument '(listp (a)))
(qa-err-data (reverse '(a b . c)) 'wrong-type-argument '(listp c))

;; == butlast/nbutlast: fresh copy vs in-place truncation ==
(let ((l (list 'a 'b 'c)))
  (qa (butlast l 1) '(a b))
  (qa l '(a b c))
  (qa-same (eq (butlast l 1) l) nil))
(let ((l (list 'a 'b 'c)))
  (qa-same (nbutlast l 1) l)
  (qa l '(a b)))
(let ((l (list 'a 'b 'c)))
  (qa (nbutlast l 0) '(a b c))
  (qa l '(a b c)))
(let ((l (list 'a)))
  (qa (butlast l) nil)
  (qa l '(a)))
(let ((l (list 'a 'b)))
  (qa (nbutlast l) '(a))
  (qa l '(a)))
(qa-err-data (nbutlast '(a b . c)) 'wrong-type-argument '(listp c))
(qa-err-data (nbutlast '(a b . c) 2) 'wrong-type-argument '(listp c))
(let ((l (list 'a 'b 'c)))
  (qa-same (last l) (cddr l)))

;; == delq/delete/delete-dups: head cell stays stale, mid removal relinks ==
(let ((l (list 'a 'b 'a 'c)))
  (qa (delq 'a l) '(b c))
  (qa l '(a b c)))
(let ((l (list 'a 'b 'c)))
  (qa (delq 'b l) '(a c))
  (qa l '(a c)))
(let ((l (list 'a 'a)))
  (qa (delq 'a l) nil)
  (qa l '(a a)))
(let ((l (list 'a)))
  (qa (delq 'a l) nil)
  (qa l '(a)))
(let ((l (list 'a 'b 'a)))
  (qa (delete 'a l) '(b))
  (qa l '(a b)))
(let ((l (list 'a 'b 'a)))
  (qa (delete-dups l) '(a b))
  (qa l '(a b)))
(qa (delete-dups nil) nil)
(let ((l (list 'a 'b)))
  (qa-same (delq 'z l) l))
(qa-err-data (delq 'z '(a b . c)) 'wrong-type-argument '(listp (a b . c)))
(qa-err-data (delete-dups '(a b . c)) 'wrong-type-argument '(listp c))

;; == delete/remove on vectors and strings: fresh objects ==
(let ((v (vector 1 2 1)))
  (qa (delete 1 v) [2])
  (qa v [1 2 1]))
(let ((s (copy-sequence "aba")))
  (let ((r (delete ?a s)))
    (qa r "b")
    (qa s "aba")
    (qa-same (eq r s) nil)))
(qa (remove 1 [1 2 1]) [2])
(qa (remove ?a "aba") "b")

;; == memq/member: returned tail shares structure; dotted lists ==
(let ((l (list 'a 'b 'c)))
  (qa-same (memq 'b l) (cdr l)))
(let ((l (list "a" "b")))
  (qa-same (member "b" l) (cdr l)))
(qa (memq 'b '(a b . c)) '(b . c))
(qa-err-data (memq 'a '(x y . z)) 'wrong-type-argument '(listp (x y . z)))
(qa (member-ignore-case 'a '(a b)) nil)
(qa (member-ignore-case 65 '(65)) nil)
(qa (member-ignore-case "a" '((a) "a")) '("a"))

;; == assoc family: shared elements, nil keys, non-cons elements ==
(let* ((pr (cons 'b 2)) (al (list (cons 'a 1) pr)))
  (qa-same (assoc 'b al) pr))
(qa (assoc nil '((nil . 1) (a . 2))) '(nil . 1))
(qa (assq nil '((nil) (a . 2))) '(nil))
(qa (assoc 'a '((nil . 1) (a . 2))) '(a . 2))
(qa (assoc "a" '(("a" . 1)) nil) '("a" . 1))
(qa (assoc 'b '((a . 1) (b . 2)) #'eql) '(b . 2))
(qa (assoc 1 '((1 . x)) #'=) '(1 . x))
(qa (rassq 2 '((a . 1) (b . 2) (c . 2))) '(b . 2))
(qa (rassoc '(2) '((b 2))) '(b 2))

;; == assq-delete-all: stale head cell, mid removal relinks ==
(let* ((p1 (cons 'a 1)) (p2 (cons 'b 2)) (al (list p1 p2)))
  (qa (assq-delete-all 'a al) '((b . 2)))
  (qa al '((a . 1) (b . 2))))
(let* ((p1 (cons 'x 0)) (p2 (cons 'a 1)) (al (list p1 p2)))
  (let ((r (assq-delete-all 'a al)))
    (qa-same r al)
    (qa al '((x . 0)))))
(qa (fboundp 'assoc-delete-all) t)

;; == alist-get: value is the CDR; place forms ==
(qa (alist-get 'a '((a 1 2))) '(1 2))
(qa (alist-get 'a '((a))) nil)
(qa (alist-get 'a '(a (a . 2))) 2)
(let ((al (list (cons 'a 1))))
  (setf (alist-get 'a al) 9)
  (qa al '((a . 9))))
(let ((al (list (cons 'a 1))))
  (setf (alist-get 'b al) 5)
  (qa al '((b . 5) (a . 1))))
(let ((al nil))
  (setf (alist-get 'a al) 1)
  (qa al '((a . 1))))
(let ((al (list (cons "a" 1))))
  (setf (alist-get "a" al nil nil #'equal) 9)
  (qa al '(("a" . 9))))
(let ((al (list (cons 'a 1))))
  (push 'v (alist-get 'a al))
  (qa al '((a v . 1))))
(let ((al (list (cons 'a (list 1 2)) (cons 'b 2))))
  (qa (pop (alist-get 'a al)) 1)
  (qa al '((a 2) (b . 2))))
(let ((al (list (cons 'a 1) (cons 'b 2))))
  (qa-err-data (pop (alist-get 'a al)) 'wrong-type-argument '(listp 1)))
(let ((al (list (cons 'a 1) (cons 'b 2))))
  (setf (alist-get 'a al nil t) nil)
  (qa al '((b . 2))))
(let ((al (list (cons 'a 1))))
  (incf (alist-get 'a al))
  (qa al '((a . 2))))

;; == add-to-ordered-list: needs a SPECIAL variable (symbol-value); the
;; per-element orders live in a weak-key hash table stored in LIST-VAR's
;; `list-order' property.  Numbered elements sort ascending (equal orders:
;; newest first); elements without an order go last, insertion order.
(defvar qa2-aol nil)
(let ((qa2-aol nil))
  (qa (add-to-ordered-list 'qa2-aol 'qa2-oa) '(qa2-oa))
  (qa qa2-aol '(qa2-oa)))
(let ((qa2-aol nil))
  (add-to-ordered-list 'qa2-aol 'qa2-oc 5)
  (add-to-ordered-list 'qa2-aol 'qa2-oa 1)
  (add-to-ordered-list 'qa2-aol 'qa2-ob 3)
  (qa qa2-aol '(qa2-oa qa2-ob qa2-oc)))
(let ((qa2-aol nil))
  (add-to-ordered-list 'qa2-aol 'qa2-oa)
  (add-to-ordered-list 'qa2-aol 'qa2-ob)
  (qa qa2-aol '(qa2-oa qa2-ob)))
;; re-adding an eq element dedups and updates its order
(let ((qa2-aol nil))
  (add-to-ordered-list 'qa2-aol 'qa2-om 3)
  (let ((r (add-to-ordered-list 'qa2-aol 'qa2-om 5)))
    (qa-same r qa2-aol)
    (qa qa2-aol '(qa2-om))))
;; equal orders: the newer element sorts first
(let ((qa2-aol nil))
  (add-to-ordered-list 'qa2-aol 'qa2-oe 1)
  (add-to-ordered-list 'qa2-aol 'qa2-of 1)
  (qa qa2-aol '(qa2-of qa2-oe)))
;; ordered elements precede unordered ones; unordered keep insert order
(let ((qa2-aol nil))
  (add-to-ordered-list 'qa2-aol 'qa2-og)
  (add-to-ordered-list 'qa2-aol 'qa2-oh 99)
  (qa qa2-aol '(qa2-oh qa2-og)))
;; float orders work
(let ((qa2-aol nil))
  (add-to-ordered-list 'qa2-aol 'qa2-oi 1.5)
  (add-to-ordered-list 'qa2-aol 'qa2-oj 1)
  (qa qa2-aol '(qa2-oj qa2-oi)))
;; non-cons elements of the starting list are just unordered entries
(let ((qa2-aol '((qa2-ox . 9))))
  (add-to-ordered-list 'qa2-aol 'qa2-oy 5)
  (qa qa2-aol '(qa2-oy (qa2-ox . 9))))
;; orders are stored in a weak-key hash table on LIST-VAR's `list-order'
(let ((qa2-aol nil))
  (add-to-ordered-list 'qa2-aol 'qa2-ok 7)
  (qa (hash-table-p (get 'qa2-aol 'list-order)) t)
  (qa (hash-table-weakness (get 'qa2-aol 'list-order)) 'key)
  (qa (gethash 'qa2-ok (get 'qa2-aol 'list-order)) 7))
;; a non-numeric ORDER removes the element's recorded order
(let ((qa2-aol nil))
  (add-to-ordered-list 'qa2-aol 'qa2-ol 3)
  (add-to-ordered-list 'qa2-aol 'qa2-ol 'sym)
  (qa (gethash 'qa2-ol (get 'qa2-aol 'list-order)) nil))

;; == cl-list* (bare `list*' is not defined in 31.1) ==
(qa (fboundp 'list*) nil)
(qa (fboundp 'pushnew) nil)
(qa (fboundp 'remove-if) nil)
(qa (cl-list* 'a) 'a)
(qa (cl-list* 'a 'b) '(a . b))
(qa (cl-list* 'a 'b 'c) '(a b . c))
(qa (cl-list* 'a 'b '(c d)) '(a b c d))
(qa (cl-list* 'a nil) '(a))
(qa (cl-list* nil nil) '(nil))
(qa-err-data (cl-list*) 'wrong-number-of-arguments '(cl-list* 0))

;; == push/pop/setf on places ==
(let ((l (list (list 'a 'b) 'x)))
  (pop (car l))
  (qa l '((b) x)))
(let ((l (list 'a 'b 'c)))
  (qa (pop (cdr l)) 'b)
  (qa l '(a c)))
(let ((l (list 'a 'b 'c)))
  (setf (nth 1 l) 'x)
  (qa l '(a x c)))
(let ((l (list 'a 'b)))
  (setf (car l) 'x)
  (qa l '(x b)))
(let ((l (list 'a 'b)))
  (setf (cdr l) 'x)
  (qa l '(a . x)))
(let ((l (list 'a 'b 'c)))
  (push 'z (nth 1 l))
  (qa l '(a (z . b) c)))
(let ((l (list 'a)))
  (cl-pushnew 'b (cdr l))
  (qa l '(a b)))
(let ((l (list 'a 'b)))
  (qa (cl-pushnew 'a l) '(a b)))
(let ((l (list 'a)))
  (qa (cl-pushnew "a" l :test #'equal) '("a" a)))
(let ((l nil))
  (cl-pushnew 'x l)
  (qa l '(x)))

;; == cons/list basics ==
(qa (cons 1 2) '(1 . 2))
(qa (cons 'a nil) '(a))
(qa (list) nil)
(qa (car nil) nil)
(qa (cdr nil) nil)

;; == nth/nthcdr extras ==
(qa (nthcdr -3 '(a b)) '(a b))
(qa (nth -3 '(a b)) 'a)
(let ((l (list 'a)))
  (qa-same (nthcdr 1 l) nil))
(qa-err-data (nthcdr 1 "ab") 'wrong-type-argument '(listp "ab"))

;; == copying depth ==
(let* ((l (list 'a 'b)) (r (copy-sequence l)))
  (qa-same (eq r l) nil)
  (qa-same (car r) (car l))
  (qa-same (eq (cdr r) (cdr l)) nil))
(let* ((inner (list 'x)) (l (list inner)))
  (qa-same (car (copy-sequence l)) inner)
  (qa-same (eq (car (copy-tree l)) inner) nil))
(let* ((v (vector 1)) (l (list v)))
  (qa-same (car (copy-tree l)) v))
(qa (copy-tree '(a . b)) '(a . b))
(qa (copy-tree nil) nil)
(qa (copy-tree 'x) 'x)
(qa-err-data (copy-sequence '(a b . c)) 'wrong-type-argument '(listp c))
(qa-err-data (copy-sequence '(a . b)) 'wrong-type-argument '(listp b))
(qa (copy-sequence nil) nil)
(qa-err-data (copy-sequence 5) 'wrong-type-argument '(sequencep 5))
(let* ((inner (list 'x)) (el (cons inner 1)) (al (list el)) (cp (copy-alist al)))
  (qa-same (eq (car cp) el) nil)
  (qa-same (caar cp) inner)
  (qa cp '(((x) . 1))))
(qa (copy-alist '(a (b . 2))) '(a (b . 2)))
(qa-err-data (copy-alist 'x) 'wrong-type-argument '(listp x))
(qa-err-data (copy-alist '(a b . c)) 'wrong-type-argument '(listp c))

;; == mapcan/mapc on non-lists; mapcan shares fn results ==
(qa (mapcan #'list "ab") '(97 98))
(qa (mapcan #'list [1 2]) '(1 2))
(let ((r (list 'a 'b)))
  (qa-same (mapcan #'identity (list r)) r))
(qa-err-data (mapcan #'identity '(a b)) 'wrong-type-argument '(consp a))
(qa-err-data (mapcan #'1+ '(1 2)) 'wrong-type-argument '(consp 2))
(qa-err-data (mapcan #'list '(a . b)) 'wrong-type-argument '(listp b))
(qa-err (mapcar #'1+ (make-hash-table)) 'wrong-type-argument)
(qa-err (mapc #'1+ (make-hash-table)) 'wrong-type-argument)
(qa (mapc #'1+ "ab") "ab")
(qa (mapc #'1+ [1 2]) [1 2])
(qa (mapc #'1+ nil) nil)
(let ((acc nil))
  (qa (mapc (lambda (x) (push x acc)) '(1 2)) '(1 2)))

;; == length< / length> / length= on dotted lists count conses, no error ==
(qa (length< '(a b . c) 5) t)
(qa (length> '(a b . c) 1) t)
(qa (length= '(a b . c) 2) t)
(qa (length= '(a) -1) nil)
(qa (length< '(a) -1) nil)
(qa (length> nil -1) t)
(qa (length= nil 0) t)
(qa (list (safe-length 'a) (safe-length [1 2]) (safe-length "ab") (safe-length 5))
    '(0 0 0 0))

;; == equal/eq/eql on lists ==
(qa (eq (list 'a) (list 'a)) nil)
(qa (equal '(a (b)) '(a (b))) t)
(qa (equal '(a . b) '(a b)) nil)
(qa (equal '(a . b) '(a . b)) t)
(qa (equal '(1) [1]) nil)
(qa (equal '((a . 1) (b . 2)) '((a . 1) (b . 2))) t)
(qa (eql 1 1.0) nil)
(qa (eql "a" "a") nil)
(qa (eql 1.0 1.0) t)
(qa-same nil '())

;; == make-list: shared elements, edge lengths ==
(qa (make-list 0 'x) nil)
(qa (make-list 3 nil) '(nil nil nil))
(qa-err-data (make-list -1 'x) 'wrong-type-argument '(wholenump -1))
(let* ((x (list 'z)) (l (make-list 2 x)))
  (qa-same (car l) (cadr l)))

;; == deep c*r chains ==
(qa (caaar '(((a)))) 'a)
(qa (cadar '((a b))) 'b)
(qa (cdaar '(((a . b)))) 'b)
(qa (caddr '(a b c d)) 'c)
(qa (cdddr '(a b c d)) '(d))
(qa (cadadr '(a (b c))) 'c)
(qa (caadr '(a (b . c))) 'b)
(qa (cdadr '(a (b . c))) 'c)
(qa (cddadr '(a (b c) d)) nil)
(qa (cddr '(a)) nil)
(qa-err-data (caar 'a) 'wrong-type-argument '(listp a))
(qa-err-data (cddddr 'a) 'wrong-type-argument '(listp a))

;; == predicates on assorted types ==
(qa (list (consp "ab") (consp '(a . b)) (atom 5) (atom nil)
          (nlistp [1]) (listp 'x) (listp '(a b . c)) (null '(a)))
    '(nil t t t t nil t nil))
(let ((h (make-hash-table)))
  (qa (list (atom h) (consp h) (listp h) (nlistp h)) '(t nil nil t)))
(qa (list (atom #'car) (consp #'car) (listp #'car)) '(t nil nil))
(qa (list (consp (make-bool-vector 2 t)) (nlistp (make-bool-vector 2 t)))
    '(nil t))

;; == add-to-list: compare-fn, return values ==
(let ((l (list "a")))
  (add-to-list 'l "a" nil #'eq)
  (qa l '("a" "a")))
(let ((l (list 'a 'b)))
  (qa (add-to-list 'l 'a) '(a b)))
(let ((l (list 'a)))
  (qa (add-to-list 'l 'a 'append) '(a)))
(let ((l nil))
  (add-to-list 'l 'a nil #'equal)
  (qa l '(a)))

;; == append: mid args must be lists, last arg anything ==
(qa-err-data (append '(a) 'b '(c)) 'wrong-type-argument '(sequencep b))
(qa-err-data (append 'a 'b) 'wrong-type-argument '(sequencep a))

(princ (qa--done))
