;;; -*- lexical-binding: nil; -*-
;; maphash reads each live slot after the previous callback (#537).
(dolist (scenario '(update remove clear append reuse-next reuse-current clear-insert))
  (let ((table (make-hash-table :test 'eq :size 8)) (seen nil))
    (puthash 'a 1 table)
    (puthash 'b 2 table)
    (puthash 'c 3 table)
    (qa (maphash
         (lambda (key value)
           (push (cons key value) seen)
           (when (eq key 'a)
             (cond
              ((eq scenario 'update) (puthash 'b 20 table))
              ((eq scenario 'remove) (remhash 'b table))
              ((eq scenario 'clear) (clrhash table))
              ((eq scenario 'append) (puthash 'd 4 table))
              ((eq scenario 'reuse-next)
               (remhash 'b table) (puthash 'd 4 table))
              ((eq scenario 'reuse-current)
               (remhash 'a table) (puthash 'd 4 table))
              (t (clrhash table) (puthash 'd 4 table) (puthash 'e 5 table)))))
         table)
        nil)
    (qa (nreverse seen)
        (cond ((eq scenario 'update) '((a . 1) (b . 20) (c . 3)))
              ((eq scenario 'remove) '((a . 1) (c . 3)))
              ((eq scenario 'clear) '((a . 1)))
              ((eq scenario 'append) '((a . 1) (b . 2) (c . 3) (d . 4)))
              ((eq scenario 'reuse-next) '((a . 1) (d . 4) (c . 3)))
              ((eq scenario 'reuse-current) '((a . 1) (b . 2) (c . 3)))
              (t '((a . 1) (e . 5)))))))
;; Separate cursors for nested traversals; updates remain live in both.
(let ((table (make-hash-table)) (outer nil) (inner nil))
  (puthash 'a 1 table) (puthash 'b 2 table)
  (maphash (lambda (key value)
             (push (cons key value) outer)
             (when (eq key 'a)
               (maphash (lambda (nested-key nested-value)
                          (push (cons nested-key nested-value) inner)
                          (when (eq nested-key 'a) (puthash 'b 20 table)))
                        table)))
           table)
  (qa (nreverse inner) '((a . 1) (b . 20)))
  (qa (nreverse outer) '((a . 1) (b . 20))))
;; Nil is a valid key and a valid value, not an unoccupied slot.
(let ((table (make-hash-table)) (seen nil))
  (puthash nil nil table)
  (maphash (lambda (key value) (push (list key value) seen)) table)
  (qa seen '((nil nil))))
;; Callbacks may remove the entry currently being visited.
(let ((table (make-hash-table)) (seen nil))
  (dotimes (n 5) (puthash n n table))
  (maphash (lambda (key value) (push value seen) (remhash key table)) table)
  (qa (nreverse seen) '(0 1 2 3 4))
  (qa (hash-table-count table) 0))
(qa (maphash (lambda (&rest _) (error "unused")) (make-hash-table)) nil)
(qa-err-data (maphash #'ignore nil) 'wrong-type-argument '(hash-table-p nil))
(princ (qa--done))
