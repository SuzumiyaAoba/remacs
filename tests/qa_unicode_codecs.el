;; GNU Emacs 31.1 byte-exact Unicode codec regression tests.
(defun qa-unicode-codec (op coding input multibyte)
  (let* ((text (if (eq op 'encode)
                   ;; The encoder matrix uses a raw byte for 255.
                   (if (equal input '(255)) (unibyte-string 255) (apply #'string input))
                 (apply #'unibyte-string input)))
         (text (if multibyte (string-to-multibyte text) text))
         (last-coding-system-used 'before)
         (result (if (eq op 'encode) (encode-coding-string text coding)
                   (decode-coding-string text coding))))
    (list (string-to-list result) (multibyte-string-p result) last-coding-system-used)))
