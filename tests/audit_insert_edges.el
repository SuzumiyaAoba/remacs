;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "insert:insert-char-inherit-nil" '(with-temp-buffer (insert (propertize "a" 'face 'bold)) (insert-char 32 2 nil) (list (buffer-string) (get-text-property 2 'face))))
(audit-check "insert:insert-char-inherit-t" '(with-temp-buffer (insert (propertize "a" 'face 'bold)) (insert-char 32 2 t) (list (buffer-string) (get-text-property 2 'face))))
(audit-check "insert:insert-char-character--1" '(with-temp-buffer (set-buffer-multibyte nil) (list (condition-case e (progn (insert-char -1 1) 'inserted) (error (car e))) (string-to-list (buffer-string)))))
(audit-check "insert:insert-char-character-4194304" '(with-temp-buffer (set-buffer-multibyte nil) (list (condition-case e (progn (insert-char 4194304 1) 'inserted) (error (car e))) (string-to-list (buffer-string)))))
(audit-check "insert:insert-char-character-4294967361" '(with-temp-buffer (set-buffer-multibyte nil) (list (condition-case e (progn (insert-char 4294967361 1) 'inserted) (error (car e))) (string-to-list (buffer-string)))))
(audit-check "insert:insert-char-zero-readonly" '(with-temp-buffer (setq buffer-read-only t) (insert-char 65 0)))
(audit-check "insert:insert-byte-inherit-nil" '(with-temp-buffer (insert (propertize "a" 'face 'bold)) (insert-byte 32 2 nil) (list (buffer-string) (get-text-property 2 'face))))
(audit-check "insert:insert-byte-inherit-t" '(with-temp-buffer (insert (propertize "a" 'face 'bold)) (insert-byte 32 2 t) (list (buffer-string) (get-text-property 2 'face))))
(audit-check "insert:insert-byte-character--1" '(with-temp-buffer (set-buffer-multibyte nil) (list (condition-case e (progn (insert-byte -1 1) 'inserted) (error (car e))) (string-to-list (buffer-string)))))
(audit-check "insert:insert-byte-character-4194304" '(with-temp-buffer (set-buffer-multibyte nil) (list (condition-case e (progn (insert-byte 4194304 1) 'inserted) (error (car e))) (string-to-list (buffer-string)))))
(audit-check "insert:insert-byte-character-4294967361" '(with-temp-buffer (set-buffer-multibyte nil) (list (condition-case e (progn (insert-byte 4294967361 1) 'inserted) (error (car e))) (string-to-list (buffer-string)))))
(audit-check "insert:insert-byte-zero-readonly" '(with-temp-buffer (setq buffer-read-only t) (insert-byte 65 0)))
(audit-check "insert:indent-to-inherit" '(with-temp-buffer (insert (propertize "a" 'face 'bold)) (indent-to 4) (list (buffer-string) (get-text-property 2 'face))))
(audit-check "insert:indent-negative-minimum" '(with-temp-buffer (insert "abc") (list (indent-to 0 -1) (current-column))))
(audit-check "insert:newline-inherit" '(with-temp-buffer (insert (propertize "a" 'face 'bold)) (newline) (list (buffer-string) (get-text-property 2 'face))))
(audit-check "insert:indent-front-sticky" '(with-temp-buffer (insert (propertize "a" 'face 'bold 'front-sticky '(face))) (goto-char 1) (indent-to 3) (get-text-property 1 'face)))
(audit-check "insert:indent-rear-nonsticky" '(with-temp-buffer (insert (propertize "a" 'face 'bold 'rear-nonsticky '(face))) (indent-to 3) (get-text-property 2 'face)))
(audit-check "insert:inherit-hook" '(with-temp-buffer (insert (propertize "a" 'face 'bold)) (let* ((observed nil) (after-change-functions (list (lambda (beg end old) (setq observed (get-text-property beg 'face)))))) (insert-char 32 1 t) observed)))
(princ "AUDIT-DONE\n")
