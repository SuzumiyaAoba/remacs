;;; -*- lexical-binding: nil; -*-
;; Issue #16: readable symbol spellings match GNU and round-trip.
(dolist (escape '(nil t))
  (let ((print-escape-control-characters escape)
        (print-escape-newlines escape)
        (print-escape-multibyte escape)
        (print-gensym t))
    (dolist (row '(
    ("?a" "\\?a")
    ("?" "\\?")
    ("??" "\\??")
    ("? " "\\?\\ ")
    ("?日本" "\\?日本")
    ("a?b" "a?b")
    ("..a" "\\..a")
    (".." "\\..")
    ("..." "\\...")
    ("." "\\.")
    (". 5" "\\.\\ 5")
    (".\\ 5" "\\.\\\\\\ 5")
    (".a" ".a")
    (".Z" ".Z")
    (".é" "\\.é")
    (".9a" "\\.9a")
    ("._" "\\._")
    ("./" "\\./")
    (".!" "\\.!")
    ("a.b" "a.b")
    ("52" "\\52")
    ("-1" "\\-1")
    (".5" "\\.5")
    ("+2.0" "\\+2.0")
    ("a b" "a\\ b")
    ("a\\b" "a\\\\b")
    ("a\n" "a\\\n")
    ("\u0000" "\\\u0000")
    ("" "")
    ("ab" "ab")
    (" " "\\ ")
    ("日本" "日本")
    ("nil" "nil")
    ("t" "t")))
      (let* ((name (car row)) (expected (nth 1 row))
             (symbol (intern name)) (uninterned (make-symbol name)))
        (qa (prin1-to-string symbol) expected)
        (qa (format "%S" symbol) expected)
        (qa (eq (read (prin1-to-string symbol)) symbol) t)
        (qa (prin1-to-string symbol t) name)
        (qa (prin1-to-string uninterned) (concat "#:" expected))
        (qa (symbol-name (read (prin1-to-string uninterned))) name)))))
(princ (qa--done))
