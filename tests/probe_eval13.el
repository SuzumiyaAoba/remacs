(P (charsetp 'my-alias))
(P (char-charset ?a))
(P (char-charset ?a 'ascii))
(P (char-charset ?a 'iso-latin-1))
(P (charset-after))
(P (charset-after 1))
(P (charset-after 999))
(P (condition-case e (define-charset 'my-charset [1 2 3] :invalid-code 255)
     (t (car e))))
(P (condition-case e (define-charset 'my-charset [1 2 3] :invalid-code 255
                                     :code-offset 0)
     (t (car e))))
(P (charsetp 'my-charset))
(P (condition-case e (unify-charset 'unicode) (error (car e))))
(P (condition-case e (unify-charset 'ascii) (error (car e))))
(P (encode-char ?a 'ascii))
(P (condition-case e (encode-char ?a 'iso-8859-1) (t (car e))))
(P (decode-char 'ascii 97))
(P (condition-case e (decode-char 'iso-8859-1 233) (t (car e))))
(P (decode-char 'ascii 300))
(set-keyboard-coding-system-internal 'utf-8)

;; with-output-to-string.
(P (with-output-to-string (princ "hi") (princ 5)))
(P (with-output-to-string))
