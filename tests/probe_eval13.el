(P (coding-system-charset-list 'iso-latin-1))
(P (condition-case e (coding-system-charset-list 'no-such-cs) (t (car e))))
(set-coding-system-priority 'utf-8 'iso-latin-1)
(with-temp-buffer
  (insert "abc")
  (P (find-coding-systems-region-internal 1 4)))
(P (find-charset-string "abc"))
(P (find-charset-string "aé中"))
(P (find-charset-string ""))
(with-temp-buffer
