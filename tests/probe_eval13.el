(P (condition-case e (format-network-address 5) (error (car e))))

;; accept-process-output flag combinations on a live proc.
(let ((p (make-process :name "acc" :command '("cat"))))
  (process-send-string p "hey\n")
  (P (accept-process-output p 1))
  (P (accept-process-output p 0 50))
  (P (accept-process-output p 0 50 t))
  (P (accept-process-output p 0 50 nil))
  (process-send-eof p)
  (delete-process p))
(P (accept-process-output nil 0))

;; deliver_output: filter lambda, buffer target, marker mid-buffer.
(let ((p (make-process :name "fl" :command '("echo" "out")
                       :filter (lambda (pr s) (princ (format "F:%s" s))))))
  (accept-process-output p 1)
  (delete-process p))
(let ((b (get-buffer-create "pb13")))
  (let ((p (make-process :name "bf" :command '("echo" "zz") :buffer b)))
    (accept-process-output p 1)
    (P (with-current-buffer b (buffer-string)))
    (delete-process p))
  (kill-buffer b))

;; pipe processes: plist keys + send-string + eof + stop/continue.
(let ((p (make-pipe-process :name "pp" :buffer "ppb" :coding '(raw-text . raw-text)
                            :noquery t :stop t :plist '(:w 3)
                            :filter 'internal-default-process-filter
                            :sentinel 'ignore)))
  (P (process-status p))
  (P (plist-get (process-plist p) :w))
  (P (process-tty-name p))
  (P (process-command p))
  (continue-process p)
  (P (process-status p))
  (process-send-string p "data")
  (process-send-eof p)
  (P (condition-case e (signal-process p 'SIGKILL) (error (car e))))
  (delete-process p)
  (kill-buffer "ppb"))

;; serial: full key set on a pty path borrowed from a child proc.
(let* ((c (make-process :name "tty" :command '("sleep" "30")))
       (tty (process-tty-name c)))
  (let ((s (condition-case e
               (make-serial-process :name "ser" :port tty :speed 9600
                                    :bytesize 8 :parity 'none :stopbits 1
                                    :flowcontrol 'none :coding '(raw-text . raw-text)
                                    :noquery t)
             (t (car e)))))
    (P (if (processp s) (process-contact s) s))
    (P (if (processp s) (process-contact s t) 'na))
    (P (if (processp s) (process-status s) 'na))
    (if (processp s) (process-send-string s "x"))
    (P (if (processp s)
           (condition-case e (process-send-eof s) (error (car e)))
         'na))
    (if (processp s) (delete-process s)))
  (delete-process c))
(P (condition-case e (make-serial-process :name "s0" :port "/no/such" :speed 9600)
     (t (car e))))
(P (condition-case e (make-serial-process :name "s1" :port 'x :speed 9600)
     (t (car e))))
(P (condition-case e (make-serial-process :name "s2" :speed 9600)
     (t (car e))))
(P (make-serial-process))

;; send-region / send-string on a cat proc.
(let ((p (make-process :name "rg" :command '("cat") :buffer "rgb")))
  (with-temp-buffer (insert "abc") (process-send-region p 1 4))
  (process-send-string p "\n")
  (accept-process-output p 1)
  (P (with-current-buffer "rgb" (buffer-string)))
  (delete-process p)
  (kill-buffer "rgb"))

;; process-lines + set-process-buffer + process-mark mid-buffer.
(P (process-lines "echo" "l1" "l2"))
(P (process-lines "printf" "a\nb\n"))
(let ((p (make-process :name "mb" :command '("echo" "mid"))))
  (set-process-buffer p (get-buffer-create "mbb"))
  (accept-process-output p 1)
  (with-current-buffer "mbb"
    (goto-char (point-min))
    (insert "pre "))
  (P (marker-position (process-mark p)))
  (P (buffer-name (process-buffer p)))
  (delete-process p)
  (kill-buffer "mbb"))
(princ "eval13 done") (terpri)
