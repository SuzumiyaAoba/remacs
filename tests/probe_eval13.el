;; coverage probe: char-code-property descriptions, translation
;; tables, arith edges, with-output-to-string, charset internals.
(defun P (x) (prin1 x) (terpri))

;; char-code-property-description: every general-category value.
(dolist (v '(Lu Ll Lt Lm Lo Mn Mc Me Nd Nl No Pc Pd Ps Pe Pi Pf Po
             Sm Sc Sk So Zs Zl Zp Cc Cf Cs Co Cn XX))
  (P (char-code-property-description 'general-category v)))
;; bidi-class: every value.
(dolist (v '(L R AL EN ES ET AN CS NSM BN B S WS ON LRE LRO RLE RLO
             PDF LRI RLI FSI PDI XX))
  (P (char-code-property-description 'bidi-class v)))
;; Unknown property / value → nil.
(P (char-code-property-description 'nope 'x))
(P (char-code-property-description 'general-category 'nope))
(P (char-code-property-description 'bidi-class 'nope))

;; general-category of assorted ASCII chars (ascii_general_category).
(dolist (c '(?a ?Z ?0 ?9 ?\s ?! ?\( 3 ?\n ?_ ?+ ?$ ?~))
  (P (get-char-code-property c 'general-category)))
;; other char-code properties + put/get round-trip.
(P (get-char-code-property ?a 'bidi-class))
(P (get-char-code-property ?a 'decimal-digit-value))
(P (get-char-code-property ?5 'decimal-digit-value))
(P (get-char-code-property ?a 'numeric-value))
(P (get-char-code-property ?a 'mirrored))
(P (get-char-code-property ?a 'old-name))
(P (get-char-code-property ?a 'iso-10646-comment))
(P (get-char-code-property ?a 'nope-property))
;; GNU validates the property table's purpose/extras deeply; guard so the
;; probe still runs there.
(P (condition-case e (define-char-code-property 'my-prop "prop-file")
     (t (car e))))
(P (condition-case e (put-char-code-property ?q 'my-prop 'val) (t (car e))))
(P (condition-case e (get-char-code-property ?q 'my-prop) (t (car e))))
(P (condition-case e (get-char-code-property ?q 'my-prop2) (t (car e))))
(P (condition-case e (char-code-property-description 'my-prop 'val) (t (car e))))

;; translation tables.
(P (condition-case e (type-of (make-translation-table '((65 . 66) (300 . 5) (-1 . 2))))
     (t (car e))))
(define-translation-table 'tt13 '((97 . 98)))
(P (get 'tt13 'translation-table))
(P (condition-case e (type-of (set-translation-table (make-translation-table '((65 . 66)))))
     (t (car e))))
(P (condition-case e (set-translation-table nil) (t (car e))))
(let ((v (make-vector 256 nil)))
  (dotimes (k 256) (aset v k k))
  (aset v 65 900)
  (P (type-of (make-translation-table-from-vector v))))
(P (condition-case e (make-translation-table-from-vector [1 2]) (error (car e))))
(P (condition-case e (make-translation-table-from-vector 5) (error (car e))))

