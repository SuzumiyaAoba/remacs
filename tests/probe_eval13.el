;; process coverage: signals, services, plist keys, eol coding.
(dolist (sig '(SIGWINCH SIGURG SIGCONT SIGIO SIGCHLD SIGCLD SIGTSTP SIGSTOP
               SIGTTIN SIGTTOU))
  (let ((p (make-process :name "sig" :command '("sleep" "30"))))
    (P (condition-case e (signal-process p sig) (error (car e))))
    (delete-process p)))
(dolist (sig '(SIGTERM SIGKILL SIGINT SIGQUIT SIGABRT SIGHUP SIGUSR1 SIGUSR2
               SIGALRM SIGPIPE SIGILL SIGTRAP SIGBUS SIGFPE SIGSYS SIGXCPU
               SIGXFSZ SIGVTALRM SIGPROF SIGSEGV SIGEMT))
  (let ((p (make-process :name "sig" :command '("sleep" "30"))))
    (P (condition-case e (signal-process p sig) (error (car e))))
    (delete-process p)))
(let ((p (make-process :name "sig" :command '("sleep" "30"))))
  (P (signal-process p 0))
  (P (condition-case e (signal-process p 'SIGBOGUS) (error (car e))))
  (P (condition-case e (signal-process p "x") (error (car e))))
  (delete-process p))
(let ((p (make-process :name "srv" :command '("sleep" "30"))))
  (P (signal-process (process-name p) 0))
  (P (signal-process (process-name p) 'SIGTERM))
  (delete-process p))

;; service_port: named, numeric-string, integer, bogus.
;; Named services resolve but binding port 80 needs root — just cover lookup.
(P (condition-case e (make-network-process :name "n1" :server t :host "127.0.0.1"
                     :service "http") (error (car e))))
(let ((s (make-network-process :name "n2" :server t :host "127.0.0.1" :service "0")))
  (P (process-contact s :local))
  (delete-process s))
(P (condition-case e (make-network-process :name "n3" :server t :host "127.0.0.1"
                     :service "bogus") (error (car e))))
(P (condition-case e (make-network-process :name "n4" :server t :host "127.0.0.1"
                     :service 'x) (error (car e))))
(let ((d (make-network-process :name "dg" :type 'datagram :server t
                               :host "127.0.0.1" :service 0)))
  (P (process-contact d :local))
  (delete-process d))
(let ((s (condition-case e
             (make-network-process :name "npl" :server t :host "127.0.0.1"
                                   :service 0 :plist '(:a 1 :b 2)
                                   :coding '(raw-text-unix . utf-8-dos)
                                   :noquery t :nowait t)
           (error (car e)))))
  (P (if (processp s) (plist-get (process-plist s) :b) s))
  (P (if (processp s) (process-coding-system s) 'na))
  (P (if (processp s) (process-query-on-exit-flag s) 'na))
  (if (processp s) (delete-process s)))

;; finish_setup plist keys on make-process.
(let ((p (make-process :name "keys" :command '("cat")
                       :connection-type 'pipe
                       :filter (lambda (pr s) (princ (format "FLT:%s" s)))
                       :sentinel (lambda (pr ev) (princ (format "SNT:%s" ev)))
                       :coding '(utf-8-unix . utf-8-unix)
                       :noquery t :plist '(:k 9))))
  (P (plist-get (process-plist p) :k))
  (process-send-string p "x\n")
  (accept-process-output p 1)
  (delete-process p))
(let ((p (make-process :name "nq" :command '("sleep" "30") :query-on-exit nil)))
  (P (process-query-on-exit-flag p))
  (delete-process p))
(P (condition-case e (make-process :name "bad" :command '("cat") :connection-type 'nope)
     (error (car e))))

;; eol_normalize via set-process-coding-system variants.
(let ((p (make-pipe-process :name "cod")))
  (dolist (cs '((raw-text-unix . raw-text-dos) (utf-8-mac . latin-1)
                ("utf-8-dos" . "utf-8-mac") (undecided . undecided)))
    (P (condition-case e
           (progn (set-process-coding-system p (car cs) (cdr cs))
                  (process-coding-system p))
         (error (car e)))))
  (set-process-coding-system p)
  (P (process-coding-system p))
  (delete-process p))

