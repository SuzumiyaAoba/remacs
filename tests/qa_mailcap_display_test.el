;;; Preserve unsupported mailcap tests and shell DISPLAY semantics.
(require 'mailcap)

(qa (let ((process-environment (copy-sequence process-environment))
      (info (list (cons 'test "test -e /tmp/sentinel")
                  (cons "needsx11" t))))
  (setenv "DISPLAY" nil)
  (mailcap-mailcap-entry-passes-test info)
  info)
    '((test . "test -e /tmp/sentinel") ("needsx11" . t)))

(qa (let ((process-environment (copy-sequence process-environment))
      (info (list (cons 'test "test -e /tmp/sentinel"))))
  (mailcap-mailcap-entry-passes-test info)
  info)
    '((test . "test -e /tmp/sentinel")))

(qa (let ((process-environment (copy-sequence process-environment))
      (info (list (cons 'test "test -z $DISPLAY")
                  (cons "needsx11" t))))
  (setenv "DISPLAY" nil)
  (mailcap-mailcap-entry-passes-test info)
  info)
    '((test . "test -z $DISPLAY") ("needsx11" . t)))

(qa (let ((process-environment (copy-sequence process-environment))
      (info (list (cons 'test "test -n $DISPLAY"))))
  (setenv "DISPLAY" "")
  (mailcap-mailcap-entry-passes-test info)
  info)
    '((test)))

(qa (let ((process-environment (copy-sequence process-environment))
      (info (list (cons 'test "test -z $DISPLAY"))))
  (setenv "DISPLAY" "")
  (mailcap-mailcap-entry-passes-test info)
  info)
    '((test . t)))

(qa (let ((process-environment (copy-sequence process-environment))
      (info (list (cons 'test "test -n $DISPLAY"))))
  (setenv "DISPLAY" nil)
  (mailcap-mailcap-entry-passes-test info)
  info)
    '((test)))

(qa (let ((process-environment (copy-sequence process-environment))
      (info (list (cons 'test "test -z $DISPLAY"))))
  (setenv "DISPLAY" nil)
  (mailcap-mailcap-entry-passes-test info)
  info)
    '((test . t)))

(qa (let ((process-environment (copy-sequence process-environment))
      (info (list (cons 'test "test -n $DISPLAY"))))
  (setenv "DISPLAY" ":0")
  (mailcap-mailcap-entry-passes-test info)
  info)
    '((test . t)))

(qa (let ((process-environment (copy-sequence process-environment))
      (info (list (cons 'test "test -z \"$DISPLAY\""))))
  (setenv "DISPLAY" ":0")
  (mailcap-mailcap-entry-passes-test info)
  info)
    '((test)))

(princ (qa--done))
