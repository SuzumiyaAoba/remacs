(file-name-absolute-p "x")
(substitute-in-file-name "$HOME/x")
(substitute-in-file-name "plain")
(abbreviate-file-name (expand-file-name "~/abc"))
(featurep 'windowsystem)
(emacs-pid)
(recursion-depth)
(minibuffer-depth)
(condition-case e (signal 'file-error '("msg")) (error e))
(commandp 'ignore)
(special-form-p 'if)
