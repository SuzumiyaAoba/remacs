(defun qa-coding-region-state (op input coding destination &optional unibyte)
  (let ((target (and (memq destination '(buffer unibyte-buffer))
                     (generate-new-buffer " *qp-target*"))))
    (unwind-protect
        (with-temp-buffer
          (when unibyte (set-buffer-multibyte nil))
          (insert "[" input "]")
          (let ((end (1- (point-max))))
            (put-text-property 2 end 'face 'bold)
            (goto-char 3)
            (when target
              (with-current-buffer target
                (when (eq destination 'unibyte-buffer) (set-buffer-multibyte nil))
                (insert "<>") (goto-char 2)))
            (set-buffer-modified-p nil)
            (let* ((last-coding-system-used 'sentinel)
                   (dest (cond ((eq destination 'same) (current-buffer))
                               ((eq destination 'string) t)
                               (target target)))
                   (ret (funcall op 2 end coding dest)))
              (list (if (stringp ret)
                        (list (string-to-list ret) (multibyte-string-p ret)) ret)
                    (string-to-list (buffer-string)) (point)
                    enable-multibyte-characters (buffer-modified-p)
                    (mapcar (lambda (p) (get-text-property p 'face))
                            (number-sequence 1 (1- (point-max))))
                    (mapcar (lambda (p) (get-text-property p 'charset))
                            (number-sequence 1 (1- (point-max))))
                    last-coding-system-used
                    (and target (with-current-buffer target
                                  (list (string-to-list (buffer-string)) (point)
                                        enable-multibyte-characters)))))))
      (when target (kill-buffer target)))))
