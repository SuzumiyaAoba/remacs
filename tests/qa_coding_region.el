;; A coding system's Lisp conversion hooks operate on a conversion
;; buffer for pre-write and in the destination for post-read.
(defun qa-coding-region-post (n)
  (setq qa-coding-region-hook-state (list n (point) (buffer-string) buffer-undo-list))
  (insert "!")
  99)
(defun qa-coding-region-pre (s e)
  (setq qa-coding-region-hook-state (list s e (point) (buffer-string)))
  (goto-char (point-min)) (insert "!"))
(defun qa-coding-region-with-hook (encode destination)
  (let* ((key (if encode :pre-write-conversion :post-read-conversion))
         (old (coding-system-get 'utf-8 key))
         (qa-coding-region-hook-state nil))
    (unwind-protect
        (progn
          (coding-system-put 'utf-8 key (if encode #'qa-coding-region-pre #'qa-coding-region-post))
          (with-temp-buffer
            (insert "[abc]") (goto-char 6)
            (let ((r (funcall (if encode #'encode-coding-region #'decode-coding-region)
                              2 5 'utf-8 destination)))
              (list r (buffer-string) (point) qa-coding-region-hook-state))))
      (coding-system-put 'utf-8 key old))))
