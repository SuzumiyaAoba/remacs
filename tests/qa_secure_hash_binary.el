  (let ((algorithm (nth 0 row)) (size (nth 1 row)))
    (dolist (case (list (list "" (nth 2 row))
                       (list "abc" (nth 3 row))
                       (list (unibyte-string 0 128 255) (nth 4 row))))
      (let ((input (car case)) (expected (nth 1 case)))
        (qa (secure-hash algorithm input) expected)
        (qa (secure-hash algorithm input nil nil nil) expected)
        (dolist (binary '(t 0 "" arbitrary))
          (let ((digest (secure-hash algorithm input nil nil binary)))
            (qa (length digest) size)
            (qa (string-bytes digest) size)
            (qa (multibyte-string-p digest) nil)
            (qa (qa-hash-hex digest) expected)))))
    (qa (qa-hash-hex (secure-hash algorithm "xabcx" 1 4 t)) (nth 3 row))
    (with-temp-buffer
      (insert "abc")
      (let ((digest (secure-hash algorithm (current-buffer) nil nil t)))
        (qa (length digest) size)
        (qa (string-bytes digest) size)
        (qa (multibyte-string-p digest) nil)
        (qa (qa-hash-hex digest) (nth 3 row)))
      (qa (secure-hash algorithm (current-buffer)) (nth 3 row)))))
;; MD5's fourth/fifth arguments are CODING-SYSTEM/NOERROR, not BINARY.
(dolist (coding '(nil utf-8 utf-8-unix raw-text))
  (dolist (noerror '(nil t))
    (qa (md5 "abc" nil nil coding noerror) "900150983cd24fb0d6963f7d28e17f72")))
(with-temp-buffer
  (insert "abc")
  (qa (buffer-hash) "a9993e364706816aba3e25717850c26c9cd0d89d")
  (qa (buffer-hash (current-buffer)) "a9993e364706816aba3e25717850c26c9cd0d89d"))
(qa-err-data (secure-hash "sha256" "abc" nil nil t) 'wrong-type-argument '(symbolp "sha256"))
(qa-err-data (secure-hash 'bogus "abc" nil nil t) 'error '("Invalid algorithm arg: bogus"))
(qa-err-data (secure-hash 'sha256 "abc" 1.5 nil t) 'wrong-type-argument '(integerp 1.5))
(qa-err-data (secure-hash 'sha256 "abc" 0 4 t) 'args-out-of-range '("abc" 0 4))
;; Binary digests remain raw bytes when consumed by other primitives.
(qa (base64-encode-string (secure-hash 'sha256 "abc" nil nil t) t)
    "ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0=")
(qa (secure-hash 'sha256 (secure-hash 'sha256 "abc" nil nil t))
    "4f8b42c22dd3729b519ba6f68d2da7cc5b2d606d05daed5ad5128cc03e6c6358")
(princ (qa--done))
