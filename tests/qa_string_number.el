;;; -*- lexical-binding: nil; -*-
;; Issue #4: numeric prefix scanning, special floats and leading whitespace.
(dolist (case '(("1.0e+INF" "1.0e+INF")
                ("-1.0e+INF" "-1.0e+INF")
                ("2.0e+INF" "1.0e+INF")
                ("1e+INF" "1.0e+INF")
                ("1.e+INF" "1.0e+INF")
                ("-1.e+INFtail" "-1.0e+INF")
                (".0e+INF" "1.0e+INF")
                ("1.0e+INFx" "1.0e+INF")
                ("1E+INF" "1.0e+INF")
                ("0.0e+NaN" "0.0e+NaN")
                ("-0.0e+NaN" "-0.0e+NaN")
                ("1.0e+NaN" "1.0e+NaN")
                ("1.5e+NaN" "1.0e+NaN")
                ("-3.e+NaNrest" "-3.0e+NaN")
                ("1.e2" "100.0")
                ("1.e+2x" "100.0")
                ("1.e-2" "0.01")
                (".5E+2x" "50.0")
                ("1." "1")
                ("1.e" "1")
                ("1.e+" "1")
                ("1.e-NaN" "1")
                ("1e-INF" "1")
                ("1e+inf" "1")
                (".e+INF" "0")
                (".e2" "0")
                ("\n12" "0")
                ("\r12" "0")
                ("\f12" "0")
                ("\v12" "0")
                ("\u00a012" "0")
                ("\t 12" "12")
                (" \t-1.e2tail" "-100.0")))
  (let ((float-output-format nil)
        (source (car case)) (expected (cadr case)))
    (qa (prin1-to-string (string-to-number source)) expected)))

;; The reader and string conversion agree on NaN payloads and infinity.
(dolist (source '("1.5e+NaN" "-3.5e+NaN" "1.e+INF" "-1.e+INF"))
  (qa (prin1-to-string (read source))
      (prin1-to-string (string-to-number source))))
;; Other bases retain integer prefix semantics.
(qa (string-to-number "1.e+INF" 16) 1)
(qa (string-to-number "1e" 16) 30)
(qa (string-to-number "101.1e2" 2) 5)
(qa (string-to-number "++ff" 16) 0)
(qa (string-to-number "-+ff" 16) 0)
(qa (string-to-number "42" nil) 42)
(princ (qa--done))
