;;; -*- lexical-binding: t; -*-
(defvar qa224-events nil)
(defvar qa224-probe-dir (make-temp-file "qa224-insert-state-" t))
(defvar qa224-io-result)
(defvar qa224-at-start)
(defvar qa224-ret)
(defun qa224-insert-handler (operation filename &rest args)
  (push (list 'handler operation args) qa224-events)
  (insert "ABC")
  (when qa224-at-start (goto-char (point-min)))
  qa224-ret)
(put 'qa224-insert-handler 'operations '(insert-file-contents))
(let ((old-aifs (symbol-function 'after-insert-file-set-coding))
      (old-format (symbol-function 'format-decode)))
  (unwind-protect
      (progn
	(fset 'after-insert-file-set-coding (lambda (n visit) (push (list 'coding n visit (point)) qa224-events) nil))
	(fset 'format-decode (lambda (_ n visit) (push (list 'format n visit (point)) qa224-events) n))
	(dolist (literal '(nil t))
	  (dolist (visit '(nil t))
	    (dolist (replace '(nil t))
	      (dolist (qa224-at-start '(nil t))
		(dolist (return-kind '(list nil sentinel))
		  (with-temp-buffer
		    (let* ((file-name-handler-alist '(("qa224:" . qa224-insert-handler)))
			   (qa224-events nil)
			   (last-coding-system-used 'raw-text)
			   (after-insert-file-functions (list (lambda (n) (push (list 'after n (point)) qa224-events) nil)))
			   (qa224-ret (cond ((eq return-kind 'list) (list "qa224:ret" 3)) ((eq return-kind 'sentinel) 'sentinel))))
		      (setq buffer-file-name (expand-file-name "old" qa224-probe-dir))
		      (let ((result (funcall (if literal #'insert-file-contents-literally #'insert-file-contents)
					     "qa224:file" visit nil nil replace)))
			(setq qa224-io-result result)
			(qa (list qa224-io-result (eq qa224-io-result qa224-ret)
				  (point) (buffer-modified-p) buffer-file-name
				  last-coding-system-used (buffer-string) (nreverse qa224-events))
			    (let ((count (if (and qa224-at-start (eq return-kind 'list)) 3 0)))
			      (list (or qa224-ret (list (expand-file-name "qa224:file") 0))
				    (not (null qa224-ret)) (if qa224-at-start 1 4)
				    (not visit) (expand-file-name "old" qa224-probe-dir) 'raw-text "ABC"
				    (append (list (list 'handler 'insert-file-contents (list visit nil nil replace))
						  (list 'coding count visit (if qa224-at-start 1 4)))
					    (when (> count 0)
					      (append (list (list 'format 3 visit 1))
						      (unless literal (list '(after 3 1))))))))))))))))))
    (fset 'after-insert-file-set-coding old-aifs)
    (fset 'format-decode old-format)
    (delete-directory qa224-probe-dir t)))

(defvar qa224-filename)
(defun qa224-write-handler (operation &rest args)
  (push (cons operation args) qa224-events) 'handled)
(put 'qa224-write-handler 'operations '(write-region))
(let* ((root (make-temp-file "qa224-write-state-" t))
       (default-directory (file-name-as-directory root)))
  (unwind-protect
      (dolist (start-kind '(string nil reversed markers))
	(dolist (visit '(nil t quiet "qa224:visit"))
	  (dolist (explicit-lock '(nil lock))
	    (dolist (handler-kind '(filename visit))
	      (when (or (eq handler-kind 'filename) (stringp visit))
		(with-temp-buffer
		  (insert "abcdef")
		  (let* ((qa224-events nil)
			 (file-name-handler-alist '(("qa224:" . qa224-write-handler)))
			 (write-region-annotate-functions (list (lambda (_ _) (push 'annotation qa224-events) nil)))
			 (qa224-filename (if (eq handler-kind 'filename) "qa224:file" "local"))
			 (start (cond ((eq start-kind 'string) "body") ((eq start-kind 'nil) nil) ((eq start-kind 'markers) (copy-marker 5)) (t 5)))
			 (end (cond ((memq start-kind '(string nil)) 'ignored) ((eq start-kind 'markers) (copy-marker 2)) (t 2))))
		    (setq buffer-file-name (expand-file-name "old" root))
		    (setq buffer-file-truename (expand-file-name "old-truename" root))
		    (let ((result (write-region start end qa224-filename nil visit explicit-lock)))
		      (setq qa224-io-result result)
		      (qa (list qa224-io-result (buffer-modified-p) buffer-file-name buffer-file-truename
				(file-exists-p (expand-file-name qa224-filename)) (nreverse qa224-events))
			  (let* ((visiting (or (eq visit t) (stringp visit)))
				 (path (expand-file-name qa224-filename))
				 (visit-path (if (stringp visit) (expand-file-name visit) path)))
			    (list 'handled (not visiting)
				  (if visiting visit-path (expand-file-name "old" root))
				  (expand-file-name "old-truename" root) nil
				  (list (list 'write-region
					      (cond ((eq start-kind 'string) "body") ((eq start-kind 'nil) nil) (t 2))
					      (if (memq start-kind '(string nil)) 'ignored 5)
					      path nil visit (or explicit-lock visit-path) nil))))))))))))
	(delete-directory root t))))

(defvar qa224-literal-error nil)
(defun qa224-inspect-literal (_operation &rest _args)
  (push (list coding-system-for-read coding-system-for-write format-alist
              after-insert-file-functions inhibit-file-name-operation
              inhibit-file-name-handlers) qa224-events)
  (when qa224-literal-error (error "literal handler failure"))
  'literal-result)
(put 'qa224-inspect-literal 'operations '(insert-file-contents))
(dolist (inhibit-file-name-operation '(different insert-file-contents))
  (with-temp-buffer
    (let ((file-name-handler-alist '(("qa224:" . qa224-inspect-literal)))
          (coding-system-for-read 'utf-8)
          (coding-system-for-write 'iso-latin-1)
          (format-alist '(old-format))
          (after-insert-file-functions '(old-hook))
          (inhibit-file-name-handlers '(old-handler))
          (qa224-events nil))
      (qa (insert-file-contents-literally "qa224:file") 'literal-result)
      (qa qa224-events
          (list (list 'no-conversion 'no-conversion nil nil 'insert-file-contents
                      (append '(jka-compr-handler image-file-handler epa-file-handler)
                              (when (eq inhibit-file-name-operation 'insert-file-contents) '(old-handler))))))
      (let ((qa224-literal-error t))
        (qa-err-data (insert-file-contents-literally "qa224:file") 'error '("literal handler failure")))
      (qa (list coding-system-for-read coding-system-for-write format-alist
                after-insert-file-functions inhibit-file-name-handlers)
          '(utf-8 iso-latin-1 (old-format) (old-hook) (old-handler))))))

;; Visiting an indirect buffer rejects before the handler or region checks.
(with-temp-buffer
  (let ((base (current-buffer))
        (file-name-handler-alist '(("qa224:" . qa224-inspect-literal)))
        (qa224-events nil))
    (let ((indirect (make-indirect-buffer base "qa224-indirect")))
      (unwind-protect
          (with-current-buffer indirect
            (qa-err-data (insert-file-contents "qa224:file" t)
                         'error '("Cannot do file visiting in an indirect buffer"))
            (qa-err-data (write-region 'bad nil "qa224:file" nil t)
                         'error '("Cannot do file visiting in an indirect buffer"))
            (qa qa224-events nil))
        (kill-buffer indirect)))))

(defvar qa224-hook-count)
(let ((saved (symbol-function 'after-insert-file-set-coding)))
  (unwind-protect
      (progn
        (fset 'after-insert-file-set-coding (lambda (&rest _) qa224-hook-count))
        (dolist (qa224-hook-count '(-1 bad 1.5 999))
          (with-temp-buffer
            (let ((file-name-handler-alist '(("qa224:" . qa224-insert-handler)))
                  (qa224-events nil) (qa224-at-start t) (qa224-ret '("file" 3)))
              (qa-err-data (insert-file-contents "qa224:file")
                           'wrong-type-argument (list 'inserted-chars qa224-hook-count))
              (qa (list (buffer-string) (point)) '("ABC" 1))))))
    (fset 'after-insert-file-set-coding saved)))

(defvar qa224-mutating-name)
(defvar qa224-mutating-log nil)
(defun qa224-mutate-handler (op &rest args)
  (let* ((name (if (eq op 'write-region) (nth 2 args) (car args)))
         (lock (when (eq op 'write-region) (nth 5 args))))
    (push (list (eq name qa224-mutating-name) (and lock (eq name lock))) qa224-mutating-log)
    (aset name (1- (length name)) ?Z)
    nil))
(put 'qa224-mutate-handler 'operations '(insert-file-contents write-region))
(let* ((qa224-probe-dir (make-temp-file "qa224-mutation-" t))
       (file-name-handler-alist '(("qa224:" . qa224-mutate-handler)))
       (qa224-mutating-name (expand-file-name "qa224:mutable" qa224-probe-dir))
       (qa224-mutating-log nil))
  (unwind-protect
      (progn
        (with-temp-buffer
          (setq qa224-io-result (insert-file-contents qa224-mutating-name))
          (qa (list (eq (car qa224-io-result) qa224-mutating-name) qa224-io-result qa224-mutating-log)
              (list t (list (expand-file-name "qa224:mutablZ" qa224-probe-dir) 0) '((t nil)))))
        (setq qa224-mutating-name (expand-file-name "qa224:mutable" qa224-probe-dir) qa224-mutating-log nil)
        (with-temp-buffer
          (insert "body")
          (qa (write-region "body" nil qa224-mutating-name nil t) nil)
          (qa (list buffer-file-name (eq buffer-file-name qa224-mutating-name)
                    (buffer-modified-p) qa224-mutating-log)
              (list (expand-file-name "qa224:mutablZ" qa224-probe-dir) t nil '((t t))))))
    (let ((file-name-handler-alist nil)) (delete-directory qa224-probe-dir t))))

(defvar qa224-lock-file)
(defvar qa224-lock-before)
(defun qa224-lock-handler (_operation &rest _args) nil)
(put 'qa224-lock-handler 'operations '(insert-file-contents write-region))
(let ((dir (make-temp-file "qa224-live-lock-" t)))
  (unwind-protect
      (dolist (op '(insert-file-contents write-region))
        (let ((qa224-lock-file (expand-file-name "old" dir)))
          (with-temp-file qa224-lock-file (insert "old"))
          (with-temp-buffer
            (set-visited-file-name qa224-lock-file)
            (insert "modified")
            (let ((qa224-lock-before (file-locked-p qa224-lock-file))
                  (file-name-handler-alist '(("qa224:" . qa224-lock-handler))))
              (if (eq op 'insert-file-contents)
                  (insert-file-contents (expand-file-name "qa224:new" dir) t)
                (write-region "body" nil (expand-file-name "qa224:new" dir) nil t))
              (qa (list qa224-lock-before (file-locked-p qa224-lock-file) (buffer-modified-p)) '(t t nil)))
            (set-buffer-modified-p nil))))
    (delete-directory dir t)))

(princ (qa--done)) (terpri)
