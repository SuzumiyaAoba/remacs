                                    (error (princ (list 'sp (car x) (car e)))))
                    (terpri))
        '((string-equal "a" "a") (string-equal 'a "a") (string-equal nil "")
          (string-lessp "a" "b") (string-lessp 'a "b") (string-lessp "a" nil)
          (string-greaterp "b" "a") (string-greaterp 'b 'a)
