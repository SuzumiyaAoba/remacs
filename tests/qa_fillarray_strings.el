;; Issue #248: fillarray preserves explicit representation, byte allocation,
;; identity and property intervals, including failed and empty operations.
(defun qa248-string (kind)
  (cond ((eq kind 'u-ascii) (copy-sequence "ab"))
        ((eq kind 'u-high) (unibyte-string 128 255))
        ((eq kind 'u-empty) (unibyte-string))
        ((eq kind 'm-ascii) (with-temp-buffer (insert "ab") (buffer-string)))
        ((eq kind 'm-two) (string 233 255))
        ((eq kind 'm-three) (copy-sequence "日本"))
        ((eq kind 'm-four) (string #x1f600 #x1f601))
        ((eq kind 'm-five) (string #x200000 #x300000))
        ((eq kind 'm-raw) (string #x3fff80 #x3fffff))
        ((eq kind 'm-mixed) (string ?a 233))
        ((eq kind 'm-average-two) (string ?a #x65e5))
        ((eq kind 'm-average-three) (string 233 #x1f600))
        ((eq kind 'm-empty) (make-string 0 ?a t))))
(defun qa248-snapshot (string)
  (list (length string) (multibyte-string-p string) (string-bytes string)
        (string-to-list string) (object-intervals string)))
(defun qa248-fill (kind item)
  (let* ((string (qa248-string kind)) (alias string)
         (payload (list 'shared)))
    (when (> (length string) 0)
      (put-text-property 0 1 'face 'bold string)
      (put-text-property 0 (length string) 'qa248 payload string))
    (let ((before (qa248-snapshot string))
          (result (condition-case err (list 'ok (eq (fillarray string item) string))
                    (error (list 'error (car err) (cdr err))))))
      (list before result (qa248-snapshot string) (eq alias string)
            (or (= (length string) 0) (eq (get-text-property 0 'qa248 string) payload))))))

