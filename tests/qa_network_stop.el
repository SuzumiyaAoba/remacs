;;; -*- lexical-binding: t; -*-
(defvar qa221-peer nil)
(defun qa221-filter (process text)
  (process-put process 'text (concat (process-get process 'text) text)))
(defun qa221-log (_server peer _message) (setq qa221-peer peer))
(defun qa221-until (predicate)
  (let ((deadline (+ (float-time) 3)))
    (while (and (not (funcall predicate)) (< (float-time) deadline)) (accept-process-output nil 0.01)))
  (unless (funcall predicate) (error "network stop fixture timed out")))

(defun qa221-run (local function &optional stopped filter-paused)
  (let* ((before (process-list)) server client (qa221-peer nil)
         (directory (and local (make-temp-file "/tmp/qa221-" t)))
         (path (and directory (expand-file-name "socket" directory))))
    (unwind-protect
        (progn
          (setq server (apply #'make-network-process
                              (append (list :name "qa221-server" :server t :coding 'binary :noquery t
                                            :stop stopped :filter (if filter-paused t #'qa221-filter)
                                            :sentinel #'ignore :log #'qa221-log)
                                      (if local (list :family 'local :service path) '(:host "127.0.0.1" :service 0)))))
          (setq client (apply #'make-network-process
                              (append (list :name "qa221-client" :coding 'binary :noquery t
                                            :filter #'qa221-filter :sentinel #'ignore)
                                      (if local (list :family 'local :service path)
                                        (list :host "127.0.0.1" :service (process-contact server :service))))))
          (unless stopped (qa221-until (lambda () qa221-peer)))
          (funcall function server client qa221-peer))
      (dolist (process (process-list))
        (unless (memq process before) (ignore-errors (delete-process process))))
      (when (and path (file-exists-p path)) (delete-file path))
      (when directory (delete-directory directory)))))

(defun qa221-transfer (_server client peer &optional repeat)
  (process-put peer 'text "") (process-put client 'text "")
  (stop-process peer) (when repeat (stop-process peer))
  (process-send-string peer "OUT")
  (qa221-until (lambda () (equal (process-get client 'text) "OUT")))
  (process-send-string client "payload")
  (accept-process-output nil 0.03)
  (let ((before (process-get peer 'text)))
    (continue-process peer)
    (qa221-until (lambda () (equal (process-get peer 'text) "payload")))
    (list before (process-get peer 'text) (process-get client 'text)
          (process-status peer) (process-command peer))))

(defun qa221-listener (server _client _peer)
  (stop-process server) (stop-process server)
  (accept-process-output nil 0.03)
  (let ((before (null qa221-peer)))
    (continue-process server)
    (qa221-until (lambda () qa221-peer))
    (list before (process-status server) (process-status qa221-peer) (process-command server))))

(defun qa221-callback-stop (_server client peer)
  (process-put peer 'text "")
  (set-process-filter peer (lambda (p text) (qa221-filter p text) (stop-process p)))
  (process-send-string client "FIRST")
  (qa221-until (lambda () (eq (process-status peer) 'stop)))
  (process-send-string client "SECOND") (accept-process-output nil 0.03)
  (let ((before (process-get peer 'text)))
    (continue-process peer)
    (qa221-until (lambda () (equal (process-get peer 'text) "FIRSTSECOND")))
    (list before (process-get peer 'text))))

(defun qa221-running-listener (server client old-peer)
  (stop-process server)
  (setq qa221-peer nil)
  (let* ((local (eq (process-contact server :family) 'local))
         (_second (apply #'make-network-process
                         (append (list :name "qa221-second" :noquery t :filter #'ignore :sentinel #'ignore)
                                 (if local (list :family 'local :service (process-contact server :service))
                                   (list :host "127.0.0.1" :service (process-contact server :service)))))))
    (process-send-string client "EXISTING") (accept-process-output nil 0.03)
    (let ((before (null qa221-peer)))
      (continue-process server) (qa221-until (lambda () qa221-peer))
      (list before (process-status server) (process-status qa221-peer) (not (eq old-peer qa221-peer))
            (process-get old-peer 'text)))))

(defun qa221-decoder (_server client peer)
  (process-put peer 'text "")
  (set-process-coding-system peer 'utf-8-unix 'binary)
  (process-send-string client (unibyte-string 195)) (accept-process-output nil 0.03)
  (stop-process peer)
  (process-send-string client (unibyte-string 169)) (accept-process-output nil 0.03)
  (let ((before (process-get peer 'text)))
    (continue-process peer)
    (qa221-until (lambda () (equal (process-get peer 'text) "é")))
    (list before (process-get peer 'text))))

(defun qa221-timer (_server client peer)
  (process-put peer 'text "")
  (stop-process peer) (process-send-string client "timer")
  (let ((timer (run-at-time 0.02 nil #'continue-process peer)))
    (unwind-protect
        (list (accept-process-output peer 0.5) (process-get peer 'text) (process-status peer))
      (cancel-timer timer))))

(defun qa221-eof (_server client peer)
  (process-put peer 'text "")
  (stop-process peer) (process-send-string client "X") (process-send-eof client)
  (accept-process-output nil 0.03)
  (let ((before (list (process-status peer) (process-get peer 'text))))
    (continue-process peer)
    (qa221-until (lambda () (not (process-live-p peer))))
    (list before (process-status peer) (process-get peer 'text))))

(qa (qa221-run nil #'qa221-transfer) '("" "payload" "OUT" open nil))
(qa (qa221-run t #'qa221-transfer) '("" "payload" "OUT" open nil))
(qa (qa221-run nil (lambda (s c p) (qa221-transfer s c p t))) '("" "payload" "OUT" open nil))
(qa (qa221-run t (lambda (s c p) (qa221-transfer s c p t))) '("" "payload" "OUT" open nil))
(qa (qa221-run nil #'qa221-listener t) '(t listen open nil))
(qa (qa221-run t #'qa221-listener t) '(t listen open nil))
(qa (qa221-run nil #'qa221-listener t t) '(t listen open nil))
(qa (qa221-run t #'qa221-listener t t) '(t listen open nil))
(qa (qa221-run nil #'qa221-running-listener) '(t listen open t "EXISTING"))
(qa (qa221-run t #'qa221-running-listener) '(t listen open t "EXISTING"))
(qa (qa221-run nil (lambda (_s _c p) (process-status p)) nil t) 'open)
(qa (qa221-run t (lambda (_s _c p) (process-status p)) nil t) 'open)
(qa (qa221-run nil #'qa221-callback-stop) '("FIRST" "FIRSTSECOND"))
(qa (qa221-run t #'qa221-callback-stop) '("FIRST" "FIRSTSECOND"))
(qa (qa221-run nil #'qa221-decoder) '("" "é"))
(qa (qa221-run t #'qa221-decoder) '("" "é"))
(require 'timer)
(qa (qa221-run nil #'qa221-timer) '(t "timer" open))
(qa (qa221-run t #'qa221-timer) '(t "timer" open))
(qa (qa221-run nil #'qa221-eof) '((stop "") closed "X"))
(qa (qa221-run t #'qa221-eof) '((stop "") closed "X"))
(qa (let (server client)
      (unwind-protect
          (progn
            (setq server (make-network-process :name "qa221-udp-server" :type 'datagram :server t :service 0
                                               :host "127.0.0.1" :coding 'binary :noquery t :filter #'qa221-filter :sentinel #'ignore))
            (setq client (make-network-process :name "qa221-udp-client" :type 'datagram
                                               :host "127.0.0.1" :service (process-contact server :service)
                                               :coding 'binary :noquery t :filter #'ignore :sentinel #'ignore))
            (process-put server 'text "") (stop-process server)
            (process-send-string client "packet") (accept-process-output nil 0.03)
            (let ((before (process-get server 'text)))
              (continue-process server)
              (qa221-until (lambda () (equal (process-get server 'text) "packet")))
              (list before (process-get server 'text))))
        (when client (delete-process client)) (when server (delete-process server))))
    '("" "packet"))
(princ (qa--done)) (terpri)
