;;; -*- lexical-binding: nil; -*-
(defun qa571-code (test value)
  ;; Pointer and builtin-symbol hashes here have their top two bits clear.
  ;; Invert GNU's fixnum SXHASH_REDUCE, then reduce to hash_hash_t.
  (let ((raw (logand (funcall (cond ((eq test 'eq) #'sxhash-eq)
                                   ((eq test 'eql) #'sxhash-eql)
                                   (t #'sxhash-equal)) value)
                     #x3fffffffffffffff)))
    (dolist (shift '(2 4 8 16 32)) (setq raw (logxor raw (ash raw (- shift)))))
    (logand (logxor raw (ash raw -32)) #xffffffff)))
(defun qa571-bucket (hash)
  ;; Capacity 100 uses a 128-entry index. GNU selects its high product bits.
  (ash (logand (* hash 2654435769) #xffffffff) -25))
(defun qa571-position-for-bucket (symbol test same-bucket)
  (let* ((symbols-with-pos-enabled nil) (target (qa571-bucket (qa571-code test symbol)))
         (kept nil) (found nil) (attempts 0))
    (while (and (not found) (< attempts 8192))
      (let ((value (position-symbol symbol 1)))
        (push value kept)
        (when (eq (eq (qa571-bucket (qa571-code test value)) target) same-bucket)
          (setq found value)))
      (setq attempts (1+ attempts)))
    (or found (error "No controlled positioned hash bucket"))))
(defun qa571-distinct-position (symbol test other)
  (let ((symbols-with-pos-enabled nil) (kept nil) (found nil)
        (left (qa571-code test other)) (right (qa571-code test symbol)))
    (while (not found)
      (let ((value (position-symbol symbol 1)))
        (push value kept)
        (let ((hash (qa571-code test value)))
          (unless (or (= hash left) (= hash right)) (setq found value)))))
    found))
(defun qa571-hash-profile (test insertion lookup same-bucket)
 (let* ((symbols-with-pos-enabled nil)
        (p (qa571-position-for-bucket 'car test same-bucket))
        (q (qa571-distinct-position 'car test p))
        (pn (qa571-position-for-bucket nil test same-bucket))
        (key (list p))
        (table (make-hash-table :test test :size 100))
        (nested (make-hash-table :test test :size 100))
        (nils (make-hash-table :test test :size 100))
        (stored nil))
  (let ((symbols-with-pos-enabled insertion))
   (puthash 'unrelated 'unrelated table)
   (puthash p 'position table)
   (remhash 'unrelated table)
   (puthash key 'nested nested)
   (puthash pn 'nil-position nils))
  (let ((symbols-with-pos-enabled lookup))
   (maphash (lambda (key _value) (setq stored key)) table)
   (let* ((copy (copy-hash-table table))
          (before (list (bare-symbol-p stored)
             (gethash p table 'missing) (gethash q table 'missing)
             (gethash 'car table 'missing)
             (gethash p copy 'missing)
             (gethash key nested 'missing) (gethash (list p) nested 'missing)
             (gethash (list q) nested 'missing)
             (gethash (list 'car) nested 'missing)
             (gethash pn nils 'missing) (gethash nil nils 'missing))))
    (puthash 'car 'bare table)
    (let ((after (list (hash-table-count table)
                      (gethash p table 'missing)
                      (gethash 'car table 'missing)
                      (let ((symbols-with-pos-enabled t))
                       (gethash 'car table 'missing)))))
     (remhash p table)
     (list before after (hash-table-count table)
           (gethash 'car table 'missing)
           (hash-table-count copy)))))))
(qa (qa571-hash-profile 'eq nil nil nil) '((nil position missing missing position nested missing missing missing nil-position missing) (2 position bare bare) 1 bare 1))
(qa (qa571-hash-profile 'eq nil nil t) '((nil position missing missing position nested missing missing missing nil-position missing) (2 position bare bare) 1 bare 1))
(qa (qa571-hash-profile 'eq nil t nil) '((nil missing missing missing missing nested missing missing missing missing missing) (2 bare bare bare) 1 missing 1))
(qa (qa571-hash-profile 'eq nil t t) '((nil position position position position nested missing missing missing nil-position nil-position) (1 bare bare bare) 0 missing 1))
(qa (qa571-hash-profile 'eq t nil nil) '((nil missing missing missing missing nested missing missing missing missing missing) (2 missing bare bare) 2 bare 1))
(qa (qa571-hash-profile 'eq t nil t) '((nil position missing missing position nested missing missing missing nil-position missing) (2 position bare bare) 1 bare 1))
(qa (qa571-hash-profile 'eq t t nil) '((nil position position position position nested missing missing missing nil-position nil-position) (1 bare bare bare) 0 missing 1))
(qa (qa571-hash-profile 'eq t t t) '((nil position position position position nested missing missing missing nil-position nil-position) (1 bare bare bare) 0 missing 1))
(qa (qa571-hash-profile 'eql nil nil nil) '((nil position missing missing position nested missing missing missing nil-position missing) (2 position bare bare) 1 bare 1))
(qa (qa571-hash-profile 'eql nil nil t) '((nil position missing missing position nested missing missing missing nil-position missing) (2 position bare bare) 1 bare 1))
(qa (qa571-hash-profile 'eql nil t nil) '((nil missing missing missing missing nested missing missing missing missing missing) (2 bare bare bare) 1 missing 1))
(qa (qa571-hash-profile 'eql nil t t) '((nil position position position position nested missing missing missing nil-position nil-position) (1 bare bare bare) 0 missing 1))
(qa (qa571-hash-profile 'eql t nil nil) '((nil missing missing missing missing nested missing missing missing missing missing) (2 missing bare bare) 2 bare 1))
(qa (qa571-hash-profile 'eql t nil t) '((nil position missing missing position nested missing missing missing nil-position missing) (2 position bare bare) 1 bare 1))
(qa (qa571-hash-profile 'eql t t nil) '((nil position position position position nested missing missing missing nil-position nil-position) (1 bare bare bare) 0 missing 1))
(qa (qa571-hash-profile 'eql t t t) '((nil position position position position nested missing missing missing nil-position nil-position) (1 bare bare bare) 0 missing 1))
(qa (qa571-hash-profile 'equal nil nil nil) '((nil position missing missing position nested nested missing missing nil-position missing) (2 position bare bare) 1 bare 1))
(qa (qa571-hash-profile 'equal nil nil t) '((nil position missing missing position nested nested missing missing nil-position missing) (2 position bare bare) 1 bare 1))
(qa (qa571-hash-profile 'equal nil t nil) '((nil missing missing missing missing missing missing missing missing missing missing) (2 bare bare bare) 1 missing 1))
(qa (qa571-hash-profile 'equal nil t t) '((nil position position position position nested missing missing missing nil-position nil-position) (1 bare bare bare) 0 missing 1))
(qa (qa571-hash-profile 'equal t nil nil) '((nil missing missing missing missing missing missing missing missing missing missing) (2 missing bare bare) 2 bare 1))
(qa (qa571-hash-profile 'equal t nil t) '((nil position missing missing position nested missing missing missing nil-position missing) (2 position bare bare) 1 bare 1))
(qa (qa571-hash-profile 'equal t t nil) '((nil position position position position nested nested nested nested nil-position nil-position) (1 bare bare bare) 0 missing 1))
(qa (qa571-hash-profile 'equal t t t) '((nil position position position position nested nested nested nested nil-position nil-position) (1 bare bare bare) 0 missing 1))
(mapc #'fmakunbound '(qa571-code qa571-bucket qa571-position-for-bucket qa571-distinct-position qa571-hash-profile))
;; Equal-hash mismatch still permits the EQ shortcut in the same bucket.
;; 340573321 is the inverse of Knuth's multiplier modulo 2^32:
;; its product is 1, so both hashes select bucket zero at capacity 100.
(let* ((symbols-with-pos-enabled nil) (calls 0)
       (p (position-symbol 'car 1)))
  (define-hash-table-test 'qa571-changing-hash
    (lambda (a b) (setq calls (1+ calls)) (eq a b))
    (lambda (_) (if symbols-with-pos-enabled 340573321 0)))
  (let ((table (make-hash-table :test 'qa571-changing-hash :size 100)))
    (puthash p 'found table)
    (let ((symbols-with-pos-enabled t))
      (qa (gethash p table 'missing) 'found)
      (qa (gethash 'car table 'missing) 'found)
      (qa calls 0))
    (qa (gethash 'car table 'missing) 'missing)
    (qa calls 1)))
(princ (qa--done))
