;;; -*- lexical-binding: t; -*-
;; Issue #113: count-lines replaces an existing restriction; it still
;; rejects positions outside the complete buffer rather than clamping them.
(defvar qa113-start)
(defvar qa113-end)
(with-temp-buffer
  (insert "a\nb\nc")
  (qa (count-lines 1 6) 3)
  (qa (count-lines 1 1) 0)
  (qa (count-lines 2 4) 2)
  (qa (count-lines 6 1) 3)
  (narrow-to-region 2 5)
  (qa (count-lines 1 6) 3)
  (qa (count-lines 6 1) 3)
  (qa (count-lines 1 1) 0)
  (qa (count-lines 6 6) 0)
  (qa (count-lines 2 4) 2)
  (qa (count-lines 4 2) 2)
  ;; Every pair of positions remains valid despite the smaller BEGV/ZV.
  (qa (let (rows)
        (dolist (qa113-start '(1 2 3 4 5 6) (nreverse rows))
          (let (row)
            (dolist (qa113-end '(1 2 3 4 5 6))
              (push (count-lines qa113-start qa113-end) row))
            (push (nreverse row) rows))))
      '((0 1 1 2 2 3)
        (1 0 1 2 2 3)
        (1 1 0 1 1 2)
        (2 2 1 0 1 2)
        (2 2 1 1 0 1)
        (3 3 2 2 1 0)))
  (qa (list (point-min) (point-max) (buffer-narrowed-p)) '(2 5 t))
  (goto-char 3)
  (set-match-data '(1 2))
  (qa (progn (count-lines 6 1) (list (point) (point-min) (point-max) (match-data)))
      '(3 2 5 (1 2)))
  (let ((qa113-start (copy-marker 1)) (qa113-end (copy-marker 6)))
    (qa (count-lines qa113-start qa113-end) 3)
    (qa (count-lines qa113-end qa113-start) 3))
  (qa-err-data (count-lines 0 6) 'args-out-of-range '(0 6))
  (qa-err-data (count-lines 1 7) 'args-out-of-range '(1 7))
  (qa-err-data (count-lines 7 0) 'args-out-of-range '(7 0))
  (qa-err-data (count-lines 0 0) 'args-out-of-range '(0 0))
  (qa-err-data (count-lines 7 7) 'args-out-of-range '(7 7))
  (qa-err-data (count-lines 1.2 6) 'wrong-type-argument '(integer-or-marker-p 1.2))
  (qa-err-data (count-lines 1 nil) 'wrong-type-argument '(integer-or-marker-p nil))
  (qa-err-data (count-lines (make-marker) 6) 'error '("Marker does not point anywhere"))
  (qa (list (point) (point-min) (point-max)) '(3 2 5)))
(with-temp-buffer
  (qa (count-lines 1 1) 0)
  (qa-err-data (count-lines 2 4) 'args-out-of-range '(2 4)))
(with-temp-buffer
  (insert "日本語\nαβ\n終")
  (let ((qa113-start (point-min)) (qa113-end (point-max)))
    (narrow-to-region 3 5)
    (qa (count-lines qa113-start qa113-end) 3)
    (qa (count-lines qa113-end qa113-start) 3)
    (qa (count-lines 1 5) 1)
    (qa (count-lines 5 1) 1)))
(with-temp-buffer
  (insert "a\nb\n")
  (narrow-to-region 2 3)
  (qa (count-lines 1 5) 2)
  (qa (count-lines 5 1) 2))
(princ (qa--done)) (terpri)
