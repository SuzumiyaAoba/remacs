;;; -*- lexical-binding: t; -*-
;; Issue #110: compare invariants rather than implementation-specific heap sizes.
(require 'cl-lib)
(require 'seq)
(defvar qa110-held nil)
(defvar qa110-kind)
(defun qa110-used (kind stats) (nth 2 (assq kind stats)))
(defun qa110-delta (index allocate minimum)
  (let* ((before (nth index (memory-use-counts)))
         (qa110-held (funcall allocate)))
    (>= (- (nth index (memory-use-counts)) before) minimum)))
(qa (let ((counts (memory-use-counts)))
      (and (= (length counts) 7)
           (seq-every-p (lambda (n) (and (integerp n) (>= n 0))) counts))) t)
(qa (qa110-delta 0 (lambda () (make-list 4096 nil)) 4096) t)
(qa (qa110-delta 1 (lambda ()
                    (let (out) (dotimes (j 128 out) (push (/ 1.0 (1+ j)) out)))) 128) t)
(qa (qa110-delta 2 (lambda () (make-vector 8192 nil)) 8192) t)
(qa (qa110-delta 3 (lambda ()
                    (let (out) (dotimes (_ 128 out) (push (make-symbol "qa110") out)))) 128) t)
(qa (qa110-delta 4 (lambda () (make-string 16384 ?x)) 16384) t)
(qa (qa110-delta 6 (lambda ()
                    (let (out) (dotimes (_ 128 out) (push (make-string 32 ?x) out)))) 128) t)
(qa (qa110-delta 5 (lambda ()
                    (let (out) (dotimes (_ 128 out) (push (propertize "abc" 'face 'bold) out)))) 128) t)
(qa (let ((before (memory-use-counts)))
      (garbage-collect)
      (seq-every-p #'identity
                   (cl-mapcar (lambda (a b) (>= b a)) before (memory-use-counts)))) t)
(qa (mapcar #'car (garbage-collect))
    '(conses symbols strings string-bytes vectors vector-slots floats intervals buffers))
(qa (mapcar #'length (garbage-collect-heapsize)) '(4 4 4 3 3 4 4 4 3))
(qa (seq-every-p
     (lambda (row)
       (and (> (nth 1 row) 0)
            (seq-every-p (lambda (n) (and (integerp n) (>= n 0))) (cdr row))))
     (garbage-collect)) t)
(dolist (qa110-kind '(conses symbols strings string-bytes vectors vector-slots floats buffers))
  (qa (> (qa110-used qa110-kind (garbage-collect)) 0) t))
(defun qa110-retention (kind allocate minimum)
  (garbage-collect)
  (let* ((before (qa110-used kind (garbage-collect)))
         (qa110-held (funcall allocate))
         (during (qa110-used kind (garbage-collect))))
    (setq qa110-held nil)
    (let ((after (qa110-used kind (garbage-collect))))
      (and (>= (- during before) minimum) (>= (- during after) minimum)))))
(qa (qa110-retention 'conses (lambda () (make-list 4096 nil)) 4000) t)
(qa (qa110-retention 'floats
                     (lambda () (let (out) (dotimes (j 1024 out) (push (/ 1.0 (1+ j)) out))))
                     1000) t)
(qa (qa110-retention 'strings
                     (lambda () (let (out) (dotimes (_ 1024 out) (push (make-string 16 ?x) out))))
                     1000) t)
(qa (qa110-retention 'vector-slots (lambda () (make-vector 8192 nil)) 8000) t)
(qa (qa110-retention 'intervals
                     (lambda () (let (out) (dotimes (_ 128 out) (push (propertize "abc" 'x t) out))))
                     100) t)
;; Removing one dead tree can release the string owning another tree.
(qa (qa110-retention 'intervals
                     (lambda ()
                       (let (head)
                         (dotimes (_ 128 head)
                           (setq head (propertize "abc" 'next head)))))
                     100) t)
(qa (let ((before gcs-done) (elapsed gc-elapsed))
      (garbage-collect)
      (and (> gcs-done before) (>= gc-elapsed elapsed))) t)
(qa (let ((before gcs-done))
      (garbage-collect-heapsize)
      (= gcs-done before)) t)
(qa (garbage-collect-maybe 0) nil)
(qa (let ((gc-cons-threshold 1) (gc-cons-percentage 0.0))
      (garbage-collect)
      (make-list 128 nil)
      (garbage-collect-maybe most-positive-fixnum)) t)
(qa-err (garbage-collect-maybe -1) 'wrong-type-argument)
(qa-err (garbage-collect-maybe 1.0) 'wrong-type-argument)
(qa (let* ((ran nil) (post-gc-hook (list (lambda () (setq ran t)))))
      (garbage-collect) ran) t)
(princ (qa--done)) (terpri)
