(defun qa63-integer (value)
  (let ((print-integers-as-characters t))
    (list (prin1-to-string value) (prin1-to-string value t)
          (format "%s" value) (format "%S" value) (number-to-string value)
          (with-output-to-string (prin1 value))
          (with-output-to-string (princ value))
          (with-output-to-string (print value)))))
(defun qa63-limit (length level)
  (let ((print-length length) (print-level level))
    (list (prin1-to-string '(1 (2 3) 4))
          (prin1-to-string [1 (2 3) 4])
          (prin1-to-string '(1 . 2))
          (prin1-to-string "abcd")
          (prin1-to-string '(1 (2 3) 4) t))))
