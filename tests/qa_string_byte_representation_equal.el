;;; -*- lexical-binding: nil; -*-
;; String equality uses stored bytes as well as character values (#400).
(let ((unibyte (unibyte-string 255))
      (multibyte (string #x3fffff)))
  (qa (list (equal unibyte multibyte)
            (equal-including-properties unibyte multibyte)
            (string= unibyte multibyte))
      '(nil nil nil))
  (qa (string-collate-equalp unibyte multibyte) nil)
  (qa (string= (unibyte-string ?a) (string-to-multibyte "a")) t)
  (qa (equal (unibyte-string ?a) (string-to-multibyte "a")) t)
  (qa (string= (make-symbol unibyte) (make-symbol multibyte)) nil)
  (qa (equal-including-properties
       (propertize unibyte 'qa400-property 'same)
       (propertize multibyte 'qa400-property 'same))
      nil)
  (qa (let ((table (make-hash-table :test 'equal)))
        (puthash unibyte 'unibyte table)
        (puthash multibyte 'multibyte table)
        (list (hash-table-count table)
              (gethash unibyte table)
              (gethash multibyte table)))
      '(2 unibyte multibyte)))
(princ (qa--done))
