;;; -*- lexical-binding: nil; -*-
(defun qa570-label (value)
  (catch 'found
    (dolist (entry qa570-objects)
      (when (eq value (cdr entry)) (throw 'found (car entry))))
    value))
(defun qa570-result (left right)
  (let ((a (cdr (assq left qa570-objects))) (b (cdr (assq right qa570-objects))))
    (condition-case err (value< a b)
      (error (cons 'error (cons (car err) (mapcar #'qa570-label (cdr err))))))))
(let* ((ba (generate-new-buffer "qa-value-a"))
       (bb (generate-new-buffer "qa-value-b"))
       (dead (generate-new-buffer "qa-value-dead"))
       (pa (make-pipe-process :name "qa-value-process-a" :noquery t :sentinel #'ignore))
       (pb (make-pipe-process :name "qa-value-process-b" :noquery t :sentinel #'ignore))
       (mutex (make-mutex "qa-value-mutex"))
       (marks (with-current-buffer ba (insert "abcd")
                (list (copy-marker 1) (copy-marker 3))))
       (qa570-objects
        (list
         (cons 'empty nil) (cons 'symbol 'alpha) (cons 'integer 1) (cons 'float 1.0)
         (cons 'big (expt 2 65)) (cons 'string "a") (cons 'list '(1 0))
         (cons 'vector [1 0]) (cons 'record (record 'tag 1))
         (cons 'bits (bool-vector nil t)) (cons 'chartable (make-char-table 'qa-value))
         (cons 'obarray (obarray-make)) (cons 'font (font-spec :family "a"))
         (cons 'hash (make-hash-table)) (cons 'buffer ba) (cons 'marker (car marks))
         (cons 'window (selected-window)) (cons 'frame (selected-frame))
         (cons 'process pa) (cons 'thread (current-thread)) (cons 'mutex mutex)
         (cons 'condition (make-condition-variable mutex "qa-value-condition"))
         (cons 'finalizer (make-finalizer #'ignore))
         (cons 'subr (symbol-function 'car)) (cons 'closure (eval '(lambda (x) x) t))
         (cons 'symbol-same-a (make-symbol "same")) (cons 'symbol-same-b (make-symbol "same"))
         (cons 'symbol-high-a (make-symbol (unibyte-string 233)))
         (cons 'symbol-high-b (make-symbol (string 234)))
         (cons 'string-byte (unibyte-string 233)) (cons 'string-unicode (string 233))
         (cons 'string-next (string 234)) (cons 'string-raw (string-to-multibyte (unibyte-string 233)))
         (cons 'list-tie '(1.0 1)) (cons 'vector-tie [1.0 1])
         (cons 'dotted-a '(1 . 2)) (cons 'dotted-b '(1 . 3))
         (cons 'list-bad-a '(0 . bad)) (cons 'list-bad-b '(1 . bad))
         (cons 'record-b (record 'tag 2)) (cons 'bits-b (bool-vector t nil))
         (cons 'hash-b (make-hash-table)) (cons 'buffer-b bb) (cons 'buffer-dead dead)
         (cons 'marker-b (cadr marks)) (cons 'marker-none (make-marker))
         (cons 'marker-other (with-current-buffer bb (insert "ab") (copy-marker 1)))
         (cons 'process-b pb) (cons 'subr-b (symbol-function 'cdr))
         (cons 'closure-b (eval '(lambda (x) (1+ x)) t))
         (cons 'overlay (with-current-buffer ba (make-overlay 1 2)))
         (cons 'overlay-b (with-current-buffer ba (make-overlay 2 3)))
         (cons 'configuration (current-window-configuration)))))
  (unwind-protect
      (progn
        (kill-buffer dead)
        (qa (qa570-result 'empty 'empty) 'nil)
        (qa (qa570-result 'empty 'symbol) 'nil)
        (qa (qa570-result 'empty 'integer) '(error type-mismatch empty integer))
