;;; -*- lexical-binding: t; -*-
(defvar treesit-extra-load-path nil)
(setq treesit-extra-load-path
      (cons (expand-file-name "~/.emacs.d/tree-sitter") treesit-extra-load-path))
(defvar qa213-results nil)
(defvar qa213-seen nil)
(defvar qa213-valid t)
(defvar qa213-parser nil)
(defvar qa213-expected-ranges nil)

(defun qa213-note (name ranges parser)
  (push name qa213-seen)
  (setq qa213-valid (and qa213-valid (eq parser qa213-parser)
                         (equal ranges qa213-expected-ranges))))
(defun qa213-a (ranges parser) (qa213-note 'a ranges parser))
(defun qa213-b (ranges parser) (qa213-note 'b ranges parser))
(defalias 'qa213-alias 'qa213-a)
(defun qa213-error (_ranges _parser) (error "Expected notifier error"))

(defun qa213-run (function)
  (with-temp-buffer
    (insert "[1,2]")
    (let* ((qa213-parser (treesit-parser-create 'json))
           (qa213-seen nil) (qa213-valid t))
      (unwind-protect
          (progn (treesit-parser-root-node qa213-parser)
                 (funcall function qa213-parser))
        (ignore-errors (treesit-parser-delete qa213-parser))))))

(defun qa213-change (parser replacement)
  (goto-char 2)
  (delete-region 2 (1- (save-excursion (search-forward "," nil t))))
  (insert replacement)
  (let ((qa213-expected-ranges (list (cons 2 (+ 2 (length replacement))))))
    (setq qa213-seen nil)
    (treesit-parser-root-node parser)
    ;; Merely requesting the same tree again must not repeat callbacks.
    (treesit-parser-root-node parser)
    (list (nreverse qa213-seen) qa213-valid)))

(defun qa213-registration (parser)
  (let* ((empty (treesit-parser-notifiers parser))
         (add (treesit-parser-add-notifier parser 'qa213-a))
         (duplicate (treesit-parser-add-notifier parser 'qa213-a))
         (single (treesit-parser-notifiers parser)))
    (treesit-parser-add-notifier parser 'qa213-b)
    (treesit-parser-add-notifier parser 'qa213-a)
    (let ((ordered (treesit-parser-notifiers parser))
          (external (treesit-parser-notifiers parser)))
      (setcar external 'qa213-other)
      (setcdr external nil)
      (list empty add duplicate single ordered
            (treesit-parser-notifiers parser)
            (eq ordered (treesit-parser-notifiers parser))
            (qa213-change parser "null")
            (treesit-parser-remove-notifier parser 'qa213-a)
            (treesit-parser-notifiers parser)
            (treesit-parser-remove-notifier parser 'qa213-a)
            (treesit-parser-notifiers parser)
            (treesit-parser-add-notifier parser 'qa213-a)
            (treesit-parser-notifiers parser)
            (progn (treesit-parser-add-notifier parser 'qa213-b)
                   (qa213-change parser "false"))
            (progn (treesit-parser-add-notifier parser 'qa213-alias)
                   (treesit-parser-notifiers parser))
            (qa213-change parser "null")))))

(defun qa213-type-errors (parser function)
  (treesit-parser-add-notifier parser 'qa213-a)
  (list
   (mapcar
    (lambda (value)
      (condition-case err
          (list 'accepted (funcall function parser value))
        (error (list (car err) (cadr err) (eq (nth 2 err) value)))))
    (list 42 1.5 "qa213-a" [qa213-a] '(qa213-a) (lambda (_ranges _parser) nil)))
   (treesit-parser-notifiers parser)))

(if (and (fboundp 'treesit-language-available-p) (treesit-language-available-p 'json))
    (progn
      (let ((qa213-results (qa213-run #'qa213-registration)))
        (qa (nth 0 qa213-results) nil)
        (qa (nth 1 qa213-results) nil)
        (qa (nth 2 qa213-results) nil)
        (qa (nth 3 qa213-results) '(qa213-a))
        (qa (nth 4 qa213-results) '(qa213-a qa213-b))
        (qa (nth 5 qa213-results) '(qa213-a qa213-b))
        (qa (nth 6 qa213-results) nil)
        (qa (nth 7 qa213-results) '((b a) t))
        (qa (nth 8 qa213-results) nil)
        (qa (nth 9 qa213-results) '(qa213-b))
        (qa (nth 10 qa213-results) nil)
        (qa (nth 11 qa213-results) '(qa213-b))
        (qa (nth 12 qa213-results) nil)
        (qa (nth 13 qa213-results) '(qa213-b qa213-a))
        (qa (nth 14 qa213-results) '((a b) t))
        (qa (nth 15 qa213-results) '(qa213-b qa213-a qa213-alias))
        (qa (nth 16 qa213-results) '((a a b) t)))
      ;; Only symbol type is checked: nil, t and unbound symbols are legal.
      (qa (qa213-run
           (lambda (parser)
             (dolist (symbol '(nil t qa213-unbound nil t qa213-unbound))
               (treesit-parser-add-notifier parser symbol))
             (let ((registered (treesit-parser-notifiers parser)))
               (treesit-parser-remove-notifier parser nil)
               (treesit-parser-remove-notifier parser t)
               (treesit-parser-remove-notifier parser 'qa213-unbound)
               (list registered (treesit-parser-notifiers parser)))))
          '((nil t qa213-unbound) nil))
      (qa (qa213-run (lambda (parser) (qa213-type-errors parser #'treesit-parser-add-notifier)))
          '(((wrong-type-argument symbolp t) (wrong-type-argument symbolp t)
             (wrong-type-argument symbolp t) (wrong-type-argument symbolp t)
             (wrong-type-argument symbolp t) (wrong-type-argument symbolp t)) (qa213-a)))
      (qa (qa213-run (lambda (parser) (qa213-type-errors parser #'treesit-parser-remove-notifier)))
          '(((wrong-type-argument symbolp t) (wrong-type-argument symbolp t)
             (wrong-type-argument symbolp t) (wrong-type-argument symbolp t)
             (wrong-type-argument symbolp t) (wrong-type-argument symbolp t)) (qa213-a)))
      (qa (condition-case err (treesit-parser-add-notifier 42 42) (error err))
          '(wrong-type-argument treesit-parser-p 42))
      (qa (condition-case err (treesit-parser-remove-notifier 42 42) (error err))
          '(wrong-type-argument treesit-parser-p 42))
      (qa (qa213-run
           (lambda (parser)
             (treesit-parser-delete parser)
             (mapcar (lambda (function)
                       (condition-case err (funcall function parser 42)
                         (error (list (car err) (eq (cadr err) parser)))))
                     '(treesit-parser-add-notifier treesit-parser-remove-notifier))))
          '((treesit-parser-deleted t) (treesit-parser-deleted t)))
      (qa (qa213-run
           (lambda (parser)
             (treesit-parser-add-notifier parser 'qa213-a)
             (treesit-parser-add-notifier parser 'qa213-error)
             (treesit-parser-add-notifier parser 'qa213-b)
             (qa213-change parser "null")))
          '((b a) t)))
  (princ "SKIP qa_treesit_notifiers: JSON grammar unavailable\n"))
(princ (qa--done)) (terpri)
