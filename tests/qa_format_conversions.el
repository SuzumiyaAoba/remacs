;; Base conversions must reject non-finite doubles without extra data.
(dolist (fmt '("%o" "%x" "%X" "%b"))
  (dolist (value '(1.0e+INF -1.0e+INF 0.0e+NaN -0.0e+NaN))
    (qa-err-data (format fmt value) 'overflow-error nil)))

;; Property offsets follow the truncated character count and padding.
(let* ((source (propertize "a日本" 'face 'bold))
       (result (format "%-4.2s" source)))
  (qa result "a   ")
  (qa (get-text-property 0 'face result) 'bold)
  (qa (get-text-property 3 'face result) 'bold))
(let* ((source (propertize "日本語" 'face 'italic))
       (result (format "%4.3s" source)))
  (qa result "  日")
  (qa (get-text-property 0 'face result) nil)
  (qa (get-text-property 2 'face result) 'italic))
;; Display settings are read from the current environment.
(let ((char-width-table (copy-sequence char-width-table)))
  (aset char-width-table ?日 3)
  (qa (format "%.2s" "日本") "")
  (qa (format "%5.3s" "日本") "  日")
  (qa (format "%-5.3s" "日本") "日  ")
  (aset char-width-table ?A 3)
  (qa (format "%.2s" "AB") "AB"))
(let ((tab-width 3))
  (qa (format "%.2s" "\ta") "")
  (qa (format "%.3s" "\ta") "\t")
  (qa (format "%5.3s" "\ta") "  \t"))
(princ (qa--done))
