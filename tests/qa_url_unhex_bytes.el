;;; -*- lexical-binding: nil; -*-
;; url-unhex-string preserves decoded bytes for later decoding (#570).
(require 'url-util)
(qa (let ((s (url-unhex-string "%C3%A9")))
      (list (multibyte-string-p s)
            (string-to-list s)
            (string-bytes s)
            (string-to-list (decode-coding-string s 'utf-8))))
    '(nil (195 169) 2 (233)))
(qa (let ((s (url-unhex-string "café%FF")))
      (list (multibyte-string-p s) (string-to-list s)))
    '(t (99 97 102 233 4194303)))
(qa (let ((s (url-unhex-string "abc%FF")))
      (list (multibyte-string-p s) (string-to-list s)))
    '(nil (97 98 99 255)))
(qa (let ((s (url-unhex-string "%FF%0A" t)))
      (list (multibyte-string-p s) (string-to-list s) (string-bytes s)))
    '(nil (255 10) 2))
(princ (qa--done))
