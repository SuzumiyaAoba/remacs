;;; Fprogn snapshots the next cdr before executing a form. -*- lexical-binding: t; -*-
(defvar qa-pg-body)
(defvar qa-pg-trace)
(defvar qa-pg-continue)
(defvar qa-pg-context)
(defvar qa-pg-change)
(defun qa-pg-run (context change)
  (let* (qa-pg-trace (qa-pg-continue t)
         (first (list 'progn
                      '(setq qa-pg-continue nil)
                      (cond ((eq change 'cdr) '(setcdr qa-pg-body '((push 'new qa-pg-trace))))
                            ((eq change 'car) '(setcar (cdr qa-pg-body) '(push 'changed qa-pg-trace)))
                            (t '(setcar qa-pg-body 'replaced)))
                      '(push 'first qa-pg-trace)))
         (qa-pg-body (list first '(push 'old qa-pg-trace)))
         (form (cond ((eq context 'progn) (cons 'progn qa-pg-body))
                     ((eq context 'let) (cons 'let (cons nil qa-pg-body)))
                     ((eq context 'if) (cons 'if (cons nil (cons 'unreached qa-pg-body))))
                     ((eq context 'cond) (list 'cond (cons t qa-pg-body)))
                     (t (cons 'while (cons 'qa-pg-continue qa-pg-body))))))
    (eval form t)
    (reverse qa-pg-trace)))

(dolist (qa-pg-context '(progn let if cond while))
  (qa (qa-pg-run qa-pg-context 'cdr) '(first old))
  (qa (qa-pg-run qa-pg-context 'car) '(first changed))
  (qa (qa-pg-run qa-pg-context 'current) '(first old)))
(qa-err-data (eval '(progn . 42)) 'wrong-type-argument '(listp 42))
(qa-err-data (eval '(progn 1 . 42)) 'wrong-type-argument '(listp 42))
(qa-err-data (eval '(let nil 1 . 42)) 'wrong-type-argument '(listp 42))
(qa-err-data (eval '(if nil 0 1 . 42)) 'wrong-type-argument '(listp 42))
(qa (eval '(cond (t 1 . 42))) 1)
(qa (condition-case err (eval '(progn (error "first") . ignored)) (error (cdr err))) '(listp ignored))

(princ (qa--done))
