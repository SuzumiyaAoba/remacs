;;; -*- lexical-binding: t; -*-
;; Issue #105: KEEP-TIME alone controls copied timestamps. The uid/gid
;; and permission options must not cause metadata cloning on macOS.
(defvar qa105-directory)
(defvar qa105-source)
(defvar qa105-target)
(defvar qa105-existing)
(defvar qa105-keep)
(defvar qa105-uid)
(defvar qa105-permissions)
(defvar qa105-source-time)
(defvar qa105-target-time)
(let ((qa105-directory (make-temp-file "qa105-copy-" t))
      (qa105-source-time (seconds-to-time 946684800))
      (qa105-target-time (seconds-to-time 1009843200)))
  (unwind-protect
      (progn
        (dolist (qa105-existing '(nil t))
          (dolist (qa105-keep '(nil t))
            (dolist (qa105-uid '(nil t))
              (dolist (qa105-permissions '(nil t))
                (setq qa105-source (expand-file-name "source" qa105-directory)
                      qa105-target (expand-file-name "target" qa105-directory))
                (when (file-exists-p qa105-source) (delete-file qa105-source))
                (when (file-exists-p qa105-target) (delete-file qa105-target))
                (with-temp-file qa105-source (insert "payload"))
                (set-file-modes qa105-source #o600)
                (set-file-times qa105-source qa105-source-time)
                (when qa105-existing
                  (with-temp-file qa105-target (insert "old"))
                  (set-file-modes qa105-target #o644)
                  (set-file-times qa105-target qa105-target-time))
                (qa (copy-file qa105-source qa105-target t qa105-keep qa105-uid qa105-permissions) nil)
                (qa (time-equal-p (file-attribute-modification-time (file-attributes qa105-target))
                                  qa105-source-time) qa105-keep)
                (qa (time-equal-p (file-attribute-access-time (file-attributes qa105-target))
                                  qa105-source-time) qa105-keep)
                (when (and qa105-existing (not qa105-keep))
                  (qa (time-equal-p (file-attribute-access-time (file-attributes qa105-target))
                                    qa105-target-time) t))
                (qa (file-modes qa105-target)
                    (if (and qa105-existing (not qa105-permissions)) #o644 #o600))
                ;; Read only after checking atime.
                (qa (with-temp-buffer (insert-file-contents qa105-target) (buffer-string)) "payload")))))
        ;; Preserve timestamps through the already open descriptor, even
        ;; when the copied permissions make reopening for writing fail.
        (set-file-times qa105-source qa105-source-time)
        (set-file-modes qa105-source #o444)
        (delete-file qa105-target)
        (qa (copy-file qa105-source qa105-target nil t) nil)
        (qa (time-equal-p (file-attribute-modification-time (file-attributes qa105-target))
                          qa105-source-time) t)
        (qa (time-equal-p (file-attribute-access-time (file-attributes qa105-target))
                          qa105-source-time) t)
        (qa (file-modes qa105-target) (logand #o444 (default-file-modes)))
        (qa (with-temp-buffer (insert-file-contents qa105-target) (buffer-string)) "payload")

        ;; Contrary to the old report, GNU rejects an existing hard link
        ;; without overwrite permission; t permits unlinking and relinking.
        (setq qa105-source (expand-file-name "hard-source" qa105-directory)
              qa105-target (expand-file-name "hard-target" qa105-directory))
        (with-temp-file qa105-source (insert "hard payload"))
        (qa (add-name-to-file qa105-source qa105-target) nil)
        (qa (file-equal-p qa105-source qa105-target) t)
        (qa-err-data (add-name-to-file qa105-source qa105-target)
                     'file-already-exists (list "File already exists" qa105-target))
        (qa (add-name-to-file qa105-source qa105-target t) nil)
        (qa (file-equal-p qa105-source qa105-target) t)
        (qa (with-temp-buffer (insert-file-contents qa105-target) (buffer-string)) "hard payload")
        (qa-err-data (add-name-to-file qa105-source qa105-source)
                     'file-already-exists (list "File already exists" qa105-source))
        ;; Copying to the input inode is an error even with overwrite.
        (qa (let ((error (condition-case error (copy-file qa105-source qa105-target t) (error error))))
              (list (car error) (cadr error) (stringp (nth 2 error))
                    (nth 3 error) (nth 4 error) (length error)))
            (list 'file-error "Input and output files are the same" t qa105-source qa105-target 5)))
    (delete-directory qa105-directory t)))

(princ (qa--done)) (terpri)
