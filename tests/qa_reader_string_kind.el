;;; -*- lexical-binding: t; -*-
;; lread.c source kinds and read_string_literal's independent byte choice.
(defun qa-reader-kind (string)
  (list (multibyte-string-p string) (string-to-list string)))
(defun qa-reader-multibyte-source (text)
  (let ((source (make-string (length text) 0 t)))
    (dotimes (index (length text)) (aset source index (aref text index)))
    source))

(qa (qa-reader-kind (read (unibyte-string 34 255 34))) '(nil (255)))
(qa (qa-reader-kind (read (unibyte-string 34 195 169 34))) '(nil (195 169)))
(qa (let ((result (read-from-string (unibyte-string 32 34 255 34 32) 1 4)))
      (list (qa-reader-kind (car result)) (cdr result))) '((nil (255)) 4))
(qa (qa-reader-kind (read-positioning-symbols (unibyte-string 34 255 34)))
    '(nil (255)))
(qa (qa-reader-kind (read (concat "\"" (string #x3fffff) "\""))) '(nil (255)))
(qa (qa-reader-kind (read (concat "\"日" (unibyte-string 255) "\"")))
    '(t (26085 4194303)))
(qa (let ((bytes (number-sequence 128 255)))
      (equal (mapcar (lambda (byte)
                       (qa-reader-kind (read (unibyte-string 34 byte 34)))) bytes)
             (mapcar (lambda (byte) (list nil (list byte))) bytes))) t)
(qa (let ((bytes (number-sequence 128 255)))
      (equal (mapcar (lambda (byte) (read (unibyte-string 63 byte))) bytes) bytes)) t)
(qa (let ((bytes (number-sequence 128 255)))
      (equal (mapcar (lambda (byte)
                       (qa-reader-kind (symbol-name (read (unibyte-string 35 58 byte))))) bytes)
             (mapcar (lambda (byte) (list nil (list byte))) bytes))) t)
(qa (qa-reader-kind (symbol-name (read "#:qa-reader-ascii")))
    '(nil (113 97 45 114 101 97 100 101 114 45 97 115 99 105 105)))
(qa (qa-reader-kind (symbol-name (read (qa-reader-multibyte-source "#:abc"))))
    '(t (97 98 99)))
(qa (qa-reader-kind (symbol-name (read (qa-reader-multibyte-source "#:"))))
    '(nil nil))
(qa (qa-reader-kind (symbol-name (read (concat "#:" (string #x3fffff)))))
    '(t (4194303)))
(qa (let* ((name (concat "qa-reader-byte-name-" (unibyte-string 255)))
           (symbol (read name)))
      (list (eq symbol (intern name))
            (multibyte-string-p (symbol-name symbol))
            (aref (symbol-name symbol) (1- (length name))))) '(t nil 255))
(qa (let* ((source (qa-reader-multibyte-source "qa-reader-new-multibyte-name"))
           (symbol (read source)))
      (multibyte-string-p (symbol-name symbol))) t)
(qa (text-properties-at 0 (symbol-name (read (propertize "#:abc" 'tag t)))) nil)

(qa (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert (unibyte-string 34 255 34)) (goto-char (point-min))
      (qa-reader-kind (read (current-buffer)))) '(nil (255)))
(qa (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert (unibyte-string 35 58 255)) (goto-char (point-min))
      (qa-reader-kind (symbol-name (read (point-marker))))) '(nil (255)))
(qa (with-temp-buffer
      (insert "#:abc") (goto-char (point-min))
      (qa-reader-kind (symbol-name (read (current-buffer))))) '(t (97 98 99)))
(qa (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert (concat "(setq qa-reader-buffer-value \"" (unibyte-string 255) "\")"))
      (eval-buffer)
      (qa-reader-kind qa-reader-buffer-value)) '(nil (255)))
