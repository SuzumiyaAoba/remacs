(dolist (case qa47-cases)
  (qa (apply #'qa47-observe (car case)) (cadr case)))
;; Odd totals give the extra row/column to the original window.
(dolist (side '(below above right left))
 (qa (save-window-excursion
       (let* ((horizontal (memq side '(right left)))
              (total (if horizontal (qa47-width) (window-total-height)))
              (w (split-window nil nil side)))
         (list (if horizontal (qa47-width) (window-total-height))
               (if horizontal (qa47-width w) (window-total-height w))
               (= total (+ (if horizontal (qa47-width) (window-total-height))
                           (if horizontal (qa47-width w) (window-total-height w)))))))
     (if (memq side '(right left)) '(40 40 t) '(12 11 t))))
;; Rejected splits must not change any geometry or buffer display count.
(dolist (size '(nil 0 24 1000000 -24 -1000000))
 (qa (save-window-excursion
       (let* ((window-min-height 99)
              (before (list (window-edges) (window-edges (frame-root-window))
                            (window-edges (minibuffer-window)) buffer-display-count)))
         (condition-case nil (split-window nil size) (error nil))
         (equal before (list (window-edges) (window-edges (frame-root-window))
                             (window-edges (minibuffer-window)) buffer-display-count)))) t))
;; Explicit sizes ignore preferred minima, while still honoring safe minima.
(dolist (side '(below above right left))
 (dolist (sign '(1 -1))
  (qa (save-window-excursion
        (let* ((window-min-height 99) (window-min-width 99)
               (horizontal (memq side '(right left)))
               (size (* sign (if horizontal 2 1)))
               (w (split-window nil size side)))
          (= (if horizontal (qa47-width (if (> sign 0) (selected-window) w))
               (window-total-height (if (> sign 0) (selected-window) w)))
             (abs size)))) t)))
(qa (save-window-excursion
      (let ((window-min-height 1) (mode-line-format nil)
            (header-line-format nil) (tab-line-format nil))
        (split-window nil 2)
        (let ((w (split-window)))
          (list (window-total-height) (window-total-height w))))) '(1 1))
(qa-err (save-window-excursion
          (let ((window-min-height 1) (mode-line-format '("mode"))
                (header-line-format nil) (tab-line-format nil))
            (split-window nil 2) (split-window))) 'error)
(qa (save-window-excursion
      (let ((window-min-height 1) (mode-line-format nil)
            (header-line-format nil) (tab-line-format nil))
        (split-window nil 2) (split-window)
        (let ((before (list (window-edges) (length (window-list)) buffer-display-count)))
          (list (condition-case e (split-window) (error e))
                (equal before (list (window-edges) (length (window-list)) buffer-display-count))))))
    '((error "Size of new window too small (after split)") t))
