;;; -*- lexical-binding: nil -*-
;; Measure the split rectangles directly; window-total-width has an
;; independent pre-existing body-width alias discrepancy in remacs.
(defun qa47-width (&optional window)
  (let ((edges (window-edges window))) (- (nth 2 edges) (car edges))))
(delete-other-windows)
(defun qa47-observe (side minimum safe size)
  (save-window-excursion
    (let* ((mode-line-format '("qa47"))
           (header-line-format nil) (tab-line-format nil)
           (horizontal (memq side '(left right)))
           (window-min-height (if horizontal 4 minimum))
           (window-min-width (if horizontal minimum 10))
           (window-safe-min-height (if horizontal 1 safe))
           (window-safe-min-width (if horizontal safe 2))
           (count 0) (error-value nil)
           (display-count buffer-display-count)
           (initial (list (qa47-width) (window-total-height))))
      (condition-case e
          (while (< count 32) (split-window nil size side) (setq count (1+ count)))
        (error (setq error-value (and (eq (car e) 'error)
                                    (string-match-p "too small for splitting" (cadr e)) t))))
      (list count error-value initial
            (length (window-list))
            (- buffer-display-count display-count)))))
(qa (save-window-excursion
      (let ((window-min-height 99)
            (before (list (window-edges) (window-edges (frame-root-window))
                          (window-edges (minibuffer-window)) buffer-display-count)))
        (condition-case nil (split-window) (error nil))
        (equal before (list (window-edges) (window-edges (frame-root-window))
                            (window-edges (minibuffer-window)) buffer-display-count)))) t)
;; Prime the batch frame's menu-line geometry before comparing repeated splits.
(save-window-excursion (split-window))
