;;; -*- lexical-binding: nil; -*-
;; Issue #172: internal DTD entity declarations and GNU's entity-node DOM.
;; Verified against GNU Emacs 31.1 + libxml2. These tests require the optional
;; system libxml2 runtime, as do DTD/entity parsing in the implementation.

(defun qa-xml-dtd--parse (text &optional discard-comments)
  (with-temp-buffer
    (insert text)
    (libxml-parse-xml-region nil nil nil discard-comments)))

;; Valid and malformed replacement values, including unused declarations.
;; Entity references in attributes expose the first value node's content;
;; references in element content are nil nodes, including empty entities.
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"hello\">]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"hello\">]><a x=\"&word;\"/>")
    '(a ((x . "hello"))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"hello\">]><a>before&word;after&word;</a>")
    '(a nil "before" nil "after" nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"\">]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"\">]><a x=\"&word;\"/>")
    '(a ((x . ""))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"\">]><a>before&word;after&word;</a>")
    '(a nil "before" nil "after" nil))
