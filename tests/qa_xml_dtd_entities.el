;; Exact issue reproductions and first-child attribute boundaries.
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word 'hello'>]><a x=\"&word;\"/>")
    '(a ((x . "hello"))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word 'hello'>]><a>&word;</a>")
    '(a nil nil))
(dolist (body '("<a x='pre&word;post'/>" "<a x='pre&word;post'></a>"))
  (qa (qa-xml-dtd--parse (concat "<!DOCTYPE a [<!ENTITY word 'hello'>]>" body))
      '(a ((x . "pre")))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word 'hello'>]><a x='&word;post'/>")
    '(a ((x . "hello"))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY empty ''><!ENTITY word 'hello'>]><a x='&empty;&word;'/>")
    '(a ((x . ""))))
(dolist (body '("<a x='pre&missing;'/>" "<a x='&word;&missing;'/>") )
  (qa (qa-xml-dtd--parse (concat "<!DOCTYPE a [<!ENTITY word 'hello'>]>" body)) nil))
;; A declaration must never leak into another parse or buffer.
(qa (qa-xml-dtd--parse "<a x='&word;'/>") nil)
(qa (qa-xml-dtd--parse "<a>&word;</a>") nil)
;; A DOCTYPE-looking string inside other markup is not a declaration.
(qa (qa-xml-dtd--parse "<a><![CDATA[<!DOCTYPE a [<!ENTITY word 'hello'>]>]]></a>")
    '(a nil "<!DOCTYPE a [<!ENTITY word 'hello'>]>"))
(qa (qa-xml-dtd--parse "<!--<!DOCTYPE a [<!ENTITY word 'hello'>]>--><a>&word;</a>") nil)
;; Retain non-DTD built-in/numeric references and text joining.
(qa (qa-xml-dtd--parse "<a x='x&amp;&#65;'>a&amp;b&#65;</a>")
    '(a ((x . "x&A")) "a&bA"))
;; Parsing a DTD does not change its buffer, point, or accessible region.
(qa (with-temp-buffer
      (insert "prefix<!DOCTYPE a [<!ENTITY w 'v'>]><a x='&w;'/>suffix")
      (narrow-to-region 7 (- (point-max) 6))
      (goto-char (point-min))
      (let ((before (buffer-string)) (start (point-min)) (end (point-max)))
        (list (libxml-parse-xml-region) (equal before (buffer-string))
              (= start (point)) (= start (point-min)) (= end (point-max)))))
    '((a ((x . "v"))) t t t t))

;; Quoted DTD delimiters, BOM/declaration routing, parameter entities,
;; declaration lookalikes, top-level comments/PIs and DISCARD-COMMENTS.
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY unused \"<\">]><a/>" nil)
    '(a nil))
(qa (qa-xml-dtd--parse "﻿<!DOCTYPE a [<!ENTITY unused \"<\">]><a/>" nil)
