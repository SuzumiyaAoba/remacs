(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"x]]>y\">]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"x]]>y\">]><a x=\"&word;\"/>")
