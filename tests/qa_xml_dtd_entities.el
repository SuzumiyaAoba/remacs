    '(top nil (comment nil "before") (a nil (comment nil "inside") nil) (comment nil "after")))
(qa (qa-xml-dtd--parse "<!--before--><!DOCTYPE a [<!ENTITY word 'hello'>]><a><!--inside-->&word;</a><!--after-->" t)
    '(a nil (comment nil "inside") nil))
