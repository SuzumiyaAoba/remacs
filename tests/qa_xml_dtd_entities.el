(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word 'hello'>]><a x='&word;'>&word;<![CDATA[c]]>&word;</a>" nil)
    '(a ((x . "hello")) nil "c" nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word 'hello'>]><a x='&word;'>&word;<![CDATA[c]]>&word;</a>" t)
