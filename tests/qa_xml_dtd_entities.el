    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"a\t\nb\rc\r\nd\">]><a x=\"&word;\"/>")
    '(a ((x . "a\11\nb\nc\nd"))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"a\t\nb\rc\r\nd\">]><a>before&word;after&word;</a>")
    '(a nil "before" nil "after" nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&#9;&#10;&#13;\">]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&#9;&#10;&#13;\">]><a x=\"&word;\"/>")
    '(a ((x . "\11\n\15"))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&#9;&#10;&#13;\">]><a>before&word;after&word;</a>")
    '(a nil "before" nil "after" nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&amp;\">]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&amp;\">]><a x=\"&word;\"/>")
    '(a ((x . "&amp;"))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&amp;\">]><a>before&word;after&word;</a>")
    '(a nil "before" nil "after" nil))
