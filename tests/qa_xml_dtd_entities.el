(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a 'a'><!ATTLIST a x CDATA 'default'>]><a x='&a;'/>")
    '(a ((x . "a"))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a 'a'><!ATTLIST a x CDATA 'default'>]><a>&a;</a>")
