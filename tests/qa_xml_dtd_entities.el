    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&word;\">]><a>before&word;after&word;</a>")
    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&#0;\">]><a/>")
    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&#0;\">]><a x=\"&word;\"/>")
    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&#0;\">]><a>before&word;after&word;</a>")
    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&bad\">]><a/>")
    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&bad\">]><a x=\"&word;\"/>")
    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"&bad\">]><a>before&word;after&word;</a>")
