(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"<!ENTITY x 'oops'>\">]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"<!ENTITY x 'oops'>\">]><a x=\"&word;\"/>")
    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word \"<!ENTITY x 'oops'>\">]><a>before&word;after&word;</a>")
    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a '&b;'><!ENTITY b 'B'>]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a '&b;'><!ENTITY b 'B'>]><a x='&a;'/>")
    '(a ((x . "&b;"))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a '&b;'><!ENTITY b 'B'>]><a>&a;</a>")
    '(a nil nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a 'first'><!ENTITY a 'second'>]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a 'first'><!ENTITY a 'second'>]><a x='&a;'/>")
    '(a ((x . "first"))))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a 'first'><!ENTITY a 'second'>]><a>&a;</a>")
    '(a nil nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a SYSTEM 'file:///nonexistent-dot-172'>]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a SYSTEM 'file:///nonexistent-dot-172'>]><a x='&a;'/>")
    'nil)
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a SYSTEM 'file:///nonexistent-dot-172'>]><a>&a;</a>")
    '(a nil nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a PUBLIC '-//x' 'file:///nonexistent-dot-172'>]><a/>")
    '(a nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY a PUBLIC '-//x' 'file:///nonexistent-dot-172'>]><a x='&a;'/>")
