(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word 'hello'>]><a>&word;&word;</a>" nil)
    '(a nil nil nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY word 'hello'>]><a>&word;&word;</a>" t)
    '(a nil nil nil))
(qa (qa-xml-dtd--parse "<!DOCTYPE a [<!ENTITY % make \"<!ENTITY word 'hello'>\">%make;]><a x='&word;'/>" nil)
    '(a ((x . "hello"))))
