;;; qa_url_cookie_public_suffix.el --- public suffix cookie regression -*- lexical-binding:t -*-

(provide 'url-parse)
(require 'cl-lib)
(require 'url-cookie)

(defun qa1876-cookie-result (host domain subdomain)
  (let ((url-cookie-storage nil)
        (url-cookie-secure-storage nil)
        (url-cookie-confirmation nil)
        (url-cookie-trusted-urls nil)
        (url-cookie-untrusted-urls nil)
        (url-privacy-level nil)
        (url-current-object 'fake-url))
    (cl-letf (((symbol-function 'url-parse-args)
               (lambda (&rest _)
                 (list (cons "sid" "secret")
                       (cons "domain" domain)
                       (cons "path" "/"))))
              ((symbol-function 'url-view-url)
               (lambda (&rest _) (format "http://%s/" host)))
              ((symbol-function 'url-host)
               (lambda (_) host))
              ((symbol-function 'url-domsuf-cookie-allowed-p)
               (lambda (candidate)
                 (not (equal (downcase candidate) "github.io"))))
              ((symbol-function 'url-lazy-message)
               (lambda (&rest _) nil)))
      (url-cookie-handle-set-cookie "sid=secret; Domain=github.io; Path=/")
      (list (caar url-cookie-storage)
            (length (url-cookie-retrieve host "/"))
            (length (url-cookie-retrieve subdomain "/"))))))

(qa (qa1876-cookie-result "github.io" "github.io" "attacker.github.io")
    '("github.io" 1 0))
(qa (qa1876-cookie-result "github.io" ".github.io" "attacker.github.io")
    '("github.io" 1 0))
(qa (qa1876-cookie-result "attacker.github.io" "github.io" "attacker.github.io")
    '(nil 0 0))
(qa (qa1876-cookie-result "example.com" "example.com" "attacker.example.com")
    '(".example.com" 1 1))

(princ (qa--done))
