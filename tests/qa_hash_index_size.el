;;; -*- lexical-binding: nil; -*-
;; Index capacity depends on allocated entry slots, not occupancy (#539).
(dolist (pair '((0 . 1) (1 . 2) (2 . 4) (6 . 8) (7 . 8) (8 . 16)
                (12 . 16) (13 . 16) (14 . 16) (15 . 16) (16 . 32)
                (26 . 32) (27 . 32) (31 . 32) (32 . 64)
                (52 . 64) (53 . 64) (64 . 128) (100 . 128)
                (104 . 128) (105 . 128) (127 . 128) (128 . 256)))
  (let* ((hint (car pair)) (expected (cdr pair))
         (table (make-hash-table :size hint)))
    (qa (internal--hash-table-index-size table) expected)
    (qa (internal--hash-table-index-size (copy-hash-table table)) expected)
    (puthash 'a 1 table)
    (let ((allocated (if (= hint 0) 8 expected)))
      (qa (internal--hash-table-index-size table) allocated)
      (remhash 'a table)
      (qa (internal--hash-table-index-size table) allocated)
      (puthash 'b 2 table)
      (clrhash table)
      (qa (internal--hash-table-index-size table) allocated)
      (qa (internal--hash-table-index-size (copy-hash-table table)) allocated))))
;; Growth changes capacity, and later removals leave that allocation intact.
(dolist (test '(eq eql equal))
  (let ((table (make-hash-table :test test :size 0)))
    (dotimes (n 150)
      (puthash n n table)
      (let* ((capacity (hash-table-size table)) (index-size 1))
        (while (<= index-size capacity) (setq index-size (* 2 index-size)))
        (qa (internal--hash-table-index-size table) index-size)))
    (let ((allocated (internal--hash-table-index-size table)))
      (dotimes (n 150) (remhash n table))
      (qa (internal--hash-table-index-size table) allocated)
      (clrhash table)
      (qa (internal--hash-table-index-size table) allocated))))
(qa-err-data (internal--hash-table-index-size nil)
             'wrong-type-argument '(hash-table-p nil))
(princ (qa--done))
