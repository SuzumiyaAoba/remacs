;;; -*- lexical-binding: t; -*-
;; Inspect live execution, not a fixed CLI-dependent total frame count.
(defun qa118-capture () (backtrace-frames 'qa118-capture))
(defun qa118-front (form count)
  (let ((frames (eval form t)) result)
    (dotimes (_ count) (push (pop frames) result))
    (nreverse result)))
(defun qa118-identity (value) value)

(qa (qa118-front '(qa118-capture) 1)
    '((t qa118-capture nil nil)))
(qa (qa118-front '(let ((value (qa118-capture))) value) 2)
    '((t qa118-capture nil nil)
      (nil let (((value (qa118-capture))) value) nil)))
(qa (qa118-front '(let* ((a 1) (value (qa118-capture))) value) 2)
    '((t qa118-capture nil nil)
      (nil let* (((a 1) (value (qa118-capture))) value) nil)))
(qa (qa118-front '(catch 'tag (qa118-capture)) 2)
    '((t qa118-capture nil nil)
      (nil catch ('tag (qa118-capture)) nil)))
(qa (qa118-front '(unwind-protect (qa118-capture) nil) 2)
    '((t qa118-capture nil nil)
      (nil unwind-protect ((qa118-capture) nil) nil)))
(qa (qa118-front '(qa118-identity (qa118-capture)) 2)
    '((t qa118-capture nil nil)
      (nil qa118-identity ((qa118-capture)) nil)))
(qa (qa118-front '(qa118-identity (qa118-identity (qa118-capture))) 3)
    '((t qa118-capture nil nil)
      (nil qa118-identity ((qa118-capture)) nil)
      (nil qa118-identity ((qa118-identity (qa118-capture))) nil)))
(qa (qa118-front '((lambda (value) (qa118-capture)) 7) 2)
    '((t qa118-capture nil nil)
      (t (lambda (value) (qa118-capture)) (7) nil)))
(qa (qa118-front '(apply #'qa118-capture nil) 2)
    '((t qa118-capture nil nil)
      (t apply (qa118-capture nil) nil)))
(qa (qa118-front '(eval '(qa118-capture) t) 2)
    '((t qa118-capture nil nil)
      (t eval ((qa118-capture) t) nil)))
;; Source macro invocations stay visible around their expansion.
(qa (qa118-front '(when t (qa118-capture)) 4)
    '((t qa118-capture nil nil)
      (nil progn ((qa118-capture)) nil)
      (nil if (t (progn (qa118-capture))) nil)
      (nil when (t (qa118-capture)) nil)))

(qa (qa118-front '(cadr (list 'before (qa118-capture) 'after)) 3)
    '((t qa118-capture nil nil)
      (nil list ('before (qa118-capture) 'after) nil)
      (nil cadr ((list 'before (qa118-capture) 'after)) nil)))

;; A byte-compiled function has no source let frame.
(fset 'qa118-compiled
      (byte-compile '(lambda () (let ((value (qa118-capture))) value))))
(qa (qa118-front '(qa118-compiled) 2)
    '((t qa118-capture nil nil) (t qa118-compiled nil nil)))

(defvar qa118-raw '(lambda () (let ((value (qa118-capture))) value)))
(fset 'qa118-compiled-raw (byte-compile '(lambda () (funcall qa118-raw))))
(qa (qa118-front '(qa118-compiled-raw) 3)
    '((t qa118-capture nil nil)
      (nil let (((value (qa118-capture))) value) nil)
      (t (lambda () (let ((value (qa118-capture))) value)) nil nil)))

(defun qa118-same-frame ()
  (let ((frame (car (backtrace-frames 'qa118-same-frame))))
    (list (cons (car frame) (cons (cadr frame) (nth 2 frame)))
          (backtrace-frame 0 'qa118-same-frame))))
(qa (let ((pair (qa118-same-frame))) (equal (car pair) (cadr pair))) t)
(defalias 'qa118-same-frame-alias 'qa118-same-frame)
(qa (let ((pair (qa118-same-frame-alias)))
      (list (equal (car pair) (cadr pair)) (nth 1 (car pair))))
    '(t qa118-same-frame-alias))
(defun qa118-offset ()
  (list (backtrace-frame 1 'qa118-offset)
        (backtrace-frame 0 '(1 . qa118-offset))))
(qa (let ((pair (qa118-offset))) (equal (car pair) (cadr pair))) t)
(qa (backtrace-frames 'qa118-never-active) nil)
(qa (backtrace-frame 0 'qa118-never-active) nil)

;; Nonlocal exits remove pending frames, while a signal handler sees the
;; actual error call before its frame unwinds.
(defun qa118-thrower () (throw 'qa118-tag 'value))
(qa (catch 'qa118-tag (let ((value (qa118-thrower))) value)) 'value)
(qa (memq 'qa118-thrower (mapcar #'cadr (backtrace-frames))) nil)
(defun qa118-signaler () (error "qa118-error"))
(qa (let (frames)
      (condition-case nil
          (handler-bind ((error (lambda (_) (setq frames (backtrace-frames 'error)))))
            (qa118-signaler))
        (error nil))
      (car frames))
    '(t error ("qa118-error") nil))
(qa (memq 'qa118-signaler (mapcar #'cadr (backtrace-frames))) nil)

(princ (qa--done))
