;;; -*- lexical-binding: t; -*-
;; Issue #88: obsolete pushnew comes from cl, whose real macro honors
;; comparison/key keywords. The bootstrap fallback is not a public API.
(qa (fboundp 'pushnew) nil)
(qa-err-data (let ((xs nil)) (pushnew 1 xs)) 'void-function '(pushnew))
(qa (macroexpand '(pushnew 1 xs)) '(pushnew 1 xs))
(qa (require 'cl-lib) 'cl-lib)
(qa (fboundp 'pushnew) nil)
(qa-err-data (let ((xs nil)) (pushnew 1 xs)) 'void-function '(pushnew))
(qa (require 'cl) 'cl)
(qa (macrop 'pushnew) t)
(qa (macroexpand '(pushnew "a" xs :test 'equal))
    '(setq xs (cl-adjoin "a" xs :test 'equal)))
(defalias 'qa88-alias 'pushnew)
(defalias 'qa88-alias2 'qa88-alias)
(qa (macrop 'qa88-alias2) t)
(qa (macroexpand '(qa88-alias2 '(1 . c) xs :key 'car))
    '(setq xs (cl-adjoin '(1 . c) xs :key 'car)))

;; Predicate inspection follows aliases without loading an autoload.
(autoload 'qa88-auto "qa88-nonexistent" nil nil 'macro)
(defalias 'qa88-auto-alias 'qa88-auto)
(qa (macrop 'qa88-auto-alias) '(macro t))
(qa (autoloadp (symbol-function 'qa88-auto)) t)
(autoload 'qa88-auto-t "qa88-nonexistent" nil nil t)
(defalias 'qa88-auto-t-alias 'qa88-auto-t)
(qa (macrop 'qa88-auto-t-alias) '(t))
(defalias 'qa88-function-alias 'car)
(qa (macrop 'qa88-function-alias) nil)
(defalias 'qa88-void-alias 'qa88-nonexistent-function)
(qa (macrop 'qa88-void-alias) nil)

(qa (let ((xs '("a" "b")))
      (pushnew "a" xs :test 'equal) xs) '("a" "b"))
(qa (let ((xs '("a" "b")))
      (pushnew "c" xs :test #'equal) xs) '("c" "a" "b"))
(qa (let ((xs '((1 . a) (2 . b))))
      (pushnew '(1 . c) xs :key 'car) xs) '((1 . a) (2 . b)))
(qa (let ((xs '((1 . a) (2 . b))))
      (pushnew '(3 . c) xs :key #'car) xs) '((3 . c) (1 . a) (2 . b)))
(qa (let ((xs '(("a" . 1) ("b" . 2))))
      (pushnew '("a" . 3) xs :key #'car :test #'equal) xs)
    '(("a" . 1) ("b" . 2)))
(qa (let ((xs '(1 2))) (pushnew -2 xs :key #'abs) xs) '(1 2))
(qa (let ((xs '(1))) (pushnew 1 xs :test-not #'=) xs) '(1 1))
(qa (let ((xs '(2 3))) (pushnew 1 xs :test-not #'=) xs) '(2 3))

;; Keep the original list object when the element is already present.
(qa (let* ((original (list "a" "b")) (xs original))
      (pushnew (make-string 1 ?a) xs :test #'equal)
      (eq xs original)) t)
;; Evaluate NEWELT and generalized PLACE subforms only once.
(qa (let ((xs '("a")) (calls 0))
      (pushnew (progn (setq calls (1+ calls)) (make-string 1 ?a)) xs :test #'equal)
      (list xs calls)) '(("a") 1))
(qa (let ((xs '(a)) (calls 0))
      (pushnew (progn (setq calls (1+ calls)) 'b) xs :test #'eq)
      (list xs calls)) '((b a) 1))
(qa (let ((vector (vector '("a"))) (calls 0))
      (pushnew "a" (aref vector (progn (setq calls (1+ calls)) 0)) :test #'equal)
      (list (aref vector 0) calls)) '(("a") 1))
(qa (let ((vector (vector '((1 . a)))))
      (pushnew '(2 . b) (aref vector 0) :key #'car)
      (aref vector 0)) '((2 . b) (1 . a)))
(qa (let ((xs '(a b))) (eq (pushnew 'a xs :test #'eq) xs)) t)

(princ (qa--done)) (terpri)
