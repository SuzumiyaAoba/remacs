;; The internal file-error catcher precedes an outer handler-bind, and
;; invokes the Lisp reporter after leaving that catcher.
(qa (let* ((directory (make-temp-file "qa604-observer-" t))
           (file (expand-file-name "file" directory))
           (lock (expand-file-name ".#file" directory))
           (old (symbol-function 'userlock--handle-unlock-error)) events)
      (unwind-protect
          (progn
            (make-symbolic-link "garbage" lock)
            (fset 'userlock--handle-unlock-error (lambda (_) (push 'reported events)))
            (handler-bind ((file-error (lambda (_) (push 'observed events))))
              (unlock-file file))
            events)
        (fset 'userlock--handle-unlock-error old)
        (delete-directory directory t))) '(reported))
;; The foreign-lock diagnostic retains the caller's filename object.
(qa (let* ((directory (make-temp-file "qa606-" t))
           (plain (expand-file-name "file" directory))
           (file (propertize plain 'qa606 'kept))
           (lock (expand-file-name ".#file" directory)))
      (unwind-protect
          (progn
            (make-symbolic-link "other@remote.42:1" lock)
            (condition-case error (lock-file file)
              (file-locked (list (eq (cadr error) file)
                                 (get-text-property 0 'qa606 (cadr error))))))
        (delete-directory directory t))) '(t kept))
(princ (qa--done))
