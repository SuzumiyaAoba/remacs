;;; -*- lexical-binding: nil; -*-
;; Lock target grammar and preservation rules (#603/#604/#605).
(defun qa604-run (target operation)
  (let* ((directory (make-temp-file "qa604-" t))
         (file (expand-file-name "file" directory))
         (lock (expand-file-name ".#file" directory))
         (old (symbol-function 'userlock--handle-unlock-error)) reports)
    (unwind-protect
        (progn
          (make-symbolic-link target lock)
          (fset 'userlock--handle-unlock-error
                (lambda (error)
                  (push (list (car error) (cadr error) (caddr error)
                              (equal (nth 3 error) file)) reports)))
          (let ((result (condition-case error
                            (funcall operation file)
                          (file-error (if (eq (car error) 'file-locked)
                                          (list (car error) (equal (cadr error) file)
                                                (caddr error) (cdddr error))
                                        (list (car error) (cadr error) (caddr error)
                                              (equal (nth 3 error) file))))
                          (error (list (car error) (cddr error))))))
            (list result (equal (file-symlink-p lock) target)
                  (not (null (file-symlink-p lock))) (nreverse reports))))
      (fset 'userlock--handle-unlock-error old)
      (delete-directory directory t))))
(qa (qa604-run "garbage" 'file-locked-p) '((file-error "Testing file lock" "Invalid argument" t) t t nil))
(qa (qa604-run "garbage" 'lock-file) '(nil t t nil))
(qa (qa604-run "garbage" 'unlock-file) '(nil t t ((file-error "Unlocking file" "Invalid argument" t))))
(qa (qa604-run "other@remote.42:bad" 'file-locked-p) '((file-error "Testing file lock" "Invalid argument" t) t t nil))
(qa (qa604-run "other@remote.42:bad" 'lock-file) '(nil t t nil))
