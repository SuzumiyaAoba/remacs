;;; -*- lexical-binding: t; -*-
;; GNU prints the cons prefix of dotted signal data, ignoring its atom tail.
(qa (error-message-string '(error "a" . "b")) "a")
(qa (error-message-string '(error "a" 1 . "b")) "a: 1")
(qa (error-message-string '(error "a" 1 2 . "b")) "a: 1, 2")
(qa (error-message-string '(error "a" 1 2)) "a: 1, 2")
(qa (error-message-string '(error . "a")) "peculiar error")
(qa (error-message-string '(error nil . "b")) "peculiar error")
(qa (error-message-string '(error "" . "b")) "")
(qa (error-message-string '(error "" 1 . "tail")) "1")
(qa (error-message-string '(error "" 1 2 . "tail")) "1, 2")
(qa (error-message-string '(file-error "message" . "tail")) "message")
(qa (error-message-string '(file-error "message" "file" . "tail")) "message: file")
(qa (error-message-string '(file-error "message" "first" "second" . "tail"))
    "message: first, second")
(qa (error-message-string '(wrong-type-argument symbolp . 5))
    "Wrong type argument: symbolp")
(qa (error-message-string '(wrong-type-argument symbolp 5 . ignored))
    "Wrong type argument: symbolp, 5")
(qa (error-message-string '(user-error "a" . "b")) "a")
(qa (error-message-string '(user-error "a" "b" . "tail")) "a, b")
(qa (error-message-string '(end-of-file "a" . "b")) "End of file during parsing: a")
(qa (error-message-string '(end-of-file "a" "b" . "tail"))
    "End of file during parsing: a, b")
(princ (qa--done))
