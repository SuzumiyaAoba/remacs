;; == print-circle / print-length / print-level ==
(defun qarp-circle-unlabeled-shared-p (object)
  (let ((print-circle t))
    (let ((single (prin1-to-string object)))
      (equal (prin1-to-string (list object object))
             (concat "(" single " " single ")")))))

(qa (qarp-circle-unlabeled-shared-p obarray) t)
(qa (qarp-circle-unlabeled-shared-p (frame-terminal)) t)
(qa (qarp-circle-unlabeled-shared-p (current-window-configuration)) t)
(qa (let ((x (list 1)))
      (setcdr x x)
      (let ((print-circle t)) (prin1-to-string x)))
    "#1=(1 . #1#)")
(qa (let ((c (list 1 2)) (print-circle t))
      (prin1-to-string (list c c)))
    "(#1=(1 2) #1#)")
(qa (let ((c (list 1 2)) (print-circle nil))
      (prin1-to-string (list c c)))
    "((1 2) (1 2))")
(qa (let ((print-length 2)) (prin1-to-string '(1 2 3 4))) "(1 2 ...)")
(qa (let ((print-length 0)) (prin1-to-string '(1 2))) "(...)")
(qa (let ((print-length 2)) (prin1-to-string [1 2 3 4])) "[1 2 ...]")
(qa (let ((print-level 1)) (prin1-to-string '((a) (b)))) "(... ...)")
(qa (let ((print-level 2)) (prin1-to-string '((a (b)) c))) "((a ...) c)")

;; GNU's recursive printer errors once nesting reaches 200.  Both output
;; modes use the same guard, while print-level can stop a deeper traversal.
(qa (let ((x nil) (print-level nil) (print-circle nil))
      (dotimes (_ 199) (setq x (list x)))
      (length (prin1-to-string x)))
    401)
(qa (let ((x nil) (print-level nil) (print-circle nil))
      (dotimes (_ 200) (setq x (list x)))
      (condition-case err
          (prin1-to-string x)
        (error (list (car err) (cadr err)))))
    '(error "Apparently circular structure being printed"))
(qa (let ((x nil) (print-level nil) (print-circle nil))
      (dotimes (_ 199) (setq x (list x)))
      (with-temp-buffer
        (princ x (current-buffer))
        (length (buffer-string))))
    401)
(qa (let ((x nil) (print-level nil) (print-circle nil))
      (dotimes (_ 200) (setq x (list x)))
      (condition-case err
          (with-temp-buffer
            (princ x (current-buffer))
            (buffer-string))
        (error (list (car err) (cadr err)))))
    '(error "Apparently circular structure being printed"))
(qa (let ((x nil) (print-level 199) (print-circle nil))
      (dotimes (_ 201) (setq x (list x)))
      (length (prin1-to-string x)))
    401)
(qa (let ((x nil) (print-level nil) (print-circle nil))
      (dotimes (_ 199) (setq x (vector x)))
      (length (prin1-to-string x)))
    401)
(qa (let ((x nil) (print-level nil) (print-circle nil))
      (dotimes (_ 200) (setq x (vector x)))
      (condition-case err
          (with-temp-buffer
            (princ x (current-buffer))
            (buffer-string))
        (error (list (car err) (cadr err)))))
    '(error "Apparently circular structure being printed"))
(qa (let ((x (current-buffer))
          (print-level nil)
          (print-circle nil)
          (qa-print-deep-callback-count 0)
          (print-unreadable-function
           (lambda (_object _escape)
             (setq qa-print-deep-callback-count
                   (1+ qa-print-deep-callback-count))
             "opaque")))
      (dotimes (_ 200) (setq x (list x)))
      (list (condition-case err
                (prin1-to-string x)
              (error (list (car err) (cadr err))))
            qa-print-deep-callback-count))
    '((error "Apparently circular structure being printed") 0))

;; == readablep ==
;; returns the printed STRING when the object has read syntax
;; remacs: returns the object, not the printed string
(qa (readablep 42) "42")
(qa (readablep "s") "\"s\"")
(qa (readablep 'a) "a")
(qa (readablep '(a . b)) "(a . b)")
(qa (readablep [1 2]) "[1 2]")
;; unreadable objects → nil
(qa (readablep (symbol-function 'car)) nil)
(qa (readablep (current-buffer)) nil)

;; == with-output-to-string ==
(qa (with-output-to-string (princ "hi") (prin1 '(1 2))) "hi(1 2)")
(qa (with-output-to-string (print 'a)) "\na\n")
(qa (with-output-to-string (princ "a\nb")) "a\nb")
(qa (with-output-to-string (prin1 "a\nb")) "\"a\nb\"")
(qa (with-output-to-string (terpri) (terpri) (princ "x")) "\n\nx")

