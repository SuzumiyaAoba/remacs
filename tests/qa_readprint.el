;; Function streams observe the reader's unread protocol. Dot-before-close
;; lookahead unreads the delimiter twice before the next form is requested.
(defun qarp-read-stream-lookahead (source)
  (let ((input (string-to-list source)) (unread nil))
    (let ((stream (lambda (&optional character)
                    (if character
                        (progn (push character unread)
                               (setq input (cons character input)))
                      (prog1 (car input) (setq input (cdr input)))))))
      (let* ((first (read stream))
             (lookahead-unreads (prog1 (nreverse unread) (setq unread nil)))
             (second (read stream)))
        (list first lookahead-unreads second)))))
(qa (qarp-read-stream-lookahead "(a .) (b)")
    '((a \.) (32 41 41) (b)))
(qa (qarp-read-stream-lookahead "[a .] [b]")
    '([a \.] (32 93 93) [b]))
(qa (let ((result (qarp-read-stream-lookahead ",a b")))
      (list (eq (caar result) (intern ","))
            (cadr result) (caddr result)))
    '(t (97 32) b))
(qa (let ((result (qarp-read-stream-lookahead ",@a b")))
      (list (eq (caar result) (intern ",@"))
            (cadr result) (caddr result)))
    '(t (32) b))

;; == read on a string / on a buffer ==
(qa (read "\"hello\"") "hello")
(qa (read "'x") '(quote x))
(qa (read "()") nil)
;; read from a buffer consumes text and advances point
(qa (with-temp-buffer
      (insert "(a b) 42")
      (goto-char (point-min))
      (list (read (current-buffer)) (point)
            (read (current-buffer)) (point)))
    '((a b) 6 42 9))
;; read-print roundtrip via buffer insert + read
(qa (with-temp-buffer
      (insert (prin1-to-string '(1 "two" [3] (4 . 5))))
      (goto-char (point-min))
      (read (current-buffer)))
    '(1 "two" [3] (4 . 5)))

;; == #n= / #n# shared and circular structure ==
(qa (let ((x (car (read-from-string "#1=(a . #1#)"))))
      (eq x (cdr x)))
    t)
(qa (let ((x (car (read-from-string "(#1=(1 2) #1#)"))))
      (eq (car x) (cadr x)))
    t)
(qa-err (qarp-r "(a #1#)") 'invalid-read-syntax)

