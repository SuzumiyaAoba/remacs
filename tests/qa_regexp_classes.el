          (list name fold method expected)))))

;; Syntax classes follow major modes and custom buffer tables.
(qa (with-temp-buffer (emacs-lisp-mode)
      (string-match "[[:space:]]" "\n")) nil)
(qa (with-temp-buffer (c-mode)
      (string-match "[[:space:]]" "\n")) nil)
(qa (with-syntax-table (make-syntax-table)
      (modify-syntax-entry ?x " ")
      (string-match "[[:space:]]" "abxc")) 2)
(qa (with-syntax-table (make-syntax-table)
      (modify-syntax-entry 32 ".")
      (string-match "[[:space:]]" "a b")) nil)
(qa (with-syntax-table (make-syntax-table)
      (modify-syntax-entry ?€ "w")
      (string-match "[[:punct:]]" "a€b")) nil)
;; ASCII case equivalence is included when compiling class members.
(qa (let ((case-fold-search t))
      (with-syntax-table (make-syntax-table)
        (modify-syntax-entry ?X " ")
        (list (string-match "[[:space:]]" "x")
              (string-match "[[:space:]]" "X")))) '(0 0))
;; Customized Unicode classifications are read as raw enum IDs.
(let ((unicode-category-table (copy-sequence unicode-category-table))
      (case-fold-search nil))
  (aset unicode-category-table #x0301 9)
  (qa (string-match "[[:alpha:]]" (string #x0301)) nil)
  (qa (string-match "[[:alnum:]]" (string #x0301)) 0)
  (aset unicode-category-table #x0378 1)
  (qa (string-match "[[:alpha:]]" (string #x0378)) 0)
  (qa (string-match "[[:print:]]" (string #x0378)) 0)
  (qa (string-match "[[:graph:]]" (string #x0378)) 0))
;; Current case tables, rather than Unicode Lowercase, decide casing.
(qa (with-temp-buffer
      (let ((table (copy-case-table (current-case-table))) (case-fold-search nil))
        (aset table ?@ ?!)
        (set-char-table-extra-slot table 0 nil)
        (set-char-table-extra-slot table 1 nil)
        (set-char-table-extra-slot table 2 nil)
        (set-case-table table)
        (list (string-match "[[:upper:]]" "@")
              (string-match "[[:lower:]]" "!")
              (string-match "[[:lower:]]" "@")))) '(0 0 nil))
;; Negation, literal union, split-string and skip-chars use the same classes.
(qa (string-match "[^[:punct:]]" "。a") 1)
(qa (string-match "[[:blank:]x]" "a　b") 1)
(qa (split-string "a。b" "[[:punct:]]") '("a" "b"))
(qa (with-temp-buffer (insert "a　b") (goto-char 1)
      (skip-chars-forward "^[:blank:]")) 1)
(qa (with-temp-buffer (insert "ab。c") (goto-char 1)
      (skip-chars-forward "^[:punct:]")) 2)
;; Raw high bytes follow GNU's byte bitmap instead of Unicode membership.
(dolist (name '("ascii" "nonascii" "unibyte" "multibyte" "alnum" "alpha"
