;; Issue #8. GNU Emacs 31.1 class membership across search entry points.
(defvar qa8-codes '(0 5 9 10 11 12 13 28 31 32 33 36 48 57 65 90 97 122 95 127 128 133 160 170 178 189 191 223 255 256 453 769 888 931 962 1488 1632 2307 8413 8192 8195 8203 8232 8233 8364 12288 12289 12290 19968 8544 9312 55296 57344 128512 1114111 1114112 4194176 4194303))
(defun qa8-results (name fold method)
  (with-syntax-table (standard-syntax-table)
    (let ((case-fold-search fold)
          (regexp (concat "\\`[[:" name ":]]\\'")))
      (mapcar
       (lambda (code)
         (let ((text (string code)))
           (and
            (cond
             ((eq method 'string) (string-match regexp text))
             ((eq method 'string-p) (string-match-p regexp text))
             ((eq method 'posix-string) (posix-string-match regexp text))
             (t (with-temp-buffer
                  ;; Set the mode in each buffer, independently of how
                  ;; buffer-local let bindings propagate to new buffers.
                  (setq case-fold-search fold)
                  (insert text)
                  (if (memq method '(backward posix-backward))
                      (goto-char (point-max))
                    (goto-char (point-min)))
                  (cond
                   ((eq method 'looking) (looking-at regexp))
                   ((eq method 'forward) (re-search-forward regexp nil t))
                   ((eq method 'backward) (re-search-backward regexp nil t))
                   ((eq method 'posix-forward) (posix-search-forward regexp nil t))
                   ((eq method 'posix-backward) (posix-search-backward regexp nil t))))))
            t)))
       qa8-codes))))
