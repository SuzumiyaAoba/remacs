;; Coverage probe: jump-to-register, numeric bases, format-spec,
;; error-message-string, macros, interactive specs, window commands.
(defmacro ci (&rest body) `(condition-case nil (progn ,@body) (quit nil) (t nil)))

;; ---------- jump-to-register branches ----------
(with-temp-buffer
  (insert "abcdefghij")
  (goto-char 5)
  (point-to-register ?a)
  (goto-char 1)
  (ci (jump-to-register ?a)))
(ci (set-register ?b 42) (jump-to-register ?b))
(ci (set-register ?c "text") (jump-to-register ?c))
(ci (set-register ?d '(window-configuration m))
    (jump-to-register ?d))
(ci (set-register ?e (cons 'buffer "*scratch*"))
    (jump-to-register ?e))
(ci (set-register ?f (cons 'file "/tmp/remacs_cov_probe.txt"))
    (jump-to-register ?f))
(ci (set-register ?g (list 'file-query "/tmp/remacs_cov_probe.txt" 2))
    (jump-to-register ?g))
(ci (set-register ?h (cons 'mystery 'x)) (jump-to-register ?h))
(ci (jump-to-register ?z))
;; marker register whose buffer died
(with-temp-buffer
  (let ((b (current-buffer)))
    (point-to-register ?i)
    (kill-buffer b)
    (ci (jump-to-register ?i))))

;; ---------- increment-register branches ----------
(with-temp-buffer
  (insert "hello world")
  (set-register ?j 5)
  (ci (increment-register 3 ?j))
  (ci (increment-register -2 ?j))
  (ci (increment-register 2.5 ?k))
  (goto-char 1) (set-mark 5)
  (ci (set-register ?l "base")
      (increment-register 1 ?l)
      (increment-register 1 ?l t)))

