;; ---------- interactive spec codes via call-interactively ----------
(progn
  (defun ci-p (n) (interactive "p") n)
  (defun ci-pp (n) (interactive "P") n)
  (defun ci-r (b e) (interactive "r") (list b e))
  (defun ci-d (d) (interactive "d") d)
  (defun ci-m (m) (interactive "m") m)
  (defun ci-str (s) (interactive "sS: ") s)
  (defun ci-sym (s) (interactive "aS: ") s)
  (defun ci-num (n) (interactive "nN: ") n)
  (defun ci-list (a b) (interactive (list 1 2)) (list a b))
  (defun ci-multi (a b c) (interactive "p\nr\nm") (list a b c))
  (defun ci-star () (interactive "*") t)
  (defun ci-unk (u) (interactive "U") u)
  (defun ci-mix (a b) (interactive "*\n^@p") (list a b))
  nil)
(with-temp-buffer
  (insert "abcdef")
  (goto-char 4) (set-mark 2)
  (ci (call-interactively 'ci-p))
  (ci (call-interactively 'ci-pp))
  (ci (call-interactively 'ci-r))
  (ci (call-interactively 'ci-d))
  (ci (call-interactively 'ci-m))
  (ci (call-interactively 'ci-str))
  (ci (call-interactively 'ci-sym))
  (ci (call-interactively 'ci-num))
  (ci (call-interactively 'ci-list))
  (ci (call-interactively 'ci-multi))
  (ci (call-interactively 'ci-star))
  (ci (call-interactively 'ci-unk))
  (ci (call-interactively 'ci-mix))
  ;; with a numeric prefix
  (let ((current-prefix-arg '(4))
        (prefix-arg '(4)))
    (ci (call-interactively 'ci-p))
    (ci (call-interactively 'ci-pp))
    (ci (call-interactively 'ci-num)))
  (let ((current-prefix-arg '-))
    (ci (call-interactively 'ci-p))
    (ci (call-interactively 'ci-pp)))
  (let ((current-prefix-arg 7))
    (ci (call-interactively 'ci-p))))
;; call-interactively on subrs with declared specs
(with-temp-buffer
  (insert "xyz")
  (ci (call-interactively 'forward-char))
  (ci (call-interactively 'self-insert-command))
  (let ((current-prefix-arg '(4)))
