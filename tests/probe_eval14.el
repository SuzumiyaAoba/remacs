;; ---------- macroexpand paths ----------
(ci (defmacro m1 (x) `(+ ,x 1))
    (macroexpand '(m1 5))
    (macroexpand-1 '(m1 5))
    (macroexpand '(m1 (m1 5)))
    (macrop 'm1)
    (funcall (symbol-function 'm1) '(m1 9)))
;; macro cons form directly
(ci (macroexpand-1 '((macro . (lambda (x) x)) 3)))
;; macroexpand on non-macro / atoms
(ci (macroexpand '(car x))
    (macroexpand-1 'atom)
    (macroexpand-1 42))
;; bad macro args (dotted)
(ci (defmacro m2 (a b) a)
    (macroexpand-1 '(m2 . x)))
;; macro that throws/signals
(ci (defmacro m3 () (error "macfail"))
    (macroexpand '(m3)))

