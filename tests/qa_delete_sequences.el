;;; -*- lexical-binding: nil; -*-
;; String character codes/representation (#386), no-op identity (#388).
(dotimes (byte 256)
  (let* ((source (unibyte-string byte 65 byte))
         (result (delete byte source)))
    (qa (string-to-list result) (if (= byte 65) nil '(65)))
    (qa (multibyte-string-p result) nil)
    (qa (string-to-list source) (list byte 65 byte))
    (qa (eq source result) nil)))
(dolist (code '(128 255 #x3fff80 #x3fffff #x110007 #x3fff7f))
  (let* ((source (string code ?a code)) (result (delete code source)))
    (qa (string-to-list result) '(97))
    (qa (multibyte-string-p result) t)
    (qa (string-to-list source) (list code 97 code))))
(let ((source (string #x3fffff 255)))
  (qa (string-to-list (delete 255 source)) '(4194303))
  (qa (string-to-list (delete #x3fffff source)) '(255)))
(dolist (source (list (string-to-multibyte "aa") (unibyte-string 97 97)))
  (qa (multibyte-string-p (delete ?a source)) (multibyte-string-p source)))
(let* ((source (propertize (string-to-multibyte "aba") 'tag 'value))
       (result (delete ?a source)))
  (qa (multibyte-string-p result) t)
  (qa (text-properties-at 0 result) nil)
  (qa (get-text-property 0 'tag source) 'value))
(dolist (source (list "" "abc" (propertize "abc" 'tag t)
                     (unibyte-string 255) (string-to-multibyte "abc")
                     [] [a b] (vector (list 'a))))
  (qa (eq source (delete 'absent source)) t))
(let* ((item (list 'a)) (source (vector item 'keep item))
       (result (delete (list 'a) source)))
  (qa result [keep])
  (qa (eq result source) nil)
  (qa (eq (aref source 0) item) t)
  (qa (length source) 3))
(qa (eq (delete 'a [a a]) []) t)
(princ (qa--done))
