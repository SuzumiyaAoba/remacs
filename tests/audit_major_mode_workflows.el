;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "mode:emacs-lisp-mode" '(with-temp-buffer (insert "(defun foo (x)\n(if x\n(+ x 1)\n0))\n") (emacs-lisp-mode)
  (indent-region (point-min) (point-max))
  (font-lock-mode 1) (font-lock-ensure)
  (list major-mode (buffer-substring-no-properties (point-min) (point-max))
        (mapcar (lambda (p) (get-text-property p 'face)) (number-sequence 1 (min 12 (1- (point-max))))))))
(audit-check "mode:lisp-mode" '(with-temp-buffer (insert "(defun foo (x)\n(if x\n(+ x 1)\n0))\n") (lisp-mode)
