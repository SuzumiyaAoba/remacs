;;; -*- lexical-binding: nil; -*-
;; Raw-byte multibyte strings differ from unibyte bytes (#400).
(dotimes (byte 256)
  (let* ((a (unibyte-string byte))
         (b (string-to-multibyte a))
         (same (< byte 128))
         (table (make-hash-table :test 'equal)))
    (qa (equal a b) same)
    (qa (equal-including-properties a b) same)
    (qa (string= a b) same)
    (qa (string= b a) same)
    (qa (string= (make-symbol a) b) same)
    (qa (string= a (make-symbol b)) same)
    (qa (equal (list a) (list b)) same)
    (qa (equal (vector a) (vector b)) same)
    (puthash a 'unibyte table)
    (puthash b 'multibyte table)
    (qa (hash-table-count table) (if same 1 2))
    (qa (gethash (copy-sequence a) table) (if same 'multibyte 'unibyte))
    (qa (gethash (copy-sequence b) table) 'multibyte)
    (qa (equal (propertize a 'tag t) (propertize b 'tag t)) same)
    (qa (equal-including-properties (propertize a 'tag t) (propertize b 'tag t)) same)))
;; Byte equality alone is insufficient when character counts differ.
(qa (equal (unibyte-string #xc3 #xa9) (string #xe9)) nil)
(qa (string= (unibyte-string #xc3 #xa9) (string #xe9)) nil)
(qa (string= nil "nil") t)
(qa (string= 'abc "abc") t)
(qa-err-data (string= 42 'abc) 'wrong-type-argument '(stringp 42))
(qa-err-data (string= 'abc 42) 'wrong-type-argument '(stringp 42))
(princ (qa--done))
