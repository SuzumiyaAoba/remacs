;;; -*- lexical-binding: t; -*-
;; GNU 31.1 accepts arbitrary eq-comparable property names.  Issue #116
;; reverses GNU's result: SYMBOL, rather than PROP, must be a symbol.
(qa (documentation-property 'qa116-missing 5) nil)
(qa (documentation-property 'qa116-missing 1.5) nil)
(qa (documentation-property 'qa116-missing "doc") nil)
(qa (documentation-property 'qa116-missing []) nil)
(qa (documentation-property 'qa116-missing '(a . b)) nil)
(qa (documentation-property 'qa116-missing nil) nil)
(qa (documentation-property 'qa116-missing t) nil)
(qa (let ((key (list 'arbitrary 'property)))
      (put 'qa116-object key "list documentation")
      (documentation-property 'qa116-object key t)) "list documentation")
(qa (let ((key (vector 'arbitrary 'property)))
      (put 'qa116-object key "vector documentation")
      (documentation-property 'qa116-object key t)) "vector documentation")
(qa (let ((key (copy-sequence "property")))
      (put 'qa116-object key "string documentation")
      (documentation-property 'qa116-object key t)) "string documentation")
(qa (progn (put 'qa116-object 7 "integer documentation")
           (documentation-property 'qa116-object 7)) "integer documentation")
(qa (let ((key (copy-sequence "same")))
      (put 'qa116-object key "identity documentation")
      (documentation-property 'qa116-object (copy-sequence key) t)) nil)
(qa (progn (put 'qa116-object 9 '(concat "evaluated" " value"))
           (documentation-property 'qa116-object 9 t)) "evaluated value")
(qa (progn (put 'qa116-object 10 0)
           (documentation-property 'qa116-object 10 t)) nil)
(qa-err-data (documentation-property 5 6) 'wrong-type-argument '(symbolp 5))
(qa-err-data (documentation-property "symbol" 5) 'wrong-type-argument '(symbolp "symbol"))
(qa-err-data (documentation-property [] 5) 'wrong-type-argument '(symbolp []))
(qa (documentation-property nil 5) nil)
(qa (documentation-property t 5) nil)
(princ (qa--done))
