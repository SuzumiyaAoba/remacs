;;; -*- lexical-binding: nil; -*-
;; GNU 31.1 verified: #628 #629 #630 #631.
(defun qa-b64-region (encoder input unibyte option)
  (with-temp-buffer
    (when unibyte (set-buffer-multibyte nil))
    (insert input)
    (let ((size (funcall encoder (point-min) (point-max) option)))
      (list size (string-to-list (buffer-string))))))
(qa (qa-b64-region 'base64-encode-region "f" nil t) '(4 (90 103 61 61)))
(qa (qa-b64-region 'base64-encode-region "f" nil nil) '(4 (90 103 61 61)))
(qa (qa-b64-region 'base64url-encode-region "f" nil nil) '(4 (90 103 61 61)))
(qa (qa-b64-region 'base64url-encode-region "f" nil t) '(2 (90 103)))
(qa (qa-b64-region 'base64url-encode-region (unibyte-string 251 255) nil nil) '(4 (45 95 56 61)))
(qa (qa-b64-region 'base64url-encode-region (unibyte-string 251 255) t t) '(3 (45 95 56)))
(dolist (size '(0 1 56 57 58 114 115))
  (dolist (no-break '(nil t))
    (qa (with-temp-buffer
          (insert (make-string size ?f))
          (let* ((length (base64-encode-region 1 (point-max) no-break))
                 (text (buffer-string))
                 (flat (base64-encode-string (make-string size ?f) t))
                 (breaks (if no-break 0 (/ (max 0 (1- (length flat))) 76))))
            (list (= length (+ (length flat) breaks))
                  (equal (replace-regexp-in-string "\n" "" text) flat)
                  (not (string-suffix-p "\n" text)))))
        '(t t t))))
(qa (qa-b64-region 'base64-decode-region "/w==" nil nil) '(1 (4194303)))
(qa (qa-b64-region 'base64-decode-region "/w==" t nil) '(1 (255)))
(qa (qa-b64-region 'base64-decode-region "wqA=" nil nil) '(2 (4194242 4194208)))
(qa (qa-b64-region 'base64-decode-region "wqA=" t nil) '(2 (194 160)))
(dolist (unibyte '(nil t))
  (qa (with-temp-buffer
        (when unibyte (set-buffer-multibyte nil))
        (insert (apply #'unibyte-string (number-sequence 0 255)))
        (let ((original (string-to-list (buffer-string))))
          (base64-encode-region 1 (point-max) nil)
          (list (base64-decode-region 1 (point-max))
                (equal (string-to-list (buffer-string)) original))))
      '(256 t)))
(dolist (encoder '(base64-encode-region base64url-encode-region))
  (dolist (code '(128 983168 55296 1114112))
    (qa (with-temp-buffer
          (insert (char-to-string code))
          (let ((original (buffer-string)))
            (condition-case error
                (progn (funcall encoder 1 (point-max) t) 'unexpected)
              (error (list (car error) (cadr error) (equal original (buffer-string)))))))
        '(error "Multibyte character in data for base64 encoding" t))))
(qa (with-temp-buffer
      (insert "Zg")
      (condition-case error (base64-decode-region 1 (point-max))
        (error (list error (buffer-string)))))
    '((error "Invalid base64 data") "Zg"))
(dolist (kind '(encode decode))
  (qa (with-temp-buffer
        (insert (if (eq kind 'encode) (char-to-string 128) "Zg"))
        (setq buffer-read-only t)
        (condition-case error
            (if (eq kind 'encode)
                (base64-encode-region 1 (point-max) t)
              (base64-decode-region 1 (point-max)))
          (error (car error))))
      'error))
(qa (condition-case error (base64url-encode-string (char-to-string 128))
      (error error))
    '(error "Multibyte character in data for base64 encoding"))
(princ (qa--done))
