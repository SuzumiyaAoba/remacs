;;; -*- coding: utf-8; lexical-binding: nil -*-
;; Issue #45: replacement counts the new middle, not all decoded characters.
;; Expected observations below were captured with GNU Emacs 31.1.
(defun qa45-observe (old new pos narrow literal)
  (let ((file (make-temp-file "qa45-")))
    (unwind-protect
        (progn
          (let ((coding-system-for-write 'utf-8-unix))
            (write-region new nil file nil 'quiet))
          (with-temp-buffer
            (insert old)
            (dotimes (j (length old))
              (put-text-property (1+ j) (+ 2 j) 'qa45-origin j))
            (let ((markers nil) (changes nil) (before nil))
              (dotimes (j (1+ (length old)))
                (push (copy-marker (1+ j)) markers)
                (push (copy-marker (1+ j) t) markers))
              (when narrow (narrow-to-region (car narrow) (cadr narrow)))
              (goto-char pos)
              (set-buffer-modified-p nil)
              (let* ((tick (buffer-chars-modified-tick))
                     (before-change-functions
                      (list (lambda (beg end) (push (list beg end) before))))
                     (after-change-functions
                      (list (lambda (beg end oldlen) (push (list beg end oldlen) changes))))
                     (coding-system-for-read 'utf-8-unix)
                     (result (funcall (if literal #'insert-file-contents-literally #'insert-file-contents)
                                      file nil nil nil t))
                     (point (point)) (lo (point-min)) (hi (point-max)))
                (widen)
                (list (cadr result) (buffer-string) point lo hi
                      (mapcar #'marker-position (reverse markers))
                      (let ((props nil))
                        (dotimes (j (buffer-size))
                          (push (get-text-property (1+ j) 'qa45-origin) props))
                        (reverse props))
                      (not (null (buffer-modified-p)))
                      (= tick (buffer-chars-modified-tick))
                      (reverse before) (reverse changes))))))
      (delete-file file))))

