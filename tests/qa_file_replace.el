  (qa (apply #'qa45-observe (car case)) (cadr case)))
(defun qa45-postprocess (action)
  (let ((file (make-temp-file "qa45-post-")))
    (unwind-protect
        (progn
          (write-region "XzzY" nil file nil 'quiet)
          (with-temp-buffer
            (insert "XabcY") (goto-char 4)
            (let* ((seen nil)
                   (after-insert-file-functions
                    (list (lambda (n)
                            (push (list n (point)) seen)
                            (cond
                             ((eq action 'grow) (insert "!") (goto-char (point-min)) (1+ n))
                             ((eq action 'property) (put-text-property 1 2 'qa45-tag t) n)
                             ((eq action 'nil) nil)
                             ((eq action 'invalid) -1)
                             ((eq action 'error) (error "qa45-post"))
                             (t n)))))
                   (result (condition-case e (cadr (insert-file-contents file nil nil nil t))
                             (error e))))
              (list result (buffer-substring-no-properties (point-min) (point-max))
                    (point) seen (get-text-property 1 'qa45-tag)))))
      (delete-file file))))

