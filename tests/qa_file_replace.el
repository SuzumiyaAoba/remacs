(defun qa45-window (action)
  (save-window-excursion
    (let ((file (make-temp-file "qa45-w-"))
          (orig (generate-new-buffer " qa45-w"))
          (other (generate-new-buffer " qa45-other")) (seen nil))
      (unwind-protect
          (progn
            (write-region "XzzY" nil file nil 'quiet)
            (with-current-buffer other (insert "123456789") (goto-char 8))
            (switch-to-buffer orig) (insert "XabcY") (goto-char 4)
            (let ((w (split-window-right)))
              (set-window-buffer w orig) (set-window-point w 4)
              (let ((after-insert-file-functions
                     (list (lambda (n)
                             (setq seen (list n (point) (window-point w)
                                              inhibit-modification-hooks (eq buffer-undo-list t)))
                             (cond ((eq action 'move) (set-window-point w 2) n)
                                   ((eq action 'grow) (insert "!") (goto-char 1) (1+ n))
                                   ((eq action 'kill) (delete-window w) n)
                                   ((eq action 'switch) (set-window-buffer w other)
                                    (set-window-point w 8) n)
                                   (t n))))))
                (let ((count (cadr (insert-file-contents file nil nil nil t))))
                  (list action count (point)
                        (and (window-live-p w) (window-point w)) seen)))))
        (delete-file file) (kill-buffer orig) (kill-buffer other)))))
(qa (qa45-window 'noop) '(noop 2 3 3 (4 1 3 t t)))
(qa (qa45-window 'move) '(move 2 3 2 (4 1 3 t t)))
(qa (qa45-window 'grow) '(grow 5 4 4 (4 1 3 t t)))
(qa (qa45-window 'kill) '(kill 2 3 nil (4 1 3 t t)))
(qa (qa45-window 'switch) '(switch 2 3 8 (4 1 3 t t)))

(defun qa45-buffer-callback (action)
  (let ((file (make-temp-file "qa45-b-"))
        (orig (generate-new-buffer " qa45-b"))
        (other (generate-new-buffer " qa45-other")))
    (unwind-protect
        (progn
          (write-region "XzzY" nil file nil 'quiet)
          (with-current-buffer other (insert "123456789") (goto-char 8))
          (with-current-buffer orig
            (insert "XabcY") (goto-char 4)
            (let ((after-insert-file-functions
                   (list (lambda (n)
                           (when (eq action 'kill) (kill-buffer orig))
                           (set-buffer other)
                           (when (eq action 'switch-int) (goto-char 1) n)))))
              (let ((result (condition-case e
                                (cadr (insert-file-contents file nil nil nil t))
                              (error e))))
                (list result (eq (current-buffer) other) (point)
                      (and (buffer-live-p orig) (with-current-buffer orig (point))))))))
      (delete-file file)
      (when (buffer-live-p orig) (kill-buffer orig))
      (when (buffer-live-p other) (kill-buffer other)))))
(qa (qa45-buffer-callback 'switch-nil) '(2 t 3 1))
(qa (qa45-buffer-callback 'switch-int) '(4 t 3 1))
(qa (qa45-buffer-callback 'kill)
    '((error "Marker does not point anywhere") t 8 nil))
(let ((file (make-temp-file "qa45-raw-")))
  (unwind-protect
      (progn
        (write-region "XY" nil file nil 'quiet)
        (dolist (literal '(nil t))
          (qa (with-temp-buffer
                (set-buffer-multibyte nil) (insert "AXY")
                (let ((changes nil) (coding-system-for-read 'no-conversion))
                  (let ((after-change-functions (list (lambda (&rest args) (push args changes)))))
                    (funcall (if literal #'insert-file-contents-literally #'insert-file-contents)
                             file nil nil nil t))
                  (reverse changes))) '((1 1 1)))))
    (delete-file file)))
