(qa (qa45-postprocess 'invalid) '((wrong-type-argument inserted-chars -1) "XzzY" 3 ((4 1)) nil))

(qa (qa45-postprocess 'error) '((error "qa45-post") "XzzY" 3 ((4 1)) nil))
