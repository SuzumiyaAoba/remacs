;;; -*- lexical-binding: t; -*-
;; Issue #111: preserve run/log lifecycle and give profiler.el real samples.
(require 'profiler)
(require 'seq)
(defvar qa111-mode)
(defun qa111-clear ()
  (profiler-cpu-stop) (profiler-memory-stop)
  (profiler-cpu-log) (profiler-memory-log)
  (profiler-reset))
(defun qa111-hot ()
  (let ((n 0))
    (while (< n 200000)
      (setq n (1+ n))
      (cons n nil))))
(defun qa111-alloc-old () (make-string 65536 ?a))
(defun qa111-alloc-new () (make-string 65536 ?b))
(defun qa111-contains (log function)
  (let ((found nil))
    (maphash (lambda (trace count)
               (when (and (> count 0) (seq-contains-p trace function))
                 (setq found t))) log)
    found))
(qa111-clear)
(qa (list (profiler-cpu-running-p) (profiler-memory-running-p)
          (profiler-cpu-log) (profiler-memory-log)
          (profiler-cpu-stop) (profiler-memory-stop))
    '(nil nil nil nil nil nil))
(qa (profiler-cpu-start 1000000000) t)
(qa (profiler-cpu-running-p) t)
(qa (hash-table-p (profiler-cpu-log)) t)
(qa (hash-table-test (profiler-cpu-log)) 'equal)
(qa (hash-table-p (profiler-cpu-log)) t)
(qa (profiler-cpu-stop) t)
(qa (profiler-cpu-stop) nil)
(qa (hash-table-p (profiler-cpu-log)) t)
(qa (profiler-cpu-log) nil)
(qa (profiler-memory-start) t)
(qa (profiler-memory-running-p) t)
(qa (hash-table-p (profiler-memory-log)) t)
(qa (hash-table-test (profiler-memory-log)) 'equal)
(qa (hash-table-p (profiler-memory-log)) t)
(qa (profiler-memory-stop) t)
(qa (profiler-memory-stop) nil)
(qa (hash-table-p (profiler-memory-log)) t)
(qa (profiler-memory-log) nil)
(qa-err-data (progn (profiler-cpu-start 1000000000) (profiler-cpu-start 0))
             'error '("CPU profiler is already running"))
(qa111-clear)
(qa-err-data (progn (profiler-memory-start) (profiler-memory-start))
             'error '("Memory profiler is already running"))
(qa111-clear)
(dolist (qa111-mode '(0 -1 1.0 nil x 2305843009213693952))
  (qa-err-data (profiler-cpu-start qa111-mode) 'error '("Invalid sampling interval"))
  ;; GNU has allocated a pending log even though timer setup failed.
  (qa (hash-table-p (profiler-cpu-log)) t)
  (qa (profiler-cpu-log) nil))
(qa (let ((profiler-max-stack-depth 4))
      (profiler-memory-start)
      (qa111-alloc-old)
      (profiler-memory-stop)
      (let ((log (profiler-memory-log)))
        (and (qa111-contains log 'qa111-alloc-old)
             (let ((valid t))
               (maphash (lambda (trace count)
                          (unless (and (vectorp trace) (= (length trace) 4)
                                       (integerp count) (> count 0))
                            (setq valid nil))) log)
               valid)))) t)
(qa (progn
      (profiler-memory-start) (qa111-alloc-old) (profiler-memory-stop)
      (let ((weight 0))
        (maphash (lambda (trace count)
                   (when (seq-contains-p trace 'qa111-alloc-old)
                     (setq weight (+ weight count)))) (profiler-memory-log))
        (>= weight 65536))) t)
(qa (progn
      (profiler-memory-start) (qa111-alloc-old) (profiler-memory-stop)
      (profiler-memory-start) (qa111-alloc-new) (profiler-memory-stop)
      (let ((log (profiler-memory-log)))
        (and (qa111-contains log 'qa111-alloc-old)
             (qa111-contains log 'qa111-alloc-new)))) t)
(qa (progn
      (profiler-memory-start) (qa111-alloc-old) (profiler-memory-stop)
      (qa111-alloc-new)
      (profiler-memory-start) (qa111-alloc-old) (profiler-memory-stop)
      (let ((log (profiler-memory-log)))
        (and (qa111-contains log 'qa111-alloc-old)
             (not (qa111-contains log 'qa111-alloc-new))))) t)
(qa (progn
      (profiler-memory-start) (qa111-alloc-old)
      (let ((old (profiler-memory-log)))
        (qa111-alloc-new) (profiler-memory-stop)
        (let ((new (profiler-memory-log)))
          (and (not (eq old new))
               (qa111-contains old 'qa111-alloc-old)
               (qa111-contains new 'qa111-alloc-new)
               (not (qa111-contains new 'qa111-alloc-old)))))) t)
(qa (progn
      (profiler-cpu-start 1000000)
      (qa111-hot)
      (profiler-cpu-stop)
      (let ((log (profiler-cpu-log)))
        (and (> (hash-table-count log) 0)
             (qa111-contains log 'qa111-hot)))) t)
(qa (progn
      (profiler-cpu-start 1000000)
      (sleep-for 0.1)
      (profiler-cpu-stop)
      (let ((weight 0))
        (maphash (lambda (trace count)
                   (when (eq (aref trace 0) 'sleep-for)
                     (setq weight (+ weight count)))) (profiler-cpu-log))
        ;; Waiting for 100ms must not become 100ms of CPU samples.
        (< weight 50))) t)
;; The overflow label is a symbol, not a string.
(qa (let ((profiler-log-size 2))
      (profiler-memory-start)
      (qa111-alloc-old) (qa111-alloc-new) (qa111-hot)
      (profiler-memory-stop)
      (let ((log (profiler-memory-log)))
        (and (> (gethash '[Discarded\ Samples nil] log 0) 0)
             (<= (hash-table-count log) 3)))) t)
(defun qa111-report (mode)
  (unwind-protect
      (save-window-excursion
        (delete-other-windows)
        (qa111-clear)
        (profiler-start mode)
        (qa111-hot)
        (profiler-report)
        (let ((type (if (eq mode 'cpu) 'cpu 'memory)))
          (and (eq major-mode 'profiler-report-mode)
               (eq (profiler-profile-type profiler-report-profile) type)
               (hash-table-p (profiler-profile-log profiler-report-profile))
               (> (buffer-size) 0)
               (progn (profiler-stop) (profiler-report) t))))
    (qa111-clear)
    (dolist (buffer (buffer-list))
      (when (string-match-p "\\`\\*\\(?:CPU\\|Memory\\)-Profiler-Report" (buffer-name buffer))
        (kill-buffer buffer)))))
(dolist (qa111-mode '(cpu mem cpu+mem))
  (qa (qa111-report qa111-mode) t))
(qa-err-data (profiler-report) 'user-error '("No profiler run recorded"))
(princ (qa--done)) (terpri)
