;;; -*- lexical-binding: nil; -*-
;; Issue #21: remote identification through the real Tramp handler.
;; These calls only parse names or inspect an existing connection.

(qa (file-remote-p "/ssh:h:/x") "/ssh:h:")
(qa (file-remote-p "/method:host:/x") "/method:host:")
(qa (file-remote-p "/ssh:h:x") "/ssh:h:")
(qa (file-remote-p "/ssh:h:/x" 'host) "h")
(qa (file-remote-p "/ssh:h:/x" 'method) "ssh")
(qa (file-remote-p "/ssh:h:/x" 'user) nil)
(qa (file-remote-p "/u@v:h:/x" 'host) nil)
(qa (file-remote-p "/x") nil)
(qa (file-remote-p "/::x") nil)
(qa (file-remote-p "ssh:h:/x") nil)
(qa (file-remote-p "") nil)
(qa (file-remote-p "/ssh:h:/x" 'localname) "/x")
(qa (file-remote-p "/ssh:h:x" 'localname) "x")
(qa (file-remote-p "/ssh:h:/x" 'unknown) "/ssh:h:")
(qa (file-remote-p "/ssh:h:/x" 'hop) nil)
(qa (file-remote-p "/ssh:u@h#2222:/x" 'user) "u")
(qa (file-remote-p "/ssh:u@h#2222:/x" 'host) "h#2222")
(qa (file-remote-p "/ssh:u@h#2222:/x" 'localname) "/x")
(qa (file-remote-p "/ssh:u@h#2222:/x") "/ssh:u@h#2222:")
(qa (file-remote-p "/ssh:[::1]:/x" 'host) "::1")
(qa (file-remote-p "/ssh:jump|ssh:u@host:/file" 'hop) "ssh:jump|")
(qa (file-remote-p "/ssh:jump|ssh:u@host:/file" 'host) "host")
(qa (file-remote-p "/ssh:jump|ssh:u@host:/file" 'user) "u")
(qa (file-remote-p "/ssh:qa21-unconnected.invalid:/x" nil t) nil)
(qa (file-remote-p "/ssh:qa21-unconnected.invalid:/x" 'host t) nil)
(qa (file-remote-p "/ssh:qa21-unconnected.invalid:/x" nil 'never)
    "/ssh:qa21-unconnected.invalid:")
(qa (file-remote-p "/ssh:qa21-unconnected.invalid:/x" 'host 'never)
    "qa21-unconnected.invalid")

;; GNU 31.1 checks stringp even for nil (the old issue's nil row
;; described a different state). Verify complete error data.
(qa-err-data (file-remote-p nil) 'wrong-type-argument '(stringp nil))
(qa-err-data (file-remote-p t) 'wrong-type-argument '(stringp t))
(qa-err-data (file-remote-p 1) 'wrong-type-argument '(stringp 1))
(qa-err-data (file-remote-p 'name) 'wrong-type-argument '(stringp name))
(qa-err-data (file-remote-p [1]) 'wrong-type-argument '(stringp [1]))

;; Remote syntax does not bypass file-name-handler dispatch. Handler
;; arguments, return values and inhibition follow files.el exactly.
(defun qa21-handler (&rest args) args)
(qa (let ((file-name-handler-alist nil)) (file-remote-p "/ssh:h:/x")) nil)
(qa (let ((file-name-handler-alist '(("\\`/qa21:" . qa21-handler))))
      (file-remote-p "/qa21:h:/file" 'localname 'never))
    '(file-remote-p "/qa21:h:/file" localname never))
(qa (let ((file-name-handler-alist '(("\\`/qa21:" . qa21-handler))))
      (file-remote-p "/qa21:h:/file"))
    '(file-remote-p "/qa21:h:/file" nil nil))
(qa (let ((file-name-handler-alist '(("\\`/qa21:" . qa21-handler)))
          (inhibit-file-name-handlers '(qa21-handler))
          (inhibit-file-name-operation 'file-remote-p))
      (file-remote-p "/qa21:h:/file" 'host)) nil)
(qa (let ((file-name-handler-alist '(("\\`/qa21:" . qa21-handler)))
          (inhibit-file-name-handlers '(qa21-handler))
          (inhibit-file-name-operation 'file-exists-p))
      (file-remote-p "/qa21:h:/file" 'host))
    '(file-remote-p "/qa21:h:/file" host nil))
(qa (let ((file-name-handler-alist '(("\\`/qa21:" . ignore))))
      (file-remote-p "/qa21:h:/file")) nil)

(princ (qa--done)) (terpri)
