;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "relocation:delete-region" '(with-temp-buffer (insert "abcd") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (save-excursion (goto-char 1) (insert "P")))))) (let ((result (delete-region 2 3))) (list result (buffer-string) (point))))))
(audit-check "relocation:delete-char" '(with-temp-buffer (insert "abcd") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (save-excursion (goto-char 1) (insert "P")))))) (let ((result (delete-char 1))) (list result (buffer-string) (point))))))
(audit-check "relocation:delete-and-extract-region" '(with-temp-buffer (insert "abcd") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (save-excursion (goto-char 1) (insert "P")))))) (let ((result (delete-and-extract-region 2 3))) (list result (buffer-string) (point))))))
(audit-check "relocation:replace-region-contents" '(with-temp-buffer (insert "abcd") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (save-excursion (goto-char 1) (insert "P")))))) (let ((result (replace-region-contents 2 3 "X"))) (list result (buffer-string) (point))))))
(audit-check "relocation:kill-insert" '(with-temp-buffer (insert "SAFE") (let* ((outer (current-buffer)) (b (generate-new-buffer " *audit-killed-target*")) (result (with-current-buffer b (insert "abcd") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (kill-buffer (current-buffer)) (set-buffer outer))))) (condition-case e (insert "X") (error (car e))))))) (list result (buffer-string)))))
(audit-check "relocation:kill-delete" '(with-temp-buffer (insert "SAFE") (let* ((outer (current-buffer)) (b (generate-new-buffer " *audit-killed-target*")) (result (with-current-buffer b (insert "abcd") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (kill-buffer (current-buffer)) (set-buffer outer))))) (condition-case e (delete-region 2 3) (error (car e))))))) (list result (buffer-string)))))
(princ "AUDIT-DONE\n")
