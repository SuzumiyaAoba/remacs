(defmacro qa139-with-library (&rest body)
  `(let ((qa139-file (make-temp-file "qa139-" nil ".el")))
     (unwind-protect
         (progn
           (write-region "(defun qa139-command (arg) (interactive \"P\") (list arg (called-interactively-p 'any)))\n(defun qa139-noncommand () 42)\n"
                         nil qa139-file nil 'silent)
           ,@body)
       (delete-file qa139-file)
       (fmakunbound 'qa139-command)
       (fmakunbound 'qa139-noncommand)
       (fmakunbound 'qa139-alias))))
(qa (qa139-with-library
      (autoload 'qa139-command qa139-file)
      (let ((current-prefix-arg 13)) (call-interactively 'qa139-command))) '(13 t))
(qa (qa139-with-library
      (autoload 'qa139-command qa139-file)
      (defalias 'qa139-alias 'qa139-command)
      (let ((current-prefix-arg 13)) (call-interactively 'qa139-alias))) '(13 t))
(qa (qa139-with-library
      (autoload 'qa139-command qa139-file)
      (interactive-form 'qa139-command)) '(interactive "P"))
(qa (qa139-with-library
      (autoload 'qa139-command qa139-file)
      (command-execute 'qa139-command)) '(nil t))
(qa (qa139-with-library
      (autoload 'qa139-noncommand qa139-file)
      (condition-case e (call-interactively 'qa139-noncommand)
        (wrong-type-argument (list (cdr e) (autoloadp (symbol-function 'qa139-noncommand))))))
    '((commandp qa139-noncommand) nil))
(qa (let ((v (make-symbol "qa139-disabled"))
          (disabled-command-function (lambda () 'blocked)))
      (fset v (lambda () (interactive) 42)) (put v 'disabled t)
      (call-interactively v)) 42)
(qa-err-data (call-interactively "abc") 'wrong-type-argument '(commandp "abc"))
(qa-err-data (interactive-form '(autoload "qa139-no-such-file" nil nil nil))
             'wrong-type-argument '(symbolp (autoload "qa139-no-such-file" nil nil nil)))
;; An explicit interactive-form property can supply a command's spec;
;; the closest alias override takes precedence over the base symbol.
(qa (let ((v (make-symbol "qa139-property")))
      (fset v (lambda (x) (list x (called-interactively-p 'any))))
      (put v 'interactive-form '(interactive (list 17)))
      (list (interactive-form v) (call-interactively v)))
    '((interactive (list 17)) (17 t)))
(qa (let ((v (make-symbol "qa139-base")) (alias (make-symbol "qa139-alias")))
      (fset v (lambda (x) x)) (defalias alias v)
      (put v 'interactive-form '(interactive (list 17)))
      (put alias 'interactive-form '(interactive (list 23)))
      (list (interactive-form alias) (call-interactively alias)))
    '((interactive (list 23)) 23))
(princ (qa--done))
