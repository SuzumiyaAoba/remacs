;; == Expanded and negative years, safe huge width, and parse overflow ==
(let ((system-time-locale "C"))
  (qa (format-time-string "%+Y|%F|%0F|%+F|%12F|%+12F" 253402398245 t)
      "+10000|+10000-01-02|10000-01-02|+10000-01-02|010000-01-02|+10000-01-02")
  (qa (format-time-string "%Y|%C|%6C|%_6C" -62198755200 t)
      "-001|-0|-00000|    -0")
  ;; No padding means this large valid width never allocates a huge string.
  (qa (format-time-string "%-2147483648Y" 1704164645 t) "2024")
  ;; Parse overflow is rejected even when '-' would suppress padding.
  (qa-err-data (format-time-string "%999999999999999999999Y" 1704164645 t)
               'error '("Invalid time specification"))
  (qa-err-data (format-time-string "%-999999999999999999999Y" 1704164645 t)
               'error '("Invalid time specification"))
  (qa-err-data (format-time-string "%999999999999999999999Q" 1704164645 t)
               'error '("Invalid time specification")))

;; Locale composites may include the caller's zone name. Keep that name
;; alive for libc and permit all text that fits GNU's native 1024-byte buffer.
(let ((system-time-locale "en_US.UTF-8"))
  (let ((base (format-time-string "%c" 0 '(0 "XYZ"))))
    (qa (or (equal base "Thu Jan  1 00:00:00 1970")
            (string-suffix-p "XYZ" base)) t)
    (when (string-suffix-p "XYZ" base)
      (dolist (n '(500 900))
        (let ((zone (make-string n ?X)))
          (qa (format-time-string "%c" 0 (list 0 zone))
              (concat (substring base 0 -3) zone))
          (qa (format-time-string "%_1024c" 0 (list 0 zone))
              (concat (make-string (- 1024 (+ (string-bytes base) n -3)) ?\s)
                      (substring base 0 -3) zone)))))))

;; Failed native conversions do not get width padding. Valid empty locale
;; strings still do. Compute the boundary from this platform's locale text.
(let ((system-time-locale "en_US.UTF-8"))
  (let ((base (format-time-string "%c" 0 '(0 "XYZ"))))
    (when (string-suffix-p "XYZ" base)
      (let ((zone (make-string (- 1023 (- (string-bytes base) 3)) ?X)))
        (qa (format-time-string "%c" 0 (list 0 zone)) "")
        (qa (format-time-string "%01024c" 0 (list 0 zone)) "")))))
(let ((system-time-locale "fr_FR.UTF-8"))
  (let ((ampm (format-time-string "%p" 0 t)))
    (qa (format-time-string "%010p" 0 t)
        (concat (make-string (- 10 (string-bytes ampm)) ?0) ampm))))

(princ (qa--done))
