;;; -*- lexical-binding: nil; -*-
;; Issue #60: folded rx literal must match two backslashes, then equals.
(let* ((literal (concat (make-string 2 92) "="))
       (regexp (car (nth 10 lisp-el-font-lock-keywords-2))))
  (qa (string-to-list regexp) '(92 92 92 92 61))
  (qa regexp (regexp-quote literal))
  (qa (car (nth 10 lisp-font-lock-keywords-2)) regexp)
  (qa (cdr (nth 10 lisp-el-font-lock-keywords-2))
      '((0 'font-lock-builtin-face prepend)))
  (dotimes (n 5)
    (let ((text (concat (make-string n 92) "=")))
      (qa (string-match-p regexp text) (and (>= n 2) (- n 2)))
      (qa (string-match-p (concat "\\`" regexp "\\'") text)
          (and (= n 2) 0))))
  (qa (string-match-p regexp (concat "prefix " literal " suffix")) 7)
  (qa (string-match-p regexp (make-string 3 92)) nil)
  (qa (string-match-p regexp "=") nil)
  (qa (string-match-p regexp "") nil)
  (with-temp-buffer
    (insert "before " literal " after")
    (goto-char (point-min))
    (qa (re-search-forward regexp nil t) 11)
    (qa (match-string 0) literal)
    (qa (match-beginning 0) 8)
    (qa (match-end 0) 11)))
(princ (qa--done)) (terpri)
