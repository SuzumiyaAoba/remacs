;;; -*- lexical-binding: nil; -*-
;; Issue #72: symbol arguments remove only the identical obarray member.
(dolist (ob (list (obarray-make) (make-vector 7 0)))
  (dolist (name '("qa72-name" "日本" "qa72\0name" "" "nil" "t" ":qa72-keyword"))
    (let* ((member (intern name ob))
           (twin (make-symbol name))
           (foreign (intern name (obarray-make)))
           (global (intern name)))
      (qa (eq member twin) nil)
      (dolist (outsider (list twin foreign global))
        (qa (unintern outsider ob) nil)
        (qa (eq (intern-soft name ob) member) t))
      (qa (unintern member ob) t)
      (qa (intern-soft name ob) nil)
      (qa (unintern member ob) nil)
      (let ((replacement (intern name ob)))
        (qa (eq replacement member) nil)
        (qa (unintern member ob) nil)
        (qa (eq (intern-soft name ob) replacement) t)
        (qa (unintern (propertize name 'face 'bold) ob) t)
        (qa (intern-soft name ob) nil)))))
;; Default obarray identity behavior must remain unchanged.
(let* ((name "qa72-default-member")
       (member (intern name))
       (twin (make-symbol name)))
  (unwind-protect
      (progn
        (qa (unintern twin nil) nil)
        (qa (eq (intern-soft name) member) t)
        (qa (unintern member nil) t)
        (qa (intern-soft name) nil))
    (unintern name nil)))
(let ((ob (obarray-make)))
  (qa (unintern "qa72-absent" ob) nil)
  (dolist (value '(1 1.5 [a] (a)))
    (qa-err-data (unintern value ob) 'wrong-type-argument (list 'stringp value))))
(princ (qa--done))
