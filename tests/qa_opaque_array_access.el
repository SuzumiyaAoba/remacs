;;; -*- lexical-binding: nil; -*-
;; Opaque pseudovectors do not expose their internal record slots (#481).
(dolist (object (list (font-spec :family "Monospace") (obarray-make)
                     (current-window-configuration)))
  (qa-err-data (length object) 'wrong-type-argument (list 'sequencep object))
  (dolist (op '(length= length< length>))
    (qa-err-data (funcall op object 0) 'wrong-type-argument (list 'sequencep object))
    (qa-err-data (funcall op object 'bad) 'wrong-type-argument '(fixnump bad)))
  (qa (length= object -1) nil)
  (qa-err-data (length< object -1) 'wrong-type-argument (list 'sequencep object))
  (qa-err-data (length> object -1) 'wrong-type-argument (list 'sequencep object))
  (dolist (index (list -1 0 1 most-positive-fixnum))
    (qa-err-data (elt object index) 'wrong-type-argument (list 'sequencep object))
    (qa-err-data (aref object index) 'wrong-type-argument (list 'arrayp object))
    (qa-err-data (aset object index 'changed) 'wrong-type-argument (list 'arrayp object)))
  ;; elt validates the object first; aref/aset validate the index first.
  (qa-err-data (elt object 'bad) 'wrong-type-argument (list 'sequencep object))
  (qa-err-data (aref object 'bad) 'wrong-type-argument '(fixnump bad))
  (qa-err-data (aset object 'bad 'changed) 'wrong-type-argument '(fixnump bad)))
;; Ordinary records with opaque-looking tags remain fully accessible.
(dolist (tag '(font-spec obarray bool-vector char-table))
  (let ((object (record tag 'value)))
    (qa (length object) 2)
    (qa (length= object 2) t)
    (qa-err-data (elt object 0) 'wrong-type-argument (list 'sequencep object))
    (qa-err-data (elt object 'bad) 'wrong-type-argument (list 'sequencep object))
    (qa (aref object 1) 'value)
    (qa (aset object 0 'new-tag) 'new-tag)
    (qa (aref object 0) 'new-tag)))
;; Genuine array types retain their element operations.
(let ((bits (bool-vector t nil)) (table (make-char-table 'test 'initial)))
  (qa (length bits) 2)
  (qa (length= bits 2) t)
  (qa (aref bits 0) t)
  (qa (aset bits 1 t) t)
  (qa (elt bits 1) t)
  (qa (length table) 4194304)
  (qa (aref table 65) 'initial)
  (qa (aset table 65 'changed) 'changed)
  (qa (elt table 65) 'changed))
(let ((function #[257 "\207" [] 1]))
  (qa (length function) 4)
  (qa (aref function 0) 257)
  (qa-err-data (elt function 0) 'wrong-type-argument (list 'sequencep function))
  (qa-err-data (elt function 'bad) 'wrong-type-argument (list 'sequencep function)))
;; GNU bytecode opcodes Blength (71), Baref (72), and Belt (156).
(dolist (object (list (font-spec) (obarray-make)))
  (qa-err-data (funcall #[257 "\107\207" [] 1] object)
               'wrong-type-argument (list 'sequencep object))
  (qa-err-data (funcall #[257 "\300\110\207" [0] 2] object)
               'wrong-type-argument (list 'arrayp object))
  (qa-err-data (funcall #[257 "\300\234\207" [0] 2] object)
               'wrong-type-argument (list 'sequencep object)))
(let ((object (record 'tag 'value)))
  (qa (funcall #[257 "\107\207" [] 1] object) 2)
  (qa (funcall #[257 "\300\110\207" [0] 2] object) 'tag)
  (qa-err-data (funcall #[257 "\300\234\207" [0] 2] object)
               'wrong-type-argument (list 'sequencep object)))
(princ (qa--done))
