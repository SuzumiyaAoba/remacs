;;; -*- lexical-binding: nil; -*-
;; Weak-key reachability, including values that refer back to their key.
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (dotimes (n 1000) (puthash (vector n) 42 h))
      (garbage-collect) (garbage-collect)
      (< (hash-table-count h) 10)) t)
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)) (keep (vector 'keep)))
      (puthash keep 'retained h)
      (dotimes (n 1000) (puthash (vector n) 42 h))
      (garbage-collect) (garbage-collect)
      (list (< (hash-table-count h) 10) (gethash keep h))) '(t retained))
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (dotimes (n 1000) (let ((key (vector n))) (puthash key (list key) h)))
      (garbage-collect) (garbage-collect)
      (< (hash-table-count h) 10)) t)
(qa (let* ((h (make-hash-table :test 'eq :weakness 'key))
           (keep (list (vector 'keep))))
      (puthash (car keep) keep h)
      (garbage-collect) (garbage-collect)
      (eq (gethash (car keep) h) keep)) t)


(defun qa194-count (mode keep-keys keep-value)
 (let ((h (make-hash-table :test 'eq :weakness mode))
       (keys (and keep-keys (make-vector 1000 nil)))
       (anchor (and keep-value (vector 'anchor))))
  (dotimes (n 1000)
   (let ((key (vector n)) (value (or anchor (vector n))))
    (when keys (aset keys n key))
    (puthash key value h)))
  (garbage-collect) (garbage-collect)
  (list (if (< (hash-table-count h) 10) 'gone (hash-table-count h))
        (and keys (= (length keys) 1000)) (and anchor t))))

(qa (qa194-count 'key nil nil) '(gone nil nil))
(qa (qa194-count 'key t nil) '(1000 t nil))
(qa (qa194-count 'key nil t) '(gone nil t))
(qa (qa194-count 'value nil nil) '(gone nil nil))
(qa (qa194-count 'value t nil) '(gone t nil))
(qa (qa194-count 'value nil t) '(1000 nil t))
(qa (qa194-count 'key-and-value nil nil) '(gone nil nil))
(qa (qa194-count 'key-and-value t nil) '(gone t nil))
(qa (qa194-count 'key-and-value nil t) '(gone nil t))
(qa (qa194-count 'key-or-value nil nil) '(gone nil nil))
(qa (qa194-count 'key-or-value t nil) '(1000 t nil))
(qa (qa194-count 'key-or-value nil t) '(1000 nil t))
(qa (qa194-count 't nil nil) '(gone nil nil))
(qa (qa194-count 't t nil) '(gone t nil))
(qa (qa194-count 't nil t) '(gone nil t))
(qa (qa194-count 'nil nil nil) '(1000 nil nil))
(qa (qa194-count 'nil t nil) '(1000 t nil))
(qa (qa194-count 'nil nil t) '(1000 nil t))

(qa-lex (let ((h (make-hash-table :test 'eq :weakness 'key)))
          (dotimes (n 1000) (puthash (vector n) 42 h))
          (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(qa-lex (let ((h (make-hash-table :test 'eq :weakness 'key)) (keep (vector 'keep)))
          (puthash keep 42 h) (garbage-collect)
          (gethash keep h)) 42)

(qa (let ((a (make-hash-table :test 'eq :weakness 'value))
          (b (make-hash-table :test 'eq :weakness 'key)) (z (vector 'z)))
      (let ((x (vector 'x)) (y (vector 'y))) (puthash x y a) (puthash z y b))
      (garbage-collect) (garbage-collect)
      (list (hash-table-count a) (hash-table-count b)
            (let ((seen nil)) (maphash (lambda (_key value) (setq seen value)) a)
              (eq seen (gethash z b))))) '(1 1 t))
(qa (let ((h (make-hash-table :test 'equal :weakness 'key)))
      (dotimes (n 1000) (puthash (format "key-%s" n) n h))
      (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (dotimes (n 1000)
        (let ((key (format "key-%s" n)))
          (put-text-property 0 1 'qa194-self key key) (puthash key n h)))
      (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (dotimes (n 1000) (puthash (cons n nil) n h))
      (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(qa (let* ((h (make-hash-table :test 'eq :weakness 'key))
           (copy (progn (dotimes (n 1000) (puthash (vector n) n h)) (copy-hash-table h))))
      (garbage-collect) (garbage-collect)
      (list (< (hash-table-count h) 10) (< (hash-table-count copy) 10))) '(t t))
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (puthash 42 'retained h) (garbage-collect)
      (list (hash-table-count h) (gethash 42 h))) '(1 retained))
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (dotimes (n 1000) (puthash (make-hash-table :test 'eq) n h))
      (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (dotimes (n 1000) (puthash (+ n 0.5) n h))
      (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (dotimes (n 1000) (puthash (+ (expt 2 100) n) n h))
      (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(qa-lex (let* ((h (make-hash-table :test 'eq :weakness 'key))
               (key (vector 'captured))
               (reader (lambda () key)))
          (puthash key 42 h)
          (garbage-collect)
          (gethash (funcall reader) h)) 42)
(qa (with-temp-buffer
      (insert "x")
      (let* ((h (make-hash-table :test 'eq :weakness 'key)) (key (vector 'property)))
        (puthash key 42 h) (put-text-property 1 2 'qa194-key key)
        (let ((indirect (make-indirect-buffer (current-buffer) " *qa194-indirect*")))
          (unwind-protect
              (progn (setq key nil) (garbage-collect)
                     (gethash (get-text-property 1 'qa194-key) h))
            (kill-buffer indirect))))) 42)
(qa (let* ((h (make-hash-table :test 'eq :weakness 'key))
           (key (vector 'property)) (owner (copy-sequence "x")))
      (puthash key 42 h) (put-text-property 0 1 'qa194-key key owner)
      (setq key nil) (garbage-collect)
      (gethash (get-text-property 0 'qa194-key owner) h)) 42)
(qa (let* ((h (make-hash-table :test 'eq :weakness 'key))
           (key (vector 'record)) (owner (record 'qa194 key)))
      (puthash key 42 h) (setq key nil) (garbage-collect)
      (gethash (aref owner 1) h)) 42)


(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (dotimes (n 1000)
        (puthash (eval '(lambda () n) (list (cons 'n n))) n h))
      (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(qa (let ((h (make-hash-table :test 'eq :weakness 'key)))
      (dotimes (n 1000) (let ((key (vector nil))) (aset key 0 key) (puthash key n h)))
      (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(qa (let ((h (read "#s(hash-table test eq weakness key data nil)")))
      (dotimes (n 1000) (puthash (vector n) n h))
      (garbage-collect) (garbage-collect) (< (hash-table-count h) 10)) t)
(princ (qa--done))
