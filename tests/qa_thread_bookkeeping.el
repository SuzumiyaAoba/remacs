;;; -*- lexical-binding: nil -*-
;; Issue #44: self-delivery is synchronous; CLEANUP clears only when non-nil.
(defun qa44-catch (fn)
  (condition-case e (funcall fn) (t e)))
(dolist (condition '(error user-error quit args-out-of-range))
  (dolist (data '(nil ("message") (1 2) ("message" . tail)))
    (qa (qa44-catch (lambda () (thread-signal (current-thread) condition data)))
        (qa44-catch (lambda () (signal condition data))))))
(dolist (condition '(42 "error" [error] qa44-unknown (error "message")))
  (dolist (data '(nil ("other")))
    (qa (qa44-catch (lambda () (thread-signal (current-thread) condition data)))
        (qa44-catch (lambda () (signal condition data))))))
(qa-err-data (thread-signal nil 42 nil) 'wrong-type-argument '(threadp nil))
(qa-err-data (thread-signal 42 'error nil) 'wrong-type-argument '(threadp 42))
(qa (let ((clean nil))
      (list (condition-case e
              (unwind-protect (thread-signal (current-thread) 'error '("stop"))
                (setq clean t))
              (error e)) clean))
    '((error "stop") t))
(thread-last-error t)
(qa (thread-last-error) nil)
(qa (progn (qa44-catch (lambda () (thread-signal (current-thread) 'error '("main"))))
           (thread-last-error)) nil)
;; Join makes lifecycle assertions deterministic. GNU does not keep exited
;; threads in all-threads; the issue's immediate post-spawn example races exit.
(dolist (cleanup '(t 1 qa44-clear))
  (let ((th (make-thread (lambda () (error "qa44-worker")) "qa44-worker")))
    (thread-join th)
    (qa (thread-live-p th) nil)
    (qa (memq th (all-threads)) nil)
    (qa (thread-last-error) '(error "qa44-worker"))
    (qa (thread-last-error nil) '(error "qa44-worker"))
    (qa (thread-last-error) '(error "qa44-worker"))
    (qa (thread-last-error cleanup) '(error "qa44-worker"))
    (qa (thread-last-error) nil)
    (qa (thread-last-error t) nil)))
(let ((th (make-thread (lambda ()
                        (thread-signal (current-thread) 'error '("self-worker")))
                      "qa44-self")))
  (thread-join th)
  (qa (thread-last-error t) '(error "self-worker"))
  (qa (thread-last-error) nil)
  (qa (thread-live-p th) nil)
  (qa (memq th (all-threads)) nil))
(qa (let ((th (make-thread (lambda () 42))))
      (list (thread-join th) (thread-live-p th) (memq th (all-threads))))
    '(42 nil nil))
(qa (thread-last-error) nil)
(qa (threadp (current-thread)) t)
(qa (not (null (memq (current-thread) (all-threads)))) t)
(qa-err-data (thread-join (current-thread)) 'error '("Cannot join current thread"))
(qa (thread-live-p (current-thread)) t)
(let ((th (make-thread (lambda () 7))))
  (while (memq th (all-threads)) (thread-yield))
  (qa (thread-live-p th) nil)
  (qa (thread-join th) 7)
  (qa (thread-join th) 7))
;; Signals to a dead target are retained for later joins, not recorded as
;; new uncaught worker errors. Validation occurs at join, not delivery.
(let ((th (make-thread (lambda () 23))))
  (thread-join th)
  (dolist (condition '(error quit 42 qa44-unknown (error "cons")))
    (dolist (data '(nil ("later")))
      (qa (thread-signal th condition data) nil)
      (qa (qa44-catch (lambda () (thread-join th)))
          (qa44-catch (lambda () (signal condition data))))
      (qa (qa44-catch (lambda () (thread-join th)))
          (qa44-catch (lambda () (signal condition data))))
      (qa (thread-last-error) nil)))
  (qa (thread-signal th nil '(ignored)) nil)
  (qa (thread-join th) 23)
  (qa (thread-join th) 23)
  (qa (thread-live-p th) nil))
;; Issue #154: literal error validation and synchronous custom self-delivery.
(qa-err-data (thread-signal (current-thread) 'nosuchsig '(d))
             'error '("Invalid error symbol" nosuchsig))
(qa-err-data (thread-signal (current-thread) 'error '("self-delivery"))
             'error '("self-delivery"))
(define-error 'qa154-error "Thread signal regression")
(qa-err-data (thread-signal (current-thread) 'qa154-error '(d)) 'qa154-error '(d))
(qa (let ((continued nil) (clean nil))
      (list (condition-case e
                (unwind-protect
                    (progn (thread-signal (current-thread) 'qa154-error '(d))
                           (setq continued t))
                  (setq clean t))
              (qa154-error e)) continued clean))
    '((qa154-error d) nil t))
(princ (qa--done)) (terpri)
