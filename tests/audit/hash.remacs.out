FORM|"hash:custom-test"|(progn (define-hash-table-test 'audit-case-fold (lambda (a b) (string= (downcase a) (downcase b))) (lambda (a) (sxhash-equal (downcase a)))) (let ((h (make-hash-table :test 'audit-case-fold))) (puthash "HELLO" 42 h) (list (gethash "hello" h) (hash-table-test h))))
AUDIT|"hash:custom-test"|(ok (nil audit-case-fold))
FORM|"hash:cycle-lookup"|(let* ((a (list 1)) (b (list 1)) (h (make-hash-table :test 'equal))) (setcdr a a) (setcdr b b) (puthash a 42 h) (gethash b h))
AUDIT|"hash:cycle-lookup"|(ok nil)
FORM|"equal:deep-different-lists"|(let ((a 1) (b 2)) (dotimes (_ 205) (setq a (list a) b (list b))) (equal a b))
AUDIT|"equal:deep-different-lists"|(ok t)
FORM|"hash:equal-shared-subtree"|(let* ((a (list 1)) (b (list a a)) (c (list (list 1) (list 1))) (h (make-hash-table :test 'equal))) (puthash b 42 h) (list (equal b c) (gethash c h)))
AUDIT|"hash:equal-shared-subtree"|(ok (t 42))
FORM|"hash:equal-byte-string"|(let ((h (make-hash-table :test 'equal)) (a (unibyte-string 233)) (b (string 233))) (puthash a 42 h) (list (equal a b) (gethash b h)))
AUDIT|"hash:equal-byte-string"|(ok (nil nil))
FORM|"hash:equal-bool-vector"|(let ((h (make-hash-table :test 'equal))) (puthash (make-bool-vector 3 t) 42 h) (gethash (make-bool-vector 3 t) h))
AUDIT|"hash:equal-bool-vector"|(ok 42)
FORM|"hash:equal-markers"|(with-temp-buffer (let ((h (make-hash-table :test 'equal))) (puthash (point-marker) 42 h) (gethash (point-marker) h)))
AUDIT|"hash:equal-markers"|(ok nil)
FORM|"hash:eql-zero"|(let ((h (make-hash-table :test 'eql))) (puthash 0.0 42 h) (list (eql 0.0 -0.0) (gethash -0.0 h)))
AUDIT|"hash:eql-zero"|(ok (nil nil))
FORM|"hash:equal-zero"|(let ((h (make-hash-table :test 'equal))) (puthash 0.0 42 h) (list (equal 0.0 -0.0) (gethash -0.0 h)))
AUDIT|"hash:equal-zero"|(ok (nil nil))
FORM|"hash:size-growth"|(let ((h (make-hash-table :size 1))) (dotimes (n 10) (puthash n n h)) (list (hash-table-count h) (> (hash-table-size h) 1)))
AUDIT|"hash:size-growth"|(ok (10 nil))
FORM|"hash:weak-key-gc"|(let ((h (make-hash-table :test 'eq :weakness 'key))) (dotimes (n 1000) (puthash (vector n) 42 h)) (garbage-collect) (garbage-collect) (< (hash-table-count h) 10))
AUDIT|"hash:weak-key-gc"|(ok nil)
AUDIT-DONE
