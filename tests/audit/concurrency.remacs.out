FORM|"mutex:foreign-unlock"|(let ((m (make-mutex))) (mutex-lock m) (unwind-protect (thread-join (make-thread (lambda nil (condition-case e (progn (mutex-unlock m) 'unlocked) (error (car e)))))) (ignore-errors (mutex-unlock m))))
