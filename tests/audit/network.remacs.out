FORM|"network:pair-control"|(audit-net-with-pair nil (lambda (server client peer) (list (process-status server) (process-status client) (process-status peer))))
AUDIT|"network:pair-control"|(ok (listen open open))
FORM|"network:send-eof"|(audit-net-with-pair nil (lambda (_server client peer) (process-send-eof client) (let ((n 0)) (while (and (process-live-p peer) (< n 30)) (setq n (1+ n)) (accept-process-output nil 0.01))) (process-status peer)))
AUDIT|"network:send-eof"|(ok open)
FORM|"network:deleted-listener-rebind"|(let* ((server (audit-net-server)) (port (process-contact server :service)) second) (unwind-protect (progn (delete-process server) (setq second (audit-net-server (list :service port))) 'bound) (when second (ignore-errors (delete-process second))) (ignore-errors (delete-process server))))
AUDIT|"network:deleted-listener-rebind"|(error (file-error "Cannot bind server socket" "Address already in use"))
FORM|"network:deleted-local-listener-unlink"|(let* ((dir (make-temp-file "remacs-audit-socket-" t)) (path (expand-file-name "socket" dir)) server) (unwind-protect (progn (setq server (make-network-process :name "audit-local" :family 'local :server t :service path :noquery t :sentinel #'ignore)) (delete-process server) (file-exists-p path)) (when server (ignore-errors (delete-process server))) (delete-directory dir t)))
AUDIT|"network:deleted-local-listener-unlink"|(ok t)
FORM|"network:accept-log-callback"|(let ((called nil)) (audit-net-with-pair (list :log (lambda (_server _client _message) (setq called t))) (lambda (_server _client _peer) called)))
AUDIT|"network:accept-log-callback"|(ok nil)
FORM|"network:accept-sentinel-target"|(let (notified) (audit-net-with-pair (list :sentinel (lambda (p _message) (push (process-status p) notified))) (lambda (_server _client _peer) (nreverse notified))))
AUDIT|"network:accept-sentinel-target"|(ok (listen))
FORM|"network:accepted-noquery-inheritance"|(audit-net-with-pair '(:noquery t) (lambda (server _client peer) (list (process-query-on-exit-flag server) (process-query-on-exit-flag peer))))
AUDIT|"network:accepted-noquery-inheritance"|(ok (nil t))
FORM|"network:accepted-coding-inheritance"|(audit-net-with-pair '(:coding binary) (lambda (server _client peer) (equal (process-coding-system server) (process-coding-system peer))))
AUDIT|"network:accepted-coding-inheritance"|(ok nil)
FORM|"network:accepted-plist-control"|(audit-net-with-pair '(:plist (audit-property 42)) (lambda (server _client peer) (equal (process-plist server) (process-plist peer))))
AUDIT|"network:accepted-plist-control"|(ok t)
FORM|"network:accepted-contact"|(audit-net-with-pair nil (lambda (_server _client peer) (let ((contact (process-contact peer))) (list (stringp (car contact)) (integerp (cadr contact)) (vectorp (process-contact peer :remote)) (vectorp (process-contact peer :local))))))
AUDIT|"network:accepted-contact"|(ok (nil nil nil nil))
FORM|"network:resolved-remote-address"|(let ((server (audit-net-server)) client) (unwind-protect (progn (setq client (make-network-process :name "audit-dns-client" :host "localhost" :family 'ipv4 :service (process-contact server :service) :noquery t :sentinel #'ignore)) (let ((remote (process-contact client :remote))) (list (aref remote 0) (aref remote 1) (aref remote 2) (aref remote 3)))) (when client (ignore-errors (delete-process client))) (ignore-errors (delete-process server))))
AUDIT|"network:resolved-remote-address"|(ok (0 0 0 0))
FORM|"network:stop-reading"|(audit-net-with-pair nil (lambda (_server client peer) (let ((text "")) (set-process-filter peer (lambda (_p chunk) (setq text (concat text chunk)))) (stop-process peer) (process-send-string client "payload") (accept-process-output nil 0.05) (let ((before text)) (continue-process peer) (accept-process-output nil 0.05) (list before text)))))
AUDIT|"network:stop-reading"|(ok (#1="payload" #1#))
AUDIT-DONE
