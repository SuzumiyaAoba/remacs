      "notify:file-rearm": "(let ((file (make-temp-file \"remacs-notify-\")) watch actions) (unwind-protect (progn (setq watch (file-notify-add-watch file '(change) (lambda (e) (push (nth 1 e) actions)))) (write-region \"first\" nil file nil 'silent) (audit-notify-wait (lambda nil (memq 'changed actions))) (let ((first (and (memq 'changed actions) t))) (file-notify-rm-watch watch) (sleep-for 0.1) (setq actions nil watch (file-notify-add-watch file '(change) (lambda (e) (push (nth 1 e) actions)))) (write-region \"second\" nil file nil 'silent) (audit-notify-wait (lambda nil (memq 'changed actions))) (list first (and (memq 'changed actions) t) (file-notify-valid-p watch)))) (when watch (ignore-errors (file-notify-rm-watch watch))) (delete-file file)))"
