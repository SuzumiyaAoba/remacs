;; probe_buffer3 — deep buffer ops on structured content
;; list navigation on real parens
(with-temp-buffer
  (insert "(a (b c) d) (e f)\n(x y)\n")
  (goto-char (point-min))
  (ignore-errors (down-list))
  (ignore-errors (up-list))
  (ignore-errors (forward-list))
  (ignore-errors (backward-list))
  (ignore-errors (backward-up-list))
  (goto-char (point-min))
  (ignore-errors (scan-lists (point) 1 0))
  (goto-char (point-min))
  (ignore-errors (scan-lists (point) -1 0))
  (goto-char (point-min))
  (ignore-errors (scan-lists (point) 0 1))
  (goto-char 3)
  (ignore-errors (down-list))
  (ignore-errors (up-list))
  (ignore-errors (backward-up-list -1))
  (goto-char (point-max))
  (ignore-errors (backward-list))
  (ignore-errors (forward-list -1)))
;; searching in a real buffer
(with-temp-buffer
  (insert "hello world foo bar hello\nsecond line\n")
  (goto-char (point-min))
  (ignore-errors (search-forward "world"))
  (ignore-errors (search-backward "hello"))
  (ignore-errors (search-forward-regexp "w.rld"))
  (ignore-errors (search-backward-regexp "h.llo"))
  (goto-char (point-min))
  (ignore-errors (looking-at "hello"))
  (ignore-errors (looking-at-p "hello"))
  (goto-char 7)
  (ignore-errors (looking-back "hello "))
  (ignore-errors (looking-back "hello " 1))
  (ignore-errors (looking-back "hello " nil t))
  (ignore-errors (posix-looking-at "hello"))
  (goto-char (point-min))
  (ignore-errors (word-search-forward "world"))
  (goto-char (point-max))
  (ignore-errors (word-search-backward "hello"))
  (ignore-errors (word-search-forward "world" nil t))
  (ignore-errors (word-search-backward "hello" nil t))
  (ignore-errors (re-search-forward "h.llo" nil t))
  (ignore-errors (re-search-backward "w.rld" nil t))
  (ignore-errors (string-match "h.llo" (buffer-string)))
  (ignore-errors (string-match-p "h.llo" (buffer-string)))
  (ignore-errors (posix-string-match "h.llo" (buffer-string)))
  (ignore-errors (match-end 0))
  (ignore-errors (match-string-no-properties 0))
  (ignore-errors (match-string-no-properties 0 "hello")))
