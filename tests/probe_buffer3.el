;; files — real temp files
(let ((f "/tmp/remacs-probe-real.txt"))
  (ignore-errors (write-region "content\n" nil f))
  (ignore-errors (file-modes f))
  (ignore-errors (file-modes f 'integer))
  (ignore-errors (set-file-modes f 420))
  (ignore-errors (file-modes f 'integer))
  (ignore-errors (file-accessible-directory-p "/tmp"))
  (ignore-errors (file-equal-p f f))
  (ignore-errors (copy-file f "/tmp/remacs-probe-copy.txt"))
  (ignore-errors (copy-file f "/tmp/remacs-probe-copy.txt" t))
  (ignore-errors (copy-file f "/tmp/remacs-probe-copy.txt" nil nil nil nil))
  (ignore-errors (delete-file "/tmp/remacs-probe-copy.txt"))
  (ignore-errors (make-directory "/tmp/remacs-probe-dir2"))
  (ignore-errors (make-directory "/tmp/remacs-probe-dir2" t))
  (ignore-errors (delete-directory "/tmp/remacs-probe-dir2"))
  (ignore-errors (delete-file f)))
(ignore-errors (find-file "/tmp/remacs-probe-find.txt"))
(ignore-errors (find-file-literally "/tmp/remacs-probe-find2.txt"))
