;;; qa_shortdoc_data.el --- Load built-in documentation without loading its UI -*- lexical-binding: t; -*-
(qa (featurep 'shortdoc) nil)
(qa (autoloadp (symbol-function 'define-short-documentation-group)) t)
(qa (require 'shortdoc-doc) 'shortdoc-doc)
(qa (list (featurep 'shortdoc-doc) (featurep 'shortdoc)
          (autoloadp (symbol-function 'define-short-documentation-group))
          (length shortdoc--groups) (and (assq 'alist shortdoc--groups) t))
    '(t nil t 18 t))
(qa (let ((groups shortdoc--groups))
      (require 'shortdoc-doc) (eq groups shortdoc--groups)) t)
(qa (require 'shortdoc) 'shortdoc)
(qa (list (featurep 'shortdoc) (length shortdoc--groups)
          (autoloadp (symbol-function 'define-short-documentation-group)))
    '(t 18 nil))
(qa (progn (load "shortdoc-doc" nil t) (length shortdoc--groups)) 18)
(princ (qa--done))
