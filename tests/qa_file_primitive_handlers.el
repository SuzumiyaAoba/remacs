;;; -*- lexical-binding: t; -*-
;; Issue #224: file-name handlers own virtual operations and their results.
(defvar qa224-log nil)
(defvar qa224-result)
(defvar qa224-mode)
(defvar qa224-root)
(defvar qa224-source)
(defvar qa224-dest)
(defvar qa224-case)
(defvar qa224-op)
(defvar qa224-ops '(file-exists-p file-readable-p file-writable-p file-modes
				  copy-file rename-file delete-file set-file-modes set-file-times
				  insert-file-contents write-region))
(defun qa224-handler (operation &rest args)
  (push (cons operation args) qa224-log)
  (cond ((eq qa224-mode 'delegate)
         (let ((inhibit-file-name-handlers (cons 'qa224-handler inhibit-file-name-handlers))
               (inhibit-file-name-operation operation))
           (apply operation args)))
        ((eq qa224-mode 'error) (error "handler failure"))
        (t qa224-result)))
(defun qa224-source-handler (operation &rest args)
  (push (cons 'source (cons operation args)) qa224-log) qa224-result)
(defun qa224-dest-handler (operation &rest args)
  (push (cons 'dest (cons operation args)) qa224-log) qa224-result)
(put 'qa224-handler 'operations qa224-ops)
(put 'qa224-source-handler 'operations qa224-ops)
(put 'qa224-dest-handler 'operations qa224-ops)

(let* ((qa224-root (make-temp-file "qa224-handlers-" t))
       (default-directory (file-name-as-directory qa224-root))
       (qa224-source (expand-file-name "qa224:source"))
       (qa224-dest (expand-file-name "qa224:dest"))
       (qa224-mode nil)
       (qa224-result (list 'shared-result))
       (qa224-log nil)
       (file-name-handler-alist '(("qa224:" . qa224-handler))))
  (unwind-protect
      (progn
        (dolist (qa224-result (list nil (list 'shared-result)))
          (dolist (qa224-case
                   (list
                    (list '(file-exists-p "qa224:source") (list 'file-exists-p qa224-source))
                    (list '(file-readable-p "qa224:source") (list 'file-readable-p qa224-source))
                    (list '(file-writable-p "qa224:source") (list 'file-writable-p qa224-source))
                    (list '(file-modes "qa224:source/") (list 'file-modes qa224-source nil))
                    (list '(file-modes "qa224:source" 'flag) (list 'file-modes qa224-source 'flag))
                    (list '(copy-file "qa224:source" "qa224:dest")
                          (list 'copy-file qa224-source qa224-dest nil nil nil nil))
                    (list '(copy-file "qa224:source" "qa224:dir/" 'ok 'time 'uid 'permissions)
                          (list 'copy-file qa224-source (expand-file-name "qa224:dir/qa224:source")
				'ok 'time 'uid 'permissions))
                    (list '(rename-file "qa224:source" "qa224:dest")
                          (list 'rename-file qa224-source qa224-dest nil))
                    (list '(rename-file "qa224:source" "qa224:dir/" 'ok)
                          (list 'rename-file qa224-source (expand-file-name "qa224:dir/qa224:source") 'ok))
                    (list '(delete-file "qa224:source") (list 'delete-file qa224-source nil))
                    (list '(delete-file "qa224:source" 'trash) (list 'delete-file qa224-source 'trash))
                    (list '(set-file-modes "qa224:source" #o600) (list 'set-file-modes qa224-source #o600 nil))
                    (list '(set-file-modes "qa224:source" #o600 'flag) (list 'set-file-modes qa224-source #o600 'flag))
                    (list '(set-file-times "qa224:source" 0) (list 'set-file-times qa224-source 0 nil))
                    (list '(set-file-times "qa224:source" 0 'flag) (list 'set-file-times qa224-source 0 'flag))
                    (list '(insert-file-contents "qa224:source") (list 'insert-file-contents qa224-source nil nil nil nil))
                    (list '(insert-file-contents "qa224:source" t 'bad 'bad t)
                          (list 'insert-file-contents qa224-source t 'bad 'bad t))
                    (list '(insert-file-contents-literally "qa224:source")
                          (list 'insert-file-contents qa224-source nil nil nil nil))
                    (list '(write-region "body" 'ignored "qa224:dest")
                          (list 'write-region "body" 'ignored qa224-dest nil nil qa224-dest nil))
                    (list '(write-region "body" 'ignored "qa224:dest" 'append 'visit 'lock 'excl)
                          (list 'write-region "body" 'ignored qa224-dest 'append 'visit 'lock 'excl))))
            (setq qa224-log nil)
            (with-temp-buffer
              (qa (let ((result (eval (car qa224-case))))
                    (if (and (null qa224-result)
                             (eq (car (cadr qa224-case)) 'insert-file-contents))
			(equal result (list qa224-source 0))
                      (eq result qa224-result))) t)
              (qa (nreverse qa224-log) (list (cadr qa224-case))))))

        ;; Bad mode/time and read-only buffers reject before dispatch.
        (setq qa224-log nil)
        (qa-err-data (set-file-modes "qa224:source" 'bad) 'wrong-type-argument '(fixnump bad))
        (qa-err-data (set-file-times "qa224:source" 'bad) 'error '("Invalid time specification"))
        (with-temp-buffer
          (let ((buffer-read-only t))
            (qa-err (insert-file-contents "qa224:source") 'buffer-read-only)))
        (with-temp-buffer
          (qa-err-data (write-region 'bad nil "qa224:dest") 'wrong-type-argument '(integer-or-marker-p bad)))
        (qa qa224-log nil)

        ;; Source wins; destination-only handlers run before opening input.
        (let ((file-name-handler-alist '(("qa224:dest" . qa224-dest-handler)
                                         ("qa224:source" . qa224-source-handler))))
          (dolist (qa224-op '(copy-file rename-file))
            (setq qa224-log nil)
            (qa (eq (funcall qa224-op qa224-source qa224-dest) qa224-result) t)
            (qa (caar qa224-log) 'source)
            (setq qa224-log nil)
            (qa (eq (funcall qa224-op "missing-local-source" qa224-dest) qa224-result) t)
            (qa (caar qa224-log) 'dest)))

        ;; A rejected handler operation must use the physical fallback.
        (put 'qa224-handler 'operations '(copy-file))
        (setq qa224-log nil)
        (qa (file-exists-p qa224-source) nil)
        (qa qa224-log nil)
        (put 'qa224-handler 'operations qa224-ops)
        (let ((inhibit-file-name-handlers '(qa224-handler))
              (inhibit-file-name-operation 'file-exists-p))
          (qa (file-exists-p qa224-source) nil)
          (qa (eq (file-readable-p qa224-source) qa224-result) t))
        (let ((qa224-mode 'error))
          (qa-err-data (copy-file qa224-source qa224-dest) 'error '("handler failure")))
        (let ((file-name-handler-alist nil))
          (qa (file-exists-p qa224-source) nil)
          (qa (file-exists-p qa224-dest) nil)))
    (let ((file-name-handler-alist nil)) (delete-directory qa224-root t))))

;; Every operation can delegate to the real primitive without recursion.
(dolist (qa224-op qa224-ops)
  (let* ((qa224-root (make-temp-file "qa224-delegate-" t))
         (qa224-source (expand-file-name "qa224:source" qa224-root))
         (qa224-dest (expand-file-name "qa224:dest" qa224-root))
         (qa224-log nil)
         (qa224-mode 'delegate))
    (unwind-protect
        (progn
          (with-temp-file qa224-source (insert "abc"))
          (set-file-modes qa224-source #o600)
          (put 'qa224-handler 'operations (list qa224-op))
          (let ((file-name-handler-alist '(("qa224:" . qa224-handler))))
            (with-temp-buffer
              (qa (pcase qa224-op
                    ('copy-file (copy-file qa224-source qa224-dest))
                    ('rename-file (rename-file qa224-source qa224-dest))
                    ('delete-file (delete-file qa224-source))
                    ('set-file-modes (set-file-modes qa224-source #o640))
                    ('set-file-times (set-file-times qa224-source 0))
                    ('insert-file-contents (list (insert-file-contents qa224-source) (buffer-string)))
                    ('write-region (write-region "body" nil qa224-dest nil 'quiet))
                    (_ (funcall qa224-op qa224-source)))
                  (pcase qa224-op
                    ((or 'file-exists-p 'file-readable-p 'file-writable-p 'set-file-times) t)
                    ('file-modes #o600)
                    ('insert-file-contents (list (list qa224-source 3) "abc"))
                    (_ nil)))
              (qa (mapcar #'car qa224-log) (list qa224-op))))
          (let ((file-name-handler-alist nil))
            (when (memq qa224-op '(copy-file rename-file write-region))
              (qa (with-temp-buffer (insert-file-contents-literally qa224-dest) (buffer-string))
                  (if (eq qa224-op 'write-region) "body" "abc")))
            (when (memq qa224-op '(rename-file delete-file))
              (qa (file-exists-p qa224-source) nil))))
      (put 'qa224-handler 'operations qa224-ops)
      (let ((file-name-handler-alist nil)) (delete-directory qa224-root t)))))

(defvar qa224-prompts nil)
(let* ((qa224-root (make-temp-file "qa224-write-existing-" t))
       (qa224-source (expand-file-name "qa224:source" qa224-root))
       (qa224-dest (expand-file-name "qa224:dir" qa224-root))
       (saved (symbol-function 'y-or-n-p))
       (qa224-log nil) (qa224-prompts nil) (qa224-mode nil)
       (qa224-result (list 'shared)))
  (unwind-protect
      (progn
        (with-temp-file qa224-source (insert "original"))
        (make-directory qa224-dest)
        (fset 'y-or-n-p (lambda (prompt) (push prompt qa224-prompts) nil))
        (let ((file-name-handler-alist '(("qa224:" . qa224-handler))))
          (qa-err-data (write-region "body" nil qa224-source nil nil nil t)
                       'file-already-exists (list "File already exists" qa224-source))
          (qa qa224-log nil)
          (qa qa224-prompts (list (format "File %s already exists; overwrite anyway? " qa224-source)))
          (qa-err-data (write-region "body" nil qa224-dest nil nil nil t)
                       'file-error (list "File is a directory" qa224-dest))
          (qa (eq (write-region "body" nil qa224-source nil nil nil 'excl) qa224-result) t))
        (qa (with-temp-buffer (insert-file-contents-literally qa224-source) (buffer-string)) "original"))
    (fset 'y-or-n-p saved)
    (delete-directory qa224-root t)))

(defvar qa224-original)
(defun qa224-identity-handler (op &rest args)
  (let ((file (if (eq op 'write-region) (nth 2 args) (car args))))
    (list (eq file qa224-original) (text-properties-at 0 file))))
(put 'qa224-identity-handler 'operations qa224-ops)
(let* ((qa224-root (make-temp-file "qa224-identity-" t))
       (qa224-original (propertize (expand-file-name "qa224:identity" qa224-root) 'face 'bold))
       (file-name-handler-alist '(("qa224:" . qa224-identity-handler))))
  (unwind-protect
      (dolist (qa224-op qa224-ops)
        (with-temp-buffer
          (qa (cond ((memq qa224-op '(copy-file rename-file))
                     (funcall qa224-op qa224-original (expand-file-name "qa224:dest" qa224-root)))
                    ((eq qa224-op 'set-file-modes) (funcall qa224-op qa224-original #o600))
                    ((eq qa224-op 'set-file-times) (funcall qa224-op qa224-original 0))
                    ((eq qa224-op 'write-region) (funcall qa224-op "body" nil qa224-original))
                    (t (funcall qa224-op qa224-original)))
              '(t (face bold)))))
    (let ((file-name-handler-alist nil)) (delete-directory qa224-root t))))

(princ (qa--done)) (terpri)
