;;; -*- lexical-binding: nil; -*-
;; take/ntake accept arbitrary-size counts without truncation (#454).
(dolist (n (list (expt 2 63) (expt 2 64) (1+ (expt 2 64))
                 (1- (expt 2 127)) (expt 2 127) (expt 2 128)
                 (expt 2 200) (1+ (expt 2 200))))
  (qa (take n '(a b c)) '(a b c))
  (qa (take n nil) nil)
  (let* ((source (list 'a 'b 'c)) (result (ntake n source)))
    (qa result '(a b c))
    (qa (eq source result) t))
  (qa (ntake n nil) nil)
  (qa (take (- n) 'not-a-list) nil)
  (qa (ntake (- n) 'not-a-list) nil)
  (qa-err-data (take n '(a b . tail)) 'wrong-type-argument '(listp tail))
  (let ((source (cons 'a (cons 'b 'tail))))
    (qa (condition-case e (ntake n source)
          (wrong-type-argument (list (car e) (cadr e) (eq (caddr e) source))))
        '(wrong-type-argument listp t))
    (qa source '(a b . tail))))
(dolist (op '(take ntake))
  (dolist (bad (list nil t 1.0 "1" (make-marker)))
    (qa-err-data (funcall op bad 'not-a-list) 'wrong-type-argument (list 'integerp bad)))
  (qa (funcall op 0 'not-a-list) nil))
;; Small counts keep prefix and mutation behavior.
(let* ((source (list 'a 'b 'c)) (prefix (take 2 source)))
  (qa prefix '(a b))
  (qa (eq source prefix) nil)
  (qa source '(a b c)))
(let* ((source (list 'a 'b 'c)) (tail (cdr source)) (prefix (ntake 2 source)))
  (qa prefix '(a b))
  (qa (eq source prefix) t)
  (qa (eq (cdr prefix) tail) t)
  (qa (cdr tail) nil))
(princ (qa--done))
