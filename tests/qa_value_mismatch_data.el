;;; -*- lexical-binding: nil; -*-
;; Error data retains the actual operands and GNU's bignum order (#559).
(let* ((big (expt 2 65))
       (text (propertize "text" 'tag 'kept))
       (vector [1])
       (pair (list 1))
       (marker (point-marker)))
  (dolist (case (list (list text 1 text 1)
                      (list 1 text 1 text)
                      (list big text text big)
                      (list text big text big)
                      (list big 'symbol 'symbol big)
                      (list 'symbol big 'symbol big)
                      (list big pair pair big)
                      (list pair big pair big)
                      (list big vector big vector)
                      (list vector big vector big)
                      (list big marker big marker)
                      (list marker big marker big)))
    (let ((error-data (condition-case e (value< (car case) (cadr case))
                        (error e))))
      (qa (car error-data) 'type-mismatch)
      (qa (length (cdr error-data)) 2)
      (qa (eq (cadr error-data) (nth 2 case)) t)
      (qa (eq (caddr error-data) (nth 3 case)) t)))
  ;; A nested comparison reports its leaf operands, not the containers.
  (qa-err-data (value< (list text) '(1)) 'type-mismatch (list text 1))
  (qa (get-text-property 0 'tag text) 'kept))
(princ (qa--done))
