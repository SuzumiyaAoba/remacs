;;; -*- lexical-binding: nil; -*-
;; Issue #86: follow symlinks for file-modes unless FLAG is non-nil,
;; and resolve directory entries through the opened directory's path.
(let* ((root (make-temp-file "qa-file-modes-" t))
       (file (expand-file-name "file" root))
       (link (expand-file-name "link" root))
       (broken (expand-file-name "broken" root))
       (real (expand-file-name "real" root))
       (alias (expand-file-name "alias" root))
       (deep-alias (expand-file-name "deep-alias" root))
       (sub (concat alias "/sub")))
  (unwind-protect
      (progn
        (with-temp-file file (insert "test"))
        (set-file-modes file #o640)
        (make-symbolic-link "file" link)
        (make-symbolic-link "missing" broken)
        (make-directory real)
        (make-directory (concat real "/sub"))
        (set-file-modes real #o750)
        (make-symbolic-link "real" alias)
        (make-symbolic-link "real/sub" deep-alias)
        (make-symbolic-link "../file" (concat real "/child-link"))
        (qa (file-modes file) #o640)
        (qa (file-modes file 'nofollow) #o640)
        (qa (file-modes (concat file "/")) #o640)
        (qa (file-modes "/") (file-modes "/" 'nofollow))
        (qa (file-modes link) #o640)
        (qa (file-modes link nil) #o640)
        (qa (let ((default-directory (file-name-as-directory root)))
              (file-modes "link")) #o640)
        (qa (file-modes broken) nil)
        (qa (file-modes (concat root "/missing")) nil)
        (qa (file-modes (concat root "/missing") 'nofollow) nil)
        (qa (file-modes alias) #o750)
        (qa (file-modes (concat alias "/")) #o750)
        (dolist (flag '(nofollow t other 0 "nofollow"))
          (qa (file-modes-number-to-symbolic (file-modes link flag) ?l)
              (nth 8 (file-attributes link)))
          (qa (file-modes-number-to-symbolic (file-modes broken flag) ?l)
              (nth 8 (file-attributes broken)))
          (qa (file-modes-number-to-symbolic (file-modes (concat alias "/") flag) ?l)
              (nth 8 (file-attributes alias))))
        ;; Standalone file-attributes still describes the final symlink.
        (qa (car (file-attributes alias)) "real")
        (qa (car (file-attributes (concat alias "/."))) "real")
        (qa (car (file-attributes link)) "file")
        (dolist (full '(nil t))
          (let* ((dots (directory-files-and-attributes alias full "^\\.$"))
                 (dot (cdar dots))
                 (parents (directory-files-and-attributes sub full "^\\.\\.$"))
                 (parent (cdar parents)))
            (qa (car dot) t)
            (qa (car parent) t)
            (qa (nth 8 dot) (nth 8 (file-attributes real)))
            (qa (nth 10 dot) (nth 10 (file-attributes real)))
            (qa (nth 10 parent) (nth 10 (file-attributes real)))))
        (qa (cadr (car (directory-files-and-attributes alias nil "^child-link$")))
            "../file")
        ;; Here the physical parent differs from the alias's parent.
        (qa (cadr (car (directory-files-and-attributes deep-alias nil "^\\.\\.$"))) t)
        (dolist (full '(nil t))
          (qa (nth 10 (cdar (directory-files-and-attributes deep-alias full "^\\.\\.$")))
              (nth 10 (file-attributes real))))
        (qa (stringp (nth 2 (cdar (directory-files-and-attributes alias nil "^\\.$" nil 'string))))
            t))
    (delete-directory root t)))
(qa-err-data (file-modes 5) 'wrong-type-argument '(stringp 5))
(qa-err-data (file-modes "a\0b") 'wrong-type-argument '(filenamep "a\0b"))
(princ (qa--done))
