;;; -*- lexical-binding: t; -*-
;; GNU accepts characters through MAX_CHAR, then separately checks whether
;; a valid character can be represented as a single byte.
(qa (unibyte-char-to-multibyte 0) 0)
(qa (unibyte-char-to-multibyte 65) 65)
(qa (unibyte-char-to-multibyte 127) 127)
(qa (unibyte-char-to-multibyte 128) 4194176)
(qa (unibyte-char-to-multibyte 255) 4194303)
(qa-err-data (unibyte-char-to-multibyte 256) 'error '("Not a unibyte character: 256"))
(qa-err-data (unibyte-char-to-multibyte 4194176) 'error '("Not a unibyte character: 4194176"))
(qa-err-data (unibyte-char-to-multibyte 4194303) 'error '("Not a unibyte character: 4194303"))
(qa-err-data (unibyte-char-to-multibyte nil) 'wrong-type-argument '(characterp nil))
(qa-err-data (unibyte-char-to-multibyte t) 'wrong-type-argument '(characterp t))
(qa-err-data (unibyte-char-to-multibyte -1) 'wrong-type-argument '(characterp -1))
(qa-err-data (unibyte-char-to-multibyte 4194304) 'wrong-type-argument '(characterp 4194304))
(qa-err-data (unibyte-char-to-multibyte 1.0) 'wrong-type-argument '(characterp 1.0))
(qa-err-data (unibyte-char-to-multibyte "X") 'wrong-type-argument '(characterp "X"))
(qa-err-data (unibyte-char-to-multibyte []) 'wrong-type-argument '(characterp []))

(qa (multibyte-char-to-unibyte 0) 0)
(qa (multibyte-char-to-unibyte 65) 65)
(qa (multibyte-char-to-unibyte 127) 127)
(qa (multibyte-char-to-unibyte 128) 128)
(qa (multibyte-char-to-unibyte 255) 255)
(qa (multibyte-char-to-unibyte 256) -1)
(qa (multibyte-char-to-unibyte 20013) -1)
(qa (multibyte-char-to-unibyte 1114111) -1)
(qa (multibyte-char-to-unibyte 4194176) 128)
(qa (multibyte-char-to-unibyte 4194303) 255)
(qa-err-data (multibyte-char-to-unibyte nil) 'wrong-type-argument '(characterp nil))
(qa-err-data (multibyte-char-to-unibyte t) 'wrong-type-argument '(characterp t))
(qa-err-data (multibyte-char-to-unibyte -1) 'wrong-type-argument '(characterp -1))
(qa-err-data (multibyte-char-to-unibyte 4194304) 'wrong-type-argument '(characterp 4194304))
(qa-err-data (multibyte-char-to-unibyte 4294967296) 'wrong-type-argument '(characterp 4294967296))
(qa-err-data (multibyte-char-to-unibyte 1.0) 'wrong-type-argument '(characterp 1.0))
(qa-err-data (multibyte-char-to-unibyte "X") 'wrong-type-argument '(characterp "X"))
(qa-err-data (multibyte-char-to-unibyte []) 'wrong-type-argument '(characterp []))

;; Reported unencodable input must stay nil, rather than a substitution.
(qa (encode-coding-char 20013 'ascii) nil)
(qa (encode-coding-char 20013 'us-ascii) nil)
(qa (encode-coding-char 233 'ascii) nil)
(qa (encode-coding-char 20013 'iso-latin-1) nil)
(defun qa120-encoded (char coding)
  (let ((string (encode-coding-char char coding)))
    (list (multibyte-string-p string) (string-to-list string) (string-bytes string))))
(qa (qa120-encoded 65 'ascii) '(nil (65) 1))
(qa (qa120-encoded 0 'ascii) '(nil (0) 1))
(qa (qa120-encoded 233 'iso-latin-1) '(nil (233) 1))
(qa (qa120-encoded 20013 'utf-8) '(nil (228 184 173) 3))

(princ (qa--done))
