;;; -*- lexical-binding: nil; -*-
;; Issue #50: out-of-bounds deletion is atomic and honors narrowing.
(dolist (backward '(nil t))
  (dolist (narrow '(nil t))
    (dolist (position '(1 2 3 4))
      (dolist (count (list -99 -4 -3 -2 -1 0 1 2 3 4 99 most-positive-fixnum most-negative-fixnum))
        (with-temp-buffer
          (insert (if narrow "XabcY" "abc"))
          (when narrow (narrow-to-region 2 5))
          (goto-char (+ (point-min) (1- position)))
          (let* ((start (point))
                 (delta (if backward (- count) count))
                 (target (+ start delta))
                 (expected (cond ((< target (point-min)) 'beginning-of-buffer)
                                 ((> target (point-max)) 'end-of-buffer)))
                 (modified (buffer-modified-tick))
                 (changes 0)
                 (before-change-functions (list (lambda (&rest _) (setq changes (1+ changes))))))
            (if expected
                (progn
                  ;; The backward wrapper negates COUNT; negating the
                  ;; smallest fixnum produces a non-fixnum before delete-char.
                  (if (and backward (= count most-negative-fixnum))
                      (qa-err (delete-backward-char count) 'wrong-type-argument)
                    (qa-err-data (if backward (delete-backward-char count) (delete-char count)) expected nil))
                  (qa (buffer-string) "abc")
                  (qa (point) start)
                  (qa (buffer-modified-tick) modified)
                  (qa changes 0))
              (qa (if backward (delete-backward-char count) (delete-char count)) nil)
              (qa (buffer-size) (- (if narrow 5 3) (abs delta)))
              (qa (buffer-string)
                  (concat (substring "abc" 0 (- (min start target) (point-min)))
                          (substring "abc" (- (max start target) (point-min)))))
              (qa (point) (min start target))
              (when (= count 0)
                (qa (buffer-modified-tick) modified)
                (qa changes 0)))))))))
;; Boundary validation precedes write protection, and zero is a no-op.
(with-temp-buffer
  (insert "abc")
  (goto-char 2)
  (let ((buffer-read-only t))
    (qa-err-data (delete-char 99) 'end-of-buffer nil)
    (qa-err-data (delete-char -99) 'beginning-of-buffer nil)
    (qa (delete-char 0) nil)
    (qa-err (delete-char 1) 'buffer-read-only))
  (qa (buffer-string) "abc"))
;; KILLFLAG takes GNU's kill-region path, not the deletion-boundary path.
(dolist (backward '(nil t))
  (with-temp-buffer
    (insert "abc")
    (goto-char 2)
    (let ((kill-ring nil) (kill-ring-yank-pointer nil) (last-command nil))
      (qa-err (if backward (delete-backward-char 99 t) (delete-char 99 t)) 'args-out-of-range)
      (qa (buffer-string) "abc")
      (qa kill-ring nil)
      (qa (if backward (delete-backward-char 1 t) (delete-char 1 t)) nil)
      (qa (buffer-string) (if backward "bc" "ac"))
      (qa (car kill-ring) (if backward "a" "b")))))
(dolist (narrow '(nil t))
  (with-temp-buffer
    (when narrow (insert "hidden") (narrow-to-region 3 3))
    (qa (delete-char 0) nil)
    (qa-err-data (delete-char 1) 'end-of-buffer nil)
    (qa-err-data (delete-char -1) 'beginning-of-buffer nil)
    (qa (buffer-string) "")))
(with-temp-buffer
  (insert "あ😀é")
  (goto-char 1)
  (qa-err-data (delete-char 4) 'end-of-buffer nil)
  (qa (buffer-string) "あ😀é")
  (qa (delete-char 2) nil)
  (qa (buffer-string) "é")
  (qa (point) 1))
(princ (qa--done))
