;;; -*- lexical-binding: nil; -*-
;; Issue #28: GNU Emacs 31.1 callback and partial-mutation ground truth.
;; Large traces/states are SHA-256 digests of their complete printed lists.
(define-error 'qa28-stop "Sort callback stopped")
(defun qa28-input (pattern size)
  (let ((values nil) (index 0))
    (while (< index size)
      (push (cond ((eq pattern 'ascending) index)
                  ((eq pattern 'descending) (- size index))
                  ((eq pattern 'permutation) (% (* index 37) size))
                  ((eq pattern 'duplicates) (% (* index 37) 11))
                  ((eq pattern 'rotate-half) (% (+ index (/ size 2)) size))
                  ((eq pattern 'rotate-quarter) (% (+ index (/ size 4)) size))
                  ((eq pattern 'rotate-three-quarters) (% (+ index (/ (* size 3) 4)) size))
                  ((eq pattern 'blocks)
                   (if (< index (/ size 2))
                       (+ (* (/ index 13) 26) (% index 13))
                     (let ((offset (- index (/ size 2))))
                       (+ 13 (* (/ offset 13) 26) (% offset 13)))))) values)
      (setq index (1+ index)))
    (nreverse values)))
(defun qa28-pack (value large)
  (let ((print-circle nil) (print-length nil) (print-level nil))
    (if large (secure-hash 'sha256 (prin1-to-string value)) value)))
(defun qa28-observe (config)
  (let* ((pattern (nth 0 config)) (size (nth 1 config))
         (vector (eq (nth 2 config) 'vector)) (mode (nth 3 config))
         (stop (nth 4 config)) (key-stop (nth 5 config))
         (snapshots (nth 6 config)) (mutate (nth 7 config))
         (keyed (memq mode '(keyed keyed-in-place keyed-reverse keyed-reverse-in-place)))
         (descending (memq mode '(reverse reverse-in-place keyed-reverse keyed-reverse-in-place)))
         (in-place (memq mode '(in-place reverse-in-place keyed-in-place keyed-reverse-in-place)))
         (numbers (qa28-input pattern size)) (index 0)
         (entries (if keyed (mapcar (lambda (value) (prog1 (cons value index) (setq index (1+ index)))) numbers) numbers))
         (source (if vector (vconcat entries) entries))
         (calls nil) (keys nil) (states nil) (count 0) (key-count 0)
         (predicate (lambda (a b)
                      (push (list a b) calls)
                      (setq count (1+ count))
                      (when snapshots (push (append source nil) states))
                      (when (and mutate (= count 1))
                        (aset source 0 (if keyed '(999 . 999) 999)))
                      (when (and stop (= count stop)) (signal 'qa28-stop (list a b)))
                      (< a b)))
         (key-function (lambda (value)
                         (push value keys) (setq key-count (1+ key-count))
                         (when (and key-stop (= key-count key-stop))
                           (signal 'qa28-stop (list value)))
                         (car value)))
         (result nil) (outcome nil) (same nil) (large (> size 8)))
    (condition-case err
        (progn
          (setq result
                (if (eq mode 'old) (sort source predicate)
                  (sort source :lessp predicate :key (and keyed key-function)
                        :reverse descending :in-place in-place)))
          (setq same (eq result source))
          (setq outcome (list 'ok (qa28-pack (append result nil) large))))
      (error (setq outcome (list (car err) (cdr err)))))
    (list outcome (qa28-pack (append source nil) large) same count
          (qa28-pack (nreverse calls) large) key-count
          (qa28-pack (nreverse keys) large) (qa28-pack (nreverse states) large))))

