;;; -*- lexical-binding: nil; -*-
;; Issue #17. Ground truth verified against GNU Emacs 31.1.

;; An empty front-advancing, non-rear-advancing overlay stays at its
;; original position. insert-before-markers moves both boundaries.
(dolist (case '((nil nil nil 2 2) (nil nil t 2 4) (nil t nil 2 2) (nil t t 4 4)
                (t nil nil 4 4) (t nil t 4 4) (t t nil 4 4) (t t t 4 4)))
  (qa (with-temp-buffer
        (insert "ab") (goto-char 2)
        (let ((o (make-overlay 2 2 nil (nth 1 case) (nth 2 case))))
          (if (car case) (insert-before-markers "xx") (insert "xx"))
          (list (overlay-start o) (overlay-end o))))
      (nthcdr 3 case)))
(qa (with-temp-buffer (insert "ab")
      (let ((o (make-overlay 1 1 nil t)))
        (goto-char 1) (insert "x") (list (overlay-start o) (overlay-end o)))) '(1 1))
(qa (with-temp-buffer (insert "ab")
      (let ((o (make-overlay 2 2 nil t)))
        (goto-char 1) (insert "x") (list (overlay-start o) (overlay-end o)))) '(3 3))
(qa (with-temp-buffer (insert "ab")
      (let ((o (make-overlay 2 2 nil t)))
        (goto-char 3) (insert "x") (list (overlay-start o) (overlay-end o)))) '(2 2))
(qa (with-temp-buffer (insert "ab")
      (let ((o (make-overlay 2 2 nil t)))
        (goto-char 2) (insert "x")
        (list (memq o (overlays-at 2)) (not (null (memq o (overlays-in 2 2))))
              (progn (move-overlay o 1 3) (list (overlay-start o) (overlay-end o))))))
    '(nil t (1 3)))
(qa (with-temp-buffer (insert "ab")
      (let ((o (make-overlay 2 2 nil t)))
        (overlay-put o 'evaporate t) (goto-char 2) (insert "x")
        (list (not (null (overlay-buffer o))) (overlay-start o) (overlay-end o)))) '(nil nil nil))
(qa (with-temp-buffer (insert "ab")
      (let* ((base (current-buffer)) (o (make-overlay 2 2 nil t))
             (indirect (clone-indirect-buffer " *overlay-transfer*" nil)))
        (unwind-protect
            (progn (with-current-buffer indirect (goto-char 2) (insert "x"))
                   (list (overlay-start o) (overlay-end o) (eq (overlay-buffer o) base)))
          (kill-buffer indirect)))) '(2 2 t))

(qa (with-temp-buffer (insert "ab")
      (let ((o (make-overlay 2 2)))
        (list (overlay-put o 'evaporate 'yes) (overlay-buffer o)
              (overlayp o) (overlay-get o 'evaporate)))) '(yes nil t yes))
(qa (with-temp-buffer (insert "ab")
      (let ((o (make-overlay 1 3)))
        (overlay-put o 'evaporate t) (move-overlay o 2 2)
        (list (overlay-buffer o) (overlay-start o) (overlay-end o)
              (overlay-get o 'evaporate)))) '(nil nil nil t))

(qa (with-temp-buffer (insert "ab")
      (let ((o (make-overlay 1 3)) (category (make-symbol "transfer-category")))
        (put category 'evaporate t) (overlay-put o 'category category)
        (move-overlay o 2 2)
        (list (overlay-buffer o) (overlay-start o) (overlay-end o)
              (overlay-get o 'evaporate)))) '(nil nil nil t))

(defun qa-transfer-insert (text start end &optional narrow)
  (let ((source (generate-new-buffer " *transfer-source*")))
    (unwind-protect
        (progn
          (with-current-buffer source
            (insert text) (when narrow (narrow-to-region (car narrow) (cadr narrow))))
          (with-temp-buffer (insert "[]") (goto-char 2)
            (insert-buffer-substring source start end)
            (list (buffer-string) (point))))
      (kill-buffer source))))
(qa (qa-transfer-insert "abc" nil nil) '("[abc]" 5))
(qa (qa-transfer-insert "abc" 3 1) '("[ab]" 4))
(qa (qa-transfer-insert "abcdef" nil nil '(2 5)) '("[bcd]" 5))
(qa (qa-transfer-insert "abcdef" 5 2 '(2 5)) '("[bcd]" 5))
(qa (qa-transfer-insert (propertize "abc" 'tag 'yes) 2 4)
    '(#("[bc]" 1 3 (tag yes)) 4))
(qa-err-data (qa-transfer-insert "" 1 2) 'args-out-of-range '(1 2))
(qa-err-data (qa-transfer-insert "abc" 0 2) 'args-out-of-range '(0 2))
(qa-err-data (qa-transfer-insert "abc" nil 5) 'args-out-of-range '(nil 5))
(qa-err-data (qa-transfer-insert "abcdef" 1 3 '(2 5)) 'args-out-of-range '(1 3))
(qa-err-data (qa-transfer-insert "abcdef" 6 2 '(2 5)) 'args-out-of-range '(6 2))
(qa-err-data (qa-transfer-insert "abc" 'bad 'bad) 'wrong-type-argument '(integer-or-marker-p bad))
(qa-err-data (qa-transfer-insert "abc" (make-marker) nil) 'error '("Marker does not point anywhere"))
(qa-err-data (qa-transfer-insert "abc" (expt 2 70) 1) 'args-out-of-range (list (expt 2 70) 1))
(qa-err-data (insert-buffer-substring nil) 'wrong-type-argument '(stringp nil))
(qa-err-data (let ((dead (generate-new-buffer " *dead-transfer*")))
               (kill-buffer dead) (insert-buffer-substring dead 'bad 'bad))
             'error '("Selecting deleted buffer"))
(qa (let ((source (generate-new-buffer " *empty-transfer*")))
      (unwind-protect
          (with-temp-buffer (insert "x") (set-buffer-modified-p nil)
            (setq buffer-read-only t)
            (list (insert-buffer-substring source) (point) (buffer-modified-p)))
        (kill-buffer source))) '(nil 2 nil))
(qa (let ((source (generate-new-buffer " *bad-transfer*")))
      (unwind-protect
          (with-temp-buffer
            (setq buffer-read-only t)
            (condition-case err (insert-buffer-substring source 1 2)
              (args-out-of-range err)))
        (kill-buffer source))) '(args-out-of-range 1 2))
(qa (with-temp-buffer (insert "abc")
      (let ((a (copy-marker 1)) (b (copy-marker 3)))
        (insert-buffer-substring (current-buffer) b a) (buffer-string))) "abcab")

;; Source and destination byte modes have the same conversion semantics
;; as inserting a string, including raw eight-bit character promotion.
(dolist (case '((nil nil (233 255)) (nil t (4194281 4194303))
                (t nil (233 229 44)) (t t (233 26085 26412))))
  (qa (let ((source (generate-new-buffer " *bytes-transfer*")))
        (unwind-protect
            (progn (with-current-buffer source
                     (set-buffer-multibyte (car case))
                     (insert (if (car case) "é日本" (unibyte-string 233 255))))
                   (with-temp-buffer
                     (set-buffer-multibyte (cadr case))
                     (insert-buffer-substring source)
                     (string-to-list (buffer-string))))
          (kill-buffer source)))
      (nth 2 case)))

(defun qa-transfer-compare (one two bounds1 bounds2 &optional narrow1 narrow2)
  (let ((first (generate-new-buffer " *compare-first*"))
        (second (generate-new-buffer " *compare-second*")))
    (unwind-protect
        (progn
          (with-current-buffer first (insert one)
            (when narrow1 (narrow-to-region (car narrow1) (cadr narrow1))))
          (with-current-buffer second (insert two)
            (when narrow2 (narrow-to-region (car narrow2) (cadr narrow2))))
          (compare-buffer-substrings first (car bounds1) (cadr bounds1)
                                     second (car bounds2) (cadr bounds2)))
      (kill-buffer first) (kill-buffer second))))
(qa (with-temp-buffer (insert "abc") (compare-buffer-substrings nil nil nil nil nil nil)) 0)
(qa (with-temp-buffer (insert "abcdef") (narrow-to-region 2 5)
      (compare-buffer-substrings nil nil nil nil 5 2)) 0)
(qa (qa-transfer-compare "abc" "abd" '(nil nil) '(nil nil)) -3)
(qa (qa-transfer-compare "abd" "abc" '(nil nil) '(nil nil)) 3)
(qa (qa-transfer-compare "abc" "ab" '(nil nil) '(nil nil)) 3)
(qa (qa-transfer-compare "ab" "abc" '(nil nil) '(nil nil)) -3)
(qa (qa-transfer-compare "abcdef" "bcd" '(nil nil) '(nil nil) '(2 5)) 0)
(qa (qa-transfer-compare "bcd" "abcdef" '(nil nil) '(nil nil) nil '(2 5)) 0)
(qa-err-data (qa-transfer-compare "abc" "xyz" '(0 2) '(bad bad)) 'args-out-of-range '(0 2))
(qa-err-data (qa-transfer-compare "abc" "xyz" '(nil nil) '(nil 5)) 'args-out-of-range '(nil 5))
(qa-err-data (qa-transfer-compare "abc" "xyz" '(nil nil) '(bad bad))
             'wrong-type-argument '(integer-or-marker-p bad))
(qa-err-data (qa-transfer-compare "abc" "abc" '(1 3) '(1 3) '(2 4)) 'args-out-of-range '(1 3))
(qa-err-data (qa-transfer-compare "abc" "abc" (list (make-marker) nil) '(nil nil))
             'error '("Marker does not point anywhere"))
(qa-err-data (compare-buffer-substrings 17 nil nil nil nil nil) 'wrong-type-argument '(stringp 17))
(qa-err-data (let ((dead (generate-new-buffer " *dead-compare*")))
               (kill-buffer dead) (compare-buffer-substrings nil nil nil dead 'bad 'bad))
             'error '("Selecting deleted buffer"))
(qa (let ((case-fold-search nil)) (qa-transfer-compare "Abc" "abc" '(nil nil) '(nil nil))) -1)
(qa (let ((case-fold-search t)) (qa-transfer-compare "Abc" "abc" '(nil nil) '(nil nil))) 0)
(qa (with-temp-buffer
      (let ((table (copy-case-table (current-case-table))))
        (set-case-syntax-pair ?! ?? table) (set-case-table table)
        (let ((case-fold-search t)) (qa-transfer-compare "!" "?" '(nil nil) '(nil nil))))) 0)
(qa (let ((one (generate-new-buffer " *unibyte-compare*")))
      (unwind-protect
          (progn (with-current-buffer one (set-buffer-multibyte nil) (insert (unibyte-string 233)))
                 (with-temp-buffer (insert "é")
                   (list (compare-buffer-substrings one nil nil nil nil nil)
                         (compare-buffer-substrings nil nil nil one nil nil))))
        (kill-buffer one))) '(1 -1))
(qa (let ((one (generate-new-buffer " *raw-compare*")))
      (unwind-protect
          (progn (with-current-buffer one (set-buffer-multibyte nil) (insert (unibyte-string 233)))
                 (with-temp-buffer (insert (unibyte-string 233))
                   (compare-buffer-substrings one nil nil nil nil nil)))
        (kill-buffer one))) 0)

(princ (qa--done))
