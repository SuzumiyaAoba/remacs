;; lists — GNU-verified: member/delq/remq/remove take no TESTFN in 31.1
;; (3-arg call signals wrong-number-of-arguments); list-length is gone;
;; delete works on vectors AND strings; memql/member/nthcdr are list-only.
;; length= on a dotted list counts conses only; length of a char-table is
;; its range size (2^22).  assoc-default returns the cdr, not the element.

;; == indexing: nth / nthcdr / elt ==
(qa (nth 0 '(a b c)) 'a)
(qa (nth 2 '(a b c)) 'c)
(qa (nth 9 '(a b c)) nil)
(qa (nth -1 '(a b c)) 'a)
(qa (nthcdr 0 '(a b c)) '(a b c))
(qa (nthcdr 9 '(a b c)) nil)
(qa (nthcdr -1 '(a b c)) '(a b c))
;; Issue #142: stop at nil rather than walking the remaining huge count.
(qa (nth most-positive-fixnum nil) nil)
(qa (nthcdr most-positive-fixnum nil) nil)
(qa (nth most-positive-fixnum '(a b c)) nil)
(qa (nthcdr most-positive-fixnum '(a b c)) nil)
(qa (nth 3 '(a b c)) nil)
(qa (nthcdr 3 '(a b c)) nil)
(qa (funcall (byte-compile (lambda (n l) (nth n l)))
             most-positive-fixnum '(a b c)) nil)
(qa (funcall (byte-compile (lambda (n l) (nthcdr n l)))
             most-positive-fixnum '(a b c)) nil)
(qa (nthcdr 1 '(a . b)) 'b)
(qa-err-data (nthcdr 2 '(a . b)) 'wrong-type-argument '(listp (a . b)))
(qa-err-data (nth most-positive-fixnum '(a . b))
             'wrong-type-argument '(listp (a . b)))
(qa-err-data (nthcdr most-positive-fixnum '(a . b))
             'wrong-type-argument '(listp (a . b)))
(qa-err-data (nthcdr 1 'a) 'wrong-type-argument '(listp a))
(qa-err-data (nthcdr 1.5 '(a b)) 'wrong-type-argument '(integerp 1.5))
(qa-err-data (nth 1 [a b]) 'wrong-type-argument '(listp [a b]))
(qa-err-data (nth 'a '(a b)) 'wrong-type-argument '(integerp a))
(let ((l (list 'a 'b 'c)))
  (qa-same (nthcdr 1 l) (cdr l)))
(qa (elt '(a b c) 1) 'b)
(qa (elt '(a b) 5) nil)
(qa (elt '(a b c) most-positive-fixnum) nil)
(qa (elt '(a b) -1) 'a)
(qa (elt "abc" 0) ?a)

