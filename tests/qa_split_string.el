;; No separator preserves the original object, properties and byte kind.
(let ((source (propertize "abc" 'p 7)))
  (qa-same (car (split-string source ",")) source))
(let ((pieces (split-string (propertize "a b" 'face 'bold))))
  (qa pieces '("a" "b"))
  (qa (mapcar (lambda (s) (get-text-property 0 'face s)) pieces) '(bold bold)))
(let ((pieces (split-string (concat "x," (propertize "y" 'p 1) ",z") ",")))
  (qa pieces '("x" "y" "z"))
  (qa (mapcar (lambda (s) (get-text-property 0 'p s)) pieces) '(nil 1 nil)))
(let ((pieces (split-string (propertize " x , y " 'p 2) "," nil " *")))
  (qa pieces '("x" "y"))
  (qa (mapcar (lambda (s) (get-text-property 0 'p s)) pieces) '(2 2)))
(let ((pieces (split-string (unibyte-string 255 44 254) ",")))
  (qa (mapcar #'string-to-list pieces) '((255) (254)))
  (qa (mapcar #'multibyte-string-p pieces) '(nil nil)))
(let ((pieces (split-string (unibyte-string ?a ?, ?b) ",")))
  (qa (mapcar #'multibyte-string-p pieces) '(nil nil)))
;; Default separator bindings and validation use the GNU call order.
(let ((split-string-default-separators ","))
  (qa (split-string ",a,,b,") '("a" "b")))
(qa-err (split-string "abc" "[") 'invalid-regexp)
(qa-err-data (split-string 1) 'wrong-type-argument '(sequencep 1))
(qa-err-data (split-string [1] 2) 'wrong-type-argument '(stringp 2))
(qa-err-data (split-string [1] ",") 'wrong-type-argument '(stringp [1]))
(qa-err-data (split-string "a,b" "," nil t) 'wrong-type-argument '(sequencep t))
(qa (split-string " a , b " "," nil '(32 42)) '("a" "b"))
;; Split leaves the separator or trim match data available to callers.
(qa (progn (split-string "a,b,c" ",") (match-data)) '(3 4))
(qa (progn (split-string "a,b" "," nil " *") (match-data)) '(0 0))
(let ((pieces (split-string (substring "あa,b" 1) ",")))
  (qa pieces '("a" "b"))
  (qa (mapcar #'multibyte-string-p pieces) '(t t)))
(princ (qa--done))
