;;; -*- lexical-binding: nil; -*-
;; Issue #77: numeric zero and t select the same named UTC zone.
;; GNU builds may call this UTC or GMT; compare the two designators.
(dolist (time '(0 -1 86400 (0 0) (1 2 3 4 5)))
  (qa (current-time-zone time 0) (current-time-zone time t))
  (dolist (format '("%H %Z" "%Z" "%#Z" "%^Z" "%10Z" "%_10Z" "%-10Z"
                    "%z" "%:z" "%::z" "%:::z" "%Y-%m-%d %H:%M:%S %Z"))
    (qa (format-time-string format time 0) (format-time-string format time t))))
(qa (current-time-zone nil 0) (current-time-zone nil t))
(qa (format-time-string "%Y" '(1 2 3 4 5) t) "1970")
(dolist (entry '(("%5Y" . "01970") ("%03d" . "001") ("%-" . "%-")
                 ("%_5Y" . " 1970") ("%-5Y" . "1970") ("%05Y" . "01970")
                 ("%-10B" . "January") ("%-10a" . "Thu") ("%-3H" . "0")
                 ("%-_5Y" . " 1970") ("%_-5Y" . "1970")
                 ("%-05Y" . "01970") ("%0-5Y" . "1970")
                 ("%^-5Y" . "1970") ("%-^5Y" . "1970")
                 ("%-5Ea" . "%-5Ea") ("%-5EQ" . "%-5EQ") ("%_-5Oa" . "%_-5Oa")
                 ("%^-5Ea" . "%^-5EA") ("%-5%" . "%-5%")
                 ("%-5%Y" . "%-51970") ("%5%Y" . "   %51970")
                 ("%_%Y" . "%_1970") ("%0%Y" . "%01970")
                 ("%05%" . "00%05%") ("%_5%" . "  %_5%")
                 ("%0_5%" . " %0_5%") ("%_05%" . "0%_05%")
                 ("%5:%" . "  %5:%") ("%%" . "%")
                 ("%_3d" . "  1") ("%-3d" . "1") ("%" . "%")
                 ("%^" . "%^") ("%_" . "%_") ("%0" . "%0")))
  (qa (format-time-string (car entry) 0 t) (cdr entry)))
(qa (current-time-zone 0 3600) '(3600 "+01"))
(qa (current-time-zone 0 -1800) '(-1800 "-0030"))
(qa (current-time-zone 0 '(0 "CUSTOM")) '(0 "CUSTOM"))
(qa (format-time-string "%Z" 0 '(0 "CUSTOM")) "CUSTOM")
(princ (qa--done))
