;;; -*- lexical-binding: nil; -*-
;; GNU subr.el's eventp, including integer and symbol-view boundaries (#592).
(dolist (entry '((nil nil) (t t) (a t) (:a nil)
                 (0 t) (-1 t) (2305843009213693951 t)
                 (2305843009213693952 t) (100000000000000000000000 t)
                 (-100000000000000000000000 t)
                 (1.0 nil) ("a" nil) ([a] nil) (#&1"\1" nil)
                 ((nil) nil) ((a) t) ((t . 2) t) ((:a . 2) nil)
                 ((1) nil) ((1 . 2) nil)
                 ((100000000000000000000000 . 2) nil)
                 (("a" . 2) nil) (((a) . 2) nil)))
  (qa (eventp (car entry)) (cadr entry)))
(let ((symbol (make-symbol ":a")))
  (qa (eventp symbol) t)
  (qa (eventp (list symbol)) t))
(dolist (created '(nil t))
  (let* ((symbols-with-pos-enabled created)
         (symbol (position-symbol 'a 1))
         (nil-symbol (position-symbol nil 1))
         (keyword (position-symbol :a 1))
         (uninterned (position-symbol (make-symbol ":a") 1)))
    (dolist (enabled '(nil t))
      (let ((symbols-with-pos-enabled enabled))
        (qa (eventp symbol) enabled)
        (qa (eventp (cons symbol 2)) enabled)
        ;; Positioned nil remains truthy even when EQ regards it as nil.
        (qa (eventp nil-symbol) enabled)
        (qa (eventp (cons nil-symbol 2)) enabled)
        (qa (eventp keyword) nil)
        (qa (eventp (cons keyword 2)) nil)
        (qa (eventp uninterned) enabled)
        (qa (eventp (cons uninterned 2)) enabled)))))
(let ((cycle (list 'mouse-1)))
  (setcdr cycle cycle)
  (qa (eventp cycle) t))
(princ (qa--done))
