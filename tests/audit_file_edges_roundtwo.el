;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "temp-file:text-ascii" '(let ((dir (make-temp-file "remacs-audit-files-" t))) (unwind-protect (let ((file (make-temp-file (expand-file-name "text-" dir) nil nil "abc"))) (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally file) (string-to-list (buffer-string)))) (delete-directory dir t))))
(audit-check "temp-file:text-unibyte" '(let ((dir (make-temp-file "remacs-audit-files-" t))) (unwind-protect (let ((file (make-temp-file (expand-file-name "text-" dir) nil nil (unibyte-string 0 128 255)))) (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally file) (string-to-list (buffer-string)))) (delete-directory dir t))))
(audit-check "temp-file:text-unicode" '(let ((dir (make-temp-file "remacs-audit-files-" t))) (unwind-protect (let ((file (make-temp-file (expand-file-name "text-" dir) nil nil "é日"))) (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally file) (string-to-list (buffer-string)))) (delete-directory dir t))))
(audit-check "temp-file:text-raw-byte" '(let ((dir (make-temp-file "remacs-audit-files-" t))) (unwind-protect (let ((file (make-temp-file (expand-file-name "text-" dir) nil nil (string #x3fff80 #x3fffff)))) (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally file) (string-to-list (buffer-string)))) (delete-directory dir t))))
(audit-check "temp-file:text-invalid" '(let ((dir (make-temp-file "remacs-audit-files-" t))) (unwind-protect (let ((file (make-temp-file (expand-file-name "text-" dir) nil nil 42))) (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally file) (string-to-list (buffer-string)))) (delete-directory dir t))))
(audit-check "temp-file:directory-mode" '(let ((dir (make-temp-file "remacs-audit-files-" t))) (unwind-protect (logand (file-modes dir) #o777) (delete-directory dir t))))
(audit-check "temp-file:ordinary-mode" '(let ((dir (make-temp-file "remacs-audit-files-" t))) (unwind-protect (let ((f (make-temp-file (expand-file-name "data-" dir)))) (logand (file-modes f) #o777)) (delete-directory dir t))))
(audit-check "temp-file:directory-ignores-text" '(let ((dir (make-temp-file "remacs-audit-files-" t))) (unwind-protect (let ((d (make-temp-file (expand-file-name "nested-" dir) t nil "data"))) (directory-files d nil "^[^.]") ) (delete-directory dir t))))
(defvar audit-r2-file-log nil)
(defun audit-r2-file-handler (op &rest args)
  (if (eq op 'expand-file-name) (car args)
    (push (list op args) audit-r2-file-log)
    'handled))
(audit-check "file-handler:access-file" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (access-file name "audit access") (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-equal-p" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-equal-p name name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-newer-than-file-p" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-newer-than-file-p name name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-directory-p" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-directory-p name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-regular-p" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-regular-p name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-executable-p" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-executable-p name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-attributes" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-attributes name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-modes" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-modes name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-symlink-p" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-symlink-p name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-local-copy" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-local-copy name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "file-handler:file-exists-p" '(let ((name "/audit-virtual/file") (audit-r2-file-log nil)
                (file-name-handler-alist (list (cons "^/audit-virtual/" 'audit-r2-file-handler))))
   (list (condition-case e (file-exists-p name) (error (car e))) (nreverse audit-r2-file-log))))
(audit-check "set-file-times:flag-nil" '(let* ((dir (make-temp-file "remacs-audit-files-" t))
                 (file (expand-file-name "file" dir)) (link (expand-file-name "link" dir)))
  (unwind-protect
      (progn (write-region "x" nil file nil 'silent)
             (make-symbolic-link file link)
             (set-file-times file 1000000000)
             (list (condition-case e (set-file-times link 1100000000 nil) (error (car e)))
                   (time-convert (file-attribute-modification-time (file-attributes file)) 'integer)))
    (delete-directory dir t))))
(audit-check "set-file-times:flag-'nofollow" '(let* ((dir (make-temp-file "remacs-audit-files-" t))
                 (file (expand-file-name "file" dir)) (link (expand-file-name "link" dir)))
  (unwind-protect
      (progn (write-region "x" nil file nil 'silent)
             (make-symbolic-link file link)
             (set-file-times file 1000000000)
             (list (condition-case e (set-file-times link 1100000000 'nofollow) (error (car e)))
                   (time-convert (file-attribute-modification-time (file-attributes file)) 'integer)))
    (delete-directory dir t))))
(audit-check "set-file-times:flag-t" '(let* ((dir (make-temp-file "remacs-audit-files-" t))
                 (file (expand-file-name "file" dir)) (link (expand-file-name "link" dir)))
  (unwind-protect
      (progn (write-region "x" nil file nil 'silent)
             (make-symbolic-link file link)
             (set-file-times file 1000000000)
             (list (condition-case e (set-file-times link 1100000000 t) (error (car e)))
                   (time-convert (file-attribute-modification-time (file-attributes file)) 'integer)))
    (delete-directory dir t))))
(audit-check "set-file-times:flag-'bogus" '(let* ((dir (make-temp-file "remacs-audit-files-" t))
                 (file (expand-file-name "file" dir)) (link (expand-file-name "link" dir)))
  (unwind-protect
      (progn (write-region "x" nil file nil 'silent)
             (make-symbolic-link file link)
             (set-file-times file 1000000000)
             (list (condition-case e (set-file-times link 1100000000 'bogus) (error (car e)))
                   (time-convert (file-attribute-modification-time (file-attributes file)) 'integer)))
    (delete-directory dir t))))
(princ "AUDIT-DONE\n")
