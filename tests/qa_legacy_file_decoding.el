;; Exact bytes are created by tests/legacy_file_coding.rs, never write-region.
;; GNU 31.1 oracle checks; qa-legacy-file-coding-dir is supplied by the runner.
(defvar qa-legacy-file-coding-dir)
(defun qa-legacy-file-read (name coding)
  (with-temp-buffer
    (let ((coding-system-for-read coding))
      (insert-file-contents (expand-file-name name qa-legacy-file-coding-dir)))
    (list (string-to-list (buffer-string))
          (mapcar (lambda (n) (get-text-property n 'charset))
                  (number-sequence (point-min) (1- (point-max))))
          last-coding-system-used)))
