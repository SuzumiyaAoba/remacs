;;; -*- lexical-binding: t; -*-
;; GNU symbol spelling and lookup must survive packed front-end key codes.
(qa (key-binding [C-home]) (quote beginning-of-buffer))
(qa (key-binding [C-end]) (quote end-of-buffer))
(qa (let ((map (make-sparse-keymap)))
      (define-key map [C-home] (quote ignore))
      (lookup-key map (key-parse "C-<home>"))) (quote ignore))
(qa (let ((map (make-sparse-keymap)))
      (define-key map [M-C-left] (quote ignore))
      (lookup-key map [C-M-left])) (quote ignore))
(qa (let ((map (make-sparse-keymap)))
      (define-key map [C-home] (quote ignore))
      (where-is-internal (quote ignore) map t)) [C-home])
(qa (let ((map (make-sparse-keymap)))
      (define-key map [M-C-S-s-f5] (quote ignore))
      (where-is-internal (quote ignore) map t)) [C-M-S-s-f5])
(qa (let ((map (make-sparse-keymap)))
      (define-key map [C-home] (quote ignore))
      (car (cadr map))) (quote C-home))
(qa (let ((map (make-sparse-keymap)))
      (define-key map [C-M-home] (quote ignore))
      (keymap-set map "C-M-<home>" (quote forward-char))
      (list (lookup-key map [M-C-home]) (length (cdr map))))
    (quote (forward-char 1)))
(qa (let ((map (make-sparse-keymap)))
      (define-key map [C-M-home] (quote ignore))
      (keymap-unset map "C-M-<home>")
      (lookup-key map [M-C-home])) nil)
(qa (key-description [C-M-S-s-f5]) "C-M-S-s-<f5>")
(qa (let ((map (make-sparse-keymap)))
      (define-key map [C-dp] (quote ignore))
      (define-key map [C-f2] (quote forward-char))
      (list (lookup-key map [C-dp]) (lookup-key map [C-f2])))
    (quote (ignore forward-char)))
;; Meta-modified symbols remain direct entries even when ESC is not a prefix.
(qa (let ((map (make-sparse-keymap)))
      (define-key map [27] (quote ignore))
      (define-key map [C-M-wheel-up] (quote forward-char))
      (list (lookup-key map [27]) (lookup-key map [M-C-wheel-up])))
    (quote (ignore forward-char)))
(qa (let ((map (make-sparse-keymap)))
      (define-key map [M-left] (quote ignore))
      (list (lookup-key map [27]) (lookup-key map [M-left])))
    (quote (nil ignore)))
(princ (qa--done))
