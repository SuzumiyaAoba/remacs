;; Hash tables, second slice — GNU 31.1 pins (verified).
;;
;; GNU truths pinned:
;;   - hash-table-keys / hash-table-values are NOT fbound until
;;     (require 'subr-x); they come from subr-x.
;;   - remhash returns nil in ALL cases (removed or missing key).
;;   - clrhash returns the SAME table object (eq).
;;   - maphash returns nil; iteration order unspecified.
;;   - :test eql treats 1.0 and 1 as different keys.
;;   - defaults: rehash-size 1.5, rehash-threshold 0.8125,
;;     weakness nil, size 0 (grows), test eql.
;;   - puthash/gethash on non-tables -> wrong-type-argument.

;; == fn surface ==
(qa (fboundp 'hash-table-keys) nil)
(qa (fboundp 'hash-table-values) nil)
(require 'subr-x)
(qa (fboundp 'hash-table-keys) t)
(qa (fboundp 'hash-table-values) t)

;; == defaults ==
(qa (hash-table-rehash-size (make-hash-table)) 1.5)
(qa (hash-table-rehash-threshold (make-hash-table)) 0.8125)
(qa (hash-table-weakness (make-hash-table)) nil)
(qa (hash-table-size (make-hash-table :size 100)) 100)
(qa (hash-table-p "abc") nil)
(qa (hash-table-p [1 2]) nil)

;; == gethash / puthash ==
(qa (let ((h (make-hash-table)))
      (puthash 'a 1 h)
      (puthash 'b 2 h)
      (list (gethash 'a h) (gethash 'b h) (gethash 'c h 'none)))
    '(1 2 none))
(qa (let ((h (make-hash-table)))
      (puthash 'k 'v h))
    'v)
(qa (let ((h (make-hash-table)))
      (puthash 'a nil h)
      (hash-table-count h))
    1)
(qa-err (puthash 'a 1 'not-a-table) 'wrong-type-argument)
(qa-err (gethash 'a nil) 'wrong-type-argument)
(qa-err (gethash 'a 'sym 'dflt 'extra) 'wrong-number-of-arguments)

;; == remhash / clrhash ==
(qa (let ((h (make-hash-table)))
      (puthash 'a 1 h)
      (list (remhash 'a h) (remhash 'a h) (hash-table-count h)))
    '(nil nil 0))
(qa (let ((h (make-hash-table)))
      (puthash 'a 1 h)
      (eq h (clrhash h)))
    t)
(qa (let ((h (make-hash-table)))
      (puthash 'a 1 h) (puthash 'b 2 h)
      (clrhash h)
      (list (hash-table-count h) (gethash 'a h 'gone)))
    '(0 gone))

;; == maphash ==
(qa (let ((h (make-hash-table)))
      (puthash 'a 1 h)
      (maphash (lambda (k v) k) h))
    nil)
(qa (let ((h (make-hash-table)) (acc nil))
      (puthash 'x 1 h)
      (puthash 'y 2 h)
      (maphash (lambda (k v) (push (cons k v) acc)) h)
      (sort acc (lambda (a b) (string< (symbol-name (car a))
                                     (symbol-name (car b))))))
    '((x . 1) (y . 2)))
;; mutation of existing entries during maphash is legal
(qa (let ((h (make-hash-table)))
      (puthash 'a 1 h)
      (maphash (lambda (k v) (puthash k (1+ v) h)) h)
      (gethash 'a h))
    2)
(qa (let ((h (make-hash-table)) (sum 0))
      (puthash 'a 10 h) (puthash 'b 20 h) (puthash 'c 30 h)
      (maphash (lambda (_k v) (setq sum (+ sum v))) h)
      sum)
    60)

;; == hash-table-keys / hash-table-values (subr-x) ==
(qa (let ((h (make-hash-table :test 'equal)))
      (puthash "b" 1 h) (puthash "a" 2 h)
      (sort (hash-table-keys h) #'string<))
    '("a" "b"))
(qa (let ((h (make-hash-table)))
      (puthash 'a 1 h) (puthash 'b 2 h)
      (sort (hash-table-values h) #'<))
    '(1 2))
(qa (hash-table-keys (make-hash-table)) nil)
(qa (hash-table-values (make-hash-table)) nil)

;; == :test variations ==
(qa (let ((h (make-hash-table :test 'equal)))
      (puthash "key" 1 h)
      (gethash (copy-sequence "key") h))
    1)
(qa (let ((h (make-hash-table :test 'eq)))
      (puthash "key" 1 h)
      (gethash (copy-sequence "key") h 'miss))
    'miss)
(qa (let ((h (make-hash-table :test 'eql)))
      (puthash 1.0 'float h)
      (list (gethash 1.0 h) (gethash 1 h 'int-miss)))
    '(float int-miss))
(qa (let ((h (make-hash-table :test 'eql)))
      (puthash 1 'one h)
      (gethash 1 h))
    'one)
(qa (hash-table-test (make-hash-table)) 'eql)

;; == count / size as table grows ==
(qa (let ((h (make-hash-table)))
      (dotimes (i 50) (puthash i i h))
      (hash-table-count h))
    50)
(qa (let ((h (make-hash-table)))
      (dotimes (i 10) (puthash i i h))
      (remhash 0 h)
      (hash-table-count h))
    9)

;; == copy / eq identity ==
(qa (let ((h (make-hash-table))) (eq h h)) t)
;; equal on hash tables is identity-based in 31.1 (contents ignored)
(qa (equal (let ((h (make-hash-table))) (puthash 'a 1 h) h)
           (let ((h (make-hash-table))) (puthash 'a 1 h) h))
    nil)
(qa (equal (let ((h (make-hash-table))) (puthash 'a 1 h) h)
           (let ((h (make-hash-table))) (puthash 'a 2 h) h))
    nil)

;; == sxhash consistency ==
(qa (= (sxhash-equal "ab") (sxhash-equal (copy-sequence "ab"))) t)
(qa (integerp (sxhash 'a)) t)
(qa (= (sxhash-eq 'a) (sxhash-eq 'a)) t)

;; == purecopy tables ==
(qa (let ((h (make-hash-table :purecopy t)))
      (puthash 'a 1 h)
      (hash-table-count h))
    1)

;; Current GNU entry capacity for all hash tests (#195).
(defun qa195-capacities (test hint)
  (let* ((h (make-hash-table :test test :size hint))
         (last (hash-table-size h)) (changes (list (list 0 last))))
    (dotimes (n 130)
      (puthash n n h)
      (unless (= last (hash-table-size h))
        (setq last (hash-table-size h))
        (push (list (1+ n) last) changes)))
    (nreverse changes)))
(qa (qa195-capacities 'eq 0) '((0 0) (1 6) (7 24) (25 96) (97 192)))
(qa (qa195-capacities 'eq 1) '((0 1) (2 24) (25 96) (97 192)))
(qa (qa195-capacities 'eq 7) '((0 7) (8 28) (29 112) (113 224)))
(qa (qa195-capacities 'eq 64) '((0 64) (65 256)))
(qa (qa195-capacities 'eq 65) '((0 65) (66 130)))
(qa (qa195-capacities 'eq 100) '((0 100) (101 200)))
(qa (qa195-capacities 'eql 0) '((0 0) (1 6) (7 24) (25 96) (97 192)))
(qa (qa195-capacities 'eql 1) '((0 1) (2 24) (25 96) (97 192)))
(qa (qa195-capacities 'eql 7) '((0 7) (8 28) (29 112) (113 224)))
(qa (qa195-capacities 'eql 64) '((0 64) (65 256)))
(qa (qa195-capacities 'eql 65) '((0 65) (66 130)))
(qa (qa195-capacities 'eql 100) '((0 100) (101 200)))
(qa (qa195-capacities 'equal 0) '((0 0) (1 6) (7 24) (25 96) (97 192)))
(qa (qa195-capacities 'equal 1) '((0 1) (2 24) (25 96) (97 192)))
(qa (qa195-capacities 'equal 7) '((0 7) (8 28) (29 112) (113 224)))
(qa (qa195-capacities 'equal 64) '((0 64) (65 256)))
(qa (qa195-capacities 'equal 65) '((0 65) (66 130)))
(qa (qa195-capacities 'equal 100) '((0 100) (101 200)))
(define-hash-table-test 'qa195-constant #'eql (lambda (_key) 0))
(qa (qa195-capacities 'qa195-constant 1) '((0 1) (2 24) (25 96) (97 192)))
(qa (let ((h (make-hash-table :size 1)))
      (dotimes (n 10) (puthash n n h))
      (list (hash-table-count h) (> (hash-table-size h) 1))) '(10 t))
(qa (let ((h (make-hash-table :test 'eq :size 1)))
      (puthash 'a 1 h) (puthash 'a 2 h)
      (let ((first (hash-table-size h)))
        (puthash 'b 3 h) (puthash 'b 4 h)
        (list first (hash-table-size h) (hash-table-count h)))) '(1 24 2))
(qa (let ((h (make-hash-table :test 'eql :size 2)))
      (puthash 'a 1 h) (puthash 'b 2 h)
      (remhash 'a h)
      (let ((before (hash-table-size h)))
        (puthash 'c 3 h)
        (let ((reused (hash-table-size h)))
          (puthash 'd 4 h)
          (list before reused (hash-table-size h) (hash-table-count h))))) '(2 2 24 3))
(qa (let ((h (make-hash-table :test 'eq :size 1)))
      (dotimes (n 10) (puthash n n h))
      (clrhash h)
      (let ((cleared (list (hash-table-size h) (hash-table-count h))))
        (dotimes (n 24) (puthash n n h))
        (let ((filled (hash-table-size h)))
          (puthash 24 24 h)
          (list cleared filled (hash-table-size h))))) '((24 0) 24 96))
(qa (let ((h (make-hash-table :test 'eq :size 1)))
      (dotimes (n 10) (puthash n n h))
      (let ((copy (copy-hash-table h)))
        (dotimes (n 25) (puthash n n copy))
        (list (hash-table-size h) (hash-table-count h)
              (hash-table-size copy) (hash-table-count copy)))) '(24 10 96 25))
(qa (let ((h (make-hash-table :test 'eq :size 1 :weakness 'key)))
      (dotimes (n 1000) (puthash (vector n) n h))
      (let ((before (hash-table-size h)))
        (garbage-collect) (garbage-collect)
        (let ((collected (< (hash-table-count h) 10)))
          (puthash 42 42 h)
          (list before (hash-table-size h) collected)))) '(1536 1536 t))
(qa (let ((h (read "#s(hash-table test eq size 999 data (a 1 b 2))")))
      (list (hash-table-size h) (hash-table-count h))) '(2 2))
(qa (let ((h (read "#s(hash-table test eql data (1 a 1 b 2 c))")))
      (list (hash-table-size h) (hash-table-count h) (gethash 1 h))) '(3 2 b))
(princ (qa--done))
