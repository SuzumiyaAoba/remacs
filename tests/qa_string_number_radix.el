;;; -*- lexical-binding: nil; -*-
;; BASE defaults/validation (#443) and single-sign parsing (#444).
(qa (string-to-number "12" nil) 12)
(qa (string-to-number " -12.5tail" nil) -12.5)
(dolist (text '("" " " "\t \t" "+" "12"))
  (dolist (base (list -1 0 1 17 most-negative-fixnum most-positive-fixnum))
    (qa-err-data (string-to-number text base) 'args-out-of-range (list base)))
  (dolist (base (list t 'bad "10" 10.0 (1+ most-positive-fixnum)))
    (qa-err-data (string-to-number text base) 'wrong-type-argument (list 'fixnump base))))
(qa-err-data (string-to-number nil 1) 'wrong-type-argument '(stringp nil))
(qa-err-data (string-to-number 42 'bad) 'wrong-type-argument '(stringp 42))
(dotimes (offset 15)
  (let* ((base (+ offset 2))
         (large (concat "1" (make-string 100 ?0))))
    (qa (string-to-number "10" base) base)
    (qa (string-to-number "+10" base) base)
    (qa (string-to-number "-10" base) (- base))
    (qa (string-to-number " \t+10suffix" base) base)
    (qa (= (string-to-number large base) (expt base 100)) t)
    (qa (= (string-to-number (concat "-" large) base) (- (expt base 100))) t)
    (dolist (prefix '("++" "--" "+-" "-+" "+++" "-++" "+--" "---"))
      (qa (string-to-number (concat prefix "10") base) 0))
    (dolist (text '("" " \t" "+" "-" "+ 10" "- 10" "\n10"))
      (qa (string-to-number text base) 0))
    (dotimes (digit 6)
      (let ((text (char-to-string (+ ?a digit))) (value (+ digit 10)))
        (qa (string-to-number text base) (if (< value base) value 0))
        (qa (string-to-number (upcase text) base) (if (< value base) value 0))))))
(princ (qa--done))
