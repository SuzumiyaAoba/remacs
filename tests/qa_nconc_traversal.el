;;; -*- lexical-binding: nil; -*-
;; Final arguments are unrestricted tails (#496); no fixed walk cap (#497).
(qa (nconc) nil)
(dolist (tail (list nil 42 'atom [a b] (record 'tag) '(a . b)
                    (font-spec) (obarray-make)))
  (qa (eq (nconc tail) tail) t)
  (qa (eq (nconc nil nil tail) tail) t)
  (let ((prefix (list 'head)))
    (qa (eq (nconc prefix tail) prefix) t)
    (qa (eq (cdr prefix) tail) t)))
(let ((tail (list 'cycle)))
  (setcdr tail tail)
  (qa (eq (nconc tail) tail) t)
  (qa (eq (nconc nil tail) tail) t)
  (let ((prefix (list 'head)))
    (qa (eq (nconc prefix tail) prefix) t)
    (qa (eq (cdr prefix) tail) t)))
(dolist (row '((1 0) (2 0) (3 2) (4 2) (5 1) (6 0) (7 6) (8 6)))
  (let ((source (number-sequence 0 (1- (car row)))) (prefix (list 'before)))
    (setcdr (last source) source)
    (qa (condition-case e (nconc prefix source nil)
          (circular-list (list (car (cadr e)) (eq (cdr prefix) source))))
        (list (cadr row) t))))
(let ((source (list 'a 'b)))
  (qa-err (nconc source source nil) 'circular-list)
  (qa (eq (cddr source) source) t))
(let* ((source (list 'a 'b)) (end (cdr source)))
  (qa (eq (nconc source source) source) t)
  (qa (eq (cdr end) source) t))
(dolist (middle '(nil (nil) (nil nil)))
  (let ((source (list 'before)))
    (qa-err-data (apply #'nconc source (append middle (list 42 nil)))
                 'wrong-type-argument '(consp 42))
    (qa source '(before . 42))))
(qa (nconc (cons 'a 'discarded) nil (cons 'b 'discarded) 'tail) '(a b . tail))
;; Retain the original last cell for safe cleanup even if a regression
;; signals before linking the final tail. Close the original spine into
;; a cycle to avoid recursively dropping a million Rc conses, then GC it.
(let* ((source (make-list 1000001 nil)) (end (last source)) (tail (list 'tail)))
  (unwind-protect
      (progn
        (qa (eq (nconc source tail) source) t)
        (qa (length source) 1000002)
        (qa (eq (cdr end) tail) t))
    (setcdr end source)))
(garbage-collect)
(princ (qa--done))
