;;; -*- lexical-binding: nil; -*-
;; Issue #84: overlays retain their type throughout their lifecycle.
(let ((one (generate-new-buffer " *qa84-one*"))
      (two (generate-new-buffer " *qa84-two*")))
  (unwind-protect
      (let ((overlay (make-overlay 1 1 one)))
        (qa (type-of overlay) 'overlay)
        (qa (overlayp overlay) t)
        (overlay-put overlay 'qa84 'value)
        (qa (type-of overlay) 'overlay)
        (let ((copy (copy-overlay overlay)))
          (qa (type-of copy) 'overlay)
          (qa (overlayp copy) t)
          (delete-overlay copy)
          (qa (type-of copy) 'overlay)
          (qa (overlayp copy) t))
        (delete-overlay overlay)
        (qa (type-of overlay) 'overlay)
        (qa (overlayp overlay) t)
        (move-overlay overlay 1 1 two)
        (qa (type-of overlay) 'overlay)
        (qa (overlayp overlay) t)
        (qa (overlay-buffer overlay) two)
        (kill-buffer two)
        (qa (type-of overlay) 'overlay)
        (qa (overlayp overlay) t)
        (qa (overlay-buffer overlay) nil))
    (kill-buffer one)
    (kill-buffer two)))
;; Ordinary vectors, even overlay-shaped ones, are not overlay objects.
(dolist (value (list [] [overlay] [overlay 0 0] [overlay 123456 0]
                     [overlay nil nil] [other 0 0] [overlay 0 0 0]))
  (qa (type-of value) 'vector)
  (qa (overlayp value) nil))
(with-temp-buffer
  (let ((overlay (make-overlay 1 1)))
    (qa (type-of (vector overlay)) 'vector)
    (qa (overlayp (vector overlay)) nil)
    (delete-all-overlays)
    (qa (type-of overlay) 'overlay)
    (qa (overlayp overlay) t)))
(qa (type-of (make-marker)) 'marker)
(qa (type-of (current-buffer)) 'buffer)
(qa (type-of (selected-window)) 'window)
;; Cross the registry cleanup threshold while retaining a detached overlay.
(let ((retained (with-temp-buffer (make-overlay 1 1))))
  (dotimes (n 300)
    (let ((temporary (with-temp-buffer (make-overlay 1 1))))
      (qa (type-of temporary) 'overlay)
      (qa (overlayp temporary) t))
    (qa (type-of retained) 'overlay))
  (qa (overlayp retained) t))
(princ (qa--done))
