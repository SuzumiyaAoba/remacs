;;; -*- lexical-binding: t -*-
;; Boundary cases from the GNU Emacs 31.1 compatibility work.

(qa-err-data (eval '(defvar qa-edge-dv 1 nil nil))
             'error '("Too many arguments"))
(qa-err-data (eval '(defconst qa-edge-dc 1 nil nil))
             'error '("Too many arguments"))
(qa-err-data (eval '(defvar qa-edge-dv 1 nil nil t))
             'error '("Too many arguments"))
(qa-err-data (eval '(let ((a 5) . b) a))
             'wrong-type-argument '(listp b))
(qa (condition-case e (error "x") (error . ignored)) nil)

(qa (sleep-for 0 nil) nil)
(qa-err-data (sleep-for 0 0.0) 'wrong-type-argument '(fixnump 0.0))
(qa-err-data (sleep-for 'x) 'wrong-type-argument '(numberp x))
(qa-err-data (sleep-for 0 'x) 'wrong-type-argument '(fixnump x))
(qa-err-data (sit-for nil) 'wrong-type-argument '(numberp nil))
(qa-err-data (sit-for 'x) 'wrong-type-argument '(numberp x))
(qa-err-data (with-temp-buffer (insert-char ?a 1.0))
             'wrong-type-argument '(fixnump 1.0))
(qa-err-data (char-equal -1 ?a) 'wrong-type-argument '(characterp -1))
(qa-err-data (char-equal ?a #x400000)
             'wrong-type-argument '(characterp 4194304))

(qa (let ((s (copy-sequence "abc")))
      (list (set-text-properties 0 0 '(x 1) s)
            (set-text-properties 0 1 nil s)
            (set-text-properties 0 1 '(x 1) s)
            (set-text-properties 0 1 '(x 1) s)
            (set-text-properties 0 3 '(x 1) s)
            (get-text-property 2 'x s)
            (set-text-properties 0 3 nil s)
            (set-text-properties 0 3 nil s)))
    '(nil nil t t t 1 t nil))
(qa-err-data (add-text-properties -1 1 '(x 1) "abc")
             'args-out-of-range '(-1 1))
(qa-err-data (remove-text-properties 1 4 '(x nil) "abc")
             'args-out-of-range '(1 4))
(qa-err-data (set-text-properties 4 1 '(x 1) "abc")
             'args-out-of-range '(4 1))
(qa-err-data (add-face-text-property -1 1 'bold nil "abc")
             'args-out-of-range '(-1 1))

(qa (mapconcat #'identity '("a" "b") '(45)) "a-b")
(qa (mapconcat #'identity '("a" "b") [45]) "a-b")
(qa (mapconcat #'identity '("a" "b") nil) "ab")
(qa (mapconcat #'identity '("a") 5) "a")
(qa (mapconcat #'identity nil 5) "")
(qa-prin1 (mapconcat #'identity '("a" "b") (propertize "-" 'x 1))
          "#(\"a-b\" 1 2 (x 1))")
(qa-err-data (mapconcat #'identity '("a" "b") 5)
             'wrong-type-argument '(sequencep 5))
(qa (mapcan #'identity (list (cons 'a 'x) nil)) '(a))
(qa (mapcan #'identity (list (list 'a) 'x)) '(a . x))
(qa (mapcan #'identity '(nil x)) 'x)
(qa-err-data (mapcan #'identity '(x (a)))
             'wrong-type-argument '(consp x))

(qa (let ((h (make-hash-table :test 'eq)))
      (puthash (float 1) 'a h)
      (puthash (float 1) 'b h)
      (hash-table-count h)) 2)
(qa (let* ((h (make-hash-table :test 'eq)) (key (float 1)))
      (puthash key 'a h) (gethash key h)) 'a)
(qa-prin1 (progn (define-hash-table-test 'qa-edge-eq #'eq #'sxhash-eq)
                 (make-hash-table :test 'qa-edge-eq))
          "#s(hash-table test qa-edge-eq)")
(qa-prin1 (let ((m (make-marker))) (set-marker-insertion-type m t) m)
          "#<marker (moves after insertion) in no buffer>")

(qa (func-arity '(lambda (a &rest . r))) '(1 . many))
(qa-err (func-arity '(lambda (a . r))) 'invalid-function)
(qa-err (func-arity '(lambda (a &optional (b 1)))) 'invalid-function)
(qa (func-arity '(lambda (&rest r extra))) '(0 . many))
(qa (let ((qa-edge-base 9) (qa-edge-alias 1))
      ;; Rejecting a let-bound alias must preserve the bound base.
      (condition-case nil (defvaralias 'qa-edge-alias 'qa-edge-base)
        (error qa-edge-base))) 9)
(qa-err (with-temp-buffer (make-local-variable 'qa-edge-local)
          (defvaralias 'qa-edge-local 'qa-edge-base)) 'error)

(qa (time-convert '(1 2 . 3) 'list) '(1 2 3 0))
(qa (time-convert '(1 2 3 . ignored) 'list) '(1 2 3 0))
(qa (time-convert '(1 2 3 4 ignored) 'list) '(1 2 3 4))
(qa (decode-time '(0 0 bad bad) t) '(0 0 0 1 1 1970 4 nil 0))
(qa (decode-time '(0 0 1000000) t) '(0 0 0 1 1 1970 4 nil 0))
(qa (float-time (encode-time '(0 0 0 1 1 2020 nil t "Asia/Tokyo")))
    1577804400.0)
(qa (float-time (encode-time '(0 0 0 1 7 2020 nil nil "America/New_York")))
    1593579600.0)
(qa (float-time (encode-time '(0 0 0 1 7 2020 nil t "America/New_York")))
    1593576000.0)
(qa-err-data (float-time '(1 . 0)) 'error '("Invalid time specification"))
(qa-err-data (float-time '(1 2 bad)) 'error '("Invalid time specification"))
(qa (time-equal-p '(1 . 0) '(1 . 0)) t)
(qa (time-less-p '(1 . 0) '(2 . 0)) t)
(qa (time-equal-p 'invalid 'invalid) t)

(qa-err-data (bool-vector-subsetp (make-bool-vector 2 t) (make-bool-vector 1 nil))
             'wrong-length-argument '(2 1 1))
(qa-err-data (bool-vector-union (make-bool-vector 2 t) (make-bool-vector 1 nil))
             'wrong-length-argument '(2 1))
(qa-err-data (bool-vector-not (make-bool-vector 2 t) (make-bool-vector 1 nil))
             'wrong-length-argument '(2 1))

(qa-err-data (let ((root (make-sparse-keymap)) (tail (make-sparse-keymap)))
               (set-keymap-parent root tail)
               (dotimes (_ 70)
                 (let ((next (make-sparse-keymap)))
                   (set-keymap-parent tail next) (setq tail next)))
               (set-keymap-parent tail root))
             'error '("Cyclic keymap inheritance"))
(qa (let ((m (make-sparse-keymap)))
      (define-key m "a" 'foo)
      (suppress-keymap m)
      (list (lookup-key m "a") (lookup-key m "1")
            (lookup-key m "-") (lookup-key m [remap self-insert-command])))
    '(foo digit-argument negative-argument undefined))
(qa (let ((m (make-sparse-keymap)))
      (list (suppress-keymap m t) (lookup-key m "1")
            (lookup-key m [remap self-insert-command]))) '(t nil undefined))

(qa (with-temp-buffer (insert "abcde") (narrow-to-region 2 4)
      (goto-char 2) (insert-before-markers "X")
      (list (point-min) (point-max) (buffer-string))) '(2 5 "Xbc"))
(qa (with-temp-buffer (insert "abcdef") (transpose-regions 3 1 7 5)
      (buffer-string)) "efcdab")
(qa-err-data (with-temp-buffer (insert "abcde") (transpose-regions 1 4 3 5))
             'error '("Transposed regions overlap"))
(qa (with-temp-buffer (insert "abc") (subst-char-in-region 4 1 ?a ?A)
      (buffer-string)) "Abc")
(qa (with-temp-buffer (insert "a\nbb\nccc") (goto-char 4)
      (move-beginning-of-line 99) (point)) 6)
(qa (with-temp-buffer (insert "a\nbb\nccc") (goto-char 4)
      (move-end-of-line 0) (point)) 2)
(qa (progn (set-match-data '(0 1 99)) (match-data)) '(0 1))

(qa-err-data (string-match "a\\{99999999999999999999999999999999999\\}" "a")
             'invalid-regexp '("Invalid content of \\{\\}"))
(qa-err-data (string-match "a\\{2,1\\}" "a")
             'invalid-regexp '("Invalid content of \\{\\}"))
(qa-err-data (string-match "a\\{1," "a") 'invalid-regexp '("Unmatched \\{"))
(qa-err-data (string-match "a\\{x" "a")
             'invalid-regexp '("Invalid content of \\{\\}"))
(qa-err-data (string-match "[" "a") 'invalid-regexp '("Unmatched [ or [^"))
(qa-err-data (string-match "\\(" "a") 'invalid-regexp '("Unmatched ( or \\("))
(qa-err-data (string-match "\\)" "a") 'invalid-regexp '("Unmatched ) or \\)"))
(qa-err-data (string-match "\\" "a") 'invalid-regexp '("Trailing backslash"))
(qa (string-match "[[:bad]]" "b]") 0)
(qa (string-match "\\{1\\}" "a") nil)
(qa (progn (string-match "a\\{\\}" "aaaa") (match-end 0)) 0)
(qa (progn (string-match "a\\{,\\}" "aaaa") (match-end 0)) 4)
(qa (progn (string-match "a\\{,2\\}" "aaaa") (match-end 0)) 2)
(qa-err-data (read-from-string "#|") 'invalid-read-syntax '("#|"))
(qa-err-data (read-from-string "#12") 'invalid-read-syntax '("#12"))
(qa-err-data (read-from-string "#9#") 'invalid-read-syntax '("#9#"))

(princ (qa--done))
