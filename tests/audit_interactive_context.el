;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "interactive:direct-'any" '(funcall-interactively (lambda () (called-interactively-p 'any))))
(audit-check "interactive:helper-'any" '(funcall-interactively (lambda () (funcall (lambda () (called-interactively-p 'any))))))
(audit-check "interactive:direct-'interactive" '(funcall-interactively (lambda () (called-interactively-p 'interactive))))
(audit-check "interactive:helper-'interactive" '(funcall-interactively (lambda () (funcall (lambda () (called-interactively-p 'interactive))))))
(audit-check "interactive:direct-'bogus" '(funcall-interactively (lambda () (called-interactively-p 'bogus))))
(audit-check "interactive:helper-'bogus" '(funcall-interactively (lambda () (funcall (lambda () (called-interactively-p 'bogus))))))
(audit-check "interactive:direct-nil" '(funcall-interactively (lambda () (called-interactively-p nil))))
(audit-check "interactive:helper-nil" '(funcall-interactively (lambda () (funcall (lambda () (called-interactively-p nil))))))
(audit-check "interactive:call-interactively-batch" '(call-interactively (lambda () (interactive) (list (called-interactively-p 'any) (called-interactively-p 'interactive)))))
(audit-check "interactive:apply-helper" '(funcall-interactively (lambda () (apply (lambda (&rest _) (called-interactively-p 'any)) '(1)))))
(audit-check "interactive:error-restores" '(progn (condition-case nil (funcall-interactively (lambda () (error "stop"))) (error nil)) (called-interactively-p 'any)))
(audit-check "interactive:bytecompiled-helper" '(let ((f (byte-compile (lambda () (called-interactively-p 'any))))) (funcall-interactively (lambda () (funcall f)))))
(audit-check "handler:all-observers" '(let ((seen nil)) (condition-case nil (handler-bind ((error (lambda (_) (push 1 seen))) (error (lambda (_) (push 2 seen)))) (error "x")) (error nil)) (nreverse seen)))
(audit-check "handler:nested-observers" '(let ((seen nil)) (condition-case nil (handler-bind ((error (lambda (_) (push 'outer seen)))) (handler-bind ((error (lambda (_) (push 'inner seen)))) (error "x"))) (error nil)) (nreverse seen)))
(audit-check "handler:nonlocal-exit" '(let ((seen nil)) (list (catch 'exit (handler-bind ((error (lambda (_) (push 'handler seen) (throw 'exit 7)))) (unwind-protect (error "x") (push 'cleanup seen)))) (nreverse seen))))
(audit-check "handler:inside-protected-success" '(let ((seen nil)) (handler-bind ((error (lambda (_) (push 'observed seen)))) (condition-case nil (error "x") (error 'caught))) seen))
(audit-check "handler:dynamic-context" '(progn (defvar audit-r2-special 1) (let ((seen nil)) (condition-case nil (handler-bind ((error (lambda (_) (setq seen audit-r2-special)))) (let ((audit-r2-special 2)) (error "x"))) (error nil)) seen)))
(princ "AUDIT-DONE\n")
