;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "hooks:before-change-functions-binding" '(with-temp-buffer (insert "abc") (let* ((seen nil) (before-change-functions (list (lambda (&rest _) (push inhibit-modification-hooks seen))))) (delete-region 2 3) seen)))
(audit-check "hooks:after-change-functions-binding" '(with-temp-buffer (insert "abc") (let* ((seen nil) (after-change-functions (list (lambda (&rest _) (push inhibit-modification-hooks seen))))) (delete-region 2 3) seen)))
(audit-check "hooks:text-mod-delete" '(with-temp-buffer (insert "abc") (let ((seen nil)) (put-text-property 1 4 'modification-hooks (list (lambda (&rest _) (push inhibit-modification-hooks seen)))) (delete-region 2 3) seen)))
(audit-check "hooks:overlay-mod-delete" '(with-temp-buffer (insert "abc") (let ((seen nil) (o (make-overlay 1 4))) (overlay-put o 'modification-hooks (list (lambda (&rest _) (push inhibit-modification-hooks seen)))) (delete-region 2 3) seen)))
(audit-check "hooks:text-mod-insert" '(with-temp-buffer (insert "abc") (let ((seen nil)) (put-text-property 1 4 'modification-hooks (list (lambda (&rest _) (push inhibit-modification-hooks seen)))) (goto-char 2) (insert "X") seen)))
(audit-check "hooks:overlay-mod-insert" '(with-temp-buffer (insert "abc") (let ((seen nil) (o (make-overlay 1 4))) (overlay-put o 'modification-hooks (list (lambda (&rest _) (push inhibit-modification-hooks seen)))) (goto-char 2) (insert "X") seen)))
(audit-check "hooks:text-mod-property" '(with-temp-buffer (insert "abc") (let ((seen nil)) (put-text-property 1 4 'modification-hooks (list (lambda (&rest _) (push inhibit-modification-hooks seen)))) (put-text-property 2 3 'face 'bold) seen)))
(audit-check "hooks:overlay-mod-property" '(with-temp-buffer (insert "abc") (let ((seen nil) (o (make-overlay 1 4))) (overlay-put o 'modification-hooks (list (lambda (&rest _) (push inhibit-modification-hooks seen)))) (put-text-property 2 3 'face 'bold) seen)))
(audit-check "hooks:kill-current-insert" '(let ((b (generate-new-buffer " *audit-hook-kill*"))) (with-current-buffer b (insert "abc") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (kill-buffer (current-buffer)))))) (condition-case e (insert "X") (error (car e)))))))
(audit-check "hooks:insert-prefix-insert" '(with-temp-buffer (insert "abcd") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (save-excursion (goto-char 1) (insert "P")))))) (insert "X") (list (buffer-string) (point)))))
(audit-check "hooks:kill-current-delete" '(let ((b (generate-new-buffer " *audit-hook-kill*"))) (with-current-buffer b (insert "abc") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (kill-buffer (current-buffer)))))) (condition-case e (delete-region 2 3) (error (car e)))))))
(audit-check "hooks:insert-prefix-delete" '(with-temp-buffer (insert "abcd") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (save-excursion (goto-char 1) (insert "P")))))) (delete-region 2 3) (list (buffer-string) (point)))))
(audit-check "hooks:kill-current-property" '(let ((b (generate-new-buffer " *audit-hook-kill*"))) (with-current-buffer b (insert "abc") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (kill-buffer (current-buffer)))))) (condition-case e (put-text-property 2 3 'face 'bold) (error (car e)))))))
(audit-check "hooks:insert-prefix-property" '(with-temp-buffer (insert "abcd") (goto-char 2) (let ((before-change-functions (list (lambda (&rest _) (save-excursion (goto-char 1) (insert "P")))))) (put-text-property 2 3 'face 'bold) (list (buffer-string) (point)))))
(audit-check "hooks:text-mod-recursion" '(with-temp-buffer (insert "abcd") (let ((count 0)) (put-text-property 1 5 'modification-hooks (list (lambda (&rest _) (setq count (1+ count)) (when (= count 1) (delete-region 3 4))))) (delete-region 2 3) (list count (buffer-string)))))
(audit-check "hooks:first-change-buffer" '(with-temp-buffer (insert "abc") (set-buffer-modified-p nil) (let ((seen nil) (first-change-hook (list (lambda () (setq seen inhibit-modification-hooks))))) (insert "x") seen)))
(princ "AUDIT-DONE\n")
