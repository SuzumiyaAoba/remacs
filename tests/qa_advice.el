;; apply/funcall/nadvice — GNU-verified semantics:
;;  #'sym on a symbol yields the symbol itself; `functionp' is nil for
;;  macros and special forms (symbols included). `subrp'/`subr-arity' take
;;  function OBJECTS, not symbols. `defalias'/`defvaralias' refuse cycles
;;  at definition time. Advice on an undefined function does NOT make it
;;  fboundp. :before advice runs newest-first; :after runs oldest-first;
;;  :around nests last-added outermost. Advice on macros runs during
;;  `macroexpand'. `advice-add' is preloaded in GNU (no require needed).
(require 'nadvice)
(require 'cl-lib)

;; == helpers ==
(defvar qadv--log nil)
(defun qadv-id (x) x)
(defun qadv-b1 (x) (push 'b1 qadv--log))
(defun qadv-b2 (x) (push 'b2 qadv--log))
(defun qadv-a1f (&rest _) (push 'a1 qadv--log))
(defun qadv-a2f (&rest _) (push 'a2 qadv--log))
(defun qadv-tick (&rest _) (push 'tick qadv--log))
(defun qadv-r (x) (concat "[" x "]"))
(defun qadv-ara (orig x) (funcall orig (concat "A" x)))
(defun qadv-arb (orig x) (funcall orig (concat "B" x)))
(defun qadv-h (x) (* x 10))
(defun qadv-fa (args) (list (1+ (car args))))
(defun qadv-i (x) (+ x 100))
(defun qadv-neg (x) -1)
(defun qadv-errf () (signal 'arith-error nil))
(defun qadv-boom (x) (signal 'arith-error nil))
(defun qadv-skipper (orig x) 'skip)
(defun qadv-m (x) x)
(defun qadv-af (x) (* x 2))
(defun qadv-1000 (orig x) (+ 1000 (funcall orig x)))
(defun qadv-carad (orig x) (list 'ad (funcall orig x)))
(defun qadv-madv (orig &rest args) '(adviced))
(defun qadv-cmd () (interactive) (called-interactively-p 'any))
(defun qadv-cmd2 () (interactive "P") current-prefix-arg)
(defun qadv-docf (x) "My doc." x)
(cl-defun qadv-cl (a &optional (b 10)) (+ a b))

;; == funcall ==
(qa (funcall 'car '(x)) 'x)
(qa (funcall #'qadv-cl 5) 15)
(qa-err (funcall) 'wrong-number-of-arguments)
(qa-err-data (funcall "abc") 'invalid-function '("abc"))
(qa-err-data (funcall [1 2] 0) 'invalid-function '([1 2]))
(qa-err-data (funcall 'when t 5) 'invalid-function '(when))
(qa-err (funcall 'car) 'wrong-number-of-arguments)
(qa-err-data (funcall 'qadv-undef) 'void-function '(qadv-undef))

;; == apply ==
(qa (apply #'cons '(1 2)) '(1 . 2))
(qa (apply #'list 1 2 '(3 4)) '(1 2 3 4))
(qa (apply #'list 1 '(2) '(3)) '(1 (2) 3))
(qa (apply #'concat "a" '("b")) "ab")
(qa (apply #'apply #'list '((1 2))) '(1 2))
(qa (apply (lambda (a &rest b) (cons a b)) '(1 2)) '(1 2))
(qa (apply #'qadv-cl '(5)) 15)
(qa (apply 'ignore nil) nil)
(qa-err-data (apply #'+ 1) 'wrong-type-argument '(listp 1))
(qa-err-data (apply #'+ '(1 . 2)) 'wrong-type-argument '(listp 2))
(qa-err-data (apply #'list "ab") 'wrong-type-argument '(listp "ab"))
(qa-err-data (apply #'list [1 2]) 'wrong-type-argument '(listp [1 2]))
(qa-err-data (apply #'list) 'wrong-type-argument '(listp list))
(qa-err (apply #'car nil) 'wrong-number-of-arguments)
(qa-err-data (apply #'car '(x)) 'wrong-type-argument '(listp x))
(qa-err-data (apply 5 '(1)) 'invalid-function '(5))
(qa-err-data (apply #'qadv-undef '(1)) 'void-function '(qadv-undef))
(qa-err (apply #'if '(t 1 2)) 'invalid-function)

;; == apply-partially ==
(qa (funcall (apply-partially #'cons 'a) 'b) '(a . b))
(qa (funcall (apply-partially #'+ 10) 1 2) 13)
(qa (funcall (apply-partially #'- 10) 3) 7)

;; == function/subr predicates ==
(qa-same #'car 'car)
(qa (functionp 'car) t)
(qa (functionp (symbol-function 'car)) t)
(qa (functionp 'if) nil)
(qa (functionp 'when) nil)
(qa (functionp '(lambda (x) x)) t)
(qa (functionp '(macro . (lambda (x) x))) nil)
(qa (functionp 'qadv-undef) nil)
(qa (subrp (symbol-function 'car)) t)
(qa (subrp (symbol-function 'if)) t)
(qa (subrp 'car) nil)
(qa (primitive-function-p (symbol-function 'car)) t)
(qa (special-form-p 'if) t)
(qa (special-form-p 'car) nil)
(qa (macrop 'when) t)
(qa (macrop 'if) nil)

;; == subr-arity / subr-name / func-arity ==
(qa (subr-arity (symbol-function 'car)) '(1 . 1))
(qa (subr-arity (symbol-function '+)) '(0 . many))
(qa (subr-arity (symbol-function 'list)) '(0 . many))
(qa (subr-arity (symbol-function 'cons)) '(2 . 2))
(qa (subr-arity (symbol-function 'format)) '(1 . many))
(qa-err (subr-arity 'car) 'wrong-type-argument)
(qa-err (subr-arity (lambda (x) x)) 'wrong-type-argument)
(qa (subr-name (symbol-function 'car)) "car")
(qa-err (subr-name (lambda (x) x)) 'wrong-type-argument)
(qa (func-arity 'car) '(1 . 1))
(qa (func-arity (lambda (a &optional b) (list a b))) '(1 . 2))
(qa (func-arity (lambda (a &rest b) a)) '(1 . many))
(qa (func-arity 'qadv-cl) '(1 . many))
(qa (func-arity 'when) '(1 . many))
(qa-err (func-arity 'qadv-undef) 'void-function)
(qa (help-function-arglist (lambda (a &optional b) (list a b)))
    '(a &optional b))
(qa (help-function-arglist 'car) '(arg1))

;; == commandp / interactivity ==
(qa (commandp '(lambda () (interactive))) t)
(qa (commandp '(lambda ())) nil)
(qa (commandp 'qadv-cmd) t)
(qa (commandp 'qadv-id) nil)
(qa (commandp #'car) nil)
(qa (commandp "abc") t)
(qa (commandp [?a]) t)
(qa (interactive-form 'qadv-cmd) '(interactive nil))
(qa (interactive-form 'qadv-cmd2) '(interactive "P"))
(qa (interactive-form #'car) nil)
(qa (interactive-form '(lambda () (interactive))) '(interactive))
(qa (interactive-form '(lambda ())) nil)
(qa (called-interactively-p 'any) nil)
(qa (interactive-p) nil)

;; == funcall-interactively ==
(qa (funcall-interactively (lambda () 5)) 5)
(qa (funcall-interactively (lambda (x) (list x)) 5) '(5))
(qa (funcall-interactively #'ignore) nil)
(qa (funcall-interactively #'qadv-cmd) t)
(qa (funcall-interactively 'qadv-cmd2) nil)

;; == aliases: defalias / fset / indirect-function ==
(qa (defalias 'qadv-al1 'car) 'qadv-al1)
(defalias 'qadv-al2 'qadv-al1)
(qa-same (indirect-function 'qadv-al2) (symbol-function 'car))
(qa (funcall 'qadv-al2 '(9)) 9)
(qa (apply 'qadv-al2 '((7))) 7)
(qa-err-data (defalias 'qadv-cyc 'qadv-cyc)
             'cyclic-function-indirection '(qadv-cyc))
(defalias 'qadv-c1 'qadv-c2)
(qa-err-data (defalias 'qadv-c2 'qadv-c1)
             'cyclic-function-indirection '(qadv-c2))
(qa (symbol-function 'qadv-c1) 'qadv-c2)
(qa (fboundp 'qadv-c1) t)
(qa (indirect-function 'qadv-c1) nil)
(qa-err-data (funcall 'qadv-c1) 'void-function '(qadv-c1))
(qa (fmakunbound 'qadv-c1) 'qadv-c1)
(qa (fboundp 'qadv-c1) nil)
(qa (symbol-function 'qadv-undef) nil)
(qa (indirect-function 'qadv-undef) nil)
(qa (indirect-function 5) 5)
(qa (fset 'qadv-fs #'car) 'car)
(qa (qadv-fs '(7)) 7)
(qa (defalias 'qadv-l (lambda (x) (* x x))) 'qadv-l)
(qa (funcall 'qadv-l 3) 9)

;; == variable aliases ==
(defvar qadv-v1 42 "v doc")
(defvaralias 'qadv-va 'qadv-v1)
(qa (indirect-variable 'qadv-va) 'qadv-v1)
(qa (indirect-variable 'qadv-v1) 'qadv-v1)
(qa qadv-va 42)
(setq qadv-va 7)
(qa qadv-v1 7)
(qa-err-data (defvaralias 'qadv-vcyc 'qadv-vcyc)
             'cyclic-variable-indirection '(qadv-vcyc))
(defvaralias 'qadv-vdangle 'qadv-novar)
(qa (indirect-variable 'qadv-vdangle) 'qadv-novar)
(qa (boundp 'qadv-vdangle) nil)
(qa (indirect-variable 5) 5)

;; == documentation / function props ==
(qa (documentation 'qadv-docf) "My doc.")
(qa (stringp (documentation 'car)) t)
(qa (stringp (documentation 'when)) t)
(qa (documentation-property 'qadv-v1 'variable-documentation) "v doc")
(qa (documentation-property 'qadv-docf 'no-such-prop) nil)
(qa-err-data (documentation 'qadv-undef) 'void-function '(qadv-undef))
(put 'qadv-sym 'qadv-prop 'hello)
(qa (function-get 'qadv-sym 'qadv-prop) 'hello)
(qa (function-get 'qadv-sym 'missing-prop) nil)
(qa (function-put 'qadv-sym 'qadv-prop 'bye) 'bye)
(qa (function-get 'car 'pure) nil)

;; == advice: ordering ==
(qa (advice-add 'qadv-id :before #'qadv-b1) nil)
(advice-add 'qadv-id :before #'qadv-b2)
(let ((qadv--log nil))
  (qadv-id 0)
  (qa qadv--log '(b1 b2)))
(advice-remove 'qadv-id #'qadv-b1)
(advice-remove 'qadv-id #'qadv-b2)
(let ((qadv--log nil))
  (advice-add 'qadv-id :after #'qadv-a1f)
  (advice-add 'qadv-id :after #'qadv-a2f)
  (qadv-id 0)
  (qa qadv--log '(a2 a1)))
(advice-remove 'qadv-id #'qadv-a1f)
(advice-remove 'qadv-id #'qadv-a2f)
(advice-add 'qadv-r :around #'qadv-ara)
(advice-add 'qadv-r :around #'qadv-arb)
(qa (qadv-r "x") "[ABx]")
(advice-remove 'qadv-r #'qadv-arb)
(qa (qadv-r "x") "[Ax]")
(advice-remove 'qadv-r #'qadv-ara)
(qa (qadv-r "x") "[x]")

;; == advice: filter-args / filter-return / override ==
(advice-add 'qadv-h :filter-args #'qadv-fa)
(advice-add 'qadv-h :filter-return #'1+)
(qa (qadv-h 3) 41)
(qa (not (null (advice-member-p #'1+ 'qadv-h))) t)
(qa (advice-member-p #'1- 'qadv-h) nil)
(advice-remove 'qadv-h #'qadv-fa)
(advice-remove 'qadv-h #'1+)
(advice-add 'qadv-i :override #'qadv-neg)
(qa (qadv-i 5) -1)
(advice-remove 'qadv-i #'qadv-neg)
(advice-add 'qadv-errf :override #'ignore)
(qa (qadv-errf) nil)
(advice-remove 'qadv-errf #'ignore)
(qa-err (qadv-errf) 'arith-error)

;; == advice: errors, edge cases ==
(defun qadv-e (x) x)
(advice-add 'qadv-e :before #'qadv-boom)
(qa-err (qadv-e 3) 'arith-error)
(advice-remove 'qadv-e #'qadv-boom)
(advice-add 'qadv-e :around #'qadv-skipper)
(qa (qadv-e 3) 'skip)
(advice-remove 'qadv-e #'qadv-skipper)
(qa-err-data (advice-add 'qadv-id :bogus #'ignore)
             'error '("Unknown add-function location ‘:bogus’"))
;; adding advice to a void function does not define it
(qa (advice-add 'qadv-undef2 :around #'qadv-skipper) nil)
(qa (fboundp 'qadv-undef2) nil)
(qa-err-data (qadv-undef2 1) 'void-function '(qadv-undef2))
;; same function added twice counts once
(defun qadv-dupf () nil)
(let ((qadv--log nil))
  (advice-add 'qadv-dupf :before #'qadv-tick)
  (advice-add 'qadv-dupf :before #'qadv-tick)
  (qadv-dupf)
  (qa qadv--log '(tick)))
(qa (advice-remove 'qadv-dupf #'ignore) nil)
;; advice on a subr works
(advice-add 'car :around #'qadv-carad)
(qa (car '(1 2)) '(ad 1))
(advice-remove 'car #'qadv-carad)
(qa (car '(1 2)) 1)
;; advice on a macro runs during macroexpand
(advice-add 'when :around #'qadv-madv)
(qa (macroexpand '(when t 5)) '(adviced))
(advice-remove 'when #'qadv-madv)
(qa (macroexpand '(when t 5)) '(if t (progn 5)))

;; == advice: membership / mapc / names ==
(advice-add 'qadv-m :before #'ignore '((name . ign)))
(qa (not (null (advice-member-p 'ign 'qadv-m))) t)
(qa (not (null (advice-member-p #'ignore 'qadv-m))) t)
(qa (advice-function-member-p #'ignore 'qadv-m) nil)
(qa (not (null (advice-function-member-p
                #'ignore (symbol-function 'qadv-m))))
    t)
(let ((n 0))
  (advice-function-mapc (lambda (f p) (setq n (1+ n)))
                        (symbol-function 'qadv-m))
  (qa n 1))
(advice-remove 'qadv-m 'ign)
(qa (advice-member-p 'ign 'qadv-m) nil)
(qa (advice-member-p #'ignore 'qadv-m) nil)

;; == add-function / remove-function on symbol-function place ==
(add-function :around (symbol-function 'qadv-af) #'qadv-1000)
(qa (qadv-af 5) 1010)
(remove-function (symbol-function 'qadv-af) #'qadv-1000)
(qa (qadv-af 5) 10)
(let ((qadv--log nil))
  (add-function :before (symbol-function 'qadv-af) #'qadv-tick)
  (qadv-af 5)
  (qa qadv--log '(tick)))
(remove-function (symbol-function 'qadv-af) #'qadv-tick)

(princ (qa--done))
