;;; -*- lexical-binding: t; -*-
;; Default obarrays are Lisp bindings, not the fixed initial table.
(qa (let* ((initial obarray) (table (obarray-make))
           (symbol (let ((obarray table)) (intern "qa-obarray-default"))))
      (list (eq symbol (intern-soft "qa-obarray-default" table))
            (intern-soft "qa-obarray-default" initial))) '(t nil))
(qa (let* ((initial obarray) (table (obarray-make))
           (symbol (let ((obarray table)) (read "qa-obarray-read"))))
      (list (eq symbol (intern-soft "qa-obarray-read" table))
            (intern-soft "qa-obarray-read" initial))) '(t nil))
(qa (let ((obarray (obarray-make)))
      (let ((value (read "nil")))
        (list (null value) (eq value (intern-soft "nil")) (boundp value)))) '(nil t nil))
(qa (let ((obarray (obarray-make)))
      (let ((value (read "nil"))) (set value 17) (symbol-value value))) 17)
(qa (let ((obarray (obarray-make)))
      (let ((value (read "t"))) (list (eq value t) (boundp value)))) '(nil nil))
(qa (let ((obarray (obarray-make)))
      (let ((value (read ":qa-custom-keyword")))
        (list (keywordp value) (boundp value)))) '(nil nil))
(qa (let ((obarray (obarray-make)))
      (let ((first (read "##"))) (eq first (intern "")))) t)
(qa (let* ((table (obarray-make)) (obarray table) (names nil))
      (intern "qa-b") (intern "qa-a")
      (mapatoms (lambda (symbol) (push (symbol-name symbol) names)))
      (sort names #'string-lessp)) '("qa-a" "qa-b"))
(qa (let* ((obarray (obarray-make)) (symbol (intern "qa-remove")))
      (list (eq (intern-soft "qa-remove" nil) symbol)
            (unintern symbol nil) (intern-soft "qa-remove"))) '(t t nil))
(qa (intern-soft (make-symbol "car")) nil)
(qa (let* ((symbols-with-pos-enabled t)
           (value (read-positioning-symbols "qa-intern-position")))
      (condition-case error (intern value)
        (error (list (car error) (cadr error) (bare-symbol-p (caddr error))
                     (eq (caddr error) (bare-symbol value))))))
    '(wrong-type-argument stringp nil t))
(qa (let* ((table (obarray-make)) (symbol (intern "qa-twin" table)))
      (list (intern-soft (make-symbol "qa-twin") table)
            (eq (intern-soft symbol table) symbol))) '(nil t))
(qa (let ((table (obarray-make)))
      (intern "qa-twin" table)
      (list (unintern (make-symbol "qa-twin") table)
            (symbolp (intern-soft "qa-twin" table)))) '(nil t))
(qa (let* ((symbol (intern "qa-uninterned-enumeration")) (seen nil))
      (unintern symbol nil)
      (mapatoms (lambda (value) (when (eq value symbol) (setq seen t)))) seen) nil)
(qa (let ((symbol (intern ":qa-removed-keyword")))
      (unintern symbol nil) (keywordp symbol)) nil)

(qa-err-data (let ((obarray nil)) (intern 17)) 'wrong-type-argument '(obarrayp nil))
(qa-err-data (let ((obarray 17)) (intern-soft "name")) 'wrong-type-argument '(obarrayp 17))
(qa-err-data (let ((obarray 17)) (unintern nil nil)) 'wrong-type-argument '(obarrayp 17))
(qa-err-data (let ((obarray 17)) (mapatoms #'ignore)) 'wrong-type-argument '(obarrayp 17))
(qa-err-data (let ((obarray 17)) (read "nil")) 'wrong-type-argument '(obarrayp 17))
(qa (let ((obarray 17)) (read "42")) 42)
(qa (let ((obarray 17)) (symbol-name (read "#:nil"))) "nil")
(qa-err-data (let ((obarray 17)) (read "#_nil")) 'wrong-type-argument '(obarrayp 17))
(qa-err-data (internal--obarray-buckets nil) 'wrong-type-argument '(obarrayp nil))

;; Storage bytes distinguish byte8 names from their one-byte counterparts.
(qa (let* ((byte-name (concat "qa-ob-byte-name-" (unibyte-string 255)))
           (multi-name (concat "qa-ob-byte-name-" (string #x3fffff)))
           (byte (intern byte-name)) (multi (intern multi-name)))
      (list (eq byte multi) (eq (symbol-name byte) byte-name)
            (eq (symbol-name multi) multi-name)
            (eq (intern-soft byte-name) byte) (eq (intern-soft multi-name) multi)))
    '(nil t t t t))
(qa (let* ((table (obarray-make)) (byte-name (unibyte-string 255))
           (multi-name (string #x3fffff))
           (byte (intern byte-name table)) (multi (intern multi-name table)))
      (list (eq byte multi) (unintern byte table)
            (eq (intern-soft multi-name table) multi) (intern-soft byte-name table)))
    '(nil t t nil))
(qa (let ((obarray (obarray-make)))
      (let ((bytes (number-sequence 128 255)))
        (mapcar (lambda (byte)
                  (let ((one (intern (unibyte-string byte)))
                        (two (intern (string (+ #x3fff00 byte)))))
                    (eq one two))) bytes))) (make-list 128 nil))
(princ (qa--done)) (terpri)
