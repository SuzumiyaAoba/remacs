;;; qa_sqlite_directory.el --- Resolve database filenames in the buffer directory -*- lexical-binding: t; -*-
(defun qa350-open (kind)
  (let* ((root (make-temp-file "qa350-root-" t))
         (base (concat (file-name-nondirectory root) ".sqlite"))
         (original default-directory)
         (filename (pcase kind
                     ('absolute (expand-file-name base root))
                     ('dot (concat "./" base))
                     ('sub (concat "sub/" base))
                     ('empty "")
                     ('memory nil)
                     ('literal-memory ":memory:")
                     (_ base)))
         (wanted (and filename (expand-file-name filename root)))
         (unwanted (and (memq kind '(relative dot sub readonly))
                        (expand-file-name filename original)))
         database unwanted-owned)
    (unwind-protect
        (progn
          ;; A failed regression may create only this new, unique basename.
          (when (and unwanted (file-exists-p unwanted))
            (error "Unexpected existing test database"))
          (setq unwanted-owned t)
          (make-directory (expand-file-name "sub" root))
          (when (eq kind 'readonly)
            (let ((seed (sqlite-open wanted))) (sqlite-close seed)))
          (let ((default-directory (file-name-as-directory root)))
            (setq database (sqlite-open filename (eq kind 'readonly))))
          (list (sqlitep database)
                (and wanted (file-regular-p wanted))
                (and unwanted (file-exists-p unwanted))
                (and database (caar (sqlite-select database "select 1")))))
      (when database (sqlite-close database))
      (when (and unwanted-owned unwanted (file-exists-p unwanted))
        (delete-file unwanted))
      (delete-directory root t))))

(qa (qa350-open 'relative) '(t t nil 1))
(qa (qa350-open 'dot) '(t t nil 1))
(qa (qa350-open 'sub) '(t t nil 1))
(qa (qa350-open 'absolute) '(t t nil 1))
(qa (qa350-open 'readonly) '(t t nil 1))
(qa (qa350-open 'empty) '(nil nil nil nil))
(qa (qa350-open 'memory) '(t nil nil 1))
;; Only nil selects GNU's in-memory database; a string is a filename.
(qa (qa350-open 'literal-memory) '(t t nil 1))
(qa-err-data (sqlite-open 42) 'wrong-type-argument '(stringp 42))
(qa-err-data (sqlite-open t) 'wrong-type-argument '(stringp t))
(qa-err-data (sqlite-open []) 'wrong-type-argument '(stringp []))
(princ (qa--done))
