;; Bounds precede character validation; index validation precedes ARRAY.
(qa-err-data (aset "é" 1 -1) 'args-out-of-range '("é" 1))
(qa-err-data (aset "é" -1 4294967361) 'args-out-of-range '("é" -1))
(qa-err-data (aset nil 1.0 nil) 'wrong-type-argument '(fixnump 1.0))
(qa-err-data (aset nil 0 nil) 'wrong-type-argument '(arrayp nil))
;; Partial store-substring writes keep properties and byte representation.
(qa (let* ((payload (list 'shared))
           (string (propertize (string-as-multibyte "abc") 'payload payload))
           (result (condition-case err (store-substring string 0 "xé")
                     (error (list (car err) (cadr err))))))
      (list result (string-to-list string) (multibyte-string-p string)
            (eq (get-text-property 0 'payload string) payload)
            (eq (get-text-property 1 'payload string) payload)))
    '((error "Attempt to store non-ASCII char into multibyte string") (120 98 99) t t t))
(qa (let* ((string (propertize (string-as-multibyte "abc") 'face 'bold))
           (result (aset string 1 ?Z)))
      (list result (string-to-list string) (multibyte-string-p string)
            (object-intervals string)))
    '(90 (97 90 99) t ((0 3 (face bold)))))
;; Exercise the byte-code aset opcode as well as ordinary function calls.
(let ((setter (byte-compile '(lambda (string character) (aset string 0 character)))))
  (qa (let ((string (string-as-multibyte "abc")))
        (list (funcall setter string 65) (string-to-list string)))
      '(65 (65 98 99)))
  (qa-err-data (funcall setter (string-as-multibyte "abc") 4294967361)
               'wrong-type-argument '(characterp 4294967361))
  (qa-err-data (funcall setter (copy-sequence "é") 233)
               'error '("Attempt to store non-ASCII char into multibyte string")))
(princ (qa--done))
