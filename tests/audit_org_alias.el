;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "org-ast:alias" '(progn (require 'org-element-ast) (org-element-deferred-create-alias :raw-value)))
(audit-check "org-ast:direct-control" '(progn (require 'org-element-ast) (org-element-deferred-create nil #'org-element-property-2 :raw-value)))
(audit-check "org-ast:funcall-control" '(progn (require 'org-element-ast) (funcall #'org-element-deferred-create nil #'org-element-property-2 :raw-value)))
(audit-check "org-ast:runtime-alias-control" '(progn (require 'org-element-ast)
 (fset 'org-element-deferred-create-alias (lambda (keyword &optional auto-undefer-p)
   (funcall #'org-element-deferred-create auto-undefer-p #'org-element-property-2 keyword)))
 (org-element-deferred-create-alias :raw-value)))
(audit-check "org-ast:mode-after-alias-control" '(progn (require 'org-element-ast)
 (fset 'org-element-deferred-create-alias (lambda (keyword &optional auto-undefer-p)
   (funcall #'org-element-deferred-create auto-undefer-p #'org-element-property-2 keyword)))
 (with-temp-buffer (org-mode) major-mode)))
(princ "AUDIT-DONE\n")
