;;; -*- lexical-binding: nil; -*-
;; Genuine overlays are opaque, even though their backing store is a vector (#484).
(with-temp-buffer
  (insert "abc")
  (let ((object (make-overlay 1 3)))
    (overlay-put object 'tag 'value)
    (qa (vectorp object) nil)
    (qa (arrayp object) nil)
    (qa (sequencep object) nil)
    (qa (eq (copy-tree object t) object) t)
    (qa (eq (car (copy-tree (list object) t)) object) t)
    (qa (eq (aref (copy-tree (vector object) t) 0) object) t)
    (dolist (form '((length object) (length= object 0) (length< object 0) (length> object 0)
                    (elt object 0) (elt object 'bad) (copy-sequence object) (reverse object)
                    (append object nil) (vconcat object) (concat object)
                    (mapcar #'identity object) (mapc #'identity object)
                    (mapcan #'list object) (mapconcat #'identity object "")
                    (delete 'absent object)))
      (qa-err-data (eval form) 'wrong-type-argument (list 'sequencep object)))
    (dolist (form '((aref object 0) (aset object 0 'corrupt) (fillarray object 'corrupt)
                    (nreverse object) (substring object 0)))
      (qa-err-data (eval form) 'wrong-type-argument (list 'arrayp object)))
    (qa-err-data (aref object 'bad) 'wrong-type-argument '(fixnump bad))
    (qa-err-data (aset object 'bad 'corrupt) 'wrong-type-argument '(fixnump bad))
    (qa-err-data (sort object #'<) 'wrong-type-argument (list 'list-or-vector-p object))
    (qa-err-data (funcall #[257 "\107\207" [] 1] object)
                 'wrong-type-argument (list 'sequencep object))
    (qa-err-data (funcall #[257 "\300\110\207" [0] 2] object)
                 'wrong-type-argument (list 'arrayp object))
    (qa-err-data (funcall #[257 "\300\234\207" [0] 2] object)
                 'wrong-type-argument (list 'sequencep object))
    (qa (length= object -1) nil)
    (qa (eq (append object) object) t)
    (qa (eq (cdr (append '(head) object)) object) t)
    (qa (overlayp object) t)
    (qa (overlay-start object) 1)
    (qa (overlay-end object) 3)
    (qa (overlay-get object 'tag) 'value)
    (delete-overlay object)
    (qa (overlayp object) t)
    (qa (vectorp object) nil)
    (qa (sequencep object) nil)
    (qa-err-data (length object) 'wrong-type-argument (list 'sequencep object))))
;; A vector that resembles a handle remains an ordinary vector.
(let ((object (vector 'overlay 0 0)))
  (qa (vectorp object) t)
  (qa (arrayp object) t)
  (qa (sequencep object) t)
  (qa (overlayp object) nil)
  (qa (length object) 3)
  (qa (aref object 0) 'overlay)
  (qa (eq (copy-tree object t) object) nil))
(princ (qa--done))
