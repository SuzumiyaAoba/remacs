(time-convert 1000000 'list)
(time-add '(1 2) '(3 4))
(time-subtract '(5 6) '(1 2))
(current-time)
(float-time '(100 200 300 0))
(float-time '(ticks . hz))
(condition-case e (float-time "x") (error e))
(secure-hash 'md5 "abc")
(secure-hash 'sha1 "abc")
(secure-hash 'sha256 "abc" nil nil t)
(secure-hash 'sha512 '(1 2))
(condition-case e (secure-hash 'bogus "x") (error e))
(help-function-arglist 'car)
(help-function-arglist 'when)
(help-function-arglist '(lambda (a &optional b) a))
(bool-vector-not (bool-vector t nil t))
(bool-vector-count-population (bool-vector t nil t))
(bool-vector-subsetp (bool-vector t nil) (bool-vector t t))
(bool-vector-count-consecutive (bool-vector t nil) 0 nil)
(bool-vector-count-consecutive (bool-vector t nil) 0 t)
(read--expression "P: " "(1 2 3)")
(condition-case e (read--expression "P: ") (error e))
(map-keymap (lambda (k v) (list k v)) global-map)
(map-keymap 'ignore (make-keymap))
(coding-system-eol-type 'utf-8)
(coding-system-eol-type 'utf-8-unix)
(coding-system-plist 'utf-8)
(coding-system-get 'utf-8 :name)
(coding-system-get 'utf-8 :coding-type)
(pos-visible-in-window-p)
(pos-visible-in-window-p 1)
(pos-visible-in-window-p 1 nil t)
(window-normalize-buffer (current-buffer))
(window-normalize-frame (selected-frame))
(condition-case e (window-normalize-buffer "x") (error e))
(event-basic-type 'C-M-S-f)
(event-modifiers 'C-M-S-f)
(listify-key-sequence "ab")
(listify-key-sequence (kbd "C-f M-x"))
(not-modified)
;; `suspend-tty' signals in batch (GNU: "Attempt to suspend a non-text
;; terminal device"); exercise it under condition-case.
(condition-case e (suspend-tty) (error e))
;; `resume-tty' likewise signals in batch ("Attempt to resume a
;; non-text terminal device").
(condition-case e (resume-tty) (error e))
(internal-timer-start-idle)
