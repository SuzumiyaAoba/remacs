  (char-table-subtype ct)
  (char-table-parent ct)
  (set-char-table-parent ct nil)
  (char-table-extra-slot ct 0)
  (set-char-table-extra-slot ct 0 'extra)
  (char-table-extra-slot ct 0)
  (char-table-range ct ?a)
  (set-char-table-range ct ?a 'va)
  (char-table-range ct ?a)
  (set-char-table-range ct '(?a . ?z) 'az)
  (char-table-range ct ?m)
  (set-char-table-range ct t 'all)
