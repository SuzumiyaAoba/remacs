;;; -*- lexical-binding: nil; -*-
;; Issue #9. Parser results verified with GNU Emacs 31.1 -Q.
;;; -*- lexical-binding: nil; -*-
(defun qa9-result (pattern method)
  (with-syntax-table (standard-syntax-table)
    (let ((case-fold-search nil))
      (condition-case err
          (list 'ok (funcall method pattern "abc{1}"))
        (error err)))))
(defun qa9-buffer-result (pattern method)
  (with-temp-buffer
    (insert "abc{1}")
    (goto-char (if (eq method 're-search-backward) (point-max) (point-min)))
    (condition-case err
        (progn
          (if (eq method 'looking-at)
              (looking-at pattern)
            (funcall method pattern nil t))
          '(ok))
      (error err))))

