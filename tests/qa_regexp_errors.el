  (let ((pattern (car case)) (expected (cadr case)))
    (dolist (method '(string-match string-match-p posix-string-match))
      (qa (list pattern method (qa9-result pattern method))
          (list pattern method expected)))
    (when (eq (car expected) 'invalid-regexp)
      (dolist (method '(looking-at re-search-forward re-search-backward))
        (qa (list pattern method (qa9-buffer-result pattern method))
            (list pattern method expected))))))
;; Valid explicit numbers are not clamped to an unrelated capture slot.
(qa (progn (string-match "\\(?64:a\\)" "a") (match-string 64 "a")) "a")
(qa (progn (string-match "\\(?255:a\\)" "a") (match-string 255 "a")) "a")
(qa (progn (string-match "\\(?256:a\\)" "a") (match-string 256 "a")) nil)
