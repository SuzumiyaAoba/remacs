;;; -*- lexical-binding: t; -*-
(qa (let ((read-symbol-shorthands '(("qa-short-" . "qa-long-"))))
      (mapcar (lambda (source) (symbol-name (read source)))
              '("qa-short-name" "#_qa-short-name" "#:qa-short-name")))
    '("qa-long-name" "qa-short-name" "qa-short-name"))
(qa (let ((read-symbol-shorthands '(("qa-" . "long-") ("qa-short-" . "specific-"))))
      (symbol-name (read "qa-short-name"))) "long-short-name")
(qa (let ((read-symbol-shorthands '(("qa-short-" . "qa-long-") ("qa-long-" . "again-"))))
      (symbol-name (read "qa-short-name"))) "qa-long-name")
(qa (let ((read-symbol-shorthands '(17 ("qa-short-" . 19) (20 . "bad")
                                   ("qa-short-" . "qa-valid-"))))
      (symbol-name (read "qa-short-name"))) "qa-valid-name")
(qa (let ((read-symbol-shorthands '(("qa-short-" . "qa-dotted-") . 19)))
      (symbol-name (intern "qa-short-name"))) "qa-dotted-name")
(qa (let ((read-symbol-shorthands 17)) (symbol-name (read "qa-unchanged"))) "qa-unchanged")
(qa (let* ((rules (list '("other-" . "none-"))) (read-symbol-shorthands rules))
      (setcdr rules rules) (symbol-name (read "qa-unchanged"))) "qa-unchanged")
(qa (let* ((rules (list 17 '("qa-short-" . "qa-cycle-"))) (read-symbol-shorthands rules))
      (setcdr (cdr rules) rules) (symbol-name (intern "qa-short-name"))) "qa-cycle-name")
(qa (let ((read-symbol-shorthands '(("nil" . "qa-moved-nil"))))
      (list (symbol-name (read "nil")) (null (read "#_nil")))) '("qa-moved-nil" t))
(qa (let ((read-symbol-shorthands '(("1" . "one"))))
      (list (read "123") (symbol-name (read "\\123")))) '(123 "one23"))
(qa (let ((read-symbol-shorthands '(("" . "qa-every-"))))
      (mapcar (lambda (source) (symbol-name (read source)))
              '("+" "--" "/=" "x" "#_x" "##" "#_" "#:")))
    '("+" "--" "/=" "qa-every-x" "x" "qa-every-" "qa-every-" ""))
(qa (let ((read-symbol-shorthands '(("+" . "qa-plus-"))))
      (list (symbol-name (read "+")) (symbol-name (intern "+")))) '("+" "qa-plus-"))
(qa (let ((read-symbol-shorthands '(("日-" . "本-"))))
      (symbol-name (read "日-name"))) "本-name")
(qa (let* ((name (concat (string #x3fffff) "-x"))
           (read-symbol-shorthands (list (cons (string #x3fffff) "qa-byte"))))
      (symbol-name (read name))) "qa-byte-x")
(qa (let* ((prefix (string #xd800))
           (read-symbol-shorthands (list (cons prefix "qa-surrogate-"))))
      (symbol-name (intern (concat prefix "x")))) "qa-surrogate-x")
(qa (let ((obarray (obarray-make)) (read-symbol-shorthands '(("s-" . "l-"))))
      (let ((name (symbol-name (intern "s-x"))))
        (list (multibyte-string-p name) (string-to-list name)))) '(t (108 45 120)))
(qa (let ((obarray (obarray-make)) (read-symbol-shorthands '(("s-" . "l-"))))
      (let ((name (symbol-name (read "s-x"))))
        (list (multibyte-string-p name) (string-to-list name)))) '(nil (108 45 120)))
(qa (let* ((obarray (obarray-make))
           (read-symbol-shorthands '(("s-" . "l-")))
           (name (symbol-name (read (concat "s-" (unibyte-string 255))))))
      (list (multibyte-string-p name) (string-to-list name))) '(nil (108 45 255)))
(qa (let* ((obarray (obarray-make)) (tag (list 'tag))
           (input (propertize "s-x" 'qa-tag tag))
           (read-symbol-shorthands '(("s-" . "l-")))
           (name (symbol-name (intern input))))
      (list (eq name input) (text-properties-at 0 name))) '(nil nil))
(qa (let* ((table (obarray-make)) (target (intern "qa-long-name" table))
           (read-symbol-shorthands '(("qa-short-" . "qa-long-"))))
      (list (eq (intern-soft "qa-short-name" table) target)
            (intern-soft (make-symbol "qa-short-name") table)
            (eq (intern-soft target table) target))) '(t nil t))
(qa (let* ((table (obarray-make)) (target (intern "qa-long-name" table))
           (read-symbol-shorthands '(("qa-short-" . "qa-long-"))))
      (list (unintern "qa-short-name" table) (intern-soft target table))) '(t nil))
(qa (let* ((table (obarray-make)) (target (intern "qa-short-name" table))
           (read-symbol-shorthands '(("qa-short-" . "qa-long-"))))
      (list (eq (intern-soft target table) target) (unintern target table))) '(t t))
(qa (let ((symbols-with-pos-enabled nil)
          (read-symbol-shorthands '(("s-" . "long-"))))
      (let ((value (read-positioning-symbols "(s-x #_s-x #:s-x)")))
        (list (mapcar (lambda (s) (symbol-name (bare-symbol s))) value)
              (mapcar #'symbol-with-pos-pos value))))
    '(("long-x" "s-x" "s-x") (1 7 13)))
(princ (qa--done)) (terpri)
