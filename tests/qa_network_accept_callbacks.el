;;; -*- lexical-binding: t; -*-
(defvar qa219-events nil)
(defvar qa219-peer nil)
(defvar qa219-mode nil)
(defun qa219-sent (p message) (push (list 'sent p (process-status p) message) qa219-events))
(defun qa219-new-filter (p text) (push (list 'new-filter p (process-status p) text) qa219-events))
(defun qa219-new-sent (p message) (push (list 'new-sent p (process-status p) message) qa219-events))
(defun qa219-filter (p text) (push (list 'filter p (process-status p) text) qa219-events))
(defun qa219-log (server peer message)
  (setq qa219-peer peer)
  (push (list 'log peer (process-status peer) message) qa219-events)
  (cond ((eq qa219-mode 'filter) (set-process-filter peer #'qa219-new-filter) (accept-process-output peer 0.03 nil t))
        ((eq qa219-mode 'sentinel-nil) (set-process-sentinel peer nil))
        ((eq qa219-mode 'server-sentinel) (set-process-sentinel server #'qa219-new-sent))
        ((eq qa219-mode 'replace) (set-process-sentinel peer #'qa219-new-sent))
        ((eq qa219-mode 'delete-peer) (delete-process peer))
        ((eq qa219-mode 'delete-server) (delete-process server))
        ((eq qa219-mode 'read) (accept-process-output peer 0.03 nil t))
        ((eq qa219-mode 'error) (error "qa219-log-error"))))
(defun qa219-alt-log (server peer message)
  (qa219-log server peer message)
  (push (list 'changed peer (process-status peer) message) qa219-events))
(defun qa219-case (local mode &optional ipv6)
  (let ((before (process-list)) server client (qa219-peer nil) (qa219-events nil) (qa219-mode mode)
        (path (and local (make-temp-name (expand-file-name "qa219-" temporary-file-directory)))))
    (unwind-protect
        (progn
          (setq server (apply #'make-network-process
                              (append (list :name "qa219-server" :server t :coding 'binary :noquery t
                                            :log (unless (eq mode 'no-log) #'qa219-log) :sentinel #'qa219-sent :filter #'qa219-filter)
                                      (if local (list :family 'local :service path) (if ipv6 '(:host "::1" :family ipv6 :service 0) '(:host "127.0.0.1" :service 0))))))
          (when (eq mode 'contact)
            (let ((contact (process-contact server t)))
              (setcar (cdr (memq :log contact)) #'qa219-alt-log)))
          (setq client (apply #'make-network-process
                              (append (list :name "qa219-client" :coding 'binary :noquery t :sentinel #'ignore :filter #'ignore)
                                      (if local (list :family 'local :service path) (list :host (if ipv6 "::1" "127.0.0.1") :family (if ipv6 'ipv6 'ipv4) :service (process-contact server :service))))))
          (when (memq mode '(read filter)) (process-send-string client "DATA"))
          (let ((deadline (+ (float-time) 2)))
            (while (and (not qa219-peer) (< (float-time) deadline))
              (condition-case err (accept-process-output nil 0.01)
                (error (push (list 'caught nil nil (car err)) qa219-events)))
              (unless qa219-peer
                (dolist (p (process-list))
                  (when (and (not (memq p before)) (not (eq p server)) (not (eq p client))) (setq qa219-peer p))))))
          (unless qa219-peer (error "No accepted callback-test peer"))
          (when (eq mode 'error)
            (process-send-string client "AFTER")
            (accept-process-output qa219-peer 0.03 nil t))
          (mapcar (lambda (event) (list (car event) (eq (nth 1 event) server) (eq (nth 1 event) qa219-peer) (nth 2 event) (nth 3 event)))
                  (reverse qa219-events)))
      (dolist (p (process-list)) (unless (memq p before) (ignore-errors (delete-process p))))
      (when (and path (file-exists-p path)) (delete-file path)))))

(qa (qa219-case nil 'normal)
    '((log nil t open "accept from 127.0.0.1\n") (sent nil t open "open from 127.0.0.1\n")))
(qa (qa219-case t 'normal)
    '((log nil t open "accept from -\n") (sent nil t open "open from -\n")))
(qa (qa219-case nil 'replace)
    '((log nil t open "accept from 127.0.0.1\n") (new-sent nil t open "open from 127.0.0.1\n")))
(qa (qa219-case t 'replace)
    '((log nil t open "accept from -\n") (new-sent nil t open "open from -\n")))
(qa (qa219-case nil 'delete-peer)
    '((log nil t open "accept from 127.0.0.1\n") (sent nil t closed "deleted\n")
      (sent nil t closed "open from 127.0.0.1\n")))
(qa (qa219-case t 'delete-peer)
    '((log nil t open "accept from -\n") (sent nil t closed "deleted\n")
      (sent nil t closed "open from -\n")))
(qa (qa219-case nil 'delete-server)
    '((log nil t open "accept from 127.0.0.1\n") (sent t nil closed "deleted\n")
      (sent nil t open "open from 127.0.0.1\n")))
(qa (qa219-case t 'delete-server)
    '((log nil t open "accept from -\n") (sent t nil closed "deleted\n")
      (sent nil t open "open from -\n")))
(qa (qa219-case nil 'read)
    '((log nil t open "accept from 127.0.0.1\n") (filter nil t open "DATA")
      (sent nil t open "open from 127.0.0.1\n")))
(qa (qa219-case t 'read)
    '((log nil t open "accept from -\n") (filter nil t open "DATA") (sent nil t open "open from -\n")))
(qa (qa219-case nil 'error)
    '((log nil t open "accept from 127.0.0.1\n") (caught nil nil nil error) (filter nil t open "AFTER")))
(qa (qa219-case t 'error)
    '((log nil t open "accept from -\n") (caught nil nil nil error) (filter nil t open "AFTER")))
(qa (qa219-case nil 'no-log) '((sent nil t open "open from 127.0.0.1\n")))
(qa (qa219-case t 'no-log) '((sent nil t open "open from -\n")))
(qa (qa219-case nil 'filter)
    '((log nil t open "accept from 127.0.0.1\n") (new-filter nil t open "DATA")
      (sent nil t open "open from 127.0.0.1\n")))
(qa (qa219-case t 'filter)
    '((log nil t open "accept from -\n") (new-filter nil t open "DATA") (sent nil t open "open from -\n")))
(qa (qa219-case nil 'sentinel-nil) '((log nil t open "accept from 127.0.0.1\n")))
(qa (qa219-case t 'sentinel-nil) '((log nil t open "accept from -\n")))
(qa (qa219-case nil 'server-sentinel)
    '((log nil t open "accept from 127.0.0.1\n") (sent nil t open "open from 127.0.0.1\n")))
(qa (qa219-case t 'server-sentinel)
    '((log nil t open "accept from -\n") (sent nil t open "open from -\n")))
(qa (qa219-case nil 'contact)
    '((log nil t open "accept from 127.0.0.1\n") (sent nil t open "open from 127.0.0.1\n")))
(qa (qa219-case t 'contact)
    '((log nil t open "accept from -\n") (sent nil t open "open from -\n")))
(let ((probe (condition-case nil
                 (make-network-process :name "qa219-ipv6-probe" :server t :host "::1" :family 'ipv6
                                       :service 0 :noquery t :sentinel #'ignore :filter #'ignore)
               (file-error nil))))
  (if probe
      (progn
        (delete-process probe)
        (qa (qa219-case nil 'normal t)
            (let ((host (if (= (byteorder) 108) "0:0:0:0:0:0:0:100" "0:0:0:0:0:0:0:1")))
              (list (list 'log nil t 'open (concat "accept from " host "\n"))
                    (list 'sent nil t 'open (concat "open from " host "\n"))))))
    (princ "SKIP qa219 IPv6: loopback unavailable\n")))
(princ (qa--done)) (terpri)
