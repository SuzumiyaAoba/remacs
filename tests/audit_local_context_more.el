;;; -*- lexical-binding: t; -*-
(load (expand-file-name "audit_helpers.el" (file-name-directory load-file-name)) nil t)
(audit-check "locals-more:kill-all" '(progn (defvar audit-r2-var 1) (with-temp-buffer (setq-local audit-r2-var 10)
   (list (let ((audit-r2-var 20)) (kill-all-local-variables) (list audit-r2-var (local-variable-p 'audit-r2-var)))
         audit-r2-var (local-variable-p 'audit-r2-var)))))
(audit-check "locals-more:recreate" '(progn (defvar audit-r2-var 1) (with-temp-buffer (setq-local audit-r2-var 10)
   (list (let ((audit-r2-var 20)) (kill-local-variable 'audit-r2-var) (setq-local audit-r2-var 30) (list audit-r2-var (local-variable-p 'audit-r2-var)))
         audit-r2-var (local-variable-p 'audit-r2-var)))))
(audit-check "locals-more:default-change" '(progn (defvar audit-r2-var 1) (with-temp-buffer (setq-local audit-r2-var 10)
   (list (let ((audit-r2-var 20)) (kill-local-variable 'audit-r2-var) (set-default 'audit-r2-var 3) (list audit-r2-var (local-variable-p 'audit-r2-var)))
         audit-r2-var (local-variable-p 'audit-r2-var)))))
(audit-check "locals-more:create-during-let" '(progn (defvar audit-r2-var 1) (with-temp-buffer
 (list (let ((audit-r2-var 20)) (setq-local audit-r2-var 30) audit-r2-var)
       audit-r2-var (local-variable-p 'audit-r2-var)))))
(audit-check "locals-more:hook-ordinary-variable" '(with-temp-buffer (setq-local audit-r2-local 10)
 (let ((f (lambda () nil))) (setq-local audit-r2-custom-hook (list f)) (kill-all-local-variables)
 (list (local-variable-p 'audit-r2-custom-hook) (local-variable-p 'audit-r2-local)))))
(audit-check "locals-more:hook-kill-permanent" '(let ((f (make-symbol "audit-r2-permanent"))) (fset f (lambda () nil)) (put f 'permanent-local-hook t)
 (with-temp-buffer (add-hook 'after-save-hook f nil t) (kill-all-local-variables t) (and (memq f after-save-hook) t))))
(princ "AUDIT-DONE\n")
