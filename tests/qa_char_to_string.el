;;; -*- lexical-binding: t; -*-
;; Numeric observations avoid losing surrogate bytes in a UTF-8 log decoder.
(defun qa126-observe (code)
  (let ((string (char-to-string code)))
    (list code (string-to-list string) (length string) (string-bytes string)
          (multibyte-string-p string)
          (string-to-list (string-as-unibyte string))
          (string-to-list (encode-coding-string string 'utf-8)))))
