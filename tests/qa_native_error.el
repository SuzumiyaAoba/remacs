;;; -*- lexical-binding: t; -*-
;; Issue #180: errors must leave a native entry before later forms run.
;; Run with a native-enabled GNU Emacs 31.1 or remacs with a C compiler.
(defvar qa180-directory (make-temp-file "remacs-qa-native-error-" t))
(defvar qa180-serial 0)
(defvar qa180-side nil)
(defvar qa180-trace nil)
(defvar qa180-inner nil)
(defvar qa180-good nil)
(defun qa180-mark (event)
  (setq qa180-trace (append qa180-trace (list event)))
  event)
(defun qa180-outer (&rest values)
  (qa180-mark 'outer)
  values)
(defun qa180-fail () (error "first"))
(defun qa180-handle (function)
  (condition-case err (funcall function) (error (car err))))
(defun qa180-compile (body &optional args)
  (setq qa180-serial (1+ qa180-serial))
  (native-compile
   (eval (cons 'lambda (cons args body)) t)
   (expand-file-name (format "case%d.eln" qa180-serial) qa180-directory)))
(defun qa180-run (body)
  (setq qa180-side nil qa180-trace nil)
  (let* ((function (qa180-compile body))
         (result (condition-case err (list 'ok (funcall function))
                   (error err))))
    (list result qa180-side qa180-trace)))

(unwind-protect
    (let ((user-emacs-directory qa180-directory)
          (native-comp-eln-load-path (list qa180-directory)))
      ;; Require actual compilation: an unavailable compiler must not turn
      ;; this regression into a passing interpreted test.
      (unless (native-comp-available-p)
        (error "qa_native_error requires native compilation"))
      (qa (qa180-run '((error "first") (setq qa180-side t)))
          '((error "first") nil nil))
      (qa (qa180-run '((progn (qa180-fail) (qa180-mark 'late)) 42))
          '((error "first") nil nil))
      ;; An outer call cannot consume an invalid handle, run later arguments,
      ;; or overwrite the first error. Earlier arguments keep their effects.
      (qa (qa180-run '((qa180-outer (qa180-mark 'before)
                                  (qa180-fail) (qa180-mark 'after))))
          '((error "first") nil (before)))
      (qa (qa180-run '((car (qa180-fail))))
          '((error "first") nil nil))
      (qa (qa180-run '((list (qa180-fail) (/ 1 0))))
          '((error "first") nil nil))
      (qa (qa180-run '((car 7) (setq qa180-side t)))
          '((wrong-type-argument listp 7) nil nil))
      (qa (qa180-run '((/ 1 0) (setq qa180-side t)))
          '((arith-error) nil nil))
      (qa (qa180-run '((signal 'error '("first")) (setq qa180-side t)))
          '((error "first") nil nil))
      ;; Both a failed value and a failing assignment stop the sequence.
      (qa (qa180-run '((setq qa180-side (qa180-fail))))
          '((error "first") nil nil))
      (qa (qa180-run '((setq qa180-side 'before
                            qa180-side (qa180-fail)
                            qa180-side 'after)))
          '((error "first") before nil))
      (qa (qa180-run '((setq :qa180-constant 7) (qa180-mark 'late)))
          '((setting-constant :qa180-constant) nil nil))
      ;; Tests, short-circuit forms, and saved values must propagate failure.
      (qa (qa180-run '((if (qa180-fail) (qa180-mark 'then)
                        (qa180-mark 'else))))
          '((error "first") nil nil))
      (qa (qa180-run '((while (qa180-fail) (qa180-mark 'body))
                      (qa180-mark 'late)))
          '((error "first") nil nil))
      (qa (qa180-run '((let ((n 0))
                        (while (< n 2) (setq n (1+ n))
                          (qa180-fail) (qa180-mark 'body)))
                      (qa180-mark 'late)))
          '((error "first") nil nil))
      (qa (qa180-run '((and t (qa180-fail) (qa180-mark 'late))))
          '((error "first") nil nil))
      (qa (qa180-run '((or nil (qa180-fail) (qa180-mark 'late))))
          '((error "first") nil nil))
      (qa (qa180-run '((not (qa180-fail)) (qa180-mark 'late)))
          '((error "first") nil nil))
      (qa (qa180-run '((prog1 (qa180-fail) (qa180-mark 'late))))
          '((error "first") nil nil))
      (qa (qa180-run '((prog1 'saved (qa180-fail) (qa180-mark 'late))))
          '((error "first") nil nil))
      (qa (qa180-run '((let ((a (qa180-fail)) (b (qa180-mark 'late)))
                        (qa180-outer a b))))
          '((error "first") nil nil))
      (qa (qa180-run '((let* ((a (qa180-fail)) (b (qa180-mark 'late)))
                        (qa180-outer a b))))
          '((error "first") nil nil))
      ;; Native -> interpreter -> native must propagate to the right handler.
      ;; Handling an inner error cannot poison the surrounding native call.
      (setq qa180-inner (qa180-compile '((qa180-fail) (qa180-mark 'inner-late))))
      (fset 'qa180-native-inner qa180-inner)
      (qa (native-comp-function-p qa180-inner) t)
      (qa (qa180-run '((qa180-native-inner) (qa180-mark 'outer-late)))
          '((error "first") nil nil))
      (qa (qa180-run '((qa180-handle #'qa180-native-inner) (qa180-mark 'handled)))
          '((ok handled) nil (handled)))
      ;; Unsupported unwind forms still use the interpreter fallback.
      (qa (qa180-run '((condition-case err (qa180-native-inner)
                        (error (qa180-mark 'caught)))
                      (qa180-mark 'after-handler)))
          '((ok after-handler) nil (caught after-handler)))
      (qa (qa180-run '((unwind-protect (qa180-native-inner)
                        (qa180-mark 'cleanup))
                      (qa180-mark 'late)))
          '((error "first") nil (cleanup)))
      ;; Success paths and successive calls retain ordinary Lisp semantics.
      (qa (qa180-run '((qa180-outer (qa180-mark 'a) (qa180-mark 'b)
                                  (qa180-mark 'c))))
          '((ok (a b c)) nil (a b c outer)))
      (qa (qa180-run '((list (and nil (qa180-fail))
                            (or t (qa180-fail))
                            (if nil (qa180-fail) 'else)
                            (prog1 'saved (qa180-mark 'later)))))
          '((ok (nil t else saved)) nil (later)))
      (qa (qa180-run '((qa180-mark nil) (setq qa180-side nil) nil))
          '((ok nil) nil (nil)))
      (setq qa180-good (qa180-compile '((list x (1+ x))) '(x)))
      (qa (list (qa180-handle qa180-inner) (funcall qa180-good 5)
                (qa180-handle qa180-inner) (funcall qa180-good 9))
          '(error (5 6) error (9 10))))
  (delete-directory qa180-directory t))
(princ (qa--done)) (terpri)
