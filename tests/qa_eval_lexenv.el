;;; -*- lexical-binding: nil -*-
;; Explicit eval environments are flat, shared alists, as in GNU 31.1.

;; List-valued cdrs are values, never enclosing environment frames.
(qa (eval 'x '((x . (1 2)))) '(1 2))
(qa (eval '(car x) '((x . (1 2)))) 1)
(qa (eval 'x '((x))) nil)
(qa (eval 'x '((x a . b))) '(a . b))
(qa (eval 'x '((x ((y . 4))))) '(((y . 4))))
(qa (eval 'x '((x . [1 2]))) [1 2])
(qa (eval 'x '((x . "value"))) "value")
(qa (eval 'x '((x . 5) (x . 7))) 5)
(qa (eval 'x '((x) (x . 7))) nil)
(qa (eval '(list x y) '((x . 1) (y . 2) (x . 3))) '(1 2))
(qa (eval 'x '(5 "skip" ((x . 2)) (x . 9))) 9)
(qa-err (eval 'qa85-absent '(((qa85-absent . 9)))) 'void-variable)

;; Non-cons non-nil arguments request a fresh lexical scope.
(dolist (env '(t 0 7 "lexical" [] (nil) (5)))
  (qa (funcall (eval '(let ((qa85-local 7)) (lambda () qa85-local)) env)) 7))
(qa-err (funcall (eval '(let ((qa85-local 7)) (lambda () qa85-local)) nil))
        'void-variable)
(qa (let ((lexical-binding nil)) (eval 'lexical-binding t)) nil)
(qa (let ((lexical-binding t)) (eval '(let ((x 8)) (symbol-value 'x)) nil)) 8)

;; A malformed tail is only checked when assq or memq reaches it.
(qa-err-data (eval 'x '(x . 5)) 'wrong-type-argument '(listp (x . 5)))
(qa-err-data (eval 'x '((z . 8) . 5))
             'wrong-type-argument '(listp ((z . 8) . 5)))
(qa (eval 'x '((x . 1) . 5)) 1)
(qa (eval 1 '(z . 5)) 1)
(qa (eval ''x '(z . 5)) 'x)
(qa (eval '(+ 1 2) '(z . 5)) 3)
(qa-err-data (eval '(let ((y 1)) 2) '(x . 5))
             'wrong-type-argument '(listp (x . 5)))
(qa (eval '(let ((x 7)) (symbol-value 'x)) '(x . 5)) 7)
(qa (eval '(let ((case-fold-search 2)) (symbol-value 'case-fold-search)) '(x . 5)) 2)
(qa-err-data (eval '(setq x 7) '(z . 5))
             'wrong-type-argument '(listp (z . 5)))
(qa (eval nil '((nil . 8))) 8)
(qa (eval t '((t . 9))) 9)
(qa (eval :qa85 '((:qa85 . 10))) 10)
(qa-err-data (eval nil '(z . 5)) 'wrong-type-argument '(listp (z . 5)))

;; Errors after a nested binding include the full searched environment.
(qa-err-data
    (let ((env (list (cons 'x 4))))
      (eval '(let ((y 1)) (setcdr env 5) z) env))
    'wrong-type-argument '(listp ((y . 1) (x . 4) . 5)))
(qa-err-data
    (let ((env (list (cons 'x 4))))
      (eval '(let ((y 1)) (setcdr env 5) (setq z 2)) env))
    'wrong-type-argument '(listp ((y . 1) (x . 4) . 5)))
(qa-err-data
    (let ((env (list (cons 'x 4))))
      (eval '(let ((y 1)) (setcdr env 5) (let ((z 2)) z)) env))
    'wrong-type-argument '(listp ((y . 1) (x . 4) . 5)))

(qa-err-data (eval '(let ((:qa85-key 1)) 3) '(z . 5))
             'setting-constant '(:qa85-key))
(qa-err-data (eval '(let* ((:qa85-key 1)) 3) '(z . 5))
             'setting-constant '(:qa85-key))

;; A bare let variable has no initializer to evaluate; `(VAR)' has nil.
(qa (eval '(let (y) y) '((nil . 8))) nil)
(qa (eval '(let* (y) y) '((nil . 8))) nil)
(qa (eval '(let ((y)) y) '((nil . 8))) 8)
(qa (eval '(let* ((y)) y) '((nil . 8))) 8)
(qa (eval '(let (case-fold-search) 1) '(z . 5)) 1)
(qa (eval '(let* (case-fold-search) 1) '(z . 5)) 1)
(qa-err-data (eval '(let ((case-fold-search)) 1) '(z . 5))
             'wrong-type-argument '(listp (z . 5)))
(qa-err-data (eval '(let* ((case-fold-search)) 1) '(z . 5))
             'wrong-type-argument '(listp (z . 5)))

;; Bare symbols declare dynamic bindings; binding pairs do not.
(qa (let ((x 99))
      (eval '(let ((x 7)) (list x (symbol-value 'x))) '(x (x . 3))))
    '(3 7))
(qa (let ((x 99))
      (eval '(let ((x 7)) (list x (symbol-value 'x))) '((x . 3))))
    '(7 99))
(qa (let ((x 99))
      (eval '(let ((x 7)) (list x (symbol-value 'x))) '(x)))
    '(7 7))

;; setq changes the first original binding cell, including duplicate keys.
(qa (let* ((cell (cons 'x 1)) (env (list cell (cons 'x 2))))
      (eval '(setq x '(7 8)) env)
      (list (cdr cell) (cdr (cadr env)) (eval 'x env)))
    '((7 8) 2 (7 8)))
(qa (let* ((cell (cons 'x 1)) (env (cons cell 5)))
      (eval '(setq x 7) env)
      (cdr cell))
    7)
(qa (let* ((cell (cons 'x 1)) (env (list cell))
           (fn (eval '(lambda () x) env)))
      (setcdr cell 8)
      (funcall fn))
    8)
(qa (let* ((cell (cons 'x 1)) (env (list cell))
           (fn (eval '(lambda () (setq x (1+ x))) env)))
      (list (funcall fn) (cdr cell) (eval 'x env)))
    '(2 2 2))
(qa (let* ((cell (cons 'x '(1 2))) (env (list cell)))
      (eq (eval 'x env) (cdr cell)))
    t)
;; Disable GNU's optional closure optimizer to observe the supplied spine.
(qa (let* ((internal-make-interpreted-closure-function nil)
           (env (list (cons 'x 1) (cons 'y 2)))
           (fn (eval '(lambda () y) env)))
      (setcdr env (list (cons 'y 9)))
      (funcall fn))
    9)
(qa (let* ((internal-make-interpreted-closure-function nil)
           (env (list (cons 'x 1)))
           (fn (eval '(lambda () x) env)))
      (eq (aref fn 2) env))
    t)
(qa (let* ((cell (cons 'x '(1 2)))
           (fn (make-interpreted-closure nil '(x) (list cell))))
      (setcdr cell '(3 4))
      (funcall fn))
    '(3 4))
(qa (funcall (make-interpreted-closure nil '(x) '((x . 1) (x . 2)))) 1)

(qa (let ((env (list (cons 'x 1) (cons 'y 2))))
      (eval '(progn (setcdr env (list (cons 'y 9))) y) env))
    9)

;; A supplied binding's key is live too, and printing retains its order.
(qa (let* ((cell (cons 'x 1)) (env (list cell)))
      (eval '(progn (setcar cell 'y) y) env))
    1)
(qa (prin1-to-string
     (make-interpreted-closure nil '(x) '((z . 3) (x . (1 2)) (x . 9) bare 42)))
    "#[nil (x) ((z . 3) (x 1 2) (x . 9) bare 42)]")
(qa (let ((internal-make-interpreted-closure-function nil))
      (prin1-to-string (eval '(lambda () x) '((z . 3) (x . (1 2)) (x . 9) bare 42))))
    "#[nil (x) ((z . 3) (x 1 2) (x . 9) bare 42)]")

;; Circular spines terminate on a first match or signal on a failed search.
(qa (let ((env (list (cons 'x 4))))
      (setcdr env env)
      (unwind-protect (eval 'x env) (setcdr env nil)))
    4)
(qa (let ((env (list (cons 'x 4))))
      (setcdr env env)
      (unwind-protect
          (condition-case e (eval 'y env)
            (circular-list (eq (cadr e) env)))
        (setcdr env nil)))
    t)

;; condition-case binds its handler variable without a declaration scan.
(qa (eval '(condition-case e x (error (car e))) '(z . 5)) 'wrong-type-argument)
(qa (eval '(condition-case e 1 (:success e)) '(z . 5)) 1)
(qa (eval '(condition-case e x (error (cdr e))) '(z . 5)) '(listp (z . 5)))
(qa (let ((case-fold-search 7))
      (eval '(condition-case case-fold-search 1
               (:success (list case-fold-search (symbol-value 'case-fold-search))))
            '(case-fold-search)))
    '(1 7))
(qa (let ((case-fold-search 7))
      (eval '(condition-case case-fold-search (car 1)
               (error (list (car case-fold-search) (symbol-value 'case-fold-search))))
            '(case-fold-search)))
    '(wrong-type-argument 7))

;; Nested calls and nonlocal exits restore the caller's environment.
(qa (eval '(list x (eval 'x '((x . 7))) x) '((x . 5))) '(5 7 5))
(qa (eval '(list (condition-case nil (eval 'x '(z . 5)) (error 'caught)) x)
          '((x . 5)))
    '(caught 5))
(qa (eval '(list (catch 'done (eval '(throw 'done 7) '((x . 3)))) x)
          '((x . 5)))
    '(7 5))
(qa (let ((x 99)) (eval 'x '((x . 5))) x) 99)

(princ (qa--done)) (terpri)
