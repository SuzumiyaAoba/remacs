;; -*- lexical-binding: t; -*-
;; cl-lib/cl-macs/cl-extra non-sequence surface — all expectations GNU 31.1-verified.
;; Not covered: `cl-equalp'/`cl-map'/`cl-nth-value' (qa_clseq.el), `cl-random'
;; (unseeded), float constants (`most-positive-float' & co are NOT bound in
;; 31.1 even after (require 'float-sup); `cl-float-limits' library is absent),
;; `cl-ctypecase'/`cl-get*'/`getf'/`remprop'/`values' (all void in 31.1).
(require 'cl-lib)
(require 'cl-extra)

(defvar qac-pv nil)
(defvar qac-pv2 nil)

;; == cl-defun: &optional / &key / &aux / destructuring params ==
(cl-defun qac-f1 (a &optional (b 10) &aux (c (+ a b))) (list a b c))
(qa (qac-f1 1) '(1 10 11))
(qa (qac-f1 1 2) '(1 2 3))
(cl-defun qac-f2 (a &key (b 1 b-p) (c 2)) (list a b c b-p))
(qa (qac-f2 5) '(5 1 2 nil))
(qa (qac-f2 5 :b 9) '(5 9 2 t))
(qa (qac-f2 5 :c 7 :b 9) '(5 9 7 t))
(qa-err-data (qac-f2 5 :zz 1) 'error '("Keyword argument :zz not one of (:b :c)"))
(qa-err-data (qac-f2 5 :b) 'error '("Missing argument for :b"))
(cl-defun qac-kw (&key x) x)
(qa (qac-kw :x 1 :x 2) 1)                       ; duplicate key: first wins
(cl-defun qac-f3 ((a b) &optional (c 9)) (list a b c))
(qa (qac-f3 '(1 2)) '(1 2 9))
(qa (qac-f3 '(1 2) 3) '(1 2 3))
(cl-defun qac-nest ((a (b c))) (list a b c))
(qa (qac-nest '(1 (2 3))) '(1 2 3))
(cl-defun qac-f4 (a &key ((:bee b) 5)) (list a b))
(qa (qac-f4 0) '(0 5))
(qa (qac-f4 0 :bee 3) '(0 3))
;; default init-forms see earlier params, left to right
(cl-defun qac-f5 (a &optional (b (1+ a)) &key (k (* b 2))) (list a b k))
(qa (qac-f5 3) '(3 4 8))
(cl-defun qac-f6 (a &rest r &key k) (list a r k))
(qa (qac-f6 1 :k 2) '(1 (:k 2) 2))
(qa-err-data (qac-f6 1 2 3) 'error '("Keyword argument 2 not one of (:k)"))
(cl-defun qac-aok (a &key k &allow-other-keys) (list a k))
(qa (qac-aok 1 :k 2 :other 3) '(1 2))
(qa (qac-aok 1 :other 3) '(1 nil))
(cl-defun qac-sup (a &optional (b 7 b-p)) (list a b b-p))
(qa (qac-sup 1) '(1 7 nil))
(qa (qac-sup 1 nil) '(1 nil t))
;; cl-defun body is wrapped in an implicit block NAMED after the function —
;; but there is NO implicit nil block: cl-return alone errs.
(cl-defun qac-df () (cl-return-from qac-df 'named) 'late)
(qa (qac-df) 'named)
(cl-defun qac-nr () (cl-return 'early) 'late)
(qa-err (qac-nr) 'void-variable)

;; == cl-flet / cl-labels ==
(qa (cl-flet ((sq (x) (* x x)) (inc (x) (1+ x))) (sq (inc 3))) 16)
(qa (cl-flet ((f (&rest a) a)) (f 1 2 3)) '(1 2 3))
(qa (cl-flet ((f (&key k) k)) (f :k 9)) 9)
;; cl-flet closures capture surrounding lexical bindings
(qa (let ((y 5)) (cl-flet ((get () y)) (setq y 9) (get))) 9)
;; sibling definitions are NOT visible to each other, and f is not recursive
(qa-err (cl-flet ((a () (b))) (cl-flet ((b () 7)) (a))) 'void-function)
(qa-err (cl-flet ((f (x) (f (1- x)))) (f 2)) 'void-function)
;; labels: self-recursion + mutual recursion + lexical capture/mutation
(qa (cl-labels ((dn (n acc) (if (zerop n) acc (dn (1- n) (1+ acc)))))
      (dn 5 0))
    5)
(qa (cl-labels ((ev (n) (if (zerop n) t (od (1- n))))
                (od (n) (if (zerop n) nil (ev (1- n)))))
      (ev 10))
    t)
(qa (let ((n 0)) (cl-labels ((bump () (setq n (1+ n)) n)) (bump) (bump))) 2)
;; inner labels body may call outer labels fns
(qa (cl-labels ((f () 'outer)) (cl-labels ((g () (f))) (g))) 'outer)
;; flet shadows macrolet in function position
(qa (cl-macrolet ((m () 'mac)) (cl-flet ((m () 'fn)) (m))) 'fn)

;; == cl-macrolet / cl-symbol-macrolet ==
(qa (cl-macrolet ((dbl (x) `(+ ,x ,x))) (dbl 5)) 10)
(qa (cl-macrolet ((sw (a b) `(let ((tmp ,a)) (setq ,a ,b ,b tmp))))
      (let ((p 1) (q 2)) (sw p q) (list p q)))
    '(2 1))
;; setq through a symbol-macro writes the expansion's place
(qa (let ((p (list 1 2)))
      (cl-symbol-macrolet ((x (car p))) (setq x 9) (list x p)))
    '(9 (9 2)))
(qa (let ((v 1)) (cl-symbol-macrolet ((s v)) (setq s 8) v)) 8)
(qa (let ((v 4)) (cl-symbol-macrolet ((s v)) s)) 4)
(qa (let ((l '(1 2 3)))
      (cl-symbol-macrolet ((x (nth 1 l))) (cl-incf x 10) l))
    '(1 12 3))
(qa (let ((l (list 1 2 3)))
      (cl-symbol-macrolet ((x (nth 0 l)) (y (nth 1 l)))
        (cl-rotatef x y) l))
    '(2 1 3))
;; inner let shadows the symbol-macro
(qa (cl-symbol-macrolet ((a 1)) (let ((a 2)) a)) 2)
;; symbol-macro does not affect function position
(qa (cl-symbol-macrolet ((f 1)) (cl-flet ((f () 8)) (f))) 8)
;; setf of a non-place expansion compiles to a call of (setf +) → void-function
(qa-err (let ((z 3)) (cl-symbol-macrolet ((s (+ z 1))) (setq s 10)))
        'void-function)

;; == cl-block / cl-return / cl-return-from ==
(qa (cl-block foo (cl-return-from foo 42) 99) 42)
(qa (cl-block nil (cl-return 7) 8) 7)
(qa (cl-block nil 1 2 3) 3)
(qa (cl-block a (cl-block b (cl-return-from a 'outer)) 'after) 'outer)
;; return-from an unknown block / bare cl-return → void-variable on the
;; internally generated catch-var (--cl-block-NAME--)
(qa-err (cl-block foo (cl-return-from bar 1)) 'void-variable)
(qa-err (cl-return 'x) 'void-variable)
;; the block name is a symbol, not evaluated
(qa-err (cl-block 'foo (cl-return-from foo 'v)) 'void-variable)

;; == cl-case / cl-ecase ==
(qa (cl-case 2 (1 'one) (2 'two) (t 'other)) 'two)
(qa (cl-case 'b ((a b) 'ab) (c 'c)) 'ab)
(qa (cl-case 'z (a 1)) nil)
(qa (cl-case 'z (a 1) (otherwise 'd)) 'd)
;; keys compared with eql: 2.0 is not 2, string keys never match
(qa (cl-case 2.0 (2 'two) (t 'o)) 'o)
(qa (cl-case 2.0 (2.0 'twof) (t 'o)) 'twof)
(qa (cl-case "s" ("s" 'str) (t 'o)) 'o)
(qa (cl-ecase 2 (1 'a) (2 'b)) 'b)
(qa (cl-ecase 'b ((a b) 'hit)) 'hit)
(qa-err-data (cl-ecase 'x (y 1)) 'error '("cl-ecase failed: x, (y)"))
(qa-err (cl-ecase 5 ((1 2 3) 'lo)) 'error)
;; a `t'/`otherwise' clause mid-clause (or in ecase at all) is a
;; macroexpansion-time error — reachable only via eval
(qa-err (eval '(cl-case 1 (t 2) (a 3))) 'error)
(qa-err (eval '(cl-ecase 'x (t 2))) 'error)

;; == cl-typecase / cl-etypecase ==
(qa (cl-typecase 5 (integer 'int) (string 'str) (t 'other)) 'int)
(qa (cl-typecase "s" (integer 'int) (string 'str)) 'str)
(qa (cl-typecase 'x (integer 'int)) nil)
(qa (cl-typecase 'x) nil)
(qa (cl-typecase 1.5 (float 'f) (t 'o)) 'f)
(qa (cl-typecase '(1) (cons 'c) (t 'o)) 'c)
(qa (cl-typecase nil (null 'n) (t 'o)) 'n)
(qa (cl-typecase 'sym (symbol 's)) 's)
(qa (cl-typecase [1] (vector 'v)) 'v)
(qa (cl-typecase ?a (character 'ch)) 'ch)
(qa (cl-typecase 5 (real 'r)) 'r)
(qa (cl-typecase 4 ((satisfies cl-evenp) 'ev) (t 'o)) 'ev)
(qa (cl-typecase 'x (integer 1) (otherwise 'o)) 'o)
;; GNU quirk: a mid-list `otherwise' clause does not error in cl-typecase
(qa (eval '(cl-typecase 1 (otherwise 'o) (integer 2))) 'o)
(qa (cl-etypecase 4 (integer 'i)) 'i)
(qa-err-data (cl-etypecase 'x (integer 'i)) 'error
             '("cl-etypecase failed: x, (integer)"))
;; GNU quirk: cl-etypecase tolerates t/otherwise clauses
(qa (eval '(cl-etypecase 1 (t 9))) 9)
(qa (cl-etypecase 4 (integer 'i) (otherwise 'o)) 'i)
;; cl-ctypecase is void in 31.1
(qa (fboundp 'cl-ctypecase) nil)

;; == cl-deftype / cl-typep ==
(cl-deftype qac-posint () '(satisfies (lambda (x) (and (integerp x) (> x 0)))))
(qa (cl-typep 5 'qac-posint) t)
(qa (cl-typep -1 'qac-posint) nil)
(cl-deftype qac-bounded (lo hi) `(integer ,lo ,hi))
(qa (cl-typep 5 '(qac-bounded 0 10)) t)
(qa (cl-typep 50 '(qac-bounded 0 10)) nil)
(cl-deftype qac-t1 (&optional (n 1)) `(integer ,n *))
(qa (cl-typep 9 '(qac-t1)) t)
(qa (cl-typep 0 '(qac-t1)) nil)
(qa (cl-typep 9 '(qac-t1 0)) t)
(cl-deftype qac-num () "doc" '(or integer float))
(qa (cl-typep 1.5 'qac-num) t)
(qa (cl-typep 3 '(integer 0 10)) t)
(qa (cl-typep 30 '(integer 0 10)) nil)
(qa (cl-typep 4 '(integer * 10)) t)
(qa (cl-typep 4 '(integer 5 *)) nil)
(qa (cl-typep 'a '(member a b)) t)
(qa (cl-typep 'a '(or string symbol)) t)
(qa (cl-typep 5 '(and integer (satisfies cl-oddp))) t)
(qa (cl-typep 5 '(not symbol)) t)
(qa (cl-typep "s" 'string) t)
(qa (cl-typep 4 'atom) t)
(qa (cl-typep nil 'list) t)
(qa (cl-typep '(1) 'list) t)
(qa (cl-typep #'car 'function) t)
;; an unknown type spec errors at expansion (compiler warning); use eval
(qa-err (eval '(cl-typecase 1 (bogus-type-x 1))) 'error)

;; == cl-check-type / cl-assert ==
(qa (let ((x 5)) (list (cl-check-type x integer) x)) '(nil 5))
(qa (let ((p (cons 1 2))) (cl-check-type (car p) integer) p) '(1 . 2))
;; error data is (TYPE VALUE PLACE-FORM) — the place form is not evaluated
(qa-err-data (let ((x "s")) (cl-check-type x integer))
             'wrong-type-argument '(integer "s" x))
(qa-err-data (let ((p (cons "s" 2))) (cl-check-type (car p) integer))
             'wrong-type-argument '(integer "s" (car p)))
(qa (cl-assert (= 1 1)) nil)
(qa-err-data (cl-assert (= 1 2)) 'cl-assertion-failed '((= 1 2)))
(qa-err-data (cl-assert nil t "custom %d" 42) 'error '("custom 42"))

;; == cl-destructuring-bind ==
(qa (cl-destructuring-bind (a b) '(1 2) (+ a b)) 3)
(qa (cl-destructuring-bind (a &optional (b 5) c) '(1) (list a b c)) '(1 5 nil))
(qa (cl-destructuring-bind (a &rest r) '(1 2 3) (list a r)) '(1 (2 3)))
(qa (cl-destructuring-bind (&key x (y 2)) '(:x 9) (list x y)) '(9 2))
(qa (cl-destructuring-bind (&key (x 1 xp)) '(:x 5) (list x xp)) '(5 t))
(qa (cl-destructuring-bind (&key ((:x x) 0)) '(:x 5) x) 5)
(qa (cl-destructuring-bind (&key x &allow-other-keys) '(:x 1 :z 2) x) 1)
(qa (cl-destructuring-bind (a &aux (b (* a 2))) '(4) (list a b)) '(4 8))
(qa (cl-destructuring-bind (a (b c)) '(1 (2 3)) (list a b c)) '(1 2 3))
(qa (cl-destructuring-bind (&whole w a) '(9) w) '(9))
(qa (cl-destructuring-bind (a . b) '(1 2 3) (list a b)) '(1 (2 3)))
(qa-err-data (cl-destructuring-bind (a b c) '(1 2) a)
             'wrong-number-of-arguments '((a b c) 2))
(qa-err-data (cl-destructuring-bind (a) '(1 2 3) a)
             'wrong-number-of-arguments '((a) 3))
(qa-err (cl-destructuring-bind (&key x) '(:x 1 :z 2) x) 'error)
(qa-err-data (cl-destructuring-bind (a b) [1 2] (list a b))
             'wrong-type-argument '(listp [1 2]))

;; == generalized setf family ==
(qa (let ((a 1) (b 2)) (list (cl-psetq a b b a) a b)) '(nil 2 1))
(qa (let ((x 1) (y 2)) (cl-psetq x (1+ y) y (1+ x)) (list x y)) '(3 2))
(qa (let ((p (list 1 2)) (q (list 3 4)))
      (cl-psetf (car p) (car q) (car q) (car p)) (list p q))
    '((3 2) (1 4)))
(qa (let ((a 1) (b 2) (c 3)) (cl-rotatef a b c) (list a b c)) '(2 3 1))
(qa (let ((a 1) (b 2)) (list (cl-rotatef a b) a b)) '(nil 2 1))
(qa (let ((a 1)) (cl-rotatef a)) nil)
(qa (let ((a 1) (b 2) (c 3)) (list (cl-shiftf a b c 9) a b c)) '(1 2 3 9))
(qa (let ((x 5)) (list (cl-shiftf x) x)) '(5 5))
(qa (let ((l '(1 2))) (list (cl-shiftf (car l) 9) l)) '(1 (9 2)))
(qa (let ((x 5)) (cl-incf x)) 6)
(qa (let ((x 5)) (list (cl-incf x 2) x)) '(7 7))
(qa (let ((x 5)) (list (cl-decf x) x)) '(4 4))
(qa (let ((l (list 1 2))) (cl-incf (car l) 10) l) '(11 2))
(qa (let ((v (vector 1 2))) (cl-decf (aref v 1)) v) [1 1])
(qa (let ((p (cons 1 2))) (cl-decf (cdr p)) p) '(1 . 1))
(qa (let ((h (make-hash-table))) (cl-incf (gethash 'k h 0) 3) (gethash 'k h)) 3)
(qa (let ((l (list :a 1))) (cl-incf (plist-get l :a) 5) l) '(:a 6))
(qa-err (let ((l (list :a 1))) (cl-incf (cl-getf l :b) 10))
        'wrong-type-argument)
(qa (let ((l (list :a 1 :b 2))) (list (cl-remf l :a) l)) '(t (:b 2)))
(qa (let ((l (list :a 1 :b 2 :a 3))) (list (cl-remf l :a) l))
    '(t (:b 2 :a 3)))
(qa (let ((l (list :a 1))) (cl-remf l :zzz)) nil)
;; cl-callf: (cl-callf FUNC PLACE ARGS...) = (setf PLACE (FUNC PLACE ARGS...))
(qa (let ((x 3)) (list (cl-callf + x 4) x)) '(7 7))
(qa (let ((x '(1 2))) (list (cl-callf cdr x) x)) '((2) (2)))
(qa (let ((s "abc")) (cl-callf upcase s) s) "ABC")
(qa (let ((l '(1 2 3)) (seen nil))
      (cl-callf (lambda (x) (setq seen x) (cdr x)) l)
      (list l seen))
    '((2 3) (1 2 3)))
;; cl-callf2: (cl-callf2 FUNC ARG PLACE) = (setf PLACE (FUNC ARG PLACE))
(qa (let ((x 1) (y 2)) (list (cl-callf2 cons x y) x y)) '((1 . 2) 1 (1 . 2)))
(qa (let ((x 10) (y 3)) (list (cl-callf2 - x y) x y)) '(7 10 7))
(qa (let ((h (make-hash-table))) (puthash 'k 5 h)
      (list (cl-callf2 gethash 'k h) h))
    '(5 5))
(qa (let ((l '(b))) (cl-pushnew 'a l)) '(a b))
(qa (let ((l '(a b))) (cl-pushnew 'a l) (cl-pushnew 'c l) l) '(c a b))
(qa (let ((l '(1 2))) (cl-pushnew 1 l :test #'=) l) '(1 2))
;; default test is eql — strings do NOT match without :test
(qa (let ((l '("a"))) (cl-pushnew "a" l) l) '("a" "a"))
(qa (let ((l '("a"))) (cl-pushnew "a" l :test #'equal) l) '("a"))

;; == cl-defstruct ==
(cl-defstruct qac-s1 name (age 0))
(qa-prin1 (make-qac-s1 :name "x" :age 3) "#s(qac-s1 \"x\" 3)")
(qa (qac-s1-p (make-qac-s1)) t)
(qa (qac-s1-p [1 2]) nil)
(qa (qac-s1-p '(1 2)) nil)
(qa (qac-s1-age (make-qac-s1 :name "n")) 0)
(qa (qac-s1-name (copy-qac-s1 (make-qac-s1 :name "z" :age 9))) "z")
(qa-same (type-of (make-qac-s1)) 'qac-s1)
(qa (recordp (make-qac-s1)) t)
(qa (equal (make-qac-s1 :name "x") (make-qac-s1 :name "x")) t)
(qa (equal (make-qac-s1 :age 1) (make-qac-s1 :age 2)) nil)
;; copy-sequence preserves the record type
(qa (recordp (copy-sequence (make-qac-s1))) t)
(qa-same (type-of (copy-sequence (make-qac-s1 :name "k"))) 'qac-s1)
(qa (let ((s (make-qac-s1))) (setf (qac-s1-age s) 5) (qac-s1-age s)) 5)
(qa (cl-struct-slot-value 'qac-s1 'age (make-qac-s1 :age 8)) 8)
(qa-err-data (cl-struct-slot-value 'qac-s1 'nope (make-qac-s1))
             'cl-struct-unknown-slot '(qac-s1 nope))
(qa (cl-struct-slot-info 'qac-s1) '((cl-tag-slot) (name nil) (age 0)))
;; #s() printed form reads back to a real struct
(qa (qac-s1-p (car (read-from-string "#s(qac-s1 \"n\" 7)"))) t)
;; slot :type annotations are recorded, not runtime-checked
(cl-defstruct qac-s2 (a 1 :type integer) b)
(qa (make-qac-s2 :a "s" :b 'z) (make-qac-s2 :a "s" :b 'z))
(qa (cl-struct-slot-info 'qac-s2) '((cl-tag-slot) (a 1 :type integer) (b nil)))
;; slot defaults evaluate at construction
(cl-defstruct qac-df3 (a (1+ 1)))
(qa (qac-df3-a (make-qac-df3)) 2)
;; copier produces an independent object
(qa (let* ((s (make-qac-df3)) (c (copy-qac-df3 s)))
      (setf (qac-df3-a c) 99) (qac-df3-a s))
    2)
;; :type vector — anonymous (no predicate possible)
(cl-defstruct (qac-v (:type vector)) a b)
(qa (make-qac-v :a 1 :b 2) [1 2])
(qa (qac-v-a (make-qac-v :a 1)) 1)
(qa (fboundp 'qac-v-p) nil)
;; :type vector :named — tag is element 0
(cl-defstruct (qac-vn (:type vector) :named) a b)
(qa (make-qac-vn :a 1 :b 2) [qac-vn 1 2])
(qa (qac-vn-p (make-qac-vn)) t)
(qa (qac-vn-p [x 1 2]) nil)
(qa (qac-vn-p '(qac-vn 1 2)) nil)
(qa (qac-vn-p [qac-vn]) nil)
(qa (aref (make-qac-vn :a 3 :b 4) 1) 3)
(qa (let ((s (make-qac-vn :a 1))) (setf (qac-vn-a s) 5) s) [qac-vn 5 nil])
;; :type list — anonymous vs :named
(cl-defstruct (qac-l (:type list)) a b)
(qa (make-qac-l :a 1 :b 2) '(1 2))
(cl-defstruct (qac-ln (:type list) :named) a b)
(qa (make-qac-ln :a 1 :b 2) '(qac-ln 1 2))
(qa (make-qac-ln) '(qac-ln nil nil))
;; list-struct predicate only checks the car tag
(qa (qac-ln-p '(qac-ln)) t)
(qa (qac-ln-p '(qac-ln 1)) t)
(qa (qac-ln-p nil) nil)
(qa (let ((s (make-qac-ln :a 1))) (setf (qac-ln-a s) 5) s) '(qac-ln 5 nil))
;; :conc-name / :predicate / :copier / :constructor
(cl-defstruct (qac-cn (:conc-name qaccn-)) field)
(qa (qaccn-field (make-qac-cn :field 7)) 7)
(qa (fboundp 'qac-cn-field) nil)
(cl-defstruct (qac-pr (:predicate qac-custom-p)) f)
(qa (qac-custom-p (make-qac-pr)) t)
(qa (fboundp 'qac-pr-p) nil)
(cl-defstruct (qac-np (:predicate nil)) x)
(qa (fboundp 'qac-np-p) nil)
(qa-prin1 (make-qac-np :x 1) "#s(qac-np 1)")
(cl-defstruct (qac-cp (:copier nil)) f)
(qa (fboundp 'copy-qac-cp) nil)
(cl-defstruct (qac-cp2 (:copier qac-mycopy)) f)
(qa (fboundp 'qac-mycopy) t)
(qa (fboundp 'copy-qac-cp2) nil)
(qa (qac-cp2-f (qac-mycopy (make-qac-cp2 :f 8))) 8)
;; GNU quirk: a named :constructor does NOT suppress the default make-* ctor
(cl-defstruct (qac-c3 (:constructor mk3 (p))) p)
(qa (mk3 4) (make-qac-c3 :p 4))
(qa (fboundp 'make-qac-c3) t)
(cl-defstruct (qac-c4 (:constructor nil)) p)
(qa (fboundp 'make-qac-c4) nil)
;; :include — subtype predicate accepts parent type, not vice versa
(cl-defstruct qac-base a)
(cl-defstruct (qac-kid (:include qac-base)) b)
(qa (qac-kid-a (make-qac-kid :a 1 :b 2)) 1)
(qa (qac-base-p (make-qac-kid)) t)
(qa (qac-kid-p (make-qac-base)) nil)
(qa (cl-typep (make-qac-kid) 'qac-base) t)
;; a defined struct name is itself a usable type
(cl-defstruct qac-ts a)
(qa (cl-typep (make-qac-ts) 'qac-ts) t)
(qa (cl-typep 1 'qac-ts) nil)
(qa (cl-typecase (make-qac-ts) (qac-ts 'yes) (t 'no)) 'yes)
(qa (qac-ts-p (make-qac-base)) nil)

;; == multiple values ==
;; GNU cl values are just lists; producers like cl-floor detect the
;; capturing context.  `values' is void; cl-values is fbound.
(qa (fboundp 'cl-values) t)
(qa (fboundp 'values) nil)
(qa (cl-values 1 2 3) '(1 2 3))
(qa (cl-values 5) '(5))
(qa (cl-values) nil)
(qa (cl-values-list '(1 2 3)) '(1 2 3))
(qa (cl-values-list nil) nil)
(qa (cl-multiple-value-bind (q r) (cl-floor 7 2) (list q r)) '(3 1))
(qa (cl-multiple-value-bind (a b c) (cl-floor 7 2) (list a b c)) '(3 1 nil))
(qa (cl-multiple-value-bind (a b) (cl-truncate 7 2) (list a b)) '(3 1))
(qa (cl-multiple-value-bind (a b) (cl-values 1 2) (list a b)) '(1 2))
(qa (cl-multiple-value-bind (a) '(9) a) 9)
(qa (cl-multiple-value-bind nil (cl-floor 7 2) 'done) 'done)
;; the value form is destructured with nth — a non-list errors
(qa-err-data (cl-multiple-value-bind (a) 5 a)
             'wrong-type-argument '(listp 5))
;; single-value functions produce atoms, not lists
(qa-err-data (cl-multiple-value-bind (a b) (round 7 2) (list a b))
             'wrong-type-argument '(listp 4))
(qa (cl-multiple-value-list (cl-floor 7 2)) '(3 1))
(qa (cl-multiple-value-list (cl-truncate 7 2)) '(3 1))
(qa (cl-multiple-value-list 5) 5)
(qa (cl-multiple-value-call #'+ (cl-values 1 2 3)) 6)
(qa-err-data (cl-multiple-value-call #'list 1)
             'wrong-type-argument '(listp 1))
(qa (let ((a 9) (b 9))
      (list (cl-multiple-value-setq (a b) (cl-values 1 2)) a b))
    '(1 1 2))
(qa (let ((a nil) (b nil))
      (cl-multiple-value-setq (a b) (cl-floor 7 2)) (list a b))
    '(3 1))

;; == cl-the / cl-locally ==
(qa (cl-the integer 5) 5)
(qa (cl-the (member a b) 'a) 'a)
(qa (cl-the (or null string) nil) nil)
(qa (cl-the list '(1 2)) '(1 2))
(qa (let ((v 7)) (cl-the fixnum v)) 7)
;; 31.1 DOES check the type at runtime: error data = (TYPE VALUE FORM)
(qa-err-data (let ((v "x")) (cl-the fixnum v))
             'wrong-type-argument '(fixnum "x" v))
(qa-err-data (cl-the (integer 0 10) 50)
             'wrong-type-argument '((integer 0 10) 50 50))
(qa (cl-locally) nil)
(qa (cl-locally 1 2 3) 3)
(qa (cl-locally (declare (special x)) 42) 42)
;; GNU ignores the special decl: the let-bound var stays lexical.
;; (qa-lex because the scoping only differs under lexical eval.)
(qa-lex (let ((z 'lex)) (cl-locally (declare (special z)) z)) 'lex)
(qa-lex (let ((z 'lex)) (cl-locally (declare (special z)) (symbol-value 'z)))
        '(qa--err void-variable (z)))

;; == cl-progv ==
(qa (cl-progv '(qac-pv qac-pv2) '(1 2)
      (+ (symbol-value 'qac-pv) (symbol-value 'qac-pv2)))
    3)
(qa (cl-progv '(qac-pv) '(x) (symbol-value 'qac-pv)) 'x)
(qa (cl-progv nil nil 'ok) 'ok)
(qa (cl-progv '(qac-pv) '(1) (setq qac-pv 2) (symbol-value 'qac-pv)) 2)
;; dynamic binding is unwound on non-local exit
(qa (list (condition-case nil (cl-progv '(qac-pv) '(1) (error "x"))
            (error 'caught))
          (symbol-value 'qac-pv))
    '(caught nil))
;; works on never-defvar'd symbols too
(qa (cl-progv '(qac-und) '(1) (symbol-value 'qac-und)) 1)
(qa (boundp 'qac-und) nil)
(qa-err-data (cl-progv '(5) '(1) 'x) 'wrong-type-argument '(symbolp 5))
(qa-err-data (cl-progv '("s") '(1) 'x) 'wrong-type-argument '(symbolp "s"))

;; == cl-constantly / cl-gensym / cl-gentemp ==
(qa (funcall (cl-constantly 5) 1 2 3) 5)
(qa (funcall (cl-constantly nil) 9) nil)
;; gensym prefix is "G"; uninterned; integer arg becomes the suffix
(qa (equal (symbol-name (cl-gensym)) (symbol-name (cl-gensym))) nil)
(qa (intern-soft (symbol-name (cl-gensym))) nil)
(qa (symbol-name (cl-gensym 5)) "G5")
(qa (let ((s (cl-gensym "T"))) (aref (symbol-name s) 0)) ?T)
;; gentemp interns, prefix "T"
(qa (let ((s (cl-gentemp)))
      (list (aref (symbol-name s) 0) (eq s (intern-soft (symbol-name s)))))
    '(?T t))
(qa (let ((s (cl-gentemp "Z"))) (aref (symbol-name s) 0)) ?Z)

;; == cl-fresh-line / cl-parse-integer / cl-digit-char-p ==
(qa (with-output-to-string (princ "a") (cl-fresh-line) (princ "b")) "a\nb")
;; returns t when it emitted a newline, nil when already at column 0
(qa (let ((r 'none))
      (list (with-output-to-string (princ "x") (setq r (cl-fresh-line))) r))
    '("x\n" t))
(qa (let ((r 'none)) (list (with-output-to-string (setq r (cl-fresh-line))) r))
    '("" nil))
(qa (with-output-to-string (princ "a") (cl-fresh-line) (cl-fresh-line)) "a\n")
(qa (cl-parse-integer "42") 42)
(qa (cl-parse-integer "-17") -17)
(qa (cl-parse-integer "  7") 7)
(qa (cl-parse-integer "  10xy" :junk-allowed t) 10)
(qa (cl-parse-integer "1z" :junk-allowed t) 1)
(qa (cl-parse-integer "abc" :junk-allowed t) nil)
(qa (cl-parse-integer "" :junk-allowed t) nil)
(qa (cl-parse-integer "ff" :radix 16) 255)
(qa (cl-parse-integer "101" :radix 2) 5)
(qa (cl-parse-integer "010" :radix 8) 8)
(qa (cl-parse-integer "42" :start 1) 2)
(qa (cl-parse-integer "x42" :start 1 :junk-allowed t) 42)
(qa (cl-parse-integer "12345" :end 3) 123)
(qa-err (cl-parse-integer "abc") 'error)
(qa-err (cl-parse-integer "12x34" :end 4) 'error)
(qa-err-data (cl-parse-integer "10" :radix 37)
             'args-out-of-range '(radix 37 (2 36)))
(qa (cl-digit-char-p ?7) 7)
(qa (cl-digit-char-p ?f 16) 15)
(qa (cl-digit-char-p ?F 16) 15)
(qa (cl-digit-char-p ?z 36) 35)
(qa (cl-digit-char-p ?9 8) nil)
(qa (cl-digit-char-p ?g) nil)
(qa (cl-digit-char-p ?-) nil)
(qa-err (cl-digit-char-p 300) 'args-out-of-range)

;; == cl-get / cl-getf / cl-remprop / oddp / evenp ==
(qa (progn (put 'qac-gs 'p 'v) (list (cl-get 'qac-gs 'p) (get 'qac-gs 'p)))
    '(v v))
(qa (cl-get 'qac-gs 'none 'dflt) 'dflt)
(qa (let ((s (make-symbol "qac-s"))) (setf (cl-get s 'p) 'v) (cl-get s 'p)) 'v)
(qa (let ((l (list :a 1))) (cl-getf l :a)) 1)
(qa (let ((l (list :a 1))) (cl-getf l :b 99)) 99)
(qa (let ((l (list :a 1))) (setf (cl-getf l :b) 9) l) '(:b 9 :a 1))
(qa (progn (put 'qac-gs 'p 'v) (list (cl-remprop 'qac-gs 'p) (get 'qac-gs 'p)))
    '(t nil))
(qa (cl-remprop 'qac-gs 'absent) nil)
(qa-err (cl-remprop 'qac-gs) 'wrong-number-of-arguments)
;; plain oddp/evenp exist (aliases) once cl-lib is loaded
(qa (oddp 3) t)
(qa (oddp 4) nil)
(qa (oddp -3) t)
(qa (evenp 0) t)
(qa (evenp 4) t)
(qa-err-data (oddp 1.0) 'wrong-type-argument '(integer-or-marker-p 1.0))
(qa-err (oddp 'x) 'wrong-type-argument)

(princ (qa--done))
