;;; -*- lexical-binding: nil; -*-
;; GNU category tables expose real empty bitsets, not synthetic nil slots.
(let ((ct (make-category-table)))
  (qa (bool-vector-p (char-table-range ct nil)) t)
  (qa (length (char-table-range ct nil)) 128)
  (qa (char-table-range ct nil) (make-bool-vector 128 nil))
  (qa (char-table-parent ct) nil)
  (qa (char-table-subtype ct) 'category-table)
  (qa (char-table-extra-slot ct 0) (make-vector 95 nil))
  (qa (char-table-extra-slot ct 1) nil)
  (dolist (c '(0 127 128 65535 65536 1114112 4194176 4194303))
    (qa (bool-vector-p (aref ct c)) t)
    (qa (aref ct c) (make-bool-vector 128 nil)))
  ;; The fresh ASCII cache is nil, so ASCII reads the separate default.
  (qa (eq (aref ct 0) (char-table-range ct nil)) t)
  (qa (eq (aref ct 127) (char-table-range ct nil)) t)
  (qa (eq (aref ct 128) (aref ct 65535)) t)
  (qa (eq (aref ct 128) (char-table-range ct nil)) nil)
  (dotimes (block 63)
    (qa (eq (aref ct (+ 128 (* block 65536)))
            (aref ct (+ 128 (* (1+ block) 65536)))) nil))
  (let (runs)
    (map-char-table (lambda (range value)
                     (push (list (copy-tree range) (length value)
                                 (category-set-mnemonics value)) runs)) ct)
    (setq runs (nreverse runs))
    (qa (length runs) 64)
    (qa (car runs) '((0 . 65535) 128 ""))
    (qa (car (last runs)) '((4128768 . 4194303) 128 "")))
  (qa (string-prefix-p "#^[#&128" (prin1-to-string ct)) t)
  (qa (not (null (string-search "category-table nil #&128" (prin1-to-string ct)))) t)
  (qa (char-table-extra-slot ct 1) nil)
  (with-category-table ct
    (qa (eq (char-category-set 0) (aref ct 0)) t)
    (qa (eq (char-category-set 4194303) (aref ct 4194303)) t)))
;; Defaults and block bitsets are mutable, but independent.
(let ((ct (make-category-table)) (other (make-category-table)))
  (aset (char-table-range ct nil) ?d t)
  (aset (aref ct 128) ?b t)
  (qa (mapcar (lambda (c) (category-set-mnemonics (aref ct c)))
              '(0 127 128 65535 65536)) '("d" "d" "b" "b" ""))
  (qa (category-set-mnemonics (aref other 0)) "")
  (qa (category-set-mnemonics (aref other 128)) "")
  (aset ct 128 (make-category-set "x"))
  (qa (category-set-mnemonics (aref ct 127)) "d")
  ;; The first ASCII store refreshes its cache from the root block.
  (aset ct 0 (make-category-set "z"))
  (qa (mapcar (lambda (c) (category-set-mnemonics (aref ct c)))
              '(0 127 128 65535 65536)) '("z" "b" "x" "b" "")))
(let ((ct (standard-category-table)))
  (qa (char-table-range ct nil) (make-bool-vector 128 nil))
  (dolist (c '(0 9 10 31))
    (qa (eq (aref ct c) (char-table-range ct nil)) t))
  (qa (string-prefix-p "#^[#&128" (prin1-to-string ct)) t))
;; Copies detach mutable default/entry bitsets and documentation vectors.
(let* ((ct (make-category-table)) (copy (copy-category-table ct)))
  (qa (equal ct copy) nil) ; copying repairs the otherwise-nil ASCII cache
  (qa (eq (char-table-range ct nil) (char-table-range copy nil)) nil)
  (qa (eq (aref ct 128) (aref copy 128)) nil)
  (qa (eq (aref copy 0) (aref copy 128)) t)
  (qa (eq (aref copy 0) (char-table-range copy nil)) nil)
  (qa (eq (char-table-extra-slot ct 0) (char-table-extra-slot copy 0)) nil)
  (aset (char-table-range copy nil) ?d t)
  (aset (aref copy 128) ?x t)
  (qa (category-set-mnemonics (char-table-range ct nil)) "")
  (qa (category-set-mnemonics (aref ct 128)) "")
  (qa (category-set-mnemonics (aref copy 0)) "x")
  (qa (category-set-mnemonics (aref copy 65536)) ""))
(let ((ct (make-category-table)))
  (define-category ?x "x" ct)
  (modify-category-entry '(100 . 200) ?x ct)
  (let ((copy (copy-category-table ct)))
    (qa (eq (char-table-extra-slot ct 1) (char-table-extra-slot copy 1)) t)
    (qa (eq (aref ct 150) (aref copy 150)) nil)
    (qa (category-set-mnemonics (aref copy 150)) "x")
    (aset (aref copy 150) ?y t)
    (qa (category-set-mnemonics (aref ct 150)) "x")
    (define-category ?y "y" copy)
    (qa (category-docstring ?y ct) nil)))
;; Omitted/nil copy source is standard, even in a customized buffer.
(with-category-table (make-category-table)
  (qa (category-set-mnemonics (aref (copy-category-table) ?a)) ".Lalr")
  (qa (category-set-mnemonics (aref (copy-category-table nil) ?a)) ".Lalr"))
(princ (qa--done)) (terpri)
