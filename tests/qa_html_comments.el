;;; -*- lexical-binding: nil; -*-
(defun qa-html-comments--parse (text &optional discard-comments)
  (with-temp-buffer
    (insert text)
    (libxml-parse-html-region nil nil nil discard-comments)))

;; Issue #173: DISCARD-COMMENTS drops document-level comments only.
;; Expected DOMs freshly verified against GNU Emacs 31.1 with libxml2.
(qa (qa-html-comments--parse "<!--before--><p><!--inside-->text</p><!--after-->" nil)
    '(top nil (comment nil "before") (html nil (body nil (p nil (comment nil "inside") "text") (comment nil "after")))))
(qa (qa-html-comments--parse "<!--before--><p><!--inside-->text</p><!--after-->" t)
    '(html nil (body nil (p nil (comment nil "inside") "text") (comment nil "after"))))
(qa (qa-html-comments--parse "<!--before--><p><!--inside-->text</p><!--after-->" 'discard)
    '(html nil (body nil (p nil (comment nil "inside") "text") (comment nil "after"))))
(qa (qa-html-comments--parse "<!--before--><p><!--inside-->text</p><!--after-->" 0)
    '(html nil (body nil (p nil (comment nil "inside") "text") (comment nil "after"))))
(qa (qa-html-comments--parse "<p><!--inside-->text</p>" nil)
    '(html nil (body nil (p nil (comment nil "inside") "text"))))
(qa (qa-html-comments--parse "<p><!--inside-->text</p>" t)
    '(html nil (body nil (p nil (comment nil "inside") "text"))))
(qa (qa-html-comments--parse "<p><!--inside-->text</p>" 'discard)
    '(html nil (body nil (p nil (comment nil "inside") "text"))))
(qa (qa-html-comments--parse "<p><!--inside-->text</p>" 0)
    '(html nil (body nil (p nil (comment nil "inside") "text"))))
(qa (qa-html-comments--parse "<!--first--><!--second--><div><!--outer--><p>before<!--middle--><b><!--deep-->bold</b>after<!--last--></p></div>" nil)
    '(top nil (comment nil "first") (comment nil "second") (html nil (body nil (div nil (comment nil "outer") (p nil "before" (comment nil "middle") (b nil (comment nil "deep") "bold") "after" (comment nil "last")))))))
(qa (qa-html-comments--parse "<!--first--><!--second--><div><!--outer--><p>before<!--middle--><b><!--deep-->bold</b>after<!--last--></p></div>" t)
    '(html nil (body nil (div nil (comment nil "outer") (p nil "before" (comment nil "middle") (b nil (comment nil "deep") "bold") "after" (comment nil "last"))))))
(qa (qa-html-comments--parse "<!--first--><!--second--><div><!--outer--><p>before<!--middle--><b><!--deep-->bold</b>after<!--last--></p></div>" 'discard)
    '(html nil (body nil (div nil (comment nil "outer") (p nil "before" (comment nil "middle") (b nil (comment nil "deep") "bold") "after" (comment nil "last"))))))
(qa (qa-html-comments--parse "<!--first--><!--second--><div><!--outer--><p>before<!--middle--><b><!--deep-->bold</b>after<!--last--></p></div>" 0)
    '(html nil (body nil (div nil (comment nil "outer") (p nil "before" (comment nil "middle") (b nil (comment nil "deep") "bold") "after" (comment nil "last"))))))
(qa (qa-html-comments--parse "<!--before--><html><head><!--head--><title>title</title></head><body><!--body--><p><!--p-->text</p></body></html><!--after-->" nil)
    '(top nil (comment nil "before") (html nil (head nil (comment nil "head") (title nil "title")) (body nil (comment nil "body") (p nil (comment nil "p") "text"))) (comment nil "after")))
(qa (qa-html-comments--parse "<!--before--><html><head><!--head--><title>title</title></head><body><!--body--><p><!--p-->text</p></body></html><!--after-->" t)
    '(html nil (head nil (comment nil "head") (title nil "title")) (body nil (comment nil "body") (p nil (comment nil "p") "text"))))
(qa (qa-html-comments--parse "<!--before--><html><head><!--head--><title>title</title></head><body><!--body--><p><!--p-->text</p></body></html><!--after-->" 'discard)
    '(html nil (head nil (comment nil "head") (title nil "title")) (body nil (comment nil "body") (p nil (comment nil "p") "text"))))
(qa (qa-html-comments--parse "<!--before--><html><head><!--head--><title>title</title></head><body><!--body--><p><!--p-->text</p></body></html><!--after-->" 0)
    '(html nil (head nil (comment nil "head") (title nil "title")) (body nil (comment nil "body") (p nil (comment nil "p") "text"))))
(qa (qa-html-comments--parse "<html><!--under-html--><head><title>x</title></head><body><p>x</p></body></html>" nil)
    '(html nil (comment nil "under-html") (head nil (title nil "x")) (body nil (p nil "x"))))
(qa (qa-html-comments--parse "<html><!--under-html--><head><title>x</title></head><body><p>x</p></body></html>" t)
    '(html nil (comment nil "under-html") (head nil (title nil "x")) (body nil (p nil "x"))))
(qa (qa-html-comments--parse "<html><!--under-html--><head><title>x</title></head><body><p>x</p></body></html>" 'discard)
    '(html nil (comment nil "under-html") (head nil (title nil "x")) (body nil (p nil "x"))))
(qa (qa-html-comments--parse "<html><!--under-html--><head><title>x</title></head><body><p>x</p></body></html>" 0)
    '(html nil (comment nil "under-html") (head nil (title nil "x")) (body nil (p nil "x"))))
(qa (qa-html-comments--parse "<html><head><!--head--></head><body><!--body--></body></html>" nil)
    '(html nil (head nil (comment nil "head")) (body nil (comment nil "body"))))
(qa (qa-html-comments--parse "<html><head><!--head--></head><body><!--body--></body></html>" t)
    '(html nil (head nil (comment nil "head")) (body nil (comment nil "body"))))
(qa (qa-html-comments--parse "<html><head><!--head--></head><body><!--body--></body></html>" 'discard)
    '(html nil (head nil (comment nil "head")) (body nil (comment nil "body"))))
(qa (qa-html-comments--parse "<html><head><!--head--></head><body><!--body--></body></html>" 0)
    '(html nil (head nil (comment nil "head")) (body nil (comment nil "body"))))
(qa (qa-html-comments--parse "<p><!--a--><!--b--></p>" nil)
    '(html nil (body nil (p nil (comment nil "a") (comment nil "b")))))
(qa (qa-html-comments--parse "<p><!--a--><!--b--></p>" t)
    '(html nil (body nil (p nil (comment nil "a") (comment nil "b")))))
(qa (qa-html-comments--parse "<p><!--a--><!--b--></p>" 'discard)
    '(html nil (body nil (p nil (comment nil "a") (comment nil "b")))))
(qa (qa-html-comments--parse "<p><!--a--><!--b--></p>" 0)
    '(html nil (body nil (p nil (comment nil "a") (comment nil "b")))))
(qa (qa-html-comments--parse "<p>left<!---->right</p>" nil)
    '(html nil (body nil (p nil "left" (comment nil "") "right"))))
(qa (qa-html-comments--parse "<p>left<!---->right</p>" t)
    '(html nil (body nil (p nil "left" (comment nil "") "right"))))
(qa (qa-html-comments--parse "<p>left<!---->right</p>" 'discard)
    '(html nil (body nil (p nil "left" (comment nil "") "right"))))
(qa (qa-html-comments--parse "<p>left<!---->right</p>" 0)
    '(html nil (body nil (p nil "left" (comment nil "") "right"))))
(qa (qa-html-comments--parse "<!--leading--><p>a<!-- &amp; 日本語 -->b</p>" nil)
    '(top nil (comment nil "leading") (html nil (body nil (p nil "a" (comment nil " &amp; 日本語 ") "b")))))
(qa (qa-html-comments--parse "<!--leading--><p>a<!-- &amp; 日本語 -->b</p>" t)
    '(html nil (body nil (p nil "a" (comment nil " &amp; 日本語 ") "b"))))
(qa (qa-html-comments--parse "<!--leading--><p>a<!-- &amp; 日本語 -->b</p>" 'discard)
    '(html nil (body nil (p nil "a" (comment nil " &amp; 日本語 ") "b"))))
(qa (qa-html-comments--parse "<!--leading--><p>a<!-- &amp; 日本語 -->b</p>" 0)
    '(html nil (body nil (p nil "a" (comment nil " &amp; 日本語 ") "b"))))
(qa (qa-html-comments--parse "<!DOCTYPE html><!--before--><html><head><title>x</title></head><body><p><!--inside-->x</p></body></html><!--after-->" nil)
    '(top nil (comment nil "before") (html nil (head nil (title nil "x")) (body nil (p nil (comment nil "inside") "x"))) (comment nil "after")))
(qa (qa-html-comments--parse "<!DOCTYPE html><!--before--><html><head><title>x</title></head><body><p><!--inside-->x</p></body></html><!--after-->" t)
    '(html nil (head nil (title nil "x")) (body nil (p nil (comment nil "inside") "x"))))
(qa (qa-html-comments--parse "<!DOCTYPE html><!--before--><html><head><title>x</title></head><body><p><!--inside-->x</p></body></html><!--after-->" 'discard)
    '(html nil (head nil (title nil "x")) (body nil (p nil (comment nil "inside") "x"))))
(qa (qa-html-comments--parse "<!DOCTYPE html><!--before--><html><head><title>x</title></head><body><p><!--inside-->x</p></body></html><!--after-->" 0)
    '(html nil (head nil (title nil "x")) (body nil (p nil (comment nil "inside") "x"))))
(qa (qa-html-comments--parse "<table><!--table--><tr><td><!--cell-->x</td></tr></table>" nil)
    '(html nil (body nil (table nil (comment nil "table") (tr nil (td nil (comment nil "cell") "x"))))))
(qa (qa-html-comments--parse "<table><!--table--><tr><td><!--cell-->x</td></tr></table>" t)
    '(html nil (body nil (table nil (comment nil "table") (tr nil (td nil (comment nil "cell") "x"))))))
(qa (qa-html-comments--parse "<table><!--table--><tr><td><!--cell-->x</td></tr></table>" 'discard)
    '(html nil (body nil (table nil (comment nil "table") (tr nil (td nil (comment nil "cell") "x"))))))
(qa (qa-html-comments--parse "<table><!--table--><tr><td><!--cell-->x</td></tr></table>" 0)
    '(html nil (body nil (table nil (comment nil "table") (tr nil (td nil (comment nil "cell") "x"))))))
(qa (qa-html-comments--parse "<table><tbody><!--tbody--><tr><td>x<!--cell--></td></tr></tbody></table>" nil)
    '(html nil (body nil (table nil (tbody nil (comment nil "tbody") (tr nil (td nil "x" (comment nil "cell"))))))))
(qa (qa-html-comments--parse "<table><tbody><!--tbody--><tr><td>x<!--cell--></td></tr></tbody></table>" t)
    '(html nil (body nil (table nil (tbody nil (comment nil "tbody") (tr nil (td nil "x" (comment nil "cell"))))))))
(qa (qa-html-comments--parse "<table><tbody><!--tbody--><tr><td>x<!--cell--></td></tr></tbody></table>" 'discard)
    '(html nil (body nil (table nil (tbody nil (comment nil "tbody") (tr nil (td nil "x" (comment nil "cell"))))))))
(qa (qa-html-comments--parse "<table><tbody><!--tbody--><tr><td>x<!--cell--></td></tr></tbody></table>" 0)
    '(html nil (body nil (table nil (tbody nil (comment nil "tbody") (tr nil (td nil "x" (comment nil "cell"))))))))
(qa (qa-html-comments--parse "<p>plain<br>text</p>" nil)
    '(html nil (body nil (p nil "plain" (br nil) "text"))))
(qa (qa-html-comments--parse "<p>plain<br>text</p>" t)
    '(html nil (body nil (p nil "plain" (br nil) "text"))))
(qa (qa-html-comments--parse "<p>plain<br>text</p>" 'discard)
    '(html nil (body nil (p nil "plain" (br nil) "text"))))
(qa (qa-html-comments--parse "<p>plain<br>text</p>" 0)
    '(html nil (body nil (p nil "plain" (br nil) "text"))))
(qa (qa-html-comments--parse "<script><!--literal--></script><p><!--real-->x</p>" nil)
    '(html nil (head nil (script nil "<!--literal-->")) (body nil (p nil (comment nil "real") "x"))))
(qa (qa-html-comments--parse "<script><!--literal--></script><p><!--real-->x</p>" t)
    '(html nil (head nil (script nil "<!--literal-->")) (body nil (p nil (comment nil "real") "x"))))
(qa (qa-html-comments--parse "<script><!--literal--></script><p><!--real-->x</p>" 'discard)
    '(html nil (head nil (script nil "<!--literal-->")) (body nil (p nil (comment nil "real") "x"))))
(qa (qa-html-comments--parse "<script><!--literal--></script><p><!--real-->x</p>" 0)
    '(html nil (head nil (script nil "<!--literal-->")) (body nil (p nil (comment nil "real") "x"))))
(qa (qa-html-comments--parse "<style><!--literal--></style><p><!--real-->x</p>" nil)
    '(html nil (head nil (style nil "<!--literal-->")) (body nil (p nil (comment nil "real") "x"))))
(qa (qa-html-comments--parse "<style><!--literal--></style><p><!--real-->x</p>" t)
    '(html nil (head nil (style nil "<!--literal-->")) (body nil (p nil (comment nil "real") "x"))))
(qa (qa-html-comments--parse "<style><!--literal--></style><p><!--real-->x</p>" 'discard)
    '(html nil (head nil (style nil "<!--literal-->")) (body nil (p nil (comment nil "real") "x"))))
(qa (qa-html-comments--parse "<style><!--literal--></style><p><!--real-->x</p>" 0)
    '(html nil (head nil (style nil "<!--literal-->")) (body nil (p nil (comment nil "real") "x"))))

;; Region selection preserves buffer contents, point, and narrowing.
(qa (with-temp-buffer
      (insert "prefix<!--before--><p><!--inside-->text</p><!--after-->suffix")
      (narrow-to-region 7 (- (point-max) 6))
      (goto-char (point-min))
      (let ((before (buffer-string)) (start (point-min)) (end (point-max)))
        (list (libxml-parse-html-region nil nil nil t)
              (equal before (buffer-string)) (= start (point))
              (= start (point-min)) (= end (point-max)))))
    '((html nil (body nil (p nil (comment nil "inside") "text")
                          (comment nil "after"))) t t t t))
(qa (with-temp-buffer
      (insert "prefix<!--before--><p><!--inside-->text</p><!--after-->suffix")
      (libxml-parse-html-region (- (point-max) 6) 7 nil t))
    '(html nil (body nil (p nil (comment nil "inside") "text")
                        (comment nil "after"))))
;; Switching the option between parses never affects later calls.
(qa (let ((text "<!--before--><p><!--inside-->text</p>"))
      (qa-html-comments--parse text t)
      (qa-html-comments--parse text nil))
    '(top nil (comment nil "before")
          (html nil (body nil (p nil (comment nil "inside") "text")))))
(dolist (text '("" " " "\t\r\n"))
  (qa (qa-html-comments--parse text nil) nil)
  (qa (qa-html-comments--parse text t) nil))

(princ (qa--done))
(terpri)
